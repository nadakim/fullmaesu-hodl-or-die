/* ══════════════════════════════════════════════════════════
   UI RENDER
══════════════════════════════════════════════════════════ */
function renderUI(){
  let totalPosVal = 0;
  openPositions.forEach(pos=>{ totalPosVal += calculatePositionValue(pos); });
  const totalAssets = availableCash + totalPosVal;

  document.getElementById('totalAssets').textContent  = '₩ '+Math.round(totalAssets).toLocaleString()+'만';
  document.getElementById('availableCash').textContent = '₩ '+Math.round(availableCash).toLocaleString()+'만';

  const pnlEl = document.getElementById('realizedPnL');
  pnlEl.textContent = '₩ '+(realizedPnL>=0?'+':'')+Math.round(realizedPnL).toLocaleString()+'만';
  pnlEl.style.color = realizedPnL>=0 ? 'var(--green)' : 'var(--red)';

  document.getElementById('marketPriceText').textContent = Math.round(marketPrice).toLocaleString();

  const handBox = document.getElementById('handBox');
  handBox.innerHTML = '';
  handCards.forEach((card,idx)=>{
    const el = document.createElement('div');
    el.className = 'card';
    el.onclick = ()=>buyPosition(idx);
    el.innerHTML = `
      <div class="sym">${card.name}</div>
      <div class="sector">${card.sector}</div>
      <div class="cost">₩${card.cost}만</div>
      <div class="beta">β ${card.beta}</div>`;
    handBox.appendChild(el);
  });

  const posBox = document.getElementById('positionsBox');
  if(openPositions.length===0){
    posBox.innerHTML = `<div style="text-align:center;padding:14px;color:var(--muted);font-family:'Press Start 2P';font-size:7px;">── NO POSITION ──</div>`;
  } else {
    posBox.innerHTML = '';
    openPositions.forEach(pos=>{
      const curVal = calculatePositionValue(pos);
      const pnl = curVal - pos.costBasis;
      const pnlPct = ((pnl/pos.costBasis)*100).toFixed(1);
      const item = document.createElement('div');
      item.className = 'pos-item';
      item.innerHTML = `
        <div class="pos-info">
          <div class="name">${pos.name}</div>
          <div class="detail">BUY:${Math.round(pos.buyPrice)} | ₩${pos.costBasis}만</div>
        </div>
        <div class="pos-pnl">
          <div class="val ${pnl>=0?'pnl-up':'pnl-down'}">
            ${pnl>=0?'+':''}${Math.round(pnl)}만 (${pnlPct}%)
          </div>
          <button class="sell-btn" onclick="sellPosition(${pos.id})">매도</button>
        </div>`;
      posBox.appendChild(item);
    });
  }
}

function showPopNum(text, isUp){
  const pop = document.createElement('div');
  pop.className = 'popnum';
  pop.style.left = (20+Math.random()*40)+'%';
  pop.style.top  = (25+Math.random()*30)+'%';
  pop.style.color = isUp ? 'var(--green)' : 'var(--red)';
  pop.style.textShadow = isUp ? '1px 1px 0 #003a14' : '1px 1px 0 #5c0010';
  pop.textContent = text;
  document.getElementById('chartBox').appendChild(pop);
  setTimeout(()=>pop.remove(), 900);
}

function cashRain(){
  const layer = document.getElementById('confettiLayer');
  const syms = ['$','₩','★','◆'];
  for(let i=0;i<18;i++){
    const b = document.createElement('div');
    b.className = 'bill';
    b.style.left = Math.random()*100+'vw';
    b.style.animationDelay = (Math.random()*.5)+'s';
    b.textContent = syms[Math.floor(Math.random()*syms.length)];
    layer.appendChild(b);
    setTimeout(()=>b.remove(), 2000);
  }
}

/* ══════════════════════════════════════════════════════════
   TABS + INIT
══════════════════════════════════════════════════════════ */
const tabBtns = document.querySelectorAll('.tabnav button');
const screens = document.querySelectorAll('.screen');
tabBtns.forEach(b=>{
  b.addEventListener('click',()=>{
    tabBtns.forEach(x=>x.classList.remove('active'));
    screens.forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    document.getElementById('screen-'+b.dataset.s).classList.add('active');
    if(b.dataset.s==='play') renderChart();
  });
});

document.getElementById('startBtn').addEventListener('click',()=>tabBtns[1].click());
document.getElementById('sellAllBtn').addEventListener('click',sellAllPositions);

const tickerContent = '▶ 삼성전자 10만 전자 가즈아! &nbsp;·&nbsp; DOGE TO THE MOON 🚀 &nbsp;·&nbsp; 존버는 승리한다 &nbsp;·&nbsp; 풀매수 기원단 &nbsp;·&nbsp; 영끌 아니면 영원히 무주택 &nbsp;·&nbsp; HODL OR DIE &nbsp;·&nbsp; ';
document.getElementById('tickerText').innerHTML = tickerContent.repeat(3);

function initGame(){
  availableCash = 10000;
  realizedPnL   = 0;
  openPositions = [];
  handCards = [];
  for(let i=0;i<5;i++){
    handCards.push(CARD_DATABASE[Math.floor(Math.random()*CARD_DATABASE.length)]);
  }
  initChartData();
  renderChart();
  renderUI();

  // 고밀도 배경 차트 매니저 실행
  ambientBg.init();

  setInterval(pushNewCandle, 800);
  setInterval(()=>{ if(Math.random()>0.4) triggerMarketEvent(); }, 15000);
}

window.addEventListener('resize', renderChart);
window.onload = initGame;
</script>
