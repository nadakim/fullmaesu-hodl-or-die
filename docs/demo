/* ── 종목 시세판 (클릭 = 큰 차트, 찌라시 대상 지정 중이면 대상 선택) ── */
function buildQuotes(){
  $('quoteBox').innerHTML = STOCKS.map(s => `
    <div class="quote-row" data-q="${s.id}">
      <div class="q-name">${s.name}<span class="q-tag"></span><small>${s.sector} · β${s.beta}</small></div>
      <canvas width="64" height="18"></canvas>
      <div class="q-price"></div>
      <div class="q-chg"></div>
    </div>`).join('');
}

function drawSpark(cv, hist, up){
  const ctx = cv.getContext('2d');
  const w = cv.width, h = cv.height;
  ctx.clearRect(0, 0, w, h);
  const mx = Math.max(...hist), mn = Math.min(...hist), rg = (mx - mn) || 1;
  ctx.fillStyle = up ? '#00ff41' : '#ff1a3c';
  hist.forEach((v, i) => {
    const x = Math.round(i * (w - 2) / (hist.length - 1));
    const y = Math.round(h - 3 - (v - mn) / rg * (h - 4));
    ctx.fillRect(x, y, 2, 2);
  });
}

function renderQuotes(){
  const targets = selectedTargets('asset');
  STOCKS.forEach(s => {
    const row = document.querySelector(`[data-q="${s.id}"]`);
    if(!row) return;
    const a = assets[s.id];
    const chg = a.price / a.dayOpen - 1;
    row.querySelector('.q-price').textContent = fmtPrice(a.price);
    const ch = row.querySelector('.q-chg');
    ch.textContent = fmtPct(chg);
    ch.className = 'q-chg ' + (chg >= 0 ? 'pnl-up' : 'pnl-down');
    drawSpark(row.querySelector('canvas'), a.history, chg >= 0);
    // 찌라시: 장전에는 결과를 숨긴다
    const pm = run.pumps[s.id], tag = row.querySelector('.q-tag');
    tag.textContent = !pm ? '' : run.phase !== 'market' ? '찌라시?' : pm > 0 ? '작전▲' : '설거지▼';
    tag.className = 'q-tag ' + (!pm ? '' : run.phase !== 'market' ? 'hidden' : pm > 0 ? 'up' : 'down');
    row.classList.toggle('targetable', targets.indexOf(s.id) >= 0);
    row.classList.toggle('charted', chartTarget === s.id);
  });
}

/* ── 행동력 · 더미 · 대기 효과 · 장 시작 ── */
function renderTurn(){
  const pre = run.phase === 'premarket';
  let pips = '';
  for(let i = 0; i < Math.max(run.ap, AP_PER_DAY); i++) pips += `<span class="ap-pip ${i < run.ap ? 'on' : ''}"></span>`;
  $('apPips').innerHTML = pips;
  $('apText').textContent = `${run.ap}/${AP_PER_DAY}`;
  $('pileText').textContent = `덱 ${run.drawPile.length} · 버림 ${run.discard.length} · 소멸 ${run.exhausted.length}`;

  const chips = [];
  const pd = run.pending, parts = [];
  if(pd.principalMult > 1) parts.push(`원금 ${pd.principalMult}배`);
  if(pd.lev > 1) parts.push(pd.lev === CREDIT_LEV ? `신용 ${pd.lev}x` : `영끌 ${pd.lev}x`);
  if(pd.dir < 0) parts.push('숏');
  if(parts.length) chips.push(`<span class="chip ${pd.dir < 0 ? 'short' : 'buy'}">다음 매수: ${parts.join(' · ')}</span>`);
  if(run.forcedState) chips.push(`<span class="chip mod">오늘 장: ${run.forcedState}</span>`);
  if(run.interestFree) chips.push('<span class="chip">오늘 이자 면제</span>');
  if(run.noSellToday) chips.push('<span class="chip mod">계좌 잠금: 매도 불가 · 반대매매 면제</span>');
  $('chipBox').innerHTML = chips.join('');

  const btn = $('openBtn');
  const shop = run.phase === 'shop';
  btn.disabled = !pre && !shop;
  btn.textContent = pre ? '▶ 장 시작' : shop ? '◈ 암시장에 들렀다가 다음 주 개장'
    : run.phase === 'market' ? `장중 · 캔들 ${run.tickInDay}/${TICKS_PER_DAY}` : '결산 중';
  $('handHint').textContent = selectedIdx >= 0 ? '대상을 클릭 · 다시 누르면 취소'
    : pre ? '카드를 눌러 사용' : '장중에는 카드 사용 불가';
}

/* ── 손패 ── */
function cardUsable(idx){
  if(run.phase !== 'premarket') return false;
  const card = CARD_BY_ID[run.hand[idx].id];
  if(card.target) return validTargetIds(idx).length > 0;
  return checkPlay(idx, null) === null;
}

function renderHand(){
  const box = $('handBox');
  const usable = run.hand.map((_, i) => cardUsable(i) ? '1' : '0').join('');
  const sig = run.hand.map(c => c.uid).join() + '|' + usable + '|' + selectedIdx + '|' + run.pending.principalMult;
  if(sig !== handSig){
    handSig = sig;
    box.innerHTML = run.hand.length === 0
      ? `<div class="empty-note">── 손패 없음 ──</div>`
      : run.hand.map((inst, i) => {
          const card = CARD_BY_ID[inst.id];
          const cls = (usable[i] === '1' ? '' : 'disabled') + (i === selectedIdx ? ' selected' : '');
          const cost = card.stock ? stockCost(STOCK_BY_ID[card.stock]) : 0;
          return cardHtml(card, { attrs: `data-idx="${i}"`, cls, cost, live: true });
        }).join('');
  }
  box.querySelectorAll('[data-p]').forEach(el => { el.textContent = '@' + fmtPrice(assets[el.dataset.p].price); });
}

/* ── 보유 포지션 ── */
function orderTags(p){
  const t = [];
  if(p.stopLoss)       t.push(`<span class="o-tag stop">손절 ${fmtPct(STOP_LOSS_PCT)}</span>`);
  if(p.takeProfit)     t.push(`<span class="o-tag take">익절 ${fmtPct(TAKE_PROFIT_PCT)}</span>`);
  if(p.trailing)       t.push(`<span class="o-tag trail">트레일 ${Math.round(TRAIL_GAP * 100)}%p</span>`);
  if(p.protectedToday) t.push('<span class="o-tag hodl">존버</span>');
  if(p.diamond)        t.push('<span class="o-tag diamond">💎 다이아몬드</span>');
  return t.join('');
}

function renderPositions(){
  const box = $('positionsBox');
  const sig = run.positions.map(p => [p.id, p.lev, p.dir, Math.round(p.principal), p.stopLoss, p.takeProfit, p.trailing, p.protectedToday, p.diamond].join(':')).join()
    + '|' + run.noSellToday + run.allProtectedToday;
  if(sig !== posSig){
    posSig = sig;
    box.innerHTML = run.positions.length === 0
      ? `<div class="empty-note">── NO POSITION ──</div>`
      : run.positions.map(p => `
        <div class="pos-item" data-id="${p.id}">
          <div class="pos-info">
            <div class="name">${p.name}${p.dir < 0 ? '<span class="lev-badge short">숏</span>' : ''}${p.lev > 1 ? `<span class="lev-badge lev${p.lev}">${p.lev}x</span>` : ''}</div>
            <div class="detail" data-f="price"></div>
            <div class="detail">원금 ₩${Math.round(p.principal).toLocaleString()}만 · 노출 <span data-f="exp"></span></div>
            ${isMarginable(p) ? '<div class="ratio" data-f="ratio"></div>' : ''}
            ${orderTags(p) ? `<div class="o-tags">${orderTags(p)}</div>` : ''}
          </div>
          <div class="pos-pnl">
            <div class="val" data-f="pnl"></div>
            <button class="sell-btn" data-sell="${p.id}" ${canSell(p) ? '' : 'disabled'}>매도</button>
          </div>
        </div>`).join('');
  }
  const targets = selectedTargets('position');
  run.positions.forEach(p => {
    const el = box.querySelector(`[data-id="${p.id}"]`);
    if(!el) return;
    el.classList.toggle('targetable', targets.indexOf(p.id) >= 0);
    el.querySelector('[data-f=price]').textContent = `평단 ${fmtPrice(avgPrice(p))} → ${fmtPrice(assets[p.assetId].price)}`;
    el.querySelector('[data-f=exp]').textContent = fmtMoney(exposure(p));
    const pnl = posPnl(p);
    const pv = el.querySelector('[data-f=pnl]');
    pv.textContent = `${fmtSigned(pnl)} (${fmtPct(posReturn(p))})`;
    pv.className = 'val ' + (pnl >= 0 ? 'pnl-up' : 'pnl-down');
    const rEl = el.querySelector('[data-f=ratio]');
    if(rEl){
      const r = marginRatio(p);
      rEl.textContent = `증거금률 ${Math.round(r * 100)}% / 반대매매 ${Math.round(MARGIN_CALL_RATIO * 100)}%` + (isProtected(p) ? ' · 면제' : '');
      rEl.className = 'ratio ' + (r < MARGIN_WARN_RATIO && !isProtected(p) ? 'danger' : 'safe');
    }
  });
}

function renderAll(){
  renderTabs();
  if(!run) return;
  if(run.phase !== 'premarket') selectedIdx = -1;
  renderMainChart();
  renderHud();
  renderQuotes();
