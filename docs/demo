function renderRelics(){
  if(relicTipId && !hasRelic(relicTipId)) relicTipId = '';
  const sig = run.relics.join() + '|' + relicTipId + '|' + run.relics.map(id => Math.round(relicStacks(id))).join();
  if(sig === relicSig) return;
  relicSig = sig;
  $('relicBar').innerHTML = '<span class="relic-label">▌ 유물</span>' + (run.relics.length
    ? run.relics.map(id => { const r = RELIC_BY_ID[id];
        const st = relicStacks(id), money = r.growth === 'money';
        const badge = r.growth && st >= (money ? 1 : 1) ? `<span class="rl-stk">${money ? Math.round(st) : st}</span>` : '';
        const glow = !r.growth || money ? '' : st >= 25 ? 'g4' : st >= 10 ? 'g3' : st >= 5 ? 'g2' : '';
        return `<button class="relic ${r.rarity} ${glow} ${id === relicTipId ? 'on' : ''}" data-relic="${id}" title="${r.name}" aria-label="${r.name}">${r.icon}${badge}</button>`; }).join('')
    : `<span class="relic-empty">${RELIC_EMPTY_TEXT}</span>`);
  fitRelicEmpty();
  const tip = $('relicTip');
  if(relicTipId){
    const r = RELIC_BY_ID[relicTipId];
    tip.innerHTML = `<b>${r.icon} ${r.name}</b> <span class="c-rar ${r.rarity}">${RARITY_LABEL[r.rarity]}</span><br>${r.desc}${r.growth ? growthTipHtml(r) : ''}<i>${r.flavor}</i>`;
