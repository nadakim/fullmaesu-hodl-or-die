      `<button data-set="${key}" data-val="${JSON.stringify(v).replace(/"/g, '&quot;')}" class="${settings[key] === v ? 'on' : ''}" ${disabled ? 'disabled' : ''}>${t}</button>`).join('')}</div>
  </div>`;
}
