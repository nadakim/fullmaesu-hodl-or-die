  body.lay-f .qm-sum{flex:none;font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.15;color:var(--text2);padding:0 calc(2 * var(--u));}
  body.lay-f .qm-sum small{color:var(--muted);font-size:var(--fs-xs);}
  body.lay-f .qm-area{position:relative;flex:1 1 0;min-height:0;}
  body.lay-f .qm-group{position:absolute;display:flex;flex-direction:column;box-sizing:border-box;box-shadow:0 0 0 calc(1 * var(--u)) var(--line);}
  body.lay-f .qm-cap{flex:none;height:calc(13 * var(--u));display:flex;align-items:center;justify-content:space-between;gap:calc(4 * var(--u));padding:0 calc(3 * var(--u));overflow:hidden;
    font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1;color:var(--muted);white-space:nowrap;}
  body.lay-f .qm-cap b{font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);font-weight:normal;}
  body.lay-f .qm-tiles{position:relative;flex:1 1 0;min-height:0;}
  body.lay-f .qm-tile{position:absolute;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;overflow:hidden;cursor:pointer;text-align:center;
    background:var(--panel2);color:var(--text);box-shadow:inset 0 0 0 calc(1 * var(--u)) var(--bg);padding:calc(2 * var(--u));}
  body.lay-f .qm-name{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.15;max-width:100%;word-break:break-all;
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;}   /* 긴 이름은 두 줄로 (말줄임 대신) */
  body.lay-f .qm-chg{display:flex;align-items:center;gap:calc(2 * var(--u));font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);line-height:1;white-space:nowrap;}
  body.lay-f .qm-chg i{font-style:normal;font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);}
  body.lay-f .qm-tile.wide{flex-direction:row;gap:calc(8 * var(--u));}
  body.lay-f .qm-tile.wide .qm-name{-webkit-line-clamp:1;}
  /* 농도 4단계 (사분위 경계 QMAP_BANDS). 진한 초록(4)만 어두운 글자 — 글자 대비 4.5:1 이상 */
  body.lay-f .qm-tile.flat{background:var(--panel2);color:var(--text2);}
  body.lay-f .qm-tile.up1{background:color-mix(in srgb, var(--green) 15%, var(--panel));}
  body.lay-f .qm-tile.up2{background:color-mix(in srgb, var(--green) 28%, var(--panel));}
  body.lay-f .qm-tile.up3{background:color-mix(in srgb, var(--green) 42%, var(--panel));}
  body.lay-f .qm-tile.up4{background:color-mix(in srgb, var(--green) 62%, var(--panel));color:var(--bg);}
  body.lay-f .qm-tile.dn1{background:color-mix(in srgb, var(--red) 15%, var(--panel));}
  body.lay-f .qm-tile.dn2{background:color-mix(in srgb, var(--red) 28%, var(--panel));}
  body.lay-f .qm-tile.dn3{background:color-mix(in srgb, var(--red) 42%, var(--panel));}
  body.lay-f .qm-tile.dn4{background:color-mix(in srgb, var(--red) 62%, var(--panel));}
  body.lay-f .qm-tile.held{box-shadow:inset 0 0 0 calc(3 * var(--u)) var(--text),inset 0 0 0 calc(4 * var(--u)) var(--bg);}
  body.lay-f .qm-tile.up4.held{box-shadow:inset 0 0 0 calc(3 * var(--u)) var(--bg),inset 0 0 0 calc(4 * var(--u)) var(--text);}
  body.lay-f .qm-tile.charted{outline:calc(2 * var(--u)) solid var(--cyan);outline-offset:calc(-2 * var(--u));}
  body.lay-f .qm-tile.targetable{outline:calc(2 * var(--u)) dashed var(--gold);outline-offset:calc(-2 * var(--u));}
  body.lay-f .qm-tile:hover,body.lay-f .qm-tile:focus-visible{filter:brightness(1.25);outline:calc(1 * var(--u)) solid var(--text);outline-offset:calc(-1 * var(--u));}
  body.lay-f .q-gcap{display:block;font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.1;color:var(--muted);white-space:nowrap;overflow:hidden;}
  body.lay-f .quote-row.g-first{margin-top:calc(4.57 * var(--u));box-shadow:0 calc(-2.3 * var(--u)) 0 calc(-1 * var(--u)) var(--line);}   /* 그룹 사이 8px + 구분선 */
  body.lay-f .quote-row{order:var(--go);flex:none;height:var(--q-row);box-sizing:border-box;display:grid;grid-template-columns:calc(52 * var(--u)) minmax(0, 1fr) calc(54 * var(--u)) calc(60 * var(--u)) calc(58 * var(--u));gap:calc(5 * var(--u));align-items:center;padding:0 calc(6 * var(--u)) 0 calc(4 * var(--u));min-height:0;position:relative;}
  body.lay-f .quote-row canvas{display:block;width:calc(54 * var(--u));height:calc(14 * var(--u));}
  body.lay-f .quote-row .q-price,body.lay-f .quote-row .q-chg{grid-column:auto;grid-row:auto;}
  body.lay-f .quote-row .q-name{grid-row:auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.15;padding-left:calc(8 * var(--u));}
  body.lay-f .q-pb{display:none;}
  body.lay-f .q-sig{display:inline;font-size:0;margin:0 0 0 calc(5 * var(--u));}   /* 시그널은 아이콘만 (적중률은 호버 툴팁) */
  body.lay-f .q-sig .sig-chip{font-size:var(--fs-xs);vertical-align:middle;}
  body.lay-f .q-chg.pnl-up::before{content:'▲ ';}
  body.lay-f .q-chg.pnl-down::before{content:'▼ ';}
  body.lay-f .q-chg .yd{display:none;}
  body.lay-f.quotes-flat .q-chg,body.lay-f.quotes-flat .quote-row canvas{display:none !important;}
  body.lay-f.quotes-flat .quote-row{grid-template-columns:calc(52 * var(--u)) minmax(0, 1fr) auto;}
  /* 보유 중인 종목: 이름 앞 작은 점 하나만 (손익 색·배지는 보유 패널에) */
  body.lay-f .quote-row.held::before{content:'';position:absolute;left:calc(57 * var(--u));top:calc(50% - 2.5 * var(--u));width:calc(5 * var(--u));height:calc(5 * var(--u));background:var(--text);}

  /* ── 보유 패널: 헤더(총 평가손익 · 총 원금) + 포지션 행. 1열 → 2열 → 손익 큰 순 + '외 N건' ── */
  body.lay-f #holdPanel{display:flex;flex-direction:column;flex:1 1 0;min-height:0;overflow:hidden;margin:calc(8 * var(--u)) 0 0;padding:0 calc(6 * var(--u)) calc(4 * var(--u));}
  body.lay-f .hold-head{flex:none;height:calc(41.14 * var(--u));box-sizing:border-box;display:grid;grid-template-columns:minmax(0, 1fr) auto;grid-template-rows:auto 1fr;align-items:center;column-gap:calc(8 * var(--u));
    padding:calc(5 * var(--u)) calc(2 * var(--u)) 0;box-shadow:inset 0 calc(-1 * var(--u)) 0 var(--line);}
  body.lay-f .hh-label{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);line-height:1.1;}
  body.lay-f .hh-prin{grid-row:1 / 3;grid-column:2;align-self:end;padding-bottom:calc(4 * var(--u));font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);color:var(--text2);white-space:nowrap;}
  body.lay-f .hh-total{grid-column:1;font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);line-height:1;white-space:nowrap;overflow:hidden;}
  body.lay-f #holdPanel.empty .hold-head{display:none;}
  body.lay-f .hold-body{flex:1 1 0;min-height:0;display:flex;flex-direction:column;overflow:hidden;}
  body.lay-f #positionsBox.hold-list{flex:1 1 0;min-height:0;max-height:none;margin:0;padding:0;overflow:hidden;background:none;box-shadow:none;
    display:grid;grid-template-columns:minmax(0, 1fr);grid-auto-rows:var(--h-row);align-content:start;gap:0;--h-row:calc(18.29 * var(--u));}
  body.lay-f #positionsBox.hold-list.c2{grid-template-columns:minmax(0, 1fr) minmax(0, 1fr);column-gap:calc(6 * var(--u));}
  body.lay-f .hold-empty{align-self:center;padding:calc(6 * var(--u)) 0;font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);color:var(--muted);text-align:center;}
  body.lay-f .hold-row{display:grid;grid-template-columns:minmax(0, 1fr) auto auto auto auto calc(26 * var(--u)) auto;align-items:center;gap:calc(4 * var(--u));min-width:0;height:var(--h-row);
    padding:0 calc(2 * var(--u));box-sizing:border-box;box-shadow:inset 0 calc(-1 * var(--u)) 0 var(--line2);cursor:default;position:relative;}
  body.lay-f .hold-row.fx-danger{box-shadow:inset 0 0 0 calc(1 * var(--u)) var(--red);}
  body.lay-f .hold-row.targetable{cursor:pointer;box-shadow:inset 0 0 0 calc(2 * var(--u)) var(--gold);}
  body.lay-f .h-name{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;}
  body.lay-f .h-badges{display:flex;gap:calc(2 * var(--u));}
  body.lay-f .h-dir,body.lay-f .h-lev{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.15;padding:0 calc(3 * var(--u));white-space:nowrap;}
  body.lay-f .h-dir.long{background:var(--green-dim);color:var(--green);}
  body.lay-f .h-dir.short{background:var(--red-dim);color:var(--red);}
  body.lay-f .h-lev{background:var(--panel2);color:var(--muted);}
  body.lay-f .h-lev.on{background:var(--gold2);color:#000;}
  body.lay-f .h-days{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--text2);white-space:nowrap;}
  body.lay-f .h-price{font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);color:var(--text2);white-space:nowrap;}
  body.lay-f .h-pnl{font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);white-space:nowrap;text-align:right;}
  body.lay-f .h-bar{position:relative;height:calc(6 * var(--u));background:var(--panel2);}
  body.lay-f .h-bar::before{content:'';position:absolute;left:calc(50% - 0.5 * var(--u));top:calc(-2 * var(--u));bottom:calc(-2 * var(--u));width:calc(1 * var(--u));background:var(--muted);}
  body.lay-f .h-bar i{position:absolute;top:0;bottom:0;width:0;}
  body.lay-f .h-bar i.up{left:50%;background:var(--green);}
  body.lay-f .h-bar i.down{right:50%;background:var(--red);}
  body.lay-f .hold-row .sell-btn{padding:0 calc(5 * var(--u));min-height:0;height:calc(14 * var(--u));font-size:var(--fs-xs);line-height:1;min-width:max-content;}
  /* 2열: 칸이 반이라 N일째·평단→현재가·손익 금액·막대는 행 툴팁으로 (이름 · 롱/숏 · 배율 · 손익% · 매도) */
  body.lay-f .hold-list.c2 .hold-row{grid-template-columns:minmax(0, 1fr) auto auto auto;}
  body.lay-f .hold-list.c2 .h-days,body.lay-f .hold-list.c2 .h-price,body.lay-f .hold-list.c2 .h-bar,body.lay-f .hold-list.c2 [data-f=amt]{display:none;}
  body.lay-f .hold-list.tight1 .h-price,body.lay-f .hold-list.tight2 .h-days{display:none;}
  body.lay-f .hold-more{display:flex;align-items:center;justify-content:flex-end;height:var(--h-row);padding:0 calc(4 * var(--u));font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);white-space:nowrap;overflow:hidden;}
  body.lay-f.no-pos #positionsBox{display:flex;}
}
</style>
</head>
<body>


 <div class="crt-layer" id="crtLayer" aria-hidden="true"><i class="crt-scan"></i><i class="crt-vig"></i><i class="crt-glass"></i><i class="crt-bezel"></i></div>
<button class="btn-chunky sm fx-skip" id="fxSkipBtn" hidden aria-label="연출 넘기기 (Space)">스킵 ▶</button>
<div class="cabinet">

  <!-- ====== 01 TITLE ====== -->
  <section id="screen-title" class="screen active">
    <canvas class="t-chart" id="titleChart"></canvas>
    <canvas class="t-noise" id="titleNoise" width="160" height="90"></canvas>
    <div class="t-scan"></div>
    <div class="t-frame"><i></i><i></i><i></i><i></i></div>

    <div class="t-logo" id="titleLogo" aria-label="">
      <span class="t-limit">하한가</span>
      <div class="t-ko" id="titleKo"></div>
      <div class="t-en" id="titleEn"></div>
      <div class="jibu-badge"><b>떡상</b><span>기원부적</span></div>
    </div>

    <nav class="t-menu" id="titleMenu" aria-label="메뉴">
      <button class="t-item" id="continueBtn" hidden><span class="t-cur">▮</span><span class="t-lbl">[이어하기]</span></button>
      <button class="t-item" id="startBtn"><span class="t-cur">▮</span><span class="t-lbl">[영끌 출격]</span></button>
      <button class="t-item" id="collectionBtn"><span class="t-cur">▮</span><span class="t-lbl">[손절 기계]</span></button>
      <button class="t-item" id="recordsBtn"><span class="t-cur">▮</span><span class="t-lbl">[파산 기록]</span></button>
      <button class="t-item" id="settingsBtn"><span class="t-cur">▮</span><span class="t-lbl">[환경 설정]</span></button>
      <div class="t-gap" id="quitGap" hidden></div>
      <button class="t-item" id="quitBtn" hidden><span class="t-cur">▮</span><span class="t-lbl">[종료]</span></button>
    </nav>

    <div class="t-meta"><div id="titleVersion"></div><div id="titleAuthor" hidden></div></div>
    <div class="t-corner">
      <div class="t-links"><a id="steamLink" target="_blank" rel="noopener" hidden>STEAM</a><a id="discordLink" target="_blank" rel="noopener" hidden>DISCORD</a></div>
      <div class="t-icons">
        <button class="btn-chunky sm t-icon" id="titleSettingsIcon" aria-label="환경 설정" title="환경 설정">⚙</button>
        <button class="btn-chunky sm t-icon" id="langBtn" aria-label="언어" title="언어">🌐</button>
      </div>
    </div>
    <div class="t-press" id="titlePress">아무 키나 눌러 시작</div>

    <div class="ticker-wrap">
      <div class="ticker" id="tickerText"></div>
    </div>
    <div class="t-crt"><i></i></div>
  </section>

  <!-- ====== 02 GAMEPLAY ====== -->
  <section id="screen-play" class="screen">
    <!-- 가로 화면: 상단 HUD 바 / 왼쪽 시장 / 오른쪽 손패·포지션 (900px 이하는 세로 스택) -->
    <div class="play-top">
      <div class="menu-wrap">
        <button class="btn-chunky sm menu-btn" id="menuBtn" aria-label="메뉴" aria-haspopup="true" aria-expanded="false">≡<i class="menu-dot" id="menuDot" hidden></i></button>
        <div class="menu-panel px-panel" id="menuPanel" hidden>
          <button data-menu="title">◀ 타이틀로<small id="menuTitleNote">판은 그대로 유지됩니다 · 타이틀의 '이어하기'로 복귀</small></button>
          <button data-menu="tips">📱 찌라시 기록<i class="menu-dot" id="menuTipDot" hidden></i></button>
          <button data-menu="deck">🃏 덱 확인</button>
          <button data-menu="signalGuide">📖 시그널 설명서</button>
          <button data-menu="glossary">📖 용어집</button>
          <button data-menu="sectors" id="menuSectors">📊 섹터 레벨</button>
          <button data-menu="settings">⚙ 환경 설정</button>
          <button data-menu="playtestLog" id="menuPlaytest">📋 전체 기록 복사<small>플레이테스트 모드 · 지금까지 끝난 판 전부</small></button>
        </div>
      </div>

      <div class="hud-col">
        <div class="hud">
          <span id="roundText">WEEK 1/8</span>
          <div class="day-track"><div class="day-fill" id="dayFill"></div></div>
          <span id="dayText">DAY 1/5 · 장전</span>
          <span class="boss-chip" id="bossChip" hidden></span>
          <div class="speed-btns" id="speedBtns" title="장중 속도 (키보드 1~4). 결과·확률은 그대로"></div>
          <button class="btn-chunky sm top-settings" id="topSettingsBtn" title="환경 설정" aria-label="환경 설정">⚙</button>
        </div>
        <div class="fss" id="fssBox" title="시장 카드(비둘기·매파·CEO 트윗·리딩방·작전 세력)를 쓸 때마다 쌓인다. 가득 차면 제재: 과징금 / 매수 금지 / 강제 청산.">
          <span class="fss-label">☎ 금감원 감시</span>
          <div class="fss-track"><div class="fss-fill" id="fssFill"></div></div>
          <span class="fss-state" id="fssState">조용함</span>
        </div>
      </div>

      <div class="balance-main px-panel-gold px-corner-box" id="balanceBox" tabindex="0" aria-describedby="balTip">
        <div class="label">▌ NET ASSETS · 순자산 <span class="bal-more">ⓘ</span></div>
        <div class="total" id="totalAssets">₩ 10,000만</div>
        <div class="target-line"><span id="targetText">WEEK 1 목표</span><span id="targetPct">0%</span></div>
        <div class="target-track"><div class="target-fill" id="targetFill"></div></div>
        <div class="bal-tip px-panel" id="balTip" role="tooltip">
          <div>빌린 돈 (신용·대차)<b id="debtVal">₩ 0만</b></div>
          <div>확정손익 (판 누적)<b id="realizedPnL">₩ 0만</b></div>
          <div>낸 이자 (판 누적)<b id="interestVal">₩ 0만</b></div>
          <small>순자산 = 현금 + 포지션 평가액 − 빌린 돈. 이자는 장 마감마다 빠져나간다 (신용·마통 이자 · 공매도 대차 이자)</small>
        </div>
      </div>

      <div class="assets-grid">
        <div class="asset-card px-panel">
          <div class="label" id="cashLabel">■ CASH</div>
          <div class="val highlight" id="availableCash">₩ 10,000만</div>
          <div class="slush-line" title="비자금 — 암시장에서만 쓰는 돈 (순자산에 안 들어감)"><b class="slush-amt" id="slushVal">💼 0만</b></div>
        </div>
      </div>

    </div>

    <aside class="info-col" id="infoCol" aria-label="정보 열"></aside>
    <div class="stock-list" id="stockList" aria-label="종목 시세"></div>
    <!-- 전투 화면(body.lay-f)에서만: 종목 시세 바로 아래 보유 패널. placeLayout이 #stockList로 옮기고 #positionsBox를 #holdBody에 넣는다 -->
    <section class="hold-panel px-panel" id="holdPanel" aria-label="보유 포지션">
      <div class="hold-head" id="holdHead">
        <span class="hh-label">총 평가손익</span>
        <span class="hh-total" id="holdTotal"></span>
        <span class="hh-prin" id="holdPrin"></span>
      </div>
      <div class="hold-body" id="holdBody"></div>
    </section>

    <div class="play-left tx-grid">
      <div class="news-row">
      <div class="news-banner" id="newsBanner">
        <span>
          <span class="news-title">[속보] </span>
          <span id="newsText">시장이 평온한 흐름을 유지 중입니다.</span>
        </span>
      </div>
      <button class="btn-chunky sm news-next" id="newsNextBtn" hidden>📰 내일</button>
      </div>

      <!-- pixel candlestick chart (시장 지수) -->
      <div class="chart-box px-corner-box" id="chartBox">
