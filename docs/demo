function renderChartZoom(){
  const box = $('chartZoom');
  if(!zoomTarget || !run || currentTab !== 'play'){ box.hidden = true; return; }
  box.hidden = false;
  const tabs = [['idx', 'IDX 지수']].concat(STOCKS.map(s => [s.id, s.name]));
  const sig = tabs.map(t => t[0]).join() + '|' + zoomTarget + '|' + zoomMode;
