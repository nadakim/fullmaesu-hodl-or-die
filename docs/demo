  if(idx >= 0 && run && card.stock && capLev(run.pending.lev) < run.pending.lev) return `<span class="ct-ev neg">⚖️ 레버리지 규제 — ${run.pending.lev}x 대신 ${capLev(run.pending.lev)}x로 산다</span>`;
