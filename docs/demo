/* ══ 성장형 유물 연출: 소발동(아이콘 1.5배 + "+N" + relicTick, 1초 안 같은 유물은 합침) · 대발동(중앙 확대 LV 도장) · 초기화(산산조각) ══ */
const RELIC_LEVELS = [5, 10, 25, 50];          // 대발동 스택
const RELIC_GROW_MERGE_MS = 1000;
const RELIC_BIG_TRIGGER = ['payday', 'parents', 'tearJar', 'compoundMonster'];   // relicTriggered 중 큰 금액 = 대발동
const relicIconEl = id => $('relicBar').querySelector(`[data-relic="${id}"]`);
const growText = (id, v) => RELIC_BY_ID[id].growth === 'money' ? `₩${formatKrw(v)}` : `${v}스택`;
let growPending = {};
function enqueueRelicGrow(d){
  const r = RELIC_BY_ID[d.id], money = r.growth === 'money';
  const g = growPending[d.id];
  if(g && !g.started && performance.now() - g.at < RELIC_GROW_MERGE_MS){ g.delta += d.delta; g.stacks = d.stacks; }
  else {
    const pay = { id: d.id, delta: d.delta, stacks: d.stacks, at: performance.now(), started: false };
    growPending[d.id] = pay;
    const item = { kind: 'relicGrow', tier: 1, blocking: false, duration: 450, payload: pay };
    item.play = ctx => {
      pay.started = true;
      const icon = relicIconEl(d.id);
      if(icon) Fx.flash(icon, 'fx-relic-on');
      Fx.chip(money ? '+₩' + formatKrw(pay.delta) : '+' + pay.delta, rectOf(icon), 'gold', 0);
      Sound.play('relicTick', { stacks: money ? 1 : pay.stacks, pitch: chainPitch(ctx) });
    };
    Fx.enqueue(item);
  }
  if(!money) RELIC_LEVELS.forEach(m => { if(d.stacks - d.delta < m && d.stacks >= m) enqueueRelicBig(d.id, `${r.name} LV.${m}!`); });
}
function enqueueRelicBig(id, text){
  const r = RELIC_BY_ID[id];
  const item = { kind: 'relicBig', tier: 3, blocking: true, duration: 1700, payload: { id, text } };
  item.timers = [];
  item.play = ctx => {
    const icon = relicIconEl(id), ir = rectOf(icon);
    const el = document.createElement('div');
    el.className = 'fx-relic-big';
    el.textContent = r.icon;
    document.body.appendChild(el);
    item.el = el;
    const cx = window.innerWidth / 2, cy = window.innerHeight * 0.45;
    const dx = ir && ir.width ? ir.left + ir.width / 2 - cx : 0, dy = ir && ir.width ? ir.top + ir.height / 2 - cy : 0;
    const at = (x, y, sc, rot) => `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(${sc}) rotate(${rot}deg)`;
    el.animate([
      { transform: at(dx, dy, 0.6, 0) },
      { transform: at(0, 0, 3.8, 0), offset: 0.25 },
      { transform: at(0, 0, 3.4, 360), offset: 0.6 },
      { transform: at(0, 0, 3.6, 360), offset: 0.8 },
      { transform: at(dx, dy, 0.6, 360) }
    ], { duration: ctx.duration, easing: 'steps(26)', fill: 'forwards' });
    Fx.hitStop(FX_TIER[3].hs);
    Sound.play('relicLevelUp', { rarity: r.rarity, pitch: chainPitch(ctx) });
    item.timers.push(setTimeout(() => {
      Fx.stamp(text, 'gold');
      Fx.burst(cx, cy, FX_TIER[3].parts, ['--gold', '--text', '--cyan']);
    }, Math.round(ctx.duration * 0.3)));
  };
  item.stop = item.skip = () => { item.timers.forEach(clearTimeout); if(item.el){ item.el.remove(); item.el = null; } };
  Fx.enqueue(item);
}
function enqueueRelicShatter(d){
  const r = RELIC_BY_ID[d.id];
  const item = { kind: 'relicReset', tier: 3, blocking: true, duration: 1500, payload: d };
  item.timers = [];
  item.play = ctx => {
    const el = document.createElement('div');
    el.className = 'fx-relic-big';
    el.textContent = r.icon;
    document.body.appendChild(el);
    item.el = el;
    const size = RELIC_BY_ID[d.id].growth === 'money' ? Math.min(40, d.lost / 20) : Math.min(40, d.lost * 2);   // 스택이 클수록 크게 부서진다
    el.animate([{ transform: 'translate(-50%,-50%) scale(0.6)' }, { transform: `translate(-50%,-50%) scale(${3 + size / 20})`, offset: 0.3 },
                { transform: `translate(-50%,-50%) scale(${3 + size / 20})` }], { duration: ctx.duration * 0.45, easing: 'steps(12)', fill: 'forwards' });
    Fx.hitStop(FX_TIER[3].hs);
    Sound.play('relicShatter', { pitch: chainPitch(ctx) });
    item.timers.push(setTimeout(() => el.classList.add('crack'), Math.round(ctx.duration * 0.2)));
    item.timers.push(setTimeout(() => {
      const rr = rectOf(el);
      el.remove(); item.el = null;
      Fx.shatter(rr, Math.round(20 + size * 1.5));
      Fx.afterStop(() => Fx.shake(2));
      Fx.stamp(`${r.name} ${growText(d.id, RELIC_BY_ID[d.id].growth === 'money' ? d.lost : d.lost)} 증발…`, '', 'sm');
      const bits = Math.min(8, 2 + Math.round(size / 6));
      for(let k = 0; k < bits; k++){   // 잃은 숫자가 떨어져 흩어진다
        const s = document.createElement('div');
        s.className = 'fx-lost';
        s.textContent = RELIC_BY_ID[d.id].growth === 'money' ? '−₩' : '−' + (k === 0 ? d.lost : 1);
        s.style.left = Math.round(rr.left + Math.random() * rr.width) + 'px';
        s.style.top = Math.round(rr.top + Math.random() * rr.height) + 'px';
        s.style.setProperty('--dx', Math.round((Math.random() - 0.5) * 200 * uiScale) + 'px');
        s.style.setProperty('--rot', Math.round((Math.random() - 0.5) * 120) + 'deg');
        document.body.appendChild(s);
        Fx.afterAnim(s, Fx.dur('lost'), () => s.remove());
      }
    }, Math.round(ctx.duration * 0.45)));
  };
  item.stop = item.skip = () => { item.timers.forEach(clearTimeout); if(item.el){ item.el.remove(); item.el = null; } };
  Fx.enqueue(item);
}
/* 개발자 콘솔 전용 (화면에 버튼 없음): window.__debug.giveRelic('moonSavings') */
window.__debug = {
  giveRelic(id){ if(!run) return false; const ok = gainRelic(id, 'debug'); renderAll(); return ok; },
