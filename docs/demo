  const st = relicStacks(r.id), best = run.relicState[r.id] ? run.relicState[r.id].best : 0;
  const eff = {
    moonSavings: () => `평가이익 +${Math.round(moonPct() * 100)}%`,
    tearJar: () => `적립금 ₩${Math.round(st).toLocaleString()}만 — 상승 콤보 ${TEARJAR_PAYOUT_COMBO}에 지급`,
    traumaSurvivor: () => `레버리지·숏 평가이익 +${Math.round(st * TRAUMA_PNL_PER_STACK * 100)}%`,
    tipCollector: () => `찌라시 A 대박 +${Math.round(tipCollectorBonus() * 100)}%p`,
    diamondTree: () => `이자 −${Math.round(dtreeCut() * 100)}%`,
    compoundMonster: () => `다음 주 첫날 현금 +${st}% (지금 ₩${Math.round(Math.max(0, netEquity()) * COMPOUND_CASH_PER_STACK * st).toLocaleString()}만)`
  }[r.id];
  return `<span class="rt-grow">현재 ${growText(r.id, r.growth === 'money' ? st : st)} · ${eff ? eff() : ''}<br>초기화: ${r.reset}<br>이번 판 최고 ${growText(r.id, best)}</span>`;
}

