      { const k = tipResultKind(d).kind; if(k === 'up') comboHit('tip'); else if(k === 'down') comboBreak(); }
      enqueueTipResult(d, fromOverlay);   // 중앙 알림 → 끝나거나 스킵하면 결과 요약 오버레이
      break;
    }
    case 'sectorLevelUp':   // (N3) 리포트 카드
      toast(`📊 ${SECTOR_BY_NAME[d.sector].icon} ${d.sector} Lv.${d.level} — 수익 마감 정산: ${sectorEffectText(d.level)}`, 'good');
      Sound.play('relicGain');
      document.querySelectorAll('#quoteBox .quote-row').forEach(r => { if(STOCK_BY_ID[r.dataset.q].sector === d.sector) Fx.flash(r, 'fx-hit'); });
      break;
    case 'relicGained':
      if(d.source === 'shop') relicClackId = d.id;   // (S8-33) 소리는 칸에 꽂힐 때 "철컥"
      else Sound.play('relicGain');
      if(d.source !== 'reward') toast(`${RELIC_BY_ID[d.id].icon} 유물 획득: ${RELIC_BY_ID[d.id].name}`, 'good');
      break;
    case 'relicTriggered':
      if(stageSources && stageSources.has(d.id)) break;   // 오늘 정산 무대가 이 유물을 차례대로 보여준다 (따로 연출하면 중복)
      if(d.id === 'cashGang'){ toast(`🕳️ 무소유 투자법: 유물 보상 대신 비자금 +${fmtSlush(d.amount)}`, 'good'); break; }
      if(d.id === 'payday') toast(`🪙 월급날: +₩${formatKrw(d.amount)} (벌써 반은 카드값)`, 'good');
      if(d.id === 'parents') toast(`💌 부모님 카드 발동: +₩${formatKrw(d.amount)}. 이번이 진짜 마지막이란다.`, 'warn');
      if(RELIC_BIG_TRIGGER.indexOf(d.id) >= 0) enqueueRelicBig(d.id, `${RELIC_BY_ID[d.id].name} +₩${formatKrw(d.amount)}!`);
      else enqueueRelic(d);
      break;
    case 'relicGrew': enqueueRelicGrow(d); break;
    case 'sellSettled':   // ⚡ 단타 중독: 매도 순간 정산
      if(d.payout >= 0.5){
        const rule = d.steps.filter(x => x.source !== 'base').map(x => x.label).slice(-2).join(' · ');
        toast(`⚡ 단타 정산 ${d.nth}번째 · ${d.posName} +${formatKrw(d.payout)} (×${fmtMultNum(d.mult)})${rule ? ' — ' + rule : ''}`, 'good');
