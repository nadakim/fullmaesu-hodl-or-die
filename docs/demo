/* 라운드 결과 · 게임오버 */
.result-kicker{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;color:var(--muted);margin-bottom:6px;}
.result-hero{font-family:'Press Start 2P','Galmuri-20px',monospace;font-size:20px;margin:6px 0 4px;text-shadow:2px 2px 0 #000;}
.result-bar{position:relative;height:12px;margin:8px 0 4px;background:#000;box-shadow:0 0 0 2px var(--line);}
.result-bar i{position:absolute;inset:0 auto 0 0;background:var(--gold2);}
.result-bar i.done{background:var(--green);}
.result-bar b{position:absolute;top:-2px;bottom:-2px;left:calc(100% / 1.5 - 1px);width:2px;background:var(--text);}
.result-pct{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;color:var(--muted);text-align:right;margin-bottom:12px;}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0 12px;text-align:left;}
.stat-grid div{background:#000;box-shadow:0 0 0 2px var(--line);padding:7px 9px;font-family:'Press Start 2P','Galmuri-6_5px',monospace;font-size:6.5px;color:var(--muted);line-height:1.5;}
.stat-grid div b{display:block;margin-top:4px;font-family:'VT323','GalmuriV-20px',monospace;font-size:20px;font-weight:normal;color:var(--text);}
.stat-grid .wide{grid-column:1 / -1;}
.stat-caption{font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--gold);text-align:left;margin-top:12px;}

/* 결산 체인: 주간 결산 통과 때 유물·보너스가 포지션 손익을 불린 순서를 재생 (연출 전용) */
.chain-list{display:flex;flex-direction:column;gap:12px;margin:12px 0;text-align:left;}
.chain-row{position:relative;background:#000;box-shadow:0 0 0 2px var(--line);padding:9px 10px 8px;animation:chainIn .24s steps(4) both;}
.chain-row.playing{box-shadow:0 0 0 2px var(--gold2),3px 3px 0 #000;}
.chain-head{display:flex;justify-content:space-between;align-items:center;gap:8px;}
.chain-name{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;line-height:1.6;padding-top:1px;color:var(--text);}
.chain-name small{color:var(--muted);font-size:8px;}
.chain-total{font-family:'VT323','GalmuriV-26px',monospace;font-size:26px;line-height:1.1;color:var(--text);white-space:nowrap;}
.chain-total.up{color:var(--green);text-shadow:2px 2px 0 var(--green-dim);}
.chain-total.down{color:var(--red);text-shadow:2px 2px 0 var(--red-dim);}
.chain-total.final.up{text-shadow:2px 0 0 var(--green-dim),-2px 0 0 var(--green-dim),0 2px 0 var(--green-dim),0 -2px 0 var(--green-dim),0 0 6px var(--green);animation:chainGlow .6s steps(6) both;}
.chain-total.final.down{text-shadow:2px 0 0 var(--red-dim),-2px 0 0 var(--red-dim),0 2px 0 var(--red-dim),0 -2px 0 var(--red-dim),0 0 6px var(--red);animation:chainGlow .6s steps(6) both;}
.chain-list .pending{visibility:hidden;animation:none;}   /* 자리를 미리 잡아 두고 차례가 오면 드러낸다 (박스 높이가 흔들리지 않게) */
.chain-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;min-height:17px;}
.chain-chips.none{display:none;}
.chain-chip{
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;line-height:1.6;
  padding:3px 6px 2px;background:var(--panel2);color:var(--gold);box-shadow:0 0 0 2px var(--gold2),2px 2px 0 #000;
  animation:chipDrop .4s steps(8) both;
}
.chain-chip.add{color:var(--cyan);box-shadow:0 0 0 2px var(--cyan),2px 2px 0 #000;}
.chain-chip.cut{color:var(--green);box-shadow:0 0 0 2px var(--green2),2px 2px 0 #000;}
.chain-stamp{
  position:absolute;bottom:-10px;right:-8px;padding:4px 6px 3px;background:#000;
  font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;line-height:1.3;
  color:var(--green);box-shadow:0 0 0 2px var(--green2),3px 3px 0 #000;
  transform:rotate(-8deg);animation:stampIn .32s steps(6) both;
}
.chain-stamp.down{color:var(--red);box-shadow:0 0 0 2px var(--red2),3px 3px 0 #000;}
.chain-rest{font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;line-height:1.8;color:var(--muted);text-align:left;animation:chainIn .24s steps(4) both;}
.chain-sum{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;line-height:1.8;color:var(--gold);text-align:right;animation:chainIn .24s steps(4) both;}
.chain-skip{font-family:'Press Start 2P','Galmuri-6_5px',monospace;font-size:6.5px;color:var(--muted);margin-top:6px;animation:blink 1.2s steps(2) infinite;}
@keyframes chainIn{from{opacity:0;transform:translateX(-8px);}to{opacity:1;transform:none;}}
@keyframes chipDrop{0%{opacity:0;transform:translateY(-16px);}50%{opacity:1;transform:translateY(3px);}75%{transform:translateY(-1px);}100%{opacity:1;transform:none;}}
@keyframes stampIn{0%{opacity:0;transform:rotate(-8deg) scale(2.2);}100%{opacity:1;transform:rotate(-8deg) scale(1);}}
@keyframes chainGlow{0%,50%{filter:brightness(1.8);}100%{filter:none;}}
.ending-badge{
  display:inline-block;margin:4px 0 10px;padding:5px 8px;background:#000;
  font-family:'Press Start 2P','Galmuri-7_5px',monospace;font-size:7.5px;color:var(--gold);box-shadow:0 0 0 2px var(--gold2);
}
.ending-cause{font-family:'VT323','GalmuriV-17px',monospace;font-size:17px;color:var(--muted);margin-bottom:6px;}
.ov-btn:disabled{opacity:.35;cursor:not-allowed;transform:none;}
.ov-cards,.deck-list{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;padding:6px 4px 12px;}
.deck-list{max-height:46vh;overflow-y:auto;}
.pile-title{font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--gold);text-align:left;margin:10px 0 6px;}

/* 카드 도감 */
#screen-collection{padding:18px 14px 28px;}
.coll-head{display:flex;justify-content:space-between;align-items:flex-start;}
.coll-grid{display:flex;flex-wrap:wrap;gap:12px;padding:6px 4px 10px;}
.coll-grid .card,.deck-list .card{cursor:default;}
.coll-grid .card:hover,.deck-list .card:not([data-remove]):hover{transform:none;box-shadow:0 0 0 2px var(--cc),0 0 0 4px var(--rc),3px 3px 0 #000;}
.deck-list .card[data-remove]{cursor:pointer;}

/* 환경 설정 */
#screen-settings{padding:18px 14px 28px;}
.set-list{display:flex;flex-direction:column;gap:10px;max-width:760px;padding:6px 4px 12px;}
.set-row{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;
  background:var(--panel);box-shadow:0 0 0 2px var(--line),3px 3px 0 #000;padding:10px 12px;}
.set-row .sr-label{font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;color:var(--text);line-height:1.6;}
.set-row .sr-desc{font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;color:var(--muted);margin-top:3px;}
.set-row.disabled{opacity:.55;}
.seg{display:flex;gap:6px;flex-wrap:wrap;}
.seg button{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;padding:8px 10px;cursor:pointer;
  background:var(--bg);color:var(--muted);border:none;box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;}
.seg button.on{color:var(--bg);background:var(--gold);box-shadow:0 0 0 2px var(--gold2),2px 2px 0 #000;}
.seg button:disabled{cursor:not-allowed;}
.set-danger{color:var(--red);box-shadow:0 0 0 2px var(--red2),2px 2px 0 #000;}
.set-danger.armed{color:var(--bg);background:var(--red);}
/* CRT 강도·배경 연출 (body 속성으로 전환) */
body[data-crt="weak"]::before{opacity:.5;}
body[data-crt="weak"]::after{opacity:.55;}
body[data-crt="off"]::before,body[data-crt="off"]::after{display:none;}
body[data-bgfx="off"] #bgChartContainer{display:none;}

/* 파산 기록 */
#screen-records{padding:18px 14px 28px;}
#screen-records .stat-grid{grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));}
.end-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));gap:10px;padding:6px 4px 12px;}
.end-tile{position:relative;background:#000;box-shadow:0 0 0 2px var(--ec),3px 3px 0 #000;padding:9px 10px 8px;min-height:72px;}
.end-tile.locked{--ec:var(--line);opacity:.6;}
.end-tile .et-title{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;line-height:1.5;color:var(--ec);padding-right:34px;}
.end-tile.locked .et-title{color:var(--muted);}
.end-tile .et-count{position:absolute;top:8px;right:9px;font-family:'VT323','GalmuriV-18px',monospace;font-size:18px;color:var(--text);}
.end-tile .et-sub{font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;line-height:1.15;color:var(--text);margin-top:6px;}
.end-tile .et-hint{font-family:'VT323','GalmuriV-15px',monospace;font-size:15px;line-height:1.15;color:var(--muted);margin-top:6px;}
.rec-list{display:flex;flex-direction:column;gap:6px;padding:6px 4px 12px;max-width:860px;}
.rec-row .rr-stats{grid-column:2 / -1;font-family:'VT323','GalmuriV-15px',monospace;font-size:15px;color:var(--muted);}
.rec-row{display:grid;grid-template-columns:44px minmax(0, 1.6fr) 64px minmax(0, 1fr) 96px;gap:4px 8px;align-items:center;
  background:var(--panel);box-shadow:0 0 0 2px var(--line);padding:7px 10px;font-family:'VT323','GalmuriV-17px',monospace;font-size:17px;color:var(--text);}
.rec-row .rr-n{font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);}
.rec-row .rr-end{font-family:'Press Start 2P','Galmuri-7_5px',monospace;font-size:7.5px;line-height:1.5;}
.rec-row .rr-when{color:var(--muted);text-align:right;white-space:nowrap;}
.rec-empty{font-family:'VT323','GalmuriV-18px',monospace;font-size:18px;color:var(--muted);padding:14px 4px;}
.rec-reset{margin-top:8px;}
.ending-new{color:var(--green);}
@media (max-width: 600px){
  .rec-row{grid-template-columns:34px minmax(0, 1fr) 70px;}
  .rec-row .rr-eq,.rec-row .rr-when{display:none;}
  .rec-row .rr-stats{grid-column:2 / -1;}
}

.cabinet.shake{animation:shake .4s steps(6);}
@keyframes shake{0%,100%{transform:none;}20%{transform:translate(-4px,2px);}40%{transform:translate(4px,-2px);}60%{transform:translate(-3px,-1px);}80%{transform:translate(3px,1px);}}
.red-flash{position:fixed;inset:0;z-index:85;pointer-events:none;background:rgba(255,26,60,.25);animation:fadeOut .5s steps(5) forwards;}
@keyframes fadeOut{to{opacity:0;}}

/* ── 타격감 (fx.js) — 흔들림 3단계 · 히트스톱 · 글리치 · 도장 · 번쩍임 · 파티클 캔버스. 전부 steps() 끊김 모션 ── */
.cabinet.shake-1{animation:shake1 .25s steps(4);}
.cabinet.shake-2{animation:shake .4s steps(6);}
.cabinet.shake-3{animation:shake3 .56s steps(8);}
.cabinet.fx-glitch{animation:fxGlitch .38s steps(6);}
.cabinet.shake-3.fx-glitch{animation:shake3 .56s steps(8),fxGlitch .38s steps(6);}
@keyframes shake1{0%,100%{transform:none;}33%{transform:translate(-2px,1px);}66%{transform:translate(2px,-1px);}}
@keyframes shake3{0%,100%{transform:none;}12%{transform:translate(-8px,4px);}25%{transform:translate(7px,-5px);}37%{transform:translate(-6px,-3px);}50%{transform:translate(6px,3px);}62%{transform:translate(-4px,2px);}75%{transform:translate(3px,-2px);}87%{transform:translate(-2px,1px);}}
@keyframes fxGlitch{0%,100%{filter:none;}20%{filter:drop-shadow(4px 0 0 var(--red)) drop-shadow(-4px 0 0 var(--cyan));}40%{filter:drop-shadow(-3px 0 0 var(--red)) drop-shadow(3px 0 0 var(--cyan));}60%{filter:drop-shadow(5px 0 0 var(--red)) drop-shadow(-2px 0 0 var(--cyan));}80%{filter:none;}}
body.fx-hitstop *,body.fx-hitstop *::before,body.fx-hitstop *::after{animation-play-state:paused !important;}   /* 히트스톱: 화면을 잠깐 얼린다 */
.fx-scan{position:fixed;inset:0;z-index:86;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.35) 0 2px,transparent 2px 4px);animation:fxScan .38s steps(6) forwards;}
@keyframes fxScan{0%{transform:none;opacity:1;}25%{transform:translateY(3px);}50%{transform:translate(2px,-2px);}75%{transform:translateY(4px);}100%{transform:none;opacity:0;}}
.fx-stamp{
  position:fixed;left:50%;top:44%;z-index:93;pointer-events:none;white-space:nowrap;
  font-family:'Press Start 2P','Galmuri-30px',monospace;font-size:30px;line-height:1.2;padding:14px 18px 10px;
  color:var(--red);background:#000;box-shadow:0 0 0 4px var(--red2),0 0 0 8px #000,8px 8px 0 #000;
  transform:translate(-50%,-50%) rotate(-6deg);animation:fxStamp .95s steps(10) forwards;
}
.fx-stamp.up{color:var(--green);box-shadow:0 0 0 4px var(--green2),0 0 0 8px #000,8px 8px 0 #000;}
@keyframes fxStamp{0%{opacity:0;transform:translate(-50%,-50%) rotate(-6deg) scale(2.6);}15%{opacity:1;transform:translate(-50%,-50%) rotate(-6deg) scale(1);}75%{opacity:1;transform:translate(-50%,-50%) rotate(-6deg) scale(1);}100%{opacity:0;transform:translate(-50%,-50%) rotate(-6deg) scale(1);}}
.fx-hit{animation:fxHit .45s steps(4);}
@keyframes fxHit{0%,50%{box-shadow:0 0 0 2px var(--gold),0 0 0 4px var(--gold2),3px 3px 0 #000;background:var(--panel2);}}
.balance-main.fx-goal{animation:fxGoal .6s steps(6);}
@keyframes fxGoal{0%,40%{box-shadow:0 0 0 2px var(--green),0 0 0 4px var(--green2),0 0 0 6px #000,4px 4px 0 #000;background:var(--green-dim);}}
.fss-track.fx-jiggle{animation:fxJiggle .3s steps(4);}
@keyframes fxJiggle{25%{transform:translate(-2px,0);}50%{transform:translate(2px,-1px);}75%{transform:translate(-1px,1px);}}
.fss.hot .fss-track{box-shadow:0 0 0 2px var(--red);animation:fssPulse 1s steps(2) infinite;}   /* 내사 착수: 테두리가 빨갛게 맥동 */
@keyframes fssPulse{50%{box-shadow:0 0 0 2px var(--red2),0 0 0 4px var(--red-dim);}}
.fx-combo{position:fixed;z-index:94;pointer-events:none;font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;text-shadow:1px 1px 0 #000;animation:pixelPop .9s steps(8) forwards;}
.fx-card-ghost{position:fixed;z-index:91;pointer-events:none;margin:0;}
.fx-canvas{position:fixed;inset:0;width:100%;height:100%;z-index:92;pointer-events:none;image-rendering:pixelated;}

/* ── 연쇄 연출 (fx.js 큐): 차단막(클릭 = 스킵) · CHAIN 카운터 · 효과 칩 · 잔상 · 유물 조명 ── */
.fx-blocker{position:fixed;inset:0;z-index:96;pointer-events:none;}
.fx-blocker.on{pointer-events:auto;cursor:pointer;}
.fx-chainctr{
  position:fixed;right:16px;top:28%;z-index:97;pointer-events:none;display:none;padding:8px 10px 6px;
  font-family:'Press Start 2P','Galmuri-14px',monospace;font-size:14px;line-height:1.2;color:var(--gold);background:#000;
  box-shadow:0 0 0 2px var(--gold2),4px 4px 0 #000;transform:scale(var(--chain-scale,1)) rotate(4deg);transform-origin:right center;
}
.fx-chainctr.on{display:block;animation:chainPop .3s steps(4);}
@keyframes chainPop{0%{transform:scale(calc(var(--chain-scale,1) * 1.8)) rotate(4deg);}100%{transform:scale(var(--chain-scale,1)) rotate(4deg);}}
.fx-chip{
  position:fixed;z-index:94;pointer-events:none;transform:translate(-50%,-100%);white-space:nowrap;padding:3px 6px 2px;
  font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;line-height:1.4;color:var(--red);background:#000;box-shadow:0 0 0 2px var(--red2);
  animation:chipUp 1.1s steps(11) forwards;
}
.fx-chip.up{color:var(--green);box-shadow:0 0 0 2px var(--green2);}
.fx-chip.gold{color:var(--gold);box-shadow:0 0 0 2px var(--gold2);}
@keyframes chipUp{0%{opacity:0;transform:translate(-50%,-60%) scale(1.6);}15%{opacity:1;transform:translate(-50%,-100%) scale(1);}80%{opacity:1;transform:translate(-50%,-180%);}100%{opacity:0;transform:translate(-50%,-200%);}}
.fx-afterimage{filter:grayscale(1) brightness(1.5);}
.relic.fx-relic-on{animation:relicOn .5s steps(5);}
@keyframes relicOn{0%,40%{background:var(--text);transform:scale(1.6);box-shadow:0 0 0 2px var(--text),0 0 0 4px var(--gold);}}
.fx-stamp.gold{color:var(--gold);box-shadow:0 0 0 4px var(--gold2),0 0 0 8px #000,8px 8px 0 #000;}
.fx-stamp.sm{top:22%;font-family:'Press Start 2P','Galmuri-14px',monospace;font-size:14px;padding:8px 10px 6px;box-shadow:0 0 0 2px var(--gold2),4px 4px 0 #000;}
.target-track.fx-goal{animation:fxGoal .6s steps(6);}
.fx-blink-up{animation:blinkUp .25s steps(2) infinite;}
.fx-blink-down{animation:blinkDown .25s steps(2) infinite;}
@keyframes blinkUp{50%{box-shadow:0 0 0 2px var(--green),3px 3px 0 #000;background:var(--green-dim);}}
@keyframes blinkDown{50%{box-shadow:0 0 0 2px var(--red),3px 3px 0 #000;background:var(--red-dim);}}

/* 갭 중앙 경보: 줄무늬 테이프 · 종목명 · 변동률 카운트업 · 밈 문구. t1 약(작게, 시장 안 멈춤) · t2 중 · t3 강 */
.gap-alert{position:fixed;inset:0;z-index:94;pointer-events:none;display:flex;align-items:center;justify-content:center;padding:16px;}
.ga-flash{position:absolute;inset:0;background:var(--green);opacity:0;animation:gaFlash .45s steps(3) forwards;}
.gap-alert.down .ga-flash{background:var(--red);}
@keyframes gaFlash{0%{opacity:.35;}100%{opacity:0;}}
.ga-rays{   /* 가장자리 방사형 집중선 */
  position:absolute;inset:-20%;opacity:.28;
  background:repeating-conic-gradient(from 0deg at 50% 50%,var(--green) 0deg 1.5deg,transparent 1.5deg 9deg);
  -webkit-mask:radial-gradient(circle at 50% 50%,transparent 32%,#000 60%);mask:radial-gradient(circle at 50% 50%,transparent 32%,#000 60%);
  animation:gaRays .6s steps(3) infinite;
}
.gap-alert.down .ga-rays{background:repeating-conic-gradient(from 0deg at 50% 50%,var(--red) 0deg 1.5deg,transparent 1.5deg 9deg);}
@keyframes gaRays{50%{transform:rotate(3deg) scale(1.03);}}
.gap-alert.t1 .ga-rays{display:none;}
.ga-box{
  position:relative;width:min(560px,100%);text-align:center;background:#000;padding:0 0 14px;
  box-shadow:0 0 0 4px var(--green2),0 0 0 8px #000,10px 10px 0 #000;animation:gaInUp .42s steps(7) both;
}
.gap-alert.down .ga-box{box-shadow:0 0 0 4px var(--red2),0 0 0 8px #000,10px 10px 0 #000;animation-name:gaInDown;}
@keyframes gaInUp{0%{opacity:0;transform:translateY(55vh) scale(2.4);}60%{opacity:1;transform:translateY(-10px) scale(1.08);}100%{opacity:1;transform:none;}}
@keyframes gaInDown{0%{opacity:0;transform:translateY(-55vh) scale(2.4);}60%{opacity:1;transform:translateY(10px) scale(1.08);}100%{opacity:1;transform:none;}}
.ga-tape{
  padding:8px 0 6px;margin-bottom:12px;overflow:hidden;
  background:repeating-linear-gradient(-45deg,var(--gold) 0 10px,#000 10px 20px);background-size:28px 28px;animation:gaTape .5s steps(4) infinite;
}
.ga-tape span{display:inline-block;padding:4px 10px 3px;background:#000;color:var(--gold);font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;line-height:1.3;}
@keyframes gaTape{to{background-position:28px 0;}}
.ga-name{font-family:'Press Start 2P','Galmuri-30px',monospace;font-size:30px;line-height:1.3;padding:4px 12px 0;color:var(--text);word-break:keep-all;}
.ga-pct{font-family:'Press Start 2P','Galmuri-30px',monospace;font-size:30px;line-height:1.3;margin-top:8px;color:var(--green);text-shadow:3px 3px 0 var(--green-dim);}
.gap-alert.down .ga-pct{color:var(--red);text-shadow:3px 3px 0 var(--red-dim);}
.ga-meme{font-family:'Press Start 2P','Galmuri-12px',monospace;font-size:12px;line-height:1.6;margin-top:10px;padding:0 12px;color:var(--gold);}
.ga-warn{display:inline-block;margin-top:10px;padding:5px 8px 3px;font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;line-height:1.4;color:#000;background:var(--red);animation:blink .4s step-end infinite;}
.gap-alert.t2 .ga-box{width:min(440px,100%);}
.gap-alert.t2 .ga-name,.gap-alert.t2 .ga-pct{font-family:'Press Start 2P','Galmuri-22px',monospace;font-size:22px;}
.gap-alert.t1 .ga-box{width:min(320px,100%);padding-bottom:10px;box-shadow:0 0 0 2px var(--green2),5px 5px 0 #000;}
.gap-alert.t1.down .ga-box{box-shadow:0 0 0 2px var(--red2),5px 5px 0 #000;}
.gap-alert.t1 .ga-name,.gap-alert.t1 .ga-pct{font-family:'Press Start 2P','Galmuri-16px',monospace;font-size:16px;}
.gap-alert.t1 .ga-meme{font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;}
.gap-alert.t1 .ga-flash{animation:none;}
/* 찌라시 결과 알림: 갭 경보와 같은 틀 (상승 up · 횡보 flat · 하락 down) */
.gap-alert.tip-res .ga-name{font-family:'Press Start 2P','Galmuri-14px',monospace;font-size:14px;line-height:1.6;padding:8px 14px 0;}
.gap-alert.tip-res.t1 .ga-name{font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;}
.gap-alert.tip-res .ga-slush{font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;line-height:1.5;margin-top:6px;color:var(--gold);}
.gap-alert.flat .ga-box,.gap-alert.t1.flat .ga-box{box-shadow:0 0 0 2px var(--muted),5px 5px 0 #000;}
.gap-alert.flat .ga-pct{color:var(--text);text-shadow:3px 3px 0 var(--line);}
.gap-alert.flat .ga-flash{animation:none;}
.ga-vig{position:absolute;inset:0;box-shadow:inset 0 0 0 40px rgba(0,0,0,.55),inset 0 0 0 90px rgba(0,0,0,.3);opacity:0;animation:gaVig .3s steps(3) forwards;}
@keyframes gaVig{to{opacity:1;}}
@media (max-width:900px){
  .ga-name,.ga-pct{font-family:'Press Start 2P','Galmuri-24px',monospace;font-size:24px;}
  .gap-alert.t2 .ga-name,.gap-alert.t2 .ga-pct{font-family:'Press Start 2P','Galmuri-18px',monospace;font-size:18px;}
  .ga-meme{font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;}
}

/* 장중 콤보: 상승 초록 → 금 → 무지개 / 하락 빨강 → 검붉음 + 가장자리 어둠. 끊기면 금이 가며 부서진다 */
.fx-streak{
  position:fixed;left:16px;bottom:16px;z-index:93;pointer-events:none;display:none;padding:7px 10px 5px;
  font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;line-height:1.3;background:#000;color:var(--green);
  box-shadow:0 0 0 2px var(--green2),4px 4px 0 #000;transform:scale(var(--streak-scale,1));transform-origin:left bottom;
}
.fx-streak.on,.fx-streak.broken{display:block;}
.fx-streak.u2{color:var(--gold);box-shadow:0 0 0 2px var(--gold2),4px 4px 0 #000;}
.fx-streak.u3{animation:rainbow .6s steps(4) infinite;}
@keyframes rainbow{0%{color:var(--green);box-shadow:0 0 0 2px var(--green);}25%{color:var(--gold);box-shadow:0 0 0 2px var(--gold);}50%{color:var(--cyan);box-shadow:0 0 0 2px var(--cyan);}75%{color:var(--purple);box-shadow:0 0 0 2px var(--purple);}}
.fx-streak.d1{color:var(--red);box-shadow:0 0 0 2px var(--red2),4px 4px 0 #000;}
.fx-streak.d2{color:var(--red2);background:var(--red-dim);box-shadow:0 0 0 2px var(--red2),4px 4px 0 #000;}
.fx-streak.broken{animation:streakBreak .5s steps(5) forwards;}
@keyframes streakBreak{0%{clip-path:none;}30%{clip-path:polygon(0 0,55% 0,40% 100%,0 100%);transform:rotate(-4deg);}100%{opacity:0;transform:translateY(24px) rotate(-12deg);}}
.fx-vignette{position:fixed;inset:0;z-index:84;pointer-events:none;opacity:0;box-shadow:inset 0 0 140px 40px #000;}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (가로) 레이아웃 — 901px 이상
   게임 영역은 16:10 고정, 뷰포트 안에 letterbox로 맞춘다.
   화면이 16:10보다 넓으면 좌우에, 좁으면 위아래에 배경이 보인다.
   900px 이하는 위의 기존 세로 스택 그대로.
═══════════════════════════════════════════════════════════ */
:root{
  --cab-ratio-w:16;
  --cab-ratio-h:10;
  --cab-max-w:90vw;   /* 폭 상한: 16:9 모니터에서 높이 100vh를 채우면 ≈90% */
  --cab-max-h:100vh;  /* 높이 상한 */
  --cab-w:min(var(--cab-max-w), calc(var(--cab-max-h) * var(--cab-ratio-w) / var(--cab-ratio-h)));
  --cab-h:calc(var(--cab-w) * var(--cab-ratio-h) / var(--cab-ratio-w));
}

@media (min-width: 901px){
  html,body{height:100%;overflow:hidden;}
  body{display:flex;align-items:center;justify-content:center;}

  .cabinet{
    display:flex;flex-direction:column;
    width:var(--cab-w);
    aspect-ratio:var(--cab-ratio-w) / var(--cab-ratio-h);
    max-width:var(--cab-max-w);max-height:var(--cab-max-h);
    min-height:0;margin:0;
    border:3px solid var(--line);
  }
  .tabnav{flex:none;}
  .tabnav button{font-size:8px;font-family:'Press Start 2P','Galmuri-8px',monospace;padding:11px 4px;}
  .footnote{display:none;}

  /* 화면마다 게임 영역 안에서만 스크롤 */
  .screen{min-height:0;}
  .screen.active{flex:1;min-height:0;overflow-y:auto;}
  #screen-event.active{display:flex;}
  #screen-title{max-width:620px;margin:0 auto;width:100%;}
  #screen-shop,#screen-collection,#screen-records,#screen-settings{padding:22px 28px 28px;}

  /* ── TR룸: 상단 HUD 바 + 좌(시장) / 우(손패·포지션) ── */
  #screen-play.active{
    display:grid;
    grid-template-columns:minmax(0, 1fr) minmax(0, 1.2fr);
    grid-template-rows:auto minmax(0, 1fr);
    grid-template-areas:"top top" "left right";
    gap:12px 16px;
    padding:12px 16px 14px;
    min-height:600px;           /* 너무 낮은 화면이면 안에서 스크롤 */
    overflow:hidden;
  }
  .play-top{
    grid-area:top;
    display:flex;flex-wrap:wrap;align-items:stretch;gap:10px 14px;
  }
  .play-left,.play-right{display:flex;flex-direction:column;min-height:0;min-width:0;}
  .play-left{grid-area:left;}
  .play-right{grid-area:right;}

  /* 상단 바 구성: 타이틀·장세 | 주차·일자 | 순자산·목표 | 현금·대출·확정·이자 */
  .play-top .hdr{flex-direction:column;align-items:flex-start;justify-content:center;gap:7px;margin:0;}
  .play-top .hud-col{flex:1 1 200px;min-width:200px;margin:0;align-self:center;display:flex;flex-direction:column;gap:8px;}
  .play-top .hud{margin:0;white-space:nowrap;}
  .play-top .balance-main{flex:0 1 270px;min-width:230px;margin:0;padding:8px 12px;}
  .play-top .balance-main .total{font-size:16px;font-family:'Press Start 2P','Galmuri-16px',monospace;margin-top:4px;}
  .play-top .target-line{margin-top:6px;}
  .play-top .assets-grid{
    flex:0 1 500px;min-width:420px;margin:0;   /* 1280×1024(게임 폭 1120px)에서도 상단 바가 한 줄에 들어가게 */
    grid-template-columns:repeat(4, minmax(0, 1fr));gap:8px;
  }
  .play-top .asset-card{display:flex;flex-direction:column;justify-content:center;padding:6px;}
  .play-top .asset-card .val{font-size:10px;font-family:'Press Start 2P','Galmuri-10px',monospace;}

  /* 왼쪽: 뉴스 → 지수 차트(남는 높이 전부) → 종목 시세판 */
  .play-left .news-banner{flex:none;}
  .play-left .chart-box{flex:1 1 auto;height:auto;min-height:140px;margin-bottom:4px;}
  .play-left .section-title{flex:none;margin-top:10px;}
  .play-left .quotes{flex:none;}
  .play-left .quote-row{grid-template-columns:1fr 96px 70px 56px;padding:4px 8px;}
  .play-left .quote-row canvas{width:96px;}

  /* 오른쪽: 행동력·더미 → 손패 → 장 시작 → 포지션(남는 높이 전부) → 전량 매도 */
  .play-right .turn-bar{margin:0 0 6px;flex:none;}
  .play-right .chips{flex:none;}
  .play-right .section-title{flex:none;margin:8px 0 6px;}
  .play-right .hand{flex:none;padding:6px 6px 12px;}
  .play-right .open-btn{flex:none;margin:2px 0 4px;padding:11px;}
  .play-right .positions-wrap{flex:1 1 0;min-height:70px;max-height:none;margin-bottom:10px;padding:2px;}
  .play-right .sell-all-btn{flex:none;padding:11px;}

  /* 알림은 상단 HUD를 가리지 않도록 왼쪽 차트 위에 */
  .toast-layer{
    top:calc((100vh - var(--cab-h)) / 2 + var(--cab-h) * 0.28);
    left:calc((100vw - var(--cab-w)) / 2 + 30px);
    transform:none;
    width:calc(var(--cab-w) * 0.4);
  }
  .hand{scroll-snap-type:x proximity;scroll-padding:0 6px;}
  .hand .card{scroll-snap-align:start;}
}
</style>
</head>
<body>

<!-- pixel bg canvas -->
<canvas id="candleBg"></canvas>

<!-- ambient floating bg stock charts layer -->
<div id="bgChartContainer"></div>

<div class="cabinet">
  <div class="tabnav">
    <button class="active" data-s="title">▶01 타이틀</button>
    <button data-s="play">02 TR룸</button>
    <button data-s="shop">03 암시장</button>
    <button data-s="event">04 찌라시</button>
  </div>

  <!-- ====== 01 TITLE ====== -->
  <section id="screen-title" class="screen active">
    <div class="eyebrow">★ "오늘도 반대매매 없는 하루 되세요" ★</div>
    <div class="badge-wrap">
      <div class="jibu-badge">떡상<span>기원부적</span></div>
    </div>
    <div class="title-main">풀매수 기원단</div>
    <div class="title-hodl">HODL or Die</div>
    <div class="title-tagline">시작부터 <b>상한가 가즈아!</b></div>

    <div class="menu">
      <button id="startBtn">▶ 영끌 출격
        <small>GAME START — 계좌 개설 후 즉시 몰빵</small>
      </button>
      <button id="collectionBtn">▷ 손절 기계
        <small>COLLECTION — 해금한 카드 · 유물 · 밈 도감</small>
      </button>
      <button id="settingsBtn">▷ 환경 설정
        <small>SETTINGS — 속도 · 화면 효과 · 기록 초기화</small>
      </button>
      <button id="recordsBtn">▷ 파산 기록
        <small>STATS — 엔딩 도감 · 역대 판 히스토리</small>
      </button>
    </div>

    <div class="ticker-wrap">
      <div class="ticker" id="tickerText"></div>
    </div>
  </section>

  <!-- ====== 02 GAMEPLAY ====== -->
  <section id="screen-play" class="screen">
    <!-- 가로 화면: 상단 HUD 바 / 왼쪽 시장 / 오른쪽 손패·포지션 (900px 이하는 세로 스택) -->
    <div class="play-top">
      <div class="hdr">
        <h2>▌ 도파민 TR룸</h2>
        <span class="state-tag" id="marketStateTag">■ NORMAL</span>
      </div>

      <div class="hud-col">
