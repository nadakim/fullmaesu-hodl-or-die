$('settingsBox').addEventListener('click', e => {
  const b = e.target.closest('button');
  if(!b || b.disabled) return;
  if(b.id === 'settingsReset'){
    if(!b.classList.contains('armed')){ b.classList.add('armed'); b.textContent = '정말 지울까요? 한 번 더 누르면 삭제'; return; }
    clearRecords();
    b.classList.remove('armed'); b.textContent = '✓ 기록을 지웠습니다';
    return;
  }
  if(b.dataset.step){   // [-] 값 [+]
    const k = b.dataset.step;
    settings[k] = Math.max(0, Math.min(100, settings[k] + (+b.dataset.d)));
    saveSettings(); applySettings(); buildSettings();
    return;
  }
  if(!b.dataset.set) return;
  settings[b.dataset.set] = JSON.parse(b.dataset.val);
  saveSettings();
  applySettings();
  buildSettings();
  if(settings.sound){ Sound.unlock(); if(b.dataset.set === 'sound' || b.dataset.set === 'sfxVol') Sound.play('sellWin'); }   // 켜거나 볼륨을 바꾸면 바로 들려준다
});

/* ── 파산 기록 화면 ── */
const ENDING_GROUPS = [['bust', '파산'], ['miss', '목표 미달'], ['win', '졸업']];
function fmtWhen(t){
  const d = new Date(t), p = v => String(v).padStart(2, '0');
  return `${p(d.getMonth() + 1)}/${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}
function buildRecords(){
  const r = loadRecords(), t = r.totals;
  const causes = Object.keys(ENDINGS);
  const total = t.runs;
  const unlocked = causes.filter(k => r.counts[k]).length;
  const bust = causes.filter(k => ENDINGS[k].group === 'bust').reduce((sum, k) => sum + (r.counts[k] || 0), 0);
  const h = r.history;
  const top = causes.filter(k => r.counts[k]).sort((a, b) => r.counts[b] - r.counts[a])[0];   // 가장 많이 본 엔딩
  $('recordsSub').textContent = `엔딩 ${unlocked} / ${causes.length} 해금 · 개미 ${total}회차`;
  const summary = `<div class="stat-grid">
      ${statTile('총 판 수', total + '판')}
      ${statTile('최고 생존', `${t.bestWeeks} / ${MAX_ROUND}주`)}
      ${statTile('최고 순자산', t.bestPeak ? fmtMoney(t.bestPeak) : '—')}
      ${statTile('총 청산', t.liq + '회')}
      ${statTile('파산 · 졸업', `<span class="${bust ? 'pnl-down' : ''}">${bust}</span> · ${r.counts.VICTORY || 0}회`)}
      ${statTile('가장 많이 본 엔딩', top ? `<span style="color:${ENDINGS[top].color}">${ENDINGS[top].title}</span> ×${r.counts[top]}` : '—', 'wide')}
    </div>`;
  const tiles = ENDING_GROUPS.map(([g, label]) => {
    const list = causes.filter(k => ENDINGS[k].group === g);
    const got = list.filter(k => r.counts[k]).length;
    return `<div class="pile-title">▌ ${label} (${got} / ${list.length})</div>
      <div class="end-grid">${list.map(k => {
        const e = ENDINGS[k], c = r.counts[k] || 0;
        return c
          ? `<div class="end-tile" data-ending="${k}" style="--ec:${e.color}"><div class="et-title">${e.title}</div><div class="et-count">×${c}</div><div class="et-sub">${e.sub}</div></div>`
          : `<div class="end-tile locked" data-ending="${k}"><div class="et-title">??? 미해금</div><div class="et-hint">조건: ${e.hint}</div></div>`;
