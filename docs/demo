      + tabs.map(([id, name]) => `<button data-cz="${id}" class="btn-chunky sm ${id === zoomTarget ? 'on' : ''}">${name}</button>`).join('') + '<button class="btn-chunky sm cz-close" data-cz-close="1">✕ 닫기 (Esc)</button>';
  }
  const isIdx = zoomTarget === 'idx', a = isIdx ? null : assets[zoomTarget];
