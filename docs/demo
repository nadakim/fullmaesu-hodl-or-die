/* ══════════════════════════════════════════════════════════
   MAIN GAME CANDLESTICK CHART (원본 보존)
══════════════════════════════════════════════════════════ */
const MAX_CANDLES = 22;
let candleData = [];

function initChartData(){
  candleData = [];
  let base = marketPrice;
  for(let i=0;i<MAX_CANDLES;i++){
    const c = generateNextCandle(base);
    candleData.push(c);
    base = c.close;
  }
  marketPrice = base;
}

function generateNextCandle(openPrice){
  let drift = 0, volMult = 1.0;
  if(marketState==='BULL'){drift=12;volMult=1.2;}
  else if(marketState==='BEAR'){drift=-12;volMult=1.2;}
  else if(marketState==='VOLATILE'){drift=0;volMult=2.8;}

  const change = drift + (Math.random()-0.49)*40*volMult;
  const closePrice = Math.max(100, Math.round(openPrice+change));
  const highExtra = Math.random()*20*volMult;
  const lowExtra  = Math.random()*20*volMult;
  const high = Math.round(Math.max(openPrice,closePrice)+highExtra);
  const low  = Math.round(Math.min(openPrice,closePrice)-lowExtra);
  return {open:Math.round(openPrice), high:Math.max(10,high), low:Math.max(10,low), close:Math.round(closePrice)};
}

function pushNewCandle(){
  const lastClose = candleData.length>0 ? candleData[candleData.length-1].close : marketPrice;
  const newCandle = generateNextCandle(lastClose);
  marketPrice = newCandle.close;
  candleData.push(newCandle);
  if(candleData.length > MAX_CANDLES) candleData.shift();
  return Math.log(newCandle.close / lastClose); // 지수 로그수익률 → 개별 종목에 전달
}


const cc = document.getElementById('candlestickChart');
const cctx = cc.getContext('2d', {antialias: false});

function renderChart(){
  if(!cc.clientWidth) return;
  cc.width  = Math.floor(cc.clientWidth);
  cc.height = Math.floor(cc.clientHeight);
  cctx.imageSmoothingEnabled = false;

  cctx.fillStyle = '#000';
  cctx.fillRect(0,0,cc.width,cc.height);

  cctx.fillStyle = 'rgba(26,34,64,0.8)';
  for(let x=0;x<cc.width;x+=6){
    for(let y=0;y<cc.height;y+=6){
      cctx.fillRect(x,y,1,1);
    }
  }

  cctx.fillStyle = '#1a2240';
  for(let i=1;i<4;i++){
    const y = Math.round((cc.height/4)*i);
    cctx.fillRect(0,y,cc.width,1);
  }

  if(candleData.length===0) return;

  const allH = candleData.map(c=>c.high);
  const allL = candleData.map(c=>c.low);
  let maxP = Math.max(...allH)*1.02;
  let minP = Math.min(...allL)*0.98;
  let range = maxP-minP||1;

  const stepX  = cc.width/MAX_CANDLES;
  const candleW = Math.max(2, Math.floor(stepX*0.55));

  candleData.forEach((c,i) => {
    const cx = Math.round(i*stepX + stepX/2 - candleW/2);

    const scaleY = v => Math.round(cc.height - ((v-minP)/range)*(cc.height-16) - 8);
    const openY  = scaleY(c.open);
    const closeY = scaleY(c.close);
    const highY  = scaleY(c.high);
    const lowY   = scaleY(c.low);
    const isUp   = c.close >= c.open;

    const col    = isUp ? '#00ff41' : '#ff1a3c';
    const shadow = isUp ? '#003a14' : '#3a000e';

    cctx.fillStyle = col;
    cctx.fillRect(cx + Math.floor(candleW/2), highY, 1, lowY-highY);

    const bodyTop = Math.min(openY,closeY);
    const bodyH   = Math.max(2, Math.abs(openY-closeY));
    cctx.fillStyle = shadow;
    cctx.fillRect(cx+2, bodyTop+2, candleW, bodyH);

    cctx.fillStyle = col;
    cctx.fillRect(cx, bodyTop, candleW, bodyH);

    cctx.fillStyle = 'rgba(255,255,255,0.4)';
    cctx.fillRect(cx, bodyTop, candleW, 1);
  });

  if(candleData.length>0){
    const lastClose = candleData[candleData.length-1].close;
    const scaleY = v => Math.round(cc.height - ((v-minP)/range)*(cc.height-16) - 8);
    const py = scaleY(lastClose);
    cctx.fillStyle = '#00e5ff';
    for(let x=0;x<cc.width;x+=4) cctx.fillRect(x,py,2,1);
  }
}

/* ══════════════════════════════════════════════════════════
   ENGINE — 게임 규칙 (DOM 접근 없음 → 나중에 C#으로 그대로 번역 가능)
   UI에는 emit()으로 이벤트만 알린다.
══════════════════════════════════════════════════════════ */
const MARKET_EVENTS = [
  { text:'FED, 기준 금리 전격 인하! 폭등장 시작!', state:'BULL' },
  { text:'대형 거래소 해킹 의혹 조사 중... 투매주의!', state:'BEAR' },
  { text:'기관 투자자 대규모 매수세 유입!', state:'BULL' },
  { text:'CEO 밈 트윗으로 변동성 폭발 중!', state:'VOLATILE' },
  { text:'글로벌 공급망 차질 우려, 시장 혼조세', state:'VOLATILE' }
];

let run = null;     // 한 판의 모든 상태
let assets = {};    // 종목별 가격 상태 { price, dayOpen, history[] }

function emit(type, data){ onGameEvent(type, data || {}); }

function gauss(){ // 표준정규분포 난수 (Box-Muller)
  let u = 0, v = 0;
  while(u === 0) u = Math.random();
  while(v === 0) v = Math.random();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
}

function initAssets(){
  assets = {};
  CARD_DATABASE.forEach(c => {
    assets[c.id] = { price: c.basePrice, dayOpen: c.basePrice, history: Array(ASSET_HISTORY).fill(c.basePrice) };
  });
  // 시작 시 차트가 비어 보이지 않도록 과거 시세를 미리 만들어 둔다
  for(let i = 0; i < ASSET_HISTORY; i++) updateAssetPrices(gauss() * 0.01);
  CARD_DATABASE.forEach(c => { assets[c.id].dayOpen = assets[c.id].price; });
}

/* 종목 수익률 = 지수 수익률 × beta × 전달비율 + 종목 고유 랜덤 변동(volatility) */
function updateAssetPrices(idxLogRet){
  CARD_DATABASE.forEach(c => {
    const a = assets[c.id];
    const r = c.beta * idxLogRet * IDX_SENS + c.volatility * IDIO_SCALE * gauss();
    a.price *= Math.exp(r);
    a.history.push(a.price);
    if(a.history.length > ASSET_HISTORY) a.history.shift();
  });
}

function drawCard(){ return CARD_DATABASE[Math.floor(Math.random() * CARD_DATABASE.length)]; }

function newRun(){
  return {
    phase: 'trading',            // trading | roundResult | over
    round: 1, day: 1, tickInDay: 0,
    cash: START_CASH, realized: 0, interestPaid: 0, lastInterest: 0,
    liquidations: 0, peakEquity: START_CASH,
    positions: [], hand: Array.from({length: 5}, drawCard),
    leverage: 1, side: 'long', eventTicksLeft: 0, ticksSinceEvent: 0,
    nextPosId: 1, endReason: null, endEquity: 0
  };
}

/* 롱: 가격에 비례. 인버스: 매수가 대비 하락한 만큼 이익 (배수는 대출로 키운 크기에 반영) */
function positionValue(p){
  const longValue = p.shares * assets[p.assetId].price;
  if(p.side === 'long') return longValue;
  return Math.max(0, 2 * p.shares * p.buyPrice - longValue);
}
const collateralRatio    = p => p.loan > 0 ? positionValue(p) / p.loan : Infinity;
const totalDebt          = () => run.positions.reduce((s, p) => s + p.loan, 0);
const totalPositionValue = () => run.positions.reduce((s, p) => s + positionValue(p), 0);
const netEquity          = () => run.cash + totalPositionValue() - totalDebt(); // 순자산
const currentTarget      = () => ROUND_TARGETS[run.round - 1];

/* 매수: 카드 비용 = 내 돈. 레버리지만큼 대출을 더해 포지션 크기를 키운다. */
function buyPosition(handIdx){
  if(!run || run.phase !== 'trading') return false;
  const card = run.hand[handIdx];
  if(!card) return false;
  if(run.cash < card.cost){ emit('insufficient', {card}); return false; }
  const lev = run.leverage;
  const price = assets[card.id].price;
  run.cash -= card.cost;
  run.positions.push({
    id: run.nextPosId++, assetId: card.id, name: card.name, lev, side: run.side,
    ownCost: card.cost,                // 내 원금
    loan: card.cost * (lev - 1),       // 신용 대출금
    shares: card.cost * lev / price,
    buyPrice: price
  });
  run.hand[handIdx] = drawCard();
  return true;
}

/* 청산: 평가액으로 대출을 먼저 갚고 남은 돈이 현금으로 (모자라면 미수 = 음수 현금) */
function closePosition(pos){
  const proceeds = positionValue(pos) - pos.loan;
  const pnl = proceeds - pos.ownCost;
  run.cash += proceeds;
  run.realized += pnl;
  run.positions = run.positions.filter(p => p !== pos);
  return pnl;
}

function sellPosition(id){
  if(!run || run.phase !== 'trading') return;
  const pos = run.positions.find(p => p.id === id);
  if(!pos) return;
  emit('sold', {pnl: closePosition(pos)});
}

function sellAllPositions(){
  if(!run || run.phase !== 'trading' || run.positions.length === 0) return;
  let total = 0;
  [...run.positions].forEach(p => { total += closePosition(p); });
  emit('soldAll', {pnl: total});
}

/* 반대매매: 담보비율(평가액 ÷ 대출금)이 140% 아래로 떨어지면 강제 청산 */
function checkMarginCalls(){
  run.positions.filter(p => collateralRatio(p) < MAINTENANCE_RATIO).forEach(p => {
    const pnl = closePosition(p);
    run.liquidations++;
    emit('marginCall', {pos: p, pnl});
  });
}

function endRun(reason){
  run.phase = 'over';
  run.endReason = reason;
  run.endEquity = netEquity();
  emit('runOver', {reason});
  return true;
}

function checkBankruptcy(){
  if(netEquity() <= 0) return endRun('BANKRUPT');
  if(run.positions.length === 0 && run.cash < MIN_CARD_COST) return endRun('BROKE');
  return false;
}

function updateMarketEvent(){
  if(run.eventTicksLeft > 0){
    run.eventTicksLeft--;
    if(run.eventTicksLeft === 0){ marketState = 'NORMAL'; emit('eventEnd'); }
    return;
  }
  run.ticksSinceEvent++;
  if(run.ticksSinceEvent >= 12 && Math.random() < 0.08){
    const ev = MARKET_EVENTS[Math.floor(Math.random() * MARKET_EVENTS.length)];
    marketState = ev.state;
    run.eventTicksLeft = EVENT_DURATION;
    run.ticksSinceEvent = 0;
    emit('event', ev);
  }
}

function endOfDay(){
  const interest = totalDebt() * DAILY_INTEREST;
  run.cash -= interest;
  run.interestPaid += interest;
  run.lastInterest = interest;
  CARD_DATABASE.forEach(c => { assets[c.id].dayOpen = assets[c.id].price; });
  if(checkBankruptcy()) return;
  if(run.day >= DAYS_PER_ROUND){ endOfRound(); return; }
  run.day++;
  emit('dayStart', {day: run.day, interest});
}

/* 주말 결산: 순자산이 목표 이상이면 다음 주로, 아니면 게임 오버. 포지션은 이월(존버 가능). */
function endOfRound(){
  const eq = netEquity(), target = currentTarget();
  if(eq < target) return endRun('MISSED');
  if(run.round >= MAX_ROUND) return endRun('VICTORY');
  run.phase = 'roundResult';
  emit('roundClear', {eq, target});
}

function startNextRound(){
  if(!run || run.phase !== 'roundResult') return;
  run.round++;
  run.day = 1;
  run.tickInDay = 0;
  run.phase = 'trading';
  emit('roundStart', {round: run.round, target: currentTarget()});
}

function tick(){
  if(!run || run.phase !== 'trading') return;
  updateAssetPrices(pushNewCandle());
  updateMarketEvent();
  checkMarginCalls();
  run.peakEquity = Math.max(run.peakEquity, netEquity());
  if(checkBankruptcy()) return;
  run.tickInDay++;
  if(run.tickInDay >= TICKS_PER_DAY){ run.tickInDay = 0; endOfDay(); }
}

