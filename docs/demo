  showOverlay(`<div class="tip-log-box">
    <div class="ov-title" style="color:var(--gold)">📱 찌라시 기록</div>
    ${run.tipLog.length ? tipResultHtml(run.tipLog[0]) + `<div class="pile-title">▌ 최근 찌라시 결과</div><ul class="tip-log">${log}</ul>`
      : `<div class="tip-empty">📵 아직 받은 찌라시가 없습니다<small>장중에 무작위로 도착합니다 (하루 최대 ${TIP_MAX_PER_DAY}개). 도착하면 시장이 멈추고 선택을 기다립니다.</small></div>`}
    </div>
    <button class="btn-chunky ov-btn" data-act="close">닫기</button>`);
  renderNav();
}

function chooseTip(i){
  resolveTip(i);
  renderAll();
}

/* ── 유물 ── */
function relicTile(r, o){
  return `<div class="relic-tile ${r.rarity} ${o.cls || ''}" ${o.attrs || ''}>
    <div class="rt-icon">${r.icon}</div><div class="rt-name">${r.name}</div>
    <div class="c-rar ${r.rarity}">${RARITY_LABEL[r.rarity]}</div>
    <div class="rt-desc">${r.desc}</div>${r.tags.length ? `<div class="rt-tags">${tagNames(r.tags)}</div>` : ''}<div class="rt-flavor">${r.flavor}</div>
    ${o.extra || ''}</div>`;
}

/* 정산 종류 배지: 합산 배수 + / 곱 배수 × / 칩 +. 정산에 안 쓰는 유물은 없음 */
const RELIC_KIND_BADGE = { add: ['＋', 'add', '칩 더하기'], mult: ['+', 'mult', '합산 배수 (+)'], xmult: ['×', 'xmult', '곱 배수 (×)'], copy: ['⇄', 'copy', '효과 복사'], last: ['⤓', 'last', '맨 오른쪽 칸 전용'] };
const relicKind = id => SETTLE_EFFECTS[id] ? SETTLE_EFFECTS[id].kind : '';
function renderRelics(){
  if(relicTipId && !hasRelic(relicTipId)) relicTipId = '';
  const arrange = canArrangeRelics();
  const seized = run.boss && bossMod('slot1Seized', false) ? 0 : -1;   // 유물 압류 (보스): 1번 칸
  const sig = run.relics.join() + '|' + relicTipId + '|' + arrange + '|' + seized + '|' + run.relics.map(id => Math.round(relicStacks(id))).join();
  if(sig === relicSig) return;
  relicSig = sig;
  const slots = run.relics.map((id, i) => { const r = RELIC_BY_ID[id];
      const st = relicStacks(id), money = r.growth === 'money';
      const badge = r.growth && st >= 1 ? `<span class="rl-stk">${money ? Math.round(st) : st}</span>` : '';
      const kb = RELIC_KIND_BADGE[relicKind(id)], kind = kb ? `<span class="rl-kind ${kb[1]}">${kb[0]}</span>` : '';
      const glow = !r.growth || money ? '' : st >= 25 ? 'g4' : st >= 10 ? 'g3' : st >= 5 ? 'g2' : '';
      const sz = i === seized;
      return `<button class="relic ${r.rarity} ${glow} ${id === relicTipId ? 'on' : ''} ${sz ? 'seized' : ''}" data-relic="${id}" data-slot="${i}" ${''} title="${i + 1}번 칸 · ${r.name}${sz ? ' · 🏷️ 압류 — 이번 주 정산 효과 무효' : ''}" aria-label="${i + 1}번 칸 ${r.name}">${r.icon}${kind}${badge}${sz ? '<span class="rl-seize">압류</span>' : ''}</button>`; }).join('')
    + '<span class="relic-slot" title="빈 칸 — 매주 결산 보상이나 암시장에서 얻는다"></span>'.repeat(Math.max(0, RELIC_SLOTS - run.relics.length));
  $('relicBar').innerHTML = `<span class="relic-label" title="정산은 왼쪽 칸부터 차례로 발동 — 더하기(+)를 앞에, 곱하기(×)를 뒤에 둘수록 커진다">▌ 유물 ${run.relics.length}/${RELIC_SLOTS}</span>` + slots;
  fitRelicEmpty();
  const tip = $('relicTip');
  if(relicTipId){
    const r = RELIC_BY_ID[relicTipId], i = run.relics.indexOf(relicTipId), kb = RELIC_KIND_BADGE[relicKind(relicTipId)];
    const kbCls = kb ? (kb[1] === 'add' ? 'n-chip' : kb[1] === 'copy' ? '' : 'n-mult') : '';
    const seizeNote = i === seized ? '<span class="rt-seize">🏷️ 유물 압류 (보스) — 이번 주 이 칸의 정산 효과는 무효. 순서를 바꾸면 다른 유물이 1번 칸으로 간다</span>' : '';
    const move = `${seizeNote}<span class="rt-move"><span>${i + 1}번 칸${kb ? ` · 정산 ${i + 1}번째 · <span class="${kbCls}">${kb[2]}</span>` : ''}</span>${arrange
      ? `<button class="btn-chunky sm" data-relic-move="-1" ${i > 0 ? '' : 'disabled'}>◀ 앞으로</button><button class="btn-chunky sm" data-relic-move="1" ${i < run.relics.length - 1 ? '' : 'disabled'}>뒤로 ▶</button><span>끌어서 옮기기 · ←→</span>`
      : '<span>순서는 장전·암시장에서 바꿀 수 있다</span>'}</span>`;
    tip.innerHTML = `<b>${r.icon} ${r.name}</b> <span class="c-rar ${r.rarity}">${RARITY_LABEL[r.rarity]}</span><br>${relicKind(r.id) ? settleColor(r.desc) : r.desc}${r.growth ? growthTipHtml(r) : ''}<i>${r.flavor}</i>${move}`;
    tip.hidden = false;
  } else tip.hidden = true;
}
/* 유물 칸 옮기기 (엔진 moveRelic). 선택(툴팁)은 옮긴 유물을 따라간다 */
function shiftRelic(id, d){
  const i = run.relics.indexOf(id);
  if(i < 0 || !moveRelic(i, i + d)) return false;
  relicSig = '';
  renderRelics();
  if(currentTab === 'shop') renderShop();
  return true;
}

/* 성장형 유물 툴팁: 현재 스택 · 지금 효과 · 초기화 조건 · 이번 판 최고 */
function growthTipHtml(r){
  const st = relicStacks(r.id), best = run.relicState[r.id] ? run.relicState[r.id].best : 0;
  const eff = {
    moonSavings: () => `정산 ×${moonX().toFixed(2)}`,
    tearJar: () => `적립금 ₩${formatKrw(st)} — 상승 콤보 ${TEARJAR_PAYOUT_COMBO}에 지급`,
    traumaSurvivor: () => `레버리지·숏 정산 ×${Math.pow(TRAUMA_XMULT_PER_STACK, st).toFixed(2)}`,
    ccompound: () => `정산 ×${ccX().toFixed(1)}`,
    phoenix: () => `정산 ×${Math.pow(PHOENIX_PER_STACK, st).toFixed(2)}`,
    tipCollector: () => `찌라시 A 대박 +${Math.round(tipCollectorBonus() * 100)}%p`,
    diamondTree: () => `이자 −${Math.round(dtreeCut() * 100)}%`,
    compoundMonster: () => `다음 주 첫날 현금 +${st}% (지금 ₩${formatKrw(Math.max(0, netEquity()) * COMPOUND_CASH_PER_STACK * st)})`
  }[r.id];
  return `<span class="rt-grow">현재 ${growText(r.id, r.growth === 'money' ? st : st)} · ${eff ? eff() : ''}<br>초기화: ${r.reset}<br>이번 판 최고 ${growText(r.id, best)}</span>`;
}

$('relicTip').addEventListener('click', e => {
  const b = e.target.closest('[data-relic-move]');
  if(b && !b.disabled && relicTipId) shiftRelic(relicTipId, +b.dataset.relicMove);
});
/* 끌어서 순서 바꾸기 (장전·암시장). 놓은 유물의 칸으로 들어가고 사이 유물이 한 칸씩 밀린다 */
const relicDragFrom = -1;   // 클릭 전용: 끌어서 옮기기는 없앴다 — 유물을 눌러 고른 뒤 설명 창의 ◀ 앞으로 / 뒤로 ▶ (키보드 ←/→ 보조)
$('relicBar').addEventListener('click', e => {
  const b = e.target.closest('[data-relic]');
  if(!b) return;
  relicTipId = relicTipId === b.dataset.relic ? '' : b.dataset.relic;   // 다시 누르면 닫힘
  renderRelics();
});

/* ── 암시장 ── */
/* 내비게이션 표시: 메뉴 점(미확인 찌라시 결과) · 타이틀 '이어하기' (진행 중인 판이 있을 때) */
function renderNav(){
  const dot = tipUnseen();
  $('menuDot').hidden = !dot;
  $('menuTipDot').hidden = !dot;
  $('continueBtn').hidden = !(run && run.phase !== 'over');
}

const fmtChance = c => (Math.round(c * 1000) / 10) + '%';
/* 암시장 가격 + 이번 주 인상률 (엔진 shopPrice·shopInflation 그대로). 1주차엔 인상률 표시 없음 */
const inflTag   = category => shopInflation(category) > 0 ? ` <span class="infl">(▲${Math.round(shopInflation(category) * 100)}%)</span>` : '';
const fmtPrice2 = (price, category) => fmtSlush(price) + inflTag(category);

function packHtml(pk){
  const empty = packPool(pk).length === 0;
  const price = packPrice(pk), afford = run.slush >= price && !empty;
  const odds = packRarityOdds(pk).map(o => `<span class="c-rar ${o.rarity}">${RARITY_LABEL[o.rarity]} ${fmtChance(o.chance)}</span>`).join('');
  return `
    <div class="pack-col">
      <button class="btn-chunky sm pk-info" data-pack-info="${pk.id}" title="${pk.name} 구성·확률 보기" aria-label="${pk.name} 구성·확률 보기">?</button>
      <button class="pack ${afford ? '' : 'disabled'}" data-pack="${pk.id}">
        <div class="pk-icon">${pk.icon}</div>
        <div>${pk.name}</div>
        <div class="pk-price">${fmtPrice2(price, 'pack')}</div>
        <div class="pk-odds">${empty ? '덱에 없는 카드가 남지 않음' : odds}</div>
        <div class="pk-desc">${pk.desc}</div>
      </button>
    </div>`;
}

/* 팩 구성 팝업 — 확률은 엔진 packRarityOdds()·packCardOdds() 결과를 그대로 표시 (화면에서 다시 계산하지 않는다).
   제외 카드 = 팩 구성 후보 중 packPool()에 없는 것 (덱에 이미 있음 · 신화 한도) — 확률 없이 흐리게만 */
function showPackInfo(packId){
  const pk = SHOP_PACK_BY_ID[packId];
  const rOdds = packRarityOdds(pk), cOdds = packCardOdds(pk), pool = packPool(pk);
  const rChance = r => { const o = rOdds.find(x => x.rarity === r); return o ? o.chance : 0; };
  const cands = (pk.pool.length ? pk.pool : CARDS.map(c => c.id))
    .filter(id => CARD_BY_ID[id] && CARD_BY_ID[id].type !== 'status' && pk.weights[CARD_BY_ID[id].rarity] > 0);
  const out = cands.filter(id => pool.indexOf(id) < 0);
  const price = packPrice(pk), affordable = run.slush >= price && pool.length > 0;
  const bars = RARITIES.map(r => `<div class="pki-bar ${r} ${rChance(r) > 0 ? '' : 'zero'}"><span class="c-rar ${r}">${RARITY_LABEL[r]}</span>
      <span class="track"><i style="width:${(rChance(r) * 100).toFixed(2)}%"></i></span><span class="pct">${fmtChance(rChance(r))}</span></div>`).join('');
  const groups = RARITIES.map(r => {
    const inPool = cOdds.filter(o => CARD_BY_ID[o.cardId].rarity === r).sort((a, b) => CARD_ORDER[a.cardId] - CARD_ORDER[b.cardId]);
    const excl = sortedCardIds(out.filter(id => CARD_BY_ID[id].rarity === r));
    if(!inPool.length && !excl.length) return '';
    return `<span class="pki-sec"><span class="c-rar ${r}">${RARITY_LABEL[r]}</span> · ${fmtChance(rChance(r))}${inPool.length ? ` ÷ ${inPool.length}종` : ' (남은 카드 없음)'}</span>
      <div class="pki-grid">${inPool.map(o => `<div class="pki-card" data-pki-card="${o.cardId}"><div class="mini">${cardHtml(CARD_BY_ID[o.cardId], {})}</div><span class="odds">${fmtChance(o.chance)}</span></div>`).join('')}
        ${excl.map(id => `<div class="pki-card out" data-pki-out="${id}"><div class="mini">${cardHtml(CARD_BY_ID[id], {})}</div><span class="odds">${inDeck(id) ? '보유 중(제외)' : '신화 한도(제외)'}</span></div>`).join('')}</div>`;
  }).join('');
  const total = cOdds.reduce((sum, o) => sum + o.chance, 0);
  showOverlay(`
    <div class="pki-head"><span class="pk-icon">${pk.icon}</span><div><div class="pki-name">${pk.name}</div><div class="pki-price">${fmtPrice2(price, 'pack')}</div><div class="pki-desc">${pk.desc}</div></div></div>
    <span class="pki-sec">▌ 등급별 확률 (등급 먼저 → 등급 안에서 균등)</span>
    <div class="pki-bars">${bars}</div>
    <span class="pki-sec">▌ 구성 카드 ${cOdds.length}종 · 확률 합 ${fmtChance(total)}</span>
    ${biasNoteHtml()}
    ${out.length ? `<div class="pki-note">흐린 카드 ${out.length}장은 덱에 이미 있거나(신화는 덱에 ${MYTHIC_DECK_LIMIT}장까지) 이번엔 나오지 않아 확률 계산에서 빠져 있습니다.</div>` : ''}
    ${pool.length ? groups : '<div class="pki-note">덱에 없는 카드가 남지 않아 지금은 살 수 없습니다.</div>'}
    <div class="pki-btns">
      <button class="btn-chunky ov-btn" data-pack-buy="${pk.id}" ${affordable ? '' : 'disabled'}>${pool.length ? (run.slush >= price ? `구매 ${fmtSlush(price)}` : `비자금 부족 (${fmtSlush(price)})`) : '살 수 없음'}</button>
      <button class="btn-chunky ov-btn alt" data-act="close">닫기</button>
    </div>`);
}

/* 진열 새로고침 버튼: 지금 가격 + 다음 두 단계 (엔진 rerollCost 그대로). 비자금 부족·새로 뽑을 게 없으면 비활성 */
let shopFlipIn = '';   // 방금 새로고침한 종류 — 그 진열만 뒤집히며 나타난다 (한 번 그리면 지운다)
/* 암시장 유물 칸마다 등급 확률 — 엔진 relicShopOdds() 값을 그대로 (보유 유물을 뺀 남은 등급으로 다시 나눈 값) */
function relicOddsHtml(){
  const odds = relicShopOdds();
  return odds.length ? `<div class="shop-note relic-odds">칸마다 등급 확률: ${odds.map(o => `<span class="c-rar ${o.rarity}" title="남은 ${RARITY_LABEL[o.rarity]} 유물 ${o.count}개 중 균등">${RARITY_LABEL[o.rarity]} ${fmtChance(o.chance)}</span>`).join(' · ')}</div>` : '';
}
function rerollBoxHtml(kind){
  const n = run.shop.rerolls[kind], cost = rerollCost(kind, n), can = rerollAvailable(kind);
  return `<span class="reroll-box"><button class="btn-chunky reroll-btn" data-reroll="${kind}" ${can && run.slush >= cost ? '' : 'disabled'}
      title="${can ? '' : kind === 'relic' ? '새로 들여올 유물이 없습니다' : '새로 뽑을 칸·카드가 없습니다'}">🔄 새로고침 <b id="rrCost-${kind}">${fmtSlush(cost)}</b></button>
    <span class="reroll-next">다음 ${rerollCost(kind, n + 1).toLocaleString()} → ${rerollCost(kind, n + 2).toLocaleString()}</span></span>`;
}
function doReroll(kind){
  if(!rerollAvailable(kind) || run.slush < shopRerollCost(kind)) return;
  const before = shopRerollCost(kind);
  const olds = kind === 'single'   // 안 산 칸만 뒤집혀 사라지고 (산 칸은 그대로)
    ? [...document.querySelectorAll('#shopBox .shop-singles .shop-item')].filter((_, i) => run.shop.singlesBought.indexOf(i) < 0).map(it => it.firstElementChild)
    : [...document.querySelectorAll('#shopBox .relic-row .relic-tile')];
  olds.forEach(el => el && el.classList.add('rr-out'));
  setTimeout(() => {
    if(!rerollShop(kind)) { renderShop(); return; }
    shopFlipIn = kind;
    renderShop(); renderNav();
    shopFlipIn = '';
    Fx.punch($('rrCost-' + kind), -(shopRerollCost(kind) - before), 0.7);   // 다음 가격이 튀어 오르며 갱신
  }, 220);
}

function renderShop(){
  const box = $('shopBox');
  if(!shopOpenNow()){
    box.innerHTML = `<div class="shop-locked">🔒 라운드 종료 후 이용 가능
      <small>주간 결산에서 목표를 달성하고 보상을 고르면, 다음 주 개장 전까지 열립니다.</small></div>`;
    return;
  }
  const sh = run.shop, nextRemove = shopRemoveCost();
  const canRemove = run.masterDeck.length > MIN_DECK_SIZE;   // 횟수 제한 없음 — 누진 비용 + 덱 최소 장수만
  if(shopPickIdx >= run.masterDeck.length) shopPickIdx = -1;
  box.innerHTML = `
    <div class="shop-bar px-panel">
      <span>WEEK ${run.round} 결산 완료 · 비자금 <b class="slush-amt" id="shopSlush">${fmtSlush(run.slush)}</b> · 덱 <b>${run.masterDeck.length}장</b><br>
        다음 주 목표 <b>${fmtMoney(ROUND_TARGETS[run.round])}</b> · 순자산 <b>${fmtMoney(netEquity())}</b><br>
        물가 상승률: 1주차 대비 <b class="infl">+${Math.round(shopInflation('pack') * 100)}%</b> (팩·낱장 · 유물 +${Math.round(shopInflation('relic') * 100)}%)</span>
      <button class="btn-chunky open-btn" id="shopLeaveBtn">▶ WEEK ${run.round + 1} 개장</button>
    </div>
    ${nextBossId() ? bossNotice(nextBossId(), '⚠ 다음 주 보스 — 여기서 대비할 카드·유물을 사 두세요') : ''}
    <div class="shop-note">암시장은 비자금만 받습니다. 계좌 돈(순자산)은 그대로 — 비자금은 주간 목표를 넘긴 만큼 더 쌓입니다 (기본 ${fmtSlush(SLUSH_WEEKLY_BASE)} + 초과분의 ${Math.round(SLUSH_EXCESS_RATE * 100)}%).</div>

    <span class="section-label">▌ 카드 팩 — 덱에 없는 카드 중 1장 무작위 · 희귀도 확률 공개</span>
    <div class="pack-row">${SHOP_PACKS.filter(packOpen).map(packHtml).join('')}</div>

    <div class="shop-sec-head"><span class="section-label">▌ 낱장 구매 — 덱에 없는 카드 확정 구매 · 구매 한도 없음</span>${rerollBoxHtml('single')}</div>
    <div class="deck-list shop-singles">${sh.singles.map((id, i) => {
      const bought = sh.singlesBought.indexOf(i) >= 0, owned = !bought && inDeck(id), price = singlePrice(id);
      const label = bought ? '구매 완료' : owned ? '덱에 있음' : `${fmtPrice2(price, 'single')} 구매`;
      const fresh = shopFlipIn === 'single' && !bought;   // 방금 새로 뽑은 칸: 뒤집히며 나타난다 (팩 개봉 flip-card 재사용)
      return `<div class="shop-item">${fresh ? `<div class="flip-card"><div class="flip-face flip-back">?</div><div class="flip-face flip-front">${cardHtml(CARD_BY_ID[id], {})}</div></div>` : cardHtml(CARD_BY_ID[id], {})}
        <button class="btn-chunky buy-btn" data-single="${i}" ${bought || owned || run.slush < price ? 'disabled' : ''}>${label}</button></div>`;
    }).join('')}</div>

    <div class="shop-sec-head"><span class="section-label">▌ 유물 — 한 판 동안 상시 발동 · ${RELIC_SHOP_COUNT}칸</span>${rerollBoxHtml('relic')}</div>
    ${relicOddsHtml()}
    <div class="relic-row">${sh.relics.length ? sh.relics.map(id => {
      const r = RELIC_BY_ID[id], price = relicPrice(id), owned = hasRelic(id);
      return relicTile(r, { cls: shopFlipIn === 'relic' ? 'rr-in' : '', extra: `<button class="btn-chunky buy-btn" data-buy-relic="${id}" ${owned || run.slush < price ? 'disabled' : ''}>${owned ? '보유 중' : `${fmtPrice2(price, 'relic')} 구매`}</button>` });
    }).join('') : '<div class="shop-note">더 들여올 유물이 없습니다. 전부 모았습니다.</div>'}</div>

