/* ══ 화면 배율 --ui ══
   데스크톱은 게임 영역이 창 전체를 채우고, 글자·카드·여백은 전부 CSS --u(= --ui × 1px)의 배수다.
   --ui = 창 높이 ÷ UI_BASE_H를 UI_SCALE_STEP 단위로 반올림, UI_SCALE_MIN~MAX. 900px 이하 모바일은 1.
   설정 '화면 크기'는 여기에 UI_SIZE_OFFSET을 더한다. 키울 때는 창이 UI_MIN_UNITS_W × UI_MIN_UNITS_H 칸보다 작아지지 않는 선까지만
   (그보다 작으면 TR룸 버튼·손패·포지션이 창에 안 들어간다). 자동 배율에서는 종목 시세 7행이 스크롤 없이 보이고,
   크게 · 매우 크게에서 높이가 모자라면 시세표만 칸 안에서 스크롤한다 */
const UI_BASE_H = 600, UI_SCALE_MIN = 1, UI_SCALE_MAX = 2.5, UI_SCALE_STEP = 0.25;
const UI_MIN_UNITS_W = 760, UI_MIN_UNITS_H = 480;
const UI_SIZE_OFFSET = { small: -0.25, auto: 0, large: 0.25, xlarge: 0.5 };
const MOBILE_MAX_W = 900;   // CSS @media (min-width: 901px)과 같은 경계
let uiScale = 1;
const isMobileLayout = () => window.innerWidth <= MOBILE_MAX_W;
const clampUi = v => Math.min(UI_SCALE_MAX, Math.max(UI_SCALE_MIN, v));
function uiScaleFor(mode){
  if(isMobileLayout()) return 1;
  const auto = clampUi(Math.round(window.innerHeight / UI_BASE_H / UI_SCALE_STEP) * UI_SCALE_STEP);
  const off = UI_SIZE_OFFSET[mode] || 0;
  if(off <= 0) return clampUi(auto + off);
  const fit = Math.floor(Math.min(window.innerWidth / UI_MIN_UNITS_W, window.innerHeight / UI_MIN_UNITS_H) / UI_SCALE_STEP) * UI_SCALE_STEP;
  return clampUi(Math.max(auto, Math.min(auto + off, fit)));
}
/* ── 전투 화면 확정 레이아웃 (UI 전용, 엔진 무관) ──
   넓은 가로 화면(폭 ≥ 1200, 가로세로비 ≥ 1.45)에서만 켜지고(body.lay-f), 그보다 좁거나 주소가 ?layout=classic이면 예전 레이아웃(classic) 그대로.
   켜질 때만 정보 요소(현금·행동력·칩·금감원)를 #infoCol로, 종목 시세·포지션을 #stockList로 옮긴다 (id·렌더 함수는 그대로) */
const LAYOUT_MQ = '(min-width: 1200px) and (min-aspect-ratio: 145/100)';
const layoutNow = () => new URLSearchParams(location.search).get('layout') !== 'classic' && window.matchMedia(LAYOUT_MQ).matches ? 'F' : 'classic';
let layoutEls = null, layoutHome = null;
function placeLayout(L){
  if(!layoutEls){
    layoutEls = { assets: document.querySelector('.play-top .assets-grid'), turn: document.querySelector('.turn-bar'), chips: $('chipBox'), fss: $('fssBox'),
                  qt: document.querySelector('.play-left .section-title'), quotes: $('quoteBox'), qmap: $('quoteMap'), hold: $('holdPanel'), positions: $('positionsBox'), chart: $('chartBox') };
    layoutHome = {};
    Object.keys(layoutEls).forEach(k => { const c = document.createComment('home:' + k); layoutEls[k].parentNode.insertBefore(c, layoutEls[k]); layoutHome[k] = c; });
  }
  const dest = L === 'F' ? { assets: 'infoCol', fss: 'infoCol', turn: 'infoCol', chips: 'infoCol', qt: 'stockList', quotes: 'stockList', qmap: 'stockList', hold: 'stockList', positions: 'holdBody', chart: 'chartPair' } : {};
  const MOVED = ['infoCol', 'stockList', 'holdBody', 'chartPair'];
  Object.keys(layoutEls).forEach(k => {
    const el = layoutEls[k];
    if(dest[k] === 'chartPair') $('chartPair').insertBefore(el, $('chartPair').firstChild);   // IDX 차트가 왼쪽
    else if(dest[k]) $(dest[k]).appendChild(el);
    else if(MOVED.indexOf(el.parentNode.id) >= 0) layoutHome[k].parentNode.insertBefore(el, layoutHome[k].nextSibling);
  });
}
function applyLayout(){
  const L = layoutNow();
  placeLayout(L);
  document.body.dataset.layout = L;
  document.body.classList.toggle('lay-f', L === 'F');
}
document.addEventListener('click', e => {
  if(e.target.closest('#topSettingsBtn')){ settingsReturn = currentTab; switchTab('settings'); }
});

function layoutUi(){
  uiScale = uiScaleFor(settings.uiSize);
  applyLayout();
  document.documentElement.style.setProperty('--ui', String(uiScale));
  Fx.setUiScale(uiScale);
  if(run){ handSig = ''; posSig = ''; renderAll(); }   // 캔버스 새 크기로 · 카드 설명 잘림 다시 판정
  fitNews();
