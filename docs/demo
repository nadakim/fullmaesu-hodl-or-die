.rl-stk{position:absolute;right:calc(-6 * var(--u));bottom:calc(-6 * var(--u));min-width:calc(12 * var(--u));padding:calc(2 * var(--u)) calc(2 * var(--u)) 0;font-family:'Press Start 2P',var(--gp-p1),monospace;font-size:var(--fs-p1);line-height:1.3;color:#000;background:var(--text);box-shadow:0 0 0 calc(1 * var(--u)) #000;pointer-events:none;}
