/* ══════════════════════════════════════════════════════════
   흐름 제어 — 탭 전환, 새 판 시작, 입력, 게임 루프
══════════════════════════════════════════════════════════ */
/* ── 디버그 시나리오: 주소 ?scenario=full | nine,hand,long,multi,empty 로 화면 상태를 강제로 만든다 (UI 검증 전용, 일반 플레이에선 주소에 없다)
   nine = 9종목 전부 보유(수익·손실 섞어서) · multi = 한 종목에 포지션 2개 · hand = 손패 HAND_MAX장 · long = 순자산 123억 4,567만 · empty = 보유 0개 · full = nine+hand+long
   all = 전 종목 보유 + 같은 종목 다른 레버리지 2개 더(롱·숏·레버리지 섞어서, 포지션 STOCKS.length+2개) · big = 4종목에 원금 수십억(긴 숫자, 1열로 금액까지 보이게)
   down = 전 종목 하락(어제·오늘 등락 전부 마이너스) · lockinv = 인버스 해금 전(1주차 처음 하는 플레이어 — 공매도·인버스 잠김)
   엔진 상태를 직접 바꾸므로 이 판의 결과는 의미 없다 */
function applyScenario(){
  const q = new URLSearchParams(location.search).get('scenario');
  if(!q || !run) return;
  const list = q === 'full' ? ['nine', 'hand', 'long'] : q.split(',');
  if(list.indexOf('nine') >= 0 || list.indexOf('multi') >= 0){
    run.cash = 300000;
    STOCKS.slice(0, 9).forEach((st, i) => {
      openPosition(st.id, 1000 + i * 300, i % 4 === 3 ? 2 : 1, i === 8 ? -1 : 1, true);
      assets[st.id].price *= 1 + ((i % 3) - 1) * 0.045;
      assets[st.id].lastDayChg = ((i % 5) - 2) * 0.017;
    });
    if(list.indexOf('multi') >= 0) openPosition(STOCKS[0].id, 800, 3, 1, true);
    STOCKS.slice(9).forEach((st, i) => { assets[st.id].lastDayChg = (i % 2 ? 1 : -1) * 0.021; });
    run.positions.forEach(p => { p.daysHeld = 1 + (p.id % 4); });
  }
  if(list.indexOf('all') >= 0 || list.indexOf('big') >= 0){
    const big = list.indexOf('big') >= 0, P = big ? 300000 : 1000;
    run.cash = big ? 9000000 : 300000;
    (big ? STOCKS.slice(0, 4) : STOCKS).forEach((st, i) => {
      openPosition(st.id, P + i * (big ? 41000 : 150), i % 4 === 3 ? 3 : i % 3 === 2 ? 2 : 1, i % 3 === 1 ? -1 : 1, true);
      assets[st.id].price *= 1 + ((i % 5) - 2) * 0.031;
      assets[st.id].lastDayChg = ((i % 5) - 2) * 0.017;
    });
    if(!big){ openPosition(STOCKS[0].id, 700, 2, 1, true); openPosition(STOCKS[1].id, 600, 1, -1, true); }
    run.positions.forEach(p => { p.daysHeld = 1 + (p.id % 6); });
  }
  if(list.indexOf('down') >= 0){
    STOCKS.forEach((st, i) => {
      const a = assets[st.id], f = 0.93 - (i % 4) * 0.012;
      a.lastDayChg = f - 1;
      a.history = a.history.map((v, k, h) => v * (1 + (h.length - 1 - k) * 0.004));   // 스파크라인도 내려가게
      a.price *= f; a.history[a.history.length - 1] = a.price;
    });
  }
  if(list.indexOf('lockinv') >= 0){ run.unlockBase = 1; run.round = 1; }
  if(list.indexOf('hand') >= 0){
    run.hand = ['stk_semi', 'stopLoss', 'hodl', 'credit', 'dove', 'stk_meme', 'takeProfit', 'yolo', 'hawk', 'pump'].slice(0, HAND_MAX).map(newCard);
    run.ap = Math.min(run.ap, 1);   // 몇 장은 행동력 부족으로 비활성
  }
  if(list.indexOf('long') >= 0) run.cash += 1234567 - netEquity();
  handSig = ''; posSig = '';
  renderAll();
}

