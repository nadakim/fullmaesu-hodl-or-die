/* 뉴스 전광판: 한 줄에 들어가면 멈춤, 넘치면 천천히 흐른다. 흔들림 끔 · 동작 줄이기면 흐르지 않고 줄바꿈 (데스크톱만) */
const NEWS_MARQUEE_SPEED = 32;   // 초당 --u 칸
function fitNews(){
  const box = $('newsBanner'), inner = box && box.firstElementChild;
  if(!inner || !box.clientWidth) return;   // 안 보이는 화면이면 다음에
  let mode = '';
  if(!isMobileLayout()){
    box.classList.remove('wrap');   // 한 줄 길이로 잰다
    const over = inner.scrollWidth - box.clientWidth + 16 * uiScale;
    if(over > 16 * uiScale){
      mode = isMotionReduced() ? 'wrap' : 'marquee';
      const shift = (-over) + 'px', dur = Math.max(6, over / (NEWS_MARQUEE_SPEED * uiScale) / 0.7).toFixed(1) + 's';
      if(box.style.getPropertyValue('--mq-shift') !== shift) box.style.setProperty('--mq-shift', shift);
      if(box.style.getPropertyValue('--mq-dur') !== dur) box.style.setProperty('--mq-dur', dur);
    }
  }
  box.classList.toggle('wrap', mode === 'wrap');
  box.classList.toggle('marquee', mode === 'marquee');
}
new MutationObserver(() => fitNews()).observe(document.getElementById('newsText'), { childList: true, characterData: true, subtree: true });

/* 유물 없음 안내: 칸이 좁아 한 줄에 안 들어가면 짧은 문구 */
const RELIC_EMPTY_TEXT = '없음 — 매주 결산 보상이나 암시장에서 얻는다', RELIC_EMPTY_SHORT = '유물 없음';
function fitRelicEmpty(){
  const el = document.querySelector('#relicBar .relic-empty');
  if(!el || !$('relicBar').clientWidth) return;
  el.textContent = RELIC_EMPTY_TEXT;
  const bar = $('relicBar');
  if(bar.scrollWidth > bar.clientWidth + 1) el.textContent = RELIC_EMPTY_SHORT;
}

const cc = document.getElementById('candlestickChart');
const cctx = cc.getContext('2d', {antialias: false});

/* (S7-15) 차트 데이터: 'day' = 오늘 장 캔들(개장 때 비움, 전일 종가 기준선) · 'daily' = 일봉 */
function chartSeries(target, mode){
  const isIdx = target === 'idx', a = isIdx ? null : assets[target];
  if(mode === 'daily'){
    const d = isIdx ? idxDay.daily : a.daily;
    if(d.length) return { data: d.slice(-DAILY_SLOTS), slots: DAILY_SLOTS, ref: 0 };
  }
  const cs = isIdx ? idxDay.candles : a.dayCandles, prev = isIdx ? idxDay.prevClose : a.prevClose;
  return { data: cs.length ? cs : [{ open: prev, close: prev, high: prev, low: prev, gap: 0 }], slots: TICKS_PER_DAY, ref: prev };
}
const DAILY_SLOTS = 20;   // 일봉 탭에 보이는 날 수
function renderChart(series){
  if(!cc.clientWidth) return;
  const dpr = window.devicePixelRatio || 1;
  const k = Math.max(1, Math.round(uiScale * dpr));   // 기준 1px = 실제 픽셀 수 (배율 × 화면 밀도, 정수로 반올림해 픽셀이 고르게)
  cc.width  = Math.floor(cc.clientWidth * dpr);   // 내부 해상도 = 화면 크기 × 밀도
  cc.height = Math.floor(cc.clientHeight * dpr);
  cctx.imageSmoothingEnabled = false;
  cctx.fillStyle = '#000';
  cctx.fillRect(0,0,cc.width,cc.height);
  drawCandles(cctx, cc.width, cc.height, series.data, k, { slots: series.slots, grid: true, priceLine: true, refLine: series.ref, geom: chartGeom });
}

/* 캔들 그리기 (메인 차트 · 타이틀 배경 공용). data를 slots칸에 왼쪽부터, offsetX(px)만큼 왼쪽으로 밀어서 그린다.
   o.minP·o.maxP를 주면 그 범위로(타이틀: 부드럽게 따라가는 범위), 없으면 data의 고가·저가 ±2% */
function drawCandles(ctx, W, H, data, k, o){
  if(o.grid){
    ctx.fillStyle = 'rgba(26,34,64,0.8)';
    for(let x=0;x<W;x+=6*k){
      for(let y=0;y<H;y+=6*k){
        ctx.fillRect(x,y,k,k);
      }
    }
    ctx.fillStyle = '#1a2240';
    for(let i=1;i<4;i++){
      const y = Math.round((H/4)*i);
      ctx.fillRect(0,y,W,k);
    }
  }
  if(data.length===0) return;

  const refs = o.refLine ? [o.refLine] : [];   // (S7-15) 전일 종가 기준선도 화면 안에 들어오게
  const maxP = o.maxP !== undefined ? o.maxP : Math.max(...data.map(c=>c.high), ...refs)*1.02;
  const minP = o.minP !== undefined ? o.minP : Math.min(...data.map(c=>c.low), ...refs)*0.98;
  const range = maxP-minP||1;
  const offsetX = o.offsetX || 0;

  const stepX  = W/o.slots;
  const candleW = o.candleW || Math.max(2*k, Math.floor(stepX*0.55));
  const scaleY = v => Math.round(H - ((v-minP)/range)*(H-16*k) - 8*k);

  data.forEach((c,i) => {
    const cx = Math.round(i*stepX + stepX/2 - candleW/2 - offsetX);
    if(cx + candleW < -8*k || cx > W + 8*k) return;
    const openY  = scaleY(c.open);
    const closeY = scaleY(c.close);
    const highY  = scaleY(c.high);
    const lowY   = scaleY(c.low);
    const isUp   = c.close >= c.open;
    if(o.geom && i === data.length - 1){ o.geom.x = (cx + candleW / 2) / W; o.geom.y = highY / H; }   // (B5) 로켓이 뿜어 나올 자리

    const col    = isUp ? '#00ff41' : '#ff1a3c';
    const shadow = isUp ? '#003a14' : '#3a000e';

    ctx.fillStyle = col;
    ctx.fillRect(cx + Math.floor(candleW/2), highY, k, lowY-highY);

    const bodyTop = Math.min(openY,closeY);
    const bodyH   = Math.max(2*k, Math.abs(openY-closeY));
    ctx.fillStyle = shadow;
    ctx.fillRect(cx+2*k, bodyTop+2*k, candleW, bodyH);

    ctx.fillStyle = col;
    ctx.fillRect(cx, bodyTop, candleW, bodyH);

    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.fillRect(cx, bodyTop, candleW, k);

    if(c.gap){   // 갭 캔들: 금색 테두리 + GAP 라벨 (상승 갭은 위, 하락 갭은 아래)
      const bx = cx - 3*k, by = highY - 3*k, bw = candleW + 6*k, bh = lowY - highY + 6*k, t = 2*k;
      ctx.fillStyle = '#ffd700';
      ctx.fillRect(bx, by, bw, t); ctx.fillRect(bx, by + bh - t, bw, t);
      ctx.fillRect(bx, by, t, bh); ctx.fillRect(bx + bw - t, by, t, bh);
      ctx.font = `${8 * k}px "Press Start 2P", "GP8", monospace`;
      ctx.textAlign = 'center';
      const lx = bx - 16*k >= 14*k ? bx - 16*k : bx + bw + 16*k;   // 갭 캔들 왼쪽 (자리가 없으면 오른쪽), 세로는 가운데
      const ly = Math.min(H - 4*k, Math.max(12*k, Math.round(by + bh / 2) + 4*k));
      ctx.fillStyle = '#000';
      ctx.fillText('GAP', lx + k, ly + k);
      ctx.fillStyle = '#ffd700';
      ctx.fillText('GAP', lx, ly);
      ctx.textAlign = 'left';
    }
  });

  if(o.refLine){   // 전일 종가: 회색 긴 점선 + '어제 종가' 표시
    const ry = scaleY(o.refLine);
    ctx.fillStyle = '#8a96c4';
    for(let x=0;x<W;x+=8*k) ctx.fillRect(x,ry,4*k,k);
    ctx.font = `${8 * k}px "Press Start 2P", "GP8", monospace`;
    ctx.textAlign = 'right';
    ctx.fillText('어제 종가', W - 4*k, Math.max(22*k, ry - 3*k));   // 오른쪽 (왼쪽 위는 차트 제목)
    ctx.textAlign = 'left';
  }
  if(o.priceLine && data.length){
    const py = scaleY(data[data.length-1].close);
    ctx.fillStyle = '#00e5ff';
    for(let x=0;x<W;x+=4*k) ctx.fillRect(x,py,2*k,k);
  }
}

