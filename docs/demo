.toast.good{color:var(--green);box-shadow:0 0 0 2px var(--green2),3px 3px 0 #000;}
.toast.warn{color:var(--gold);box-shadow:0 0 0 2px var(--gold2),3px 3px 0 #000;}
@keyframes toastIn{0%{opacity:0;transform:translateY(-6px);}8%{opacity:1;transform:none;}85%{opacity:1;}100%{opacity:0;}}

.overlay{
