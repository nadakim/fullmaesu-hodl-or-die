}

/* (S8-33) 암시장 호버: 카드·팩·유물에 올리면 "띠잉~" (5음계 중 하나, 연출용 Math.random) */
let shopHoverEl = null, shopHoverAt = 0;
$('shopBox').addEventListener('mouseover', e => {
