    weeksCleared: 0, lastWeek: null, endCause: '',
    positions: [], nextPosId: 1, nextUid: 1,
    masterDeck: STARTER_DECK.slice(), drawPile: [], hand: [], discard: [], exhausted: [],
    ap: AP_PER_DAY,
