});

/* ── 유물 ── */
function relicTile(r, o){
  return `<div class="relic-tile ${r.rarity} ${o.cls || ''}" ${o.attrs || ''}>
    <div class="rt-icon">${r.icon}</div><div class="rt-name">${r.name}</div>
    <div class="c-rar ${r.rarity}">${RARITY_LABEL[r.rarity]}</div>
    <div class="rt-desc">${r.desc}</div><div class="rt-flavor">${r.flavor}</div>
    ${o.extra || ''}</div>`;
}

function renderRelics(){
  if(relicTipId && !hasRelic(relicTipId)) relicTipId = '';
  const sig = run.relics.join() + '|' + relicTipId;
  if(sig === relicSig) return;
  relicSig = sig;
  $('relicBar').innerHTML = '<span class="relic-label">▌ 유물</span>' + (run.relics.length
    ? run.relics.map(id => { const r = RELIC_BY_ID[id];
        return `<button class="relic ${r.rarity} ${id === relicTipId ? 'on' : ''}" data-relic="${id}" title="${r.name}" aria-label="${r.name}">${r.icon}</button>`; }).join('')
    : '<span class="relic-empty">없음 — 매주 결산 보상이나 암시장에서 얻는다</span>');
  const tip = $('relicTip');
  if(relicTipId){
    const r = RELIC_BY_ID[relicTipId];
    tip.innerHTML = `<b>${r.icon} ${r.name}</b> <span class="c-rar ${r.rarity}">${RARITY_LABEL[r.rarity]}</span><br>${r.desc}<i>${r.flavor}</i>`;
    tip.hidden = false;
  } else tip.hidden = true;
}

$('relicBar').addEventListener('click', e => {
  const b = e.target.closest('[data-relic]');
  if(!b) return;
  relicTipId = relicTipId === b.dataset.relic ? '' : b.dataset.relic;   // 다시 누르면 닫힘
  renderRelics();
});

