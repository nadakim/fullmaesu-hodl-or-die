  if(overlayOpen || currentTab !== 'play'){ setTimeout(() => whenFxIdle(showNextUnlock), 300); return; }   // 보스 경보·다른 창이 먼저
  const u = UNLOCK_INTRO[unlockQueue.shift()];
  showOverlay(`
    <div class="result-kicker">WEEK ${run.round} · 새 시스템 해금</div>
    <div class="ov-title" style="color:var(--gold)">${u.title}</div>
    <div class="unlock-lines">${u.lines.map(l => `<p>${l}</p>`).join('')}</div>
    <button class="btn-chunky ov-btn" data-act="unlockNext">▶ ${unlockQueue.length ? '다음' : '확인'}</button>`);
  Sound.play('rareDraw');
}

function switchTab(s){
  if(s === 'shop' && !shopOpenNow()){ toast(SHOP_REJECT_TEXT.phase, 'warn'); return; }
  // TR룸·암시장을 떠날 때는 그 화면의 알림을 지운다 (암시장 알림이 TR룸 차트 위에 남지 않게)
  if(s !== currentTab && (currentTab === 'play' || currentTab === 'shop')) clearToasts();
  const wasTitle = currentTab === 'title', prevTab = currentTab;
  currentTab = s;  // 게임 화면이 아니면 시장이 멈춘다
  closeMenu();
  screens.forEach(x => x.classList.toggle('active', x.id === 'screen-' + s));
  if(s === 'title') enterTitle(); else if(wasTitle) leaveTitle();
  if(s === 'play'){
    if(!run || (run.phase === 'over' && !overlayOpen)) startRun();
    renderAll();
  }
  if(s === 'shop'){ renderShop(); if(prevTab !== 'shop') enterShopHaze(); }
  if(s === 'records') buildRecords();
  if(s === 'settings'){ $('settingsBack').textContent = settingsReturn === 'play' ? '◀ TR룸' : '◀ 타이틀'; buildSettings(); }
  if(s === 'play' && run && run.pendingTip && !overlayOpen) showTipOverlay();
  renderNav();
  syncOverlay();
  updateMusic();
  fitActiveScreen();
}

