/* 팩 구성 팝업 — 확률은 엔진 packRarityOdds()·packCardOdds() 결과를 그대로 표시 (화면에서 다시 계산하지 않는다).
   제외 카드 = 팩 구성 후보 중 packPool()에 없는 것 (덱에 이미 있음 · 신화 한도) — 확률 없이 흐리게만 */
function showPackInfo(packId){
  const pk = SHOP_PACK_BY_ID[packId];
  const rOdds = packRarityOdds(pk), cOdds = packCardOdds(pk), pool = packPool(pk);
  const rChance = r => { const o = rOdds.find(x => x.rarity === r); return o ? o.chance : 0; };
  const cands = (pk.pool.length ? pk.pool : CARDS.map(c => c.id))
    .filter(id => CARD_BY_ID[id] && CARD_BY_ID[id].type !== 'status' && pk.weights[CARD_BY_ID[id].rarity] > 0);
  const out = cands.filter(id => pool.indexOf(id) < 0);
  const price = packPrice(pk), affordable = run.slush >= price && pool.length > 0;
  const bars = RARITIES.map(r => `<div class="pki-bar ${r} ${rChance(r) > 0 ? '' : 'zero'}"><span class="c-rar ${r}">${RARITY_LABEL[r]}</span>
      <span class="track"><i style="width:${(rChance(r) * 100).toFixed(2)}%"></i></span><span class="pct">${fmtChance(rChance(r))}</span></div>`).join('');
  const groups = RARITIES.map(r => {
    const inPool = cOdds.filter(o => CARD_BY_ID[o.cardId].rarity === r).sort((a, b) => CARD_ORDER[a.cardId] - CARD_ORDER[b.cardId]);
    const excl = sortedCardIds(out.filter(id => CARD_BY_ID[id].rarity === r));
    if(!inPool.length && !excl.length) return '';
    return `<span class="pki-sec"><span class="c-rar ${r}">${RARITY_LABEL[r]}</span> · ${fmtChance(rChance(r))}${inPool.length ? ` ÷ ${inPool.length}종` : ' (남은 카드 없음)'}</span>
      <div class="pki-grid">${inPool.map(o => `<div class="pki-card" data-pki-card="${o.cardId}"><div class="mini">${cardHtml(CARD_BY_ID[o.cardId], {})}</div><span class="odds">${fmtChance(o.chance)}</span></div>`).join('')}
        ${excl.map(id => `<div class="pki-card out" data-pki-out="${id}"><div class="mini">${cardHtml(CARD_BY_ID[id], {})}</div><span class="odds">${inDeck(id) ? '보유 중(제외)' : '신화 한도(제외)'}</span></div>`).join('')}</div>`;
  }).join('');
  const total = cOdds.reduce((sum, o) => sum + o.chance, 0);
  showOverlay(`
    <div class="pki-head"><span class="pk-icon">${pk.icon}</span><div><div class="pki-name">${pk.name}</div><div class="pki-price">${fmtPrice2(price, 'pack')}</div><div class="pki-desc">${pk.desc}</div></div></div>
    <span class="pki-sec">▌ 등급별 확률 (등급 먼저 → 등급 안에서 균등)</span>
    <div class="pki-bars">${bars}</div>
    <span class="pki-sec">▌ 구성 카드 ${cOdds.length}종 · 확률 합 ${fmtChance(total)}</span>
    ${out.length ? `<div class="pki-note">흐린 카드 ${out.length}장은 덱에 이미 있거나(신화는 덱에 ${MYTHIC_DECK_LIMIT}장까지) 이번엔 나오지 않아 확률 계산에서 빠져 있습니다.</div>` : ''}
    ${pool.length ? groups : '<div class="pki-note">덱에 없는 카드가 남지 않아 지금은 살 수 없습니다.</div>'}
    <div class="pki-btns">
      <button class="ov-btn" data-pack-buy="${pk.id}" ${affordable ? '' : 'disabled'}>${pool.length ? (run.slush >= price ? `구매 ${fmtSlush(price)}` : `비자금 부족 (${fmtSlush(price)})`) : '살 수 없음'}</button>
      <button class="ov-btn alt" data-act="close">닫기</button>
    </div>`);
}

/* 진열 새로고침 버튼: 지금 가격 + 다음 두 단계 (엔진 rerollCost 그대로). 비자금 부족·새로 뽑을 게 없으면 비활성 */
let shopFlipIn = '';   // 방금 새로고침한 종류 — 그 진열만 뒤집히며 나타난다 (한 번 그리면 지운다)
/* 암시장 유물 칸마다 등급 확률 — 엔진 relicShopOdds() 값을 그대로 (보유 유물을 뺀 남은 등급으로 다시 나눈 값) */
function relicOddsHtml(){
  const odds = relicShopOdds();
  return odds.length ? `<div class="shop-note relic-odds">칸마다 등급 확률: ${odds.map(o => `<span class="c-rar ${o.rarity}" title="남은 ${RARITY_LABEL[o.rarity]} 유물 ${o.count}개 중 균등">${RARITY_LABEL[o.rarity]} ${fmtChance(o.chance)}</span>`).join(' · ')}</div>` : '';
}
function rerollBoxHtml(kind){
  const n = run.shop.rerolls[kind], cost = rerollCost(kind, n), can = rerollAvailable(kind);
  return `<span class="reroll-box"><button class="reroll-btn" data-reroll="${kind}" ${can && run.slush >= cost ? '' : 'disabled'}
      title="${can ? '' : kind === 'relic' ? '새로 들여올 유물이 없습니다' : '새로 뽑을 칸·카드가 없습니다'}">🔄 새로고침 <b id="rrCost-${kind}">${fmtSlush(cost)}</b></button>
    <span class="reroll-next">다음 ${rerollCost(kind, n + 1).toLocaleString()} → ${rerollCost(kind, n + 2).toLocaleString()}</span></span>`;
}
function doReroll(kind){
  if(!rerollAvailable(kind) || run.slush < shopRerollCost(kind)) return;
  const before = shopRerollCost(kind);
  const olds = kind === 'single'   // 안 산 칸만 뒤집혀 사라지고 (산 칸은 그대로)
    ? [...document.querySelectorAll('#shopBox .shop-singles .shop-item')].filter((_, i) => run.shop.singlesBought.indexOf(i) < 0).map(it => it.firstElementChild)
    : [...document.querySelectorAll('#shopBox .relic-row .relic-tile')];
  olds.forEach(el => el && el.classList.add('rr-out'));
  setTimeout(() => {
    if(!rerollShop(kind)) { renderShop(); return; }
    shopFlipIn = kind;
    renderShop(); renderNav();
    shopFlipIn = '';
    Fx.punch($('rrCost-' + kind), -(shopRerollCost(kind) - before), 0.7);   // 다음 가격이 튀어 오르며 갱신
  }, 220);
}

function renderShop(){
