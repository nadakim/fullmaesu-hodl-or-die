/* ══ 스크롤 없는 화면 (UI 전용): 칸보다 내용이 길면 쪽으로 나눈다 ══
   host = 높이가 정해진 칸(오버레이 상자 · 데스크톱 화면). 제목·필터·버튼(PG_KEEP)은 매 쪽에 남기고, 나머지 블록을 칸 높이에 맞춰 쪽으로 나눈다.
   블록이 칸 높이의 절반보다 크면 그 안의 자식(카드 격자·목록 행·통계 칸)으로 내려가서 나눈다 (카드·.pg-atom은 쪼개지 않음).
   쪽 넘김 = ◀ n/N ▶ 막대(.pg-bar, 클릭). 내용이 들어가면 아무것도 하지 않는다. 다시 그려도 지금 쪽(host.dataset.pg)을 유지 */
const PG_KEEP = '#overlayBox > .ov-title,#overlayBox .result-kicker,#overlayBox .ov-btn,#overlayBox .ov-btns,#overlayBox [data-act="close"],.gloss > .ov-title,.pg-keep,.pg-bar,.coll-filter,.shop-title,.shop-sub,.shop-bar,.coll-head,.deck-tabs';
const PG_HEAD = '.section-label,.shop-sec-head,.pile-title,.stat-caption';
function fitPages(host, opts){
  if(!host) return;
  opts = opts || {};
  host.querySelectorAll('.pg-hide').forEach(e => e.classList.remove('pg-hide'));
  host.querySelectorAll('.pg-bar').forEach(e => e.remove());
  const over = () => host.scrollHeight - host.clientHeight > 1;
  if(!host.clientHeight || !over()){ host.dataset.pg = '0'; return; }
  const H = host.clientHeight, blocks = [], wraps = [];
  const keepBox = c => host.id === 'overlayBox' && !!c.querySelector('.ov-btn,[data-act="close"]') && !c.querySelector('.card');   // 오버레이 버튼 묶음(예: 팩 팝업 구매·닫기)도 매 쪽에
  const skip = c => c.matches(PG_KEEP) || keepBox(c) || /^(none|contents)$/.test(getComputedStyle(c).display) || /absolute|fixed/.test(getComputedStyle(c).position);
  const collect = el => [...el.children].forEach(c => {
    if(skip(c)) return;
    if(c.getBoundingClientRect().height > H * 0.5 && c.children.length >= 1 && !c.matches('.card,.pg-atom')){ wraps.push(c); collect(c); }
    else blocks.push(c);
  });
  collect(host);
  if(blocks.length < 2) return;
  const bar = document.createElement('div');
  bar.className = 'pg-bar';
  bar.innerHTML = '<button data-pg="-1" aria-label="이전 쪽">◀</button><span class="pg-n"></span><button data-pg="1" aria-label="다음 쪽">▶</button>';
  bar._host = host;
  const firstBtn = [...host.children].find(c => c.matches('.ov-btn,.ov-btns'));
  host.insertBefore(bar, firstBtn || null);
  // 쪽 나누기는 요청한 쪽과 무관하게 한 번만 정한다 — 같은 줄(격자 한 줄)의 블록은 한 묶음, 묶음을 하나씩 더해 보며 칸에 들어가는 만큼 한 쪽
  const rs = blocks.map(b => b.getBoundingClientRect()), groups = [];
  blocks.forEach((b, i) => { const g = groups[groups.length - 1]; if(g && Math.abs(rs[g[0]].top - rs[i].top) < 1 && blocks[g[0]].parentElement === b.parentElement) g.push(i); else groups.push([i]); });
  const pageOf = new Array(blocks.length).fill(0);
  const show = pg => {
    blocks.forEach((b, i) => b.classList.toggle('pg-hide', pageOf[i] !== pg));
    wraps.slice().reverse().forEach(w => w.classList.toggle('pg-hide', ![...w.children].some(c => !c.classList.contains('pg-hide') && !skip(c))));
  };
  let n = 0, g = 0;
  while(g < groups.length){
    let end = g;   // 이번 쪽 = groups[g..end]
    const set = (a, z) => { groups.forEach((gr, k) => { if(k >= a) gr.forEach(i => { pageOf[i] = k <= z ? n : -1; }); }); show(n); };   // 앞 쪽들은 그대로
    set(g, end);
    while(end + 1 < groups.length){ set(g, end + 1); if(over()){ set(g, end); break; } end++; }
    const head = groups[end].every(i => blocks[i].matches(PG_HEAD));
    if(head && end > g && end + 1 < groups.length) end--;   // 소제목이 쪽 끝에 홀로 남지 않게
    groups.forEach((gr, k) => { if(k >= g && k <= end) gr.forEach(i => { pageOf[i] = n; }); });
    n++; g = end + 1;
  }
  groups.forEach((gr, k) => gr.forEach(i => { if(pageOf[i] < 0) pageOf[i] = n - 1; }));
  const page = Math.max(0, Math.min(n - 1, opts.page !== undefined ? opts.page : (+host.dataset.pg || 0)));
  show(page);
  bar.querySelector('.pg-n').textContent = `${page + 1}/${n}`;
  bar.querySelector('[data-pg="-1"]').disabled = page === 0;
  bar.querySelector('[data-pg="1"]').disabled = page === n - 1;
  bar.dataset.n = n;
  host.dataset.pg = String(page);
}
document.addEventListener('click', e => {
  const b = e.target.closest('.pg-bar [data-pg]');
  if(!b || b.disabled) return;
  const host = b.closest('.pg-bar')._host;
  fitPages(host, { page: (+host.dataset.pg || 0) + (+b.dataset.pg) });
});
/* 쪽으로 나뉜 칸에서 요소가 가려져 있으면 그 요소가 있는 쪽으로 넘긴다 (클릭 전용 조작·자동 점검 공용) */
function revealPaged(t){
  const el = typeof t === 'string' ? document.querySelector(t) : t;
  if(!el) return false;
  if(!el.closest('.pg-hide')) return true;
  let host = el.parentElement;
  while(host && ![...host.children].some(c => c.classList.contains('pg-bar'))) host = host.parentElement;
  if(!host) return false;
  const n = +[...host.children].find(c => c.classList.contains('pg-bar')).dataset.n || 1;
  for(let pg = 0; pg < n; pg++){ fitPages(host, { page: pg }); if(!el.closest('.pg-hide')) return true; }
  return false;
}
