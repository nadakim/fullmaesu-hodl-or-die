let amtCtx = null;
const AMT_QUICK = [0.1, 0.25, 0.5, 1];
function showAmountPicker(idx){
  const card = CARD_BY_ID[run.hand[idx].id], s = STOCK_BY_ID[card.base.slice(4)], max = stockMaxAmount();
  if(max < STOCK_BUY_MIN){ toast('현금이 부족합니다', 'bad'); return; }
  amtCtx = { idx, stockId: s.id, max, amount: Math.min(s.cost, max) };
  const pm = run.pending, tags = [pm.lev > 1 ? `레버리지 ${pm.lev}x` : '', pm.dir < 0 ? '공매도' : '', pm.principalMult > 1 ? `영끌 원금 ×${pm.principalMult}` : ''].filter(Boolean);
  showOverlay(`
    <div class="ov-title" style="color:var(--gold)">${s.name} 매수 금액</div>
    <div class="ov-sub">현금 ${fmtMoney(run.cash)} · 기본 ${fmtMoney(s.cost)}${tags.length ? ' · ' + tags.join(' · ') : ''}</div>
    <div class="amt-box">
      <div class="amt-row"><input type="range" id="amtRange" min="${STOCK_BUY_MIN}" max="${max}" step="10" value="${amtCtx.amount}">
        <input type="number" id="amtNum" min="${STOCK_BUY_MIN}" max="${max}" step="10" value="${amtCtx.amount}"></div>
      <div class="amt-row">${AMT_QUICK.map(q => `<button class="btn-chunky sm amt-q" data-amt-q="${q}">${q === 1 ? '전액' : Math.round(q * 100) + '%'}</button>`).join('')}</div>
      <div class="amt-info" id="amtInfo"></div>
    </div>
    <button class="btn-chunky ov-btn" data-act="amtOk">▶ 매수 (Enter)</button>
    <button class="btn-chunky ov-btn alt" data-act="amtCancel">✕ 취소 (Esc)</button>`);
  updateAmountInfo();
  const n = $('amtNum'); if(n){ n.focus(); n.select(); }
}
function setAmount(v, from){
  if(!amtCtx) return;
  amtCtx.amount = Math.max(STOCK_BUY_MIN, Math.min(amtCtx.max, Math.round(+v || 0)));
  if(from !== 'range') $('amtRange').value = amtCtx.amount;
  if(from !== 'num') $('amtNum').value = amtCtx.amount;
  updateAmountInfo();
}
function updateAmountInfo(){
  const el = $('amtInfo'); if(!el || !amtCtx) return;
  const hp = hypotheticalBuy(amtCtx.stockId, amtCtx.amount), before = previewSettlement().mult, after = previewSettlement(hp).mult;
  el.innerHTML = `투입 원금 <b>${fmtMoney(hp.principal)}</b> · 노출액 <b>${fmtMoney(hp.entryExposure)}</b> · 남는 현금 <b>${fmtMoney(run.cash - hp.principal)}</b><br>
    정산 배수 <span class="n-mult">×${before.toFixed(2)}</span> → <b class="n-mult">×${after.toFixed(2)}</b> · 유리하게 1% 움직이면 <b>${fmtSigned(hp.entryExposure * 0.01 * settleSteps(hp, 1).mult)}</b>`;
}
function confirmAmount(){
  if(!amtCtx) return;
  const c = amtCtx; amtCtx = null;
  hideOverlay();
  playCardFx(c.idx, null, { amount: c.amount });
}
function cancelAmount(){ amtCtx = null; hideOverlay(); renderAll(); }
