#screen-shop::before{background:var(--purple);opacity:.07;}
#screen-shop::after{opacity:.09;   /* 보라 벨벳 체크 (hard-stop 체커보드) — 안개처럼 천천히 흐른다 */
  background-image:conic-gradient(var(--purple) 25%, transparent 0 50%, var(--purple) 0 75%, transparent 0);
  background-size:calc(16 * var(--u)) calc(16 * var(--u));animation:hazeDrift 14s steps(28) infinite;}
