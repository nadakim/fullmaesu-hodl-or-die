/* 포지션 배지 · 예약주문 태그 */
.lev-badge{font-size:6px;font-family:'Press Start 2P','Galmuri-6px',monospace;padding:1px 3px;margin-left:5px;background:var(--gold2);color:#000;vertical-align:middle;}
.lev-badge.lev3{background:var(--red);color:var(--text);}
.lev-badge.short{background:var(--red2);color:var(--text);}
.o-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px;}
.o-tag{font-size:5.5px;font-family:'Press Start 2P','Galmuri-5_5px',monospace;padding:2px 3px;background:#000;box-shadow:0 0 0 1px var(--line);color:var(--muted);}
.o-tag.stop{color:var(--red);}
.o-tag.take{color:var(--green);}
.o-tag.trail{color:var(--cyan);}
.o-tag.hodl{color:var(--cyan);}
.o-tag.diamond{color:var(--gold);}
.ratio{font-size:6.5px;font-family:'Press Start 2P','Galmuri-6_5px',monospace;margin-top:4px;}
.ratio.safe{color:var(--gold);}
.ratio.danger{color:var(--red);animation:blink .6s step-end infinite;}
.positions-wrap{max-height:240px;}
.sell-btn:disabled{opacity:.35;cursor:not-allowed;transform:none;}

.toast-layer{
