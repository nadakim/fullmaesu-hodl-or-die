                   cause:w => `목표 미달 (달성률 ${Math.floor(w.pct * 100)}%).` },
  VICTORY:       { title:'개미 졸업!',             color:'var(--green)', group:'win', hint:`${MAX_ROUND}주 목표를 모두 달성`,
                   sub:`${MAX_ROUND}주 연속 목표 달성. 이제 당신이 세력입니다.`,
                   cause:() => '모든 주간 목표를 넘겼습니다.' }
};

/* 생존 주 수에 따른 등급 */
function antGrade(weeks){
  if(weeks >= MAX_ROUND) return '세력';
  if(weeks >= 6) return '고수 개미';
  if(weeks >= 3) return '중수 개미';
  if(weeks >= 1) return '주린이';
  return '1주 컷';
}

/* 이 브라우저에서 끝낸 판 수 ("개미 N회차") — 저장이 막혀 있으면 이번 세션만 센다 */
let antRunsFallback = 0;
function countFinishedRun(){
  let n = antRunsFallback + 1;
  try { n = (parseInt(localStorage.getItem('hodl.antRuns'), 10) || 0) + 1; localStorage.setItem('hodl.antRuns', String(n)); } catch(e) {}
  antRunsFallback = n;
  return n;
}

/* ── 파산 기록: 끝낸 판을 이 브라우저에 저장 (엔딩별 횟수 + 최근 판 목록) ──
   저장이 막혀 있으면(시크릿 모드 등) 이번 세션 동안만 메모리에 남긴다 */
const RECORDS_KEY = 'hodl.records';
const RECORDS_HISTORY = 30;   // 최근 판 목록 길이
const emptyRecords = () => ({ counts: {}, history: [], totals: { runs: 0, bestWeeks: 0, bestPeak: 0, liq: 0 } });
let recordsFallback = emptyRecords();
function loadRecords(){
  let r = null;
  try { r = JSON.parse(localStorage.getItem(RECORDS_KEY)); } catch(e) {}
  if(!r || !r.counts || !Array.isArray(r.history)) return recordsFallback;
  if(!r.totals){   // 누적 통계가 없던 옛 기록: 남아 있는 목록으로 채운다
    const h = r.history;
    r.totals = { runs: Object.keys(r.counts).reduce((s, k) => s + r.counts[k], 0),
      bestWeeks: h.reduce((m, x) => Math.max(m, x.weeks), 0), bestPeak: h.reduce((m, x) => Math.max(m, x.peak), 0),
      liq: h.reduce((s, x) => s + x.liq, 0) };
  }
  return r;
}
function saveRecords(r){
  recordsFallback = r;
  try { localStorage.setItem(RECORDS_KEY, JSON.stringify(r)); } catch(e) {}
}
/* 끝난 판 하나를 기록. 반환: 이번이 이 엔딩 첫 해금인지 */
function recordRun(n, cause){
  const r = loadRecords();
  const first = !r.counts[cause];
  r.counts[cause] = (r.counts[cause] || 0) + 1;
  const peak = Math.round(run.peakEquity);
  r.history.unshift({
    n, cause, round: run.round, day: run.day, weeks: run.weeksCleared,
    eq: Math.round(run.endEquity), peak, liq: run.liquidations,
    relics: run.relics.length, deck: run.masterDeck.length, at: Date.now(),
    boss: run.endBoss || '', bosses: run.bossesBeaten.length   // (S9) 사인 보스 · 격파한 보스 수
  });
  const t = r.totals;   // 목록(최근 30판)과 달리 전체 판 누적
  t.runs = Math.max(t.runs + 1, n);   // n = '개미 N회차' 카운터 (hodl.antRuns)
  t.bestWeeks = Math.max(t.bestWeeks, run.weeksCleared);
  t.bestPeak = Math.max(t.bestPeak, peak);
  t.liq += run.liquidations;
  if(r.history.length > RECORDS_HISTORY) r.history.length = RECORDS_HISTORY;
  saveRecords(r);
  return first;
}
function clearRecords(){
  saveRecords(emptyRecords());
  antRunsFallback = 0;
  try { localStorage.removeItem('hodl.antRuns'); } catch(e) {}
}

function statTile(label, value, cls){ return `<div class="${cls || ''}">${label}<b>${value}</b></div>`; }
const signCls = v => v >= 0 ? 'pnl-up' : 'pnl-down';

/* ══ 플레이테스트 킷 (docs/playtest/PROTOCOL.md) — ?playtest=1 또는 설정 '플레이테스트 모드'일 때만. 일반 모드는 화면에 아무것도 없다 (엔진 무변경) ══
   판 시작 때 시드를 정해 두고(setSeed — 같은 시드 = 같은 판 재현), 판이 끝나면 기록을 localStorage hodl.playtestLog에 쌓는다.
   게임오버·졸업 화면에 '📋 판 기록 복사'(사람이 읽는 요약 + JSON 한 줄). 설문(1~5점 3개 + 한 줄)은 주소에 ?playtest=1이 있을 때만 */
function playtestUrl(){ return /[?&]playtest=1(&|$)/.test(location.search); }   // 설문은 이 주소 파라미터일 때만
function playtestOn(){ return playtestUrl() || !!settings.playtest; }            // (함수 선언 — applySettings가 먼저 불러도 된다)
const PLAYTEST_LOG_KEY = 'hodl.playtestLog';
const PLAYTEST_LOG_MAX = 200;           // 기록 보관 판 수 (넘으면 오래된 것부터)
const PLAYTEST_SEED_MAX = 2147483647;
const PLAYTEST_NOTE_MAX = 120;          // 한 줄 후기 글자 수
const PLAYTEST_SURVEY = [   // 밈 톤이지만 뜻은 분명하게 (1 = 전혀, 5 = 매우)
  { key: 'fun',   q: () => '이번 판, 재미있었나?', lo: '떡락 (노잼)', hi: '떡상 (꿀잼)' },
  { key: 'fair',  q: win => win ? '이번 졸업, 납득되나? (실력이었나)' : '이번 파산, 납득되나? (억울하면 1)', lo: '억울함', hi: '인정' },
  { key: 'again', q: () => '바로 한 판 더 하고 싶나?', lo: '계좌 해지', hi: '당장 풀매수' }
];
let playtest = { sessionRuns: 0, seed: null, startedAt: 0, run: null, lastId: '' };
let playtestLogFallback = [];
function loadPlaytestLog(){
  try { const v = JSON.parse(localStorage.getItem(PLAYTEST_LOG_KEY)); if(Array.isArray(v)) return v; } catch(e) {}
  return playtestLogFallback;
}
function savePlaytestLog(list){
  playtestLogFallback = list;
  try { localStorage.setItem(PLAYTEST_LOG_KEY, JSON.stringify(list)); } catch(e) {}
}
function playtestBeforeRun(){   // startRun에서 startNewRun 바로 앞 (플레이테스트 모드일 때만 시드를 정한다)
  if(!playtestOn()) return;
  playtest.seed = Math.floor(Math.random() * PLAYTEST_SEED_MAX);
  setSeed(playtest.seed);
  playtest.startedAt = Date.now();
  playtest.sessionRuns++;
}
/* 유물 획득 주차: 이번 판 이벤트 로그를 따라가며 roundStart로 주차를 센다 (결산 보상·암시장 = 결산한 주) */
function relicWeeks(){
  const wk = {}; let round = 1;
  eventLog.forEach(e => { if(e.type === 'roundStart') round = e.data.round; else if(e.type === 'relicGained' && !(e.data.id in wk)) wk[e.data.id] = round; });
  return wk;
}
function playtestRecord(){
  const wk = relicWeeks(), own = playtest.run === run;
  return {
    id: Date.now().toString(36) + '-' + Math.floor(Math.random() * 1e6).toString(36),
    version: GAME_META.version, game: GAME_TITLE.en, date: new Date().toISOString(),
    sessionRun: own ? playtest.sessionRuns : 0, seed: own ? playtest.seed : null,
    endWeek: run.round, endDay: run.day, weeksCleared: run.weeksCleared,
    ending: run.endCause, endingTitle: (ENDINGS[run.endCause] || {}).title || run.endCause, deathBoss: run.endBoss || '',
    bossPlan: run.bossPlan || {}, bossesBeaten: (run.bossesBeaten || []).slice(),
    endEquity: Math.round(run.endEquity), peakEquity: Math.round(run.peakEquity), maxDayMult: +(run.maxSettleMult || 1).toFixed(2),
    relics: run.relics.map(id => ({ id, name: RELIC_BY_ID[id].name, week: wk[id] || 0 })), deckSize: run.masterDeck.length,
    playSec: own && playtest.startedAt ? Math.round((Date.now() - playtest.startedAt) / 1000) : null,
    settings: { speed: settings.speed, fxSpeed: settings.fxSpeed, chainFx: settings.chainFx, shake: settings.shake, uiSize: settings.uiSize, fontSize: settings.fontSize, window: innerWidth + 'x' + innerHeight },
    survey: null
  };
}
const fmtPlaySec = sec => sec === null ? '?' : `${Math.floor(sec / 60)}분 ${sec % 60}초`;
function playtestSummary(r){
  const boss = Object.keys(r.bossPlan).map(w => `${w}주 ${(BOSS_BY_ID[r.bossPlan[w]] || {}).name || r.bossPlan[w]}${r.bossesBeaten.indexOf(r.bossPlan[w]) >= 0 ? ' ✔' : r.endWeek > +w ? '' : r.endWeek === +w && r.ending !== 'VICTORY' ? ' ✘' : ' ·'}`).join(' / ');
  const sv = r.survey;
  return [
    `[${r.game} 플레이테스트] ${r.version} · 세션 ${r.sessionRun}판째 · 시드 ${r.seed === null ? '-' : r.seed}`,
    `결과: ${r.endingTitle} (WEEK ${r.endWeek} DAY ${r.endDay} · ${r.weeksCleared}주 통과)${r.deathBoss ? ` · 사인: ${(BOSS_BY_ID[r.deathBoss] || {}).name || r.deathBoss}` : ''}`,
    `보스: ${boss || '없음'}`,
    `순자산: 최종 ${formatKrw(r.endEquity)} · 최고 ${formatKrw(r.peakEquity)} · 하루 최대 배수 ×${r.maxDayMult}`,
    `유물: ${r.relics.length ? r.relics.map(x => `${x.name}(${x.week}주)`).join(', ') : '없음'} · 덱 ${r.deckSize}장`,
    `플레이 ${fmtPlaySec(r.playSec)} · 장중 속도 ${r.settings.speed}x · 연출 ${r.settings.fxSpeed} · 화면 ${r.settings.uiSize}/${r.settings.fontSize} · ${r.settings.window}`,
    sv ? `설문: 재미 ${sv.fun || '-'} · 납득 ${sv.fair || '-'} · 한 판 더 ${sv.again || '-'}${sv.note ? ` · "${sv.note}"` : ''}` : '설문: (안 함)'
  ].join('\n');
}
function playtestSaveRecord(rec){
  const list = loadPlaytestLog().concat([rec]);
  savePlaytestLog(list.slice(-PLAYTEST_LOG_MAX));
  playtest.lastId = rec.id;
}
function playtestCurrent(){ return loadPlaytestLog().find(r => r.id === playtest.lastId) || null; }
function playtestUpdate(fn){
  const list = loadPlaytestLog(), r = list.find(x => x.id === playtest.lastId);
  if(!r) return;
  fn(r);
  savePlaytestLog(list);
}
/* 클립보드 복사: navigator.clipboard가 막혀 있으면(사지방·http) 숨긴 textarea + execCommand. 마지막 복사 내용은 window.__playtestLastCopy (테스트용) */
function copyText(text){
  window.__playtestLastCopy = text;
  const fallback = () => {
    const ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.left = '-9999px';
    document.body.appendChild(ta); ta.select();
    let ok = false; try { ok = document.execCommand('copy'); } catch(e) {}
    ta.remove();
    return ok;
  };
  const done = ok => toast(ok ? '📋 복사 완료 — 테스트 담당자에게 붙여 넣어 보내 주세요' : '복사가 막혀 있습니다. 아래 칸을 길게 눌러 직접 복사하세요', ok ? 'good' : 'warn');
  try {
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(text).then(() => done(true), () => done(fallback())); return; }
  } catch(e) {}
  done(fallback());
}
const playtestCopyOne = r => playtestSummary(r) + '\nJSON: ' + JSON.stringify(r);
function playtestCopyAll(){
  const list = loadPlaytestLog();
  if(!list.length){ toast('아직 기록된 판이 없습니다', 'info'); return; }
  copyText(`[${GAME_TITLE.en} 플레이테스트 전체 기록] ${list.length}판\n` + list.map(r => playtestSummary(r).split('\n').slice(0, 2).join(' | ')).join('\n') + '\n\nJSONL:\n' + list.map(r => JSON.stringify(r)).join('\n'));
}
function playtestBoxHtml(win){
  const r = playtestCurrent(), sv = (r && r.survey) || {};
  const q = PLAYTEST_SURVEY.map(x => `<div class="pt-q"><div class="pt-qt">${x.q(win)}</div>
    <div class="pt-scale"><span class="pt-lo">${x.lo}</span>${[1, 2, 3, 4, 5].map(v => `<button class="btn-chunky sm pt-v ${sv[x.key] === v ? 'on' : ''}" data-pt-q="${x.key}" data-pt-v="${v}">${v}</button>`).join('')}<span class="pt-hi">${x.hi}</span></div></div>`).join('');
  return `<div class="pt-wrap"><span class="px-tag">플레이테스트</span><div class="pt-box px-panel" id="ptBox">
    ${playtestUrl() ? `${q}<label class="pt-note">한 줄 후기 (리딩방에 남길 한마디)<input type="text" id="ptNote" maxlength="${PLAYTEST_NOTE_MAX}" value="${(sv.note || '').replace(/"/g, '&quot;')}" placeholder="예: 3주차 보스에서 털림. 곱하기 유물이 안 나옴"></label>` : ''}
    <button class="btn-chunky sm pt-copy" data-act="ptCopy">📋 판 기록 복사</button>
  </div></div>`;
}
function playtestSurvey(key, v){
  playtestUpdate(r => { r.survey = Object.assign({ fun: 0, fair: 0, again: 0, note: '' }, r.survey || {}); r.survey[key] = v; });
  document.querySelectorAll(`[data-pt-q="${key}"]`).forEach(b => b.classList.toggle('on', +b.dataset.ptV === v));
}
$('overlayBox').addEventListener('input', e => { if(e.target.id === 'ptNote') playtestNote(e.target.value); });
$('overlayBox').addEventListener('keydown', e => { if(e.target.id === 'ptNote') e.stopPropagation(); });   // 입력 중엔 Space·Enter 단축키 막기
function playtestNote(text){
  playtestUpdate(r => { r.survey = Object.assign({ fun: 0, fair: 0, again: 0, note: '' }, r.survey || {}); r.survey.note = text.slice(0, PLAYTEST_NOTE_MAX); });
}

function showRunOver(reason){
  overPending = false;
  updateMusic();   // desired → records (스팅어가 끝나면 이어서 튼다)
  const cause = run.endCause || reason, e = ENDINGS[cause], w = run.lastWeek;
  const n = countFinishedRun();
  const firstTime = recordRun(n, cause);
  if(playtestOn()) playtestSaveRecord(playtestRecord());   // (플레이테스트) 판 기록 누적
  const unlocked = Object.keys(loadRecords().counts).filter(k => ENDINGS[k]).length;
  const weeks = run.weeksCleared;
  showOverlay(`
    <div class="result-kicker">GAME OVER · WEEK ${run.round} DAY ${run.day}</div>
    <div class="ov-title ending-title" style="color:${e.color}" data-cause="${cause}">${e.title}</div>
    <div class="ov-sub">${e.sub}</div>
    <div class="ending-cause">${e.cause(w)}</div>
    ${run.endBoss ? `<div class="ending-badge ending-boss">🏴 사인: ${bossText(run.endBoss)} (WEEK ${run.round} ${BOSS_BY_ID[run.endBoss].final ? '최종 ' : ''}보스)</div>` : ''}
    <div class="ending-badge">${cause === 'VICTORY' ? `개미 ${n}회차 만에 졸업` : `당신은 이제 개미 ${n}회차`} · 등급: ${antGrade(weeks)}</div>
    ${firstTime ? `<div class="ending-badge ending-new">★ 새 엔딩 해금 · 파산 기록 ${unlocked} / ${Object.keys(ENDINGS).length}</div>` : ''}
    <div class="stat-grid">
      ${statTile('최종 순자산', `<span class="${signCls(run.endEquity - START_CASH)}">${fmtMoney(run.endEquity)}</span>`)}
      ${statTile('최고 순자산', fmtMoney(run.peakEquity))}
      ${statTile('생존 라운드', `${weeks} / ${MAX_ROUND}주`)}
      ${statTile('청산', run.liquidations + '회')}
      ${statTile('확정손익', `<span class="${signCls(run.realized)}">₩ ${fmtSigned(run.realized)}</span>`)}
      ${statTile('누적 이자', fmtMoney(run.interestPaid))}
      ${statTile('수익률 (시작 대비)', `<span class="${signCls(run.endEquity - START_CASH)}">${fmtPct(run.endEquity / START_CASH - 1)}</span>`)}
      ${statTile('덱 · 유물', `${run.masterDeck.length}장 · ${run.relics.length}개`)}
    </div>
    ${playtestOn() ? playtestBoxHtml(cause === 'VICTORY') : ''}
    <button class="btn-chunky ov-btn" data-act="restart">↺ 다시 시작</button>
    <button class="btn-chunky ov-btn alt" data-act="title">◀ 타이틀로</button>`);
  if(reason === 'VICTORY') cashRain();
}

/* ══ 장 마감 정산 무대 (S6, docs/design/JUICE_BIBLE.md §2) ══
   엔진이 이미 확정한 run.lastDay(= daySettled 기록)를 재생만 한다 — 계산·rand·상태 변경 없음.
   포지션 하나씩 → 유물·카드 단계가 왼쪽부터 차례로(더하기 "딩" / 곱하기 "슈욱—펑", 5음계로 한 칸씩 위) → 배수 불타기(×10·×100·×1,000·×10,000)
   → 크리티컬 릴 → 정산금 카운트업 → 동전이 순자산으로 → 순자산 "쾅" → 저음 "둥" → '▶ 다음 날'.
   세기는 이번 판 최고 정산 대비 비율(stageRatio), 작은 정산은 2배속 자동. 클릭·SPACE 한 번 = 빨리 감기, 두 번 = 결과로 */
const JUICE_CONFIG = {
  stageMs: { intro: 420, row: 300, step: 480, crit: 1100, count: 800, sum: 500, coins: 700, end: 420 },   // 1배속 기준 (ms)
  fireTiers: [[10000, 4], [1000, 3], [100, 2], [10, 1]],   // 누적 배수 → 불타기 단계
  smallRatio: 0.25,              // 이번 판 최고 정산의 이 비율 미만이면 '작은 정산' → 자동 배속
  smallSpeed: 2,                 // 작은 정산 배속
  plainStageMs: { intro: 120, rows: 360, count: 320, end: 200 },   // 간이 무대(보정 없는 날): 포지션 칩 전체 · 합계 카운트업 · 끝 "둥" 전 — 1배속 합 ≈ 1초
  plainCountSteps: 8,            // 간이 무대 합계 카운트업 칸 수
  plainHintRuns: 3,              // 간이 무대 '배수를 올려보세요' 힌트: 판마다 처음 이만큼만
  ffSpeed: 5,                    // 한 번 클릭 = 빨리 감기 배속
  maxRows: 4,                    // 포지션이 많으면 정산금 절댓값 상위 이만큼만 재생 (나머지는 합계 한 줄)
  pentatonic: [0, 2, 4, 7, 9],   // 장조 5음계 (반음) — 단계마다 한 칸씩 위
  maxOctaves: 2,                 // 2옥타브를 넘으면 한 옥타브 내려 다시 (셰퍼드 톤 흉내)
  coins: [6, 40],                // 동전 파티클 수 (최소, 최대 — 세기 비례)
  nextGuardMs: 400,              // 결과가 뜬 뒤 이 시간 동안 '▶ 다음 날'·엔터 무시
  fireShake: { 1: 0, 2: 1, 3: 2, 4: 3 },   // 불타기 단계별 흔들림
