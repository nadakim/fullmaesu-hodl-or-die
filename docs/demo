  $('marketStateTag').textContent = '■ NORMAL';
}

function onGameEvent(type, d){
  switch(type){
    case 'cardRejected': toast(REJECT_TEXT[d.reason] || d.reason, 'bad'); break;
    case 'bought':
      if(d.merged) toast(`${d.pos.name} ${posLabel(d.pos)} 추가 매수 +${Math.round(d.added).toLocaleString()}만 → 평단 ${fmtPrice(avgPrice(d.pos))}`, 'info');
      break;
    case 'cardPlayed':   if(d.card.type !== 'stock') toast('▶ ' + d.card.name, 'info'); break;
    case 'sold':
      showPopNum(fmtSigned(d.pnl), d.pnl >= 0);
      if(d.pnl > 500) cashRain();
      break;
    case 'soldAll':
      showPopNum('청산: ' + fmtSigned(d.pnl), d.pnl >= 0);
      if(d.pnl > 1000) cashRain();
      break;
    case 'orderFilled':
      toast(`${ORDER_LABEL[d.kind]} 체결 · ${d.pos.name} ${fmtSigned(d.pnl)}` + (d.bonus > 0 ? ` (상투 감별사 +${Math.round(d.bonus)}만)` : ''), d.pnl >= 0 ? 'good' : 'bad');
      showPopNum(fmtSigned(d.pnl), d.pnl >= 0);
      break;
    case 'marginCall':
      toast(`⚠ 반대매매! ${d.pos.name} ${posLabel(d.pos)} ${fmtSigned(d.pnl)} (` +
        (d.saved > 0 ? `📞 투매 손실 ${Math.round(d.saved)}만 면제` : `투매 −${Math.round(d.penalty)}만`) + ' · 트라우마 +1)', 'bad');
      if(d.refund > 0) toast(`🤝 손실 보전 약정: +${Math.round(d.refund)}만 환급 (※ 실제로는 불법)`, 'warn');
      flashLiquidation();
      break;
    case 'circuitBreak':
      toast(`🛑 서킷브레이커 발동! 개장 대비 −${pct(1 - d.eq / d.open)} — 오늘 장 조기 마감`, 'warn');
      $('newsText').textContent = '서킷브레이커 발동 — 매매 거래 일시 중단';
      break;
    case 'gapOpen':
      toast(`📉 작전 세력 이탈: ${STOCK_BY_ID[d.stockId].name} 개장 직후 ${Math.round(d.pct * 100)}% 갭`, 'bad');
      break;
    case 'valueGodPaid':
      toast(`📜 가치투자의 신: 장기 보유 배당 +${Math.round(d.amount)}만`, 'good');
      break;
    case 'reshuffle': toast('버린 카드를 섞어 새 덱으로', 'info'); break;
    case 'dayStart':
      if(d.day > 1) toast(`WEEK ${d.round} · DAY ${d.day} 장전 — 카드를 쓰고 장을 여세요`, 'info');
      if(d.buyBan) toast('☎ 오늘은 "투자주의 계좌" — 신규 매수 금지', 'bad');
      break;
    case 'marketOpen':
      toast('▶ 장 시작!', 'good');
      if(d.marketCard){
        const [news, kind] = MARKET_CARD_NEWS[d.marketCard][d.outcome];
        $('newsText').textContent = news;
        toast(`${CARD_BY_ID[d.marketCard].name} → ${STATE_LABEL[d.outcome]}`, kind);
      }
      if(d.forcedState) $('marketStateTag').textContent = '■ ' + d.forcedState;
      if(d.reverting){
        if(!d.marketCard) $('newsText').textContent = '어제 급등락에 차익실현 매물 출회… 개장 초반 되돌림';
        toast('📉 차익실현 매물 — 개장 초반 되돌림', 'warn');
      }
      d.pumps.forEach(pm => toast(pm.dir > 0 ? `📈 ${pm.name} 작전 성공! 급등 중` : `📉 ${pm.name} 설거지 당함! 급락 중`, pm.dir > 0 ? 'good' : 'bad'));
      break;
    case 'dayEnd':
      if(d.waived) toast('장 마감 · 오늘 이자 면제', 'good');
      else if(d.interest > 0.5) toast(`장 마감 · 이자 −${Math.round(d.interest).toLocaleString()}만` + (d.discounted ? ' (🏦 VVIP 할인)' : ''), 'warn');
      break;
    case 'event':
      $('newsText').textContent = d.text;
      $('marketStateTag').textContent = '■ ' + d.state;
      break;
    case 'eventEnd': resetNews(); break;
    case 'fssRaised':
      if(d.warn) toast('☎ 금감원: "최근 거래 패턴을 살펴보고 있습니다"', 'warn');
      break;
    case 'fssSanction':
      showOverlay(`
        <div class="ov-title" style="color:var(--red)">☎ 금감원에서 전화가 왔습니다</div>
        <div class="ov-sub">"고객님 계좌에서 시세조종이 의심되는 거래가 반복적으로 확인되어 연락드렸습니다."</div>
        <div class="fss-verdict">${d.kind === 'fine'
          ? `과징금 <b>−${fmtMoney(d.amount)}</b><br><small>순자산의 ${pct(FSS_FINE_PCT)}. 리딩방 회비보다는 쌉니다.</small>`
          : d.kind === 'ban'
          ? `내일 하루 <b>신규 매수 금지</b><br><small>"투자주의 계좌" 지정. 보유 종목은 팔 수 있습니다.</small>`
          : `<b>${d.pos.name} ${posLabel(d.pos)}</b> 강제 청산 ${fmtSigned(d.pnl)}<br><small>보유 중 가장 큰 포지션. "증거 보전 차원입니다."</small>`}</div>
        <div class="ov-sub">감시 게이지는 0으로 돌아갑니다. 당분간 조용히 지내세요.</div>
        <button class="ov-btn" data-act="close">…네, 알겠습니다</button>`);
      break;
    case 'roundClear': lastRoundClear = d; showRoundResult(d); break;
    case 'rewardChosen':   // 보상이 끝나면 암시장으로 넘어가므로 거기서 보여준다
      pendingRewardToasts.push(d.kind === 'take' ? [`${CARD_BY_ID[d.cardId].name} 획득 · 덱 ${d.deckSize}장`, 'good']
        : d.kind === 'remove' ? [`${CARD_BY_ID[d.cardId].name} 제거 · 덱 ${d.deckSize}장`, 'warn'] : ['카드 보상 건너뜀', 'info']);
      break;
    case 'relicRewardOpen': showRelicReward(); break;
    case 'relicRewardChosen':
      pendingRewardToasts.push(d.relicId ? [`${RELIC_BY_ID[d.relicId].icon} 유물 획득: ${RELIC_BY_ID[d.relicId].name}`, 'good'] : ['유물 보상 건너뜀', 'info']);
      break;
    case 'roundStart': toast(`WEEK ${d.round} 개장 — 목표 ${fmtMoney(d.target)} · DAY 1 장전`, 'good'); break;
    case 'shopOpen':
      shopPickIdx = -1;
      switchTab('shop');
      pendingRewardToasts.forEach(t => toast(t[0], t[1]));
      pendingRewardToasts = [];
      toast('◈ 암시장 개장 — 다음 주 개장 전까지', 'info');
      break;
    case 'shopRejected': toast(SHOP_REJECT_TEXT[d.reason] || d.reason, 'bad'); break;
    case 'packOpened':   showPackResult(d); break;
    case 'singleBought': toast(`${CARD_BY_ID[d.cardId].name} 구매 −${d.price}만 · 덱 ${d.deckSize}장`, 'good'); break;
    case 'shopRemoved':  toast(`${CARD_BY_ID[d.cardId].name} 영구 제거 −${d.price}만 · 덱 ${d.deckSize}장`, 'warn'); break;
    case 'runOver': showRunOver(d.reason); break;
    case 'tipEvent':
      renderTabs();
      if(currentTab === 'play') showTipOverlay();
      if(currentTab === 'event') renderTipScreen();
      break;
    case 'tipResolved':
      renderTabs();
      if(overlayOpen && $('overlayBox').querySelector('[data-tip-choice]')) showTipResultOverlay(d);
      break;
    case 'relicGained':
      if(d.source !== 'reward') toast(`${RELIC_BY_ID[d.id].icon} 유물 획득: ${RELIC_BY_ID[d.id].name}`, 'good');
      break;
    case 'relicTriggered':
      if(d.id === 'parents') toast(`💌 부모님 카드 발동: +₩${d.amount.toLocaleString()}만. 이번이 진짜 마지막이란다.`, 'warn');
      break;
  }
}

/* ── 카드 한 장 (손패 · 도감 · 보상 · 덱 확인 공용) ── */
function cardHtml(card, o){
  const stock = card.stock ? STOCK_BY_ID[card.stock] : null;
  const foot = [card.target ? TARGET_LABEL[card.target] : '', card.exhaust ? '소멸' : ''].filter(Boolean).join(' ');
  return `
    <div class="card t-${card.type} r-${card.rarity} ${o.cls || ''}" ${o.attrs || ''}>
      <div class="c-top"><span class="c-ap">${card.type === 'status' ? '✕' : (o.ap !== undefined ? o.ap : card.ap)}</span><span class="c-type">${TYPE_LABEL[card.type]}</span></div>
      <div class="sym">${card.name}</div>
      ${stock ? `<div class="c-cost">₩${(o.cost || stock.cost).toLocaleString()}만</div>` : ''}
      ${stock && o.live ? `<div class="c-price" data-p="${stock.id}"></div>` : ''}
      <div class="c-desc">${card.desc}</div>
      <div class="c-foot"><span>${foot}</span><span class="c-rar ${card.rarity}">${card.type === 'status' ? '' : RARITY_LABEL[card.rarity]}</span></div>
    </div>`;
}

const selectedCard = () => (selectedIdx >= 0 && run.hand[selectedIdx]) ? CARD_BY_ID[run.hand[selectedIdx].id] : null;
const selectedTargets = kind => { const c = selectedCard(); return c && c.target === kind ? validTargetIds(selectedIdx) : []; };

/* ── HUD / 자산 ── */
function renderHud(){
  const eq = netEquity(), target = currentTarget(), borrowed = totalBorrowed();
  const market = run.phase === 'market';
  $('roundText').textContent = `WEEK ${run.round}/${MAX_ROUND}`;
  $('dayText').textContent = `DAY ${run.day}/${DAYS_PER_ROUND} · ${market ? '장중' : '장전'}`;
  $('dayFill').style.width = (market ? run.tickInDay / TICKS_PER_DAY * 100 : 0) + '%';

  $('totalAssets').textContent = fmtMoney(eq);
  $('totalAssets').style.color = eq >= START_CASH ? 'var(--green)' : 'var(--red)';
  $('targetText').textContent = `WEEK ${run.round} 목표 ${fmtMoney(target)}`;
  const done = eq >= target;
  $('targetPct').textContent = done ? '달성 ✓' : Math.max(0, eq / target * 100).toFixed(0) + '%';
  $('targetPct').style.color = done ? 'var(--green)' : 'var(--muted)';
  $('targetFill').style.width = Math.min(100, Math.max(0, eq / target * 100)) + '%';
  $('targetFill').classList.toggle('done', done);

  $('cashLabel').textContent = run.cash < 0 ? '■ 미수금' : '■ CASH';
  $('availableCash').textContent = fmtMoney(run.cash);
  $('availableCash').style.color = run.cash < 0 ? 'var(--red)' : '';
  $('debtVal').textContent = fmtMoney(borrowed);
  $('debtVal').style.color = borrowed > 0 ? 'var(--red)' : '';
  $('realizedPnL').textContent = '₩ ' + fmtSigned(run.realized);
  $('realizedPnL').style.color = run.realized >= 0 ? 'var(--green)' : 'var(--red)';
  $('interestVal').textContent = fmtMoney(run.interestPaid);

  const fss = run.fss / FSS_MAX;
  $('fssFill').style.width = Math.min(100, fss * 100) + '%';
  $('fssBox').className = 'fss' + (run.fss >= FSS_WARN ? ' hot' : run.fss >= FSS_WARN / 2 ? ' warm' : '');
  $('fssState').textContent = run.buyBanToday ? '매수 금지 중' : `${FSS_TEXT(run.fss)} ${Math.round(run.fss)}/${FSS_MAX}`;
}

