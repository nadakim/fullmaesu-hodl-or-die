  const nw = run.newsToday && run.phase !== 'shop' ? NEWS_BY_ID[run.newsToday] : null;   // 뉴스 칩: 판정 전 / 사실 / 불발
  if(nw) chips.push(`<span class="chip">${!run.newsResolved ? `📰 오늘: ${newsEffectText(nw)} · ${newsRelText(nw)}`
