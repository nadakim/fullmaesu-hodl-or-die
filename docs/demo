        if(!d.marketCard) $('newsText').textContent = '어제 급등락에 차익실현 매물 출회… 개장 초반 되돌림';
        toast('📉 차익실현 매물 — 개장 초반 되돌림', 'warn');
      }
      d.pumps.forEach(pm => toast(pm.dir > 0 ? `📈 ${pm.name} 작전 성공! 급등 중` : `📉 ${pm.name} 설거지 당함! 급락 중`, pm.dir > 0 ? 'good' : 'bad'));
      break;
    case 'newsResolved': {
      const n = NEWS_BY_ID[d.id];
      $('newsText').textContent = newsLine();
      toast(d.active ? `📰 사실로 확인: ${newsEffectText(n)}` : `📰 루머로 판명 — ${n.text.split(' — ')[0]} 효과 없음`, d.active ? 'warn' : 'info');
      break;
    }
    case 'dayEnd':
      Sound.play('dayEnd');
      $('newsText').textContent = newsTomorrowLine();
