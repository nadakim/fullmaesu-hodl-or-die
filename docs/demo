}
/* (D11) 턱걸이 통과 (목표의 100~squeakMax): 결산 체인 끝에 도장 + 긴 한숨 + 짧은 슬로모션 */
function slowMo(ms, rate){
  if(!motionOK() || !document.getAnimations) return;
  const anims = document.getAnimations();
  anims.forEach(a => { try { a.playbackRate = rate; } catch(e) {} });
  setTimeout(() => anims.forEach(a => { try { a.playbackRate = 1; } catch(e) {} }), ms);
}
function squeakThrough(){
  const J = JUICE_CONFIG;
  Fx.stamp('턱걸이 통과!', 'gold');
  Sound.play('sigh');
  requestAnimationFrame(() => slowMo(J.slowMoMs, J.slowMoRate));
}

/* 카드 연쇄: 한 장전에서 연달아 쓰면 2장째부터 잔상, 3장째부터 'n연속'. 풀매수처럼 한 번에 여러 종목을 사면 매수를 하나씩 */
let cardChain = { run: null, key: '', n: 0 }, buySeq = 0, buySeqTimer = null;
function noteCardChain(){
  const key = run.round + '/' + run.day;
  if(cardChain.run !== run || cardChain.key !== key) cardChain = { run, key, n: 0 };
  return ++cardChain.n;
}
const cardChainCount = () => cardChain.run === run && cardChain.key === run.round + '/' + run.day ? cardChain.n : 0;   // 오늘 이미 쓴 카드 수 (이번 카드 제외)

/* ══ S8 TR룸 연출 (30·31·32) — UI 전용, 엔진 상태를 읽기만 한다 ══ */
/* (30) 장전 드로우: dayStart에서 표시 → 손패를 다시 그릴 때 부채꼴로 한 장씩 (5음계로 위로), 희귀 이상은 반짝 + 종.
   정산 무대·연쇄 연출이 끝난 뒤에 펼친다 (소리가 겹치지 않게) */
let dealPending = false, stageQueued = false;
const dealReady = () => dealPending && currentTab === 'play' && run && run.phase === 'premarket' && !stage && !stageQueued && !Fx.queueLength && !overlayOpen;
function playDeal(box){
  dealPending = false;
  if(settings.fxSpeed === 'min') return;
  const cards = [...box.querySelectorAll('.card.gcard')], n = cards.length, J = JUICE_CONFIG;
  box.style.setProperty('--deal-gap', J.dealGapMs + 'ms');
  box.style.setProperty('--deal-ms', J.dealMs + 'ms');
  cards.forEach((el, i) => {
    const off = n > 1 ? i / (n - 1) - 0.5 : 0;   // −0.5(왼쪽) ~ +0.5(오른쪽)
    el.style.setProperty('--deal-i', i);
    el.style.setProperty('--deal-x', Math.round(-off * 160));
    el.style.setProperty('--deal-r', (off * 2 * J.dealFan) + 'deg');
    el.classList.add('deal');
    const at = i * J.dealGapMs, rarity = CARD_BY_ID[el.dataset.cid] ? CARD_BY_ID[el.dataset.cid].rarity : '';
    setTimeout(() => Sound.play('cardDeal', { pitch: stagePitch(i) }), at);
    setTimeout(() => {
      el.classList.remove('deal');
      if(J.shineRarities.indexOf(rarity) >= 0 && el.isConnected){ el.classList.add('shine'); Sound.play('rareDraw', { rarity }); Fx.afterAnim(el, 2 * Fx.dur('shine'), () => el.classList.remove('shine'), 'rareShine'); }
    }, at + J.dealMs);
  });
}
function scheduleDeal(){   // 정산 무대가 열리면 그 뒤로 (stageNext → renderAll)
  const r = run;
  setTimeout(() => whenFxIdle(() => { if(run === r && dealReady()){ handSig = ''; renderHand(); } }), 0);
}

/* (31) 장 시작 카운트다운: 막는 연출 한 칸 (그동안 시장 정지, 클릭·Space = 스킵). 연쇄 속도 '최소'면 생략.
   '▶ 장 시작'을 눌렀을 때만 (countdownNext) — 다른 경로의 startMarket(테스트·자동 진행)은 벨만 */
let countdownNext = false;
function enqueueCountdown(){
  const item = { kind: 'countdown', tier: 1, blocking: true, duration: JUICE_CONFIG.countdownMs, payload: {} };
  item.play = ctx => {
    const el = document.createElement('div'), beat = ctx.duration / 4;
    el.className = 'countdown';
    document.body.appendChild(el);
    item.el = el; item.timers = [];
    ['3', '2', '1'].forEach((t, i) => item.timers.push(setTimeout(() => {
      el.innerHTML = `<div class="cd-num">${t}</div>`;
      Sound.play('drumRoll', { pitch: Sound.semis(i * 2) });
    }, i * beat)));
    item.timers.push(setTimeout(() => {
      item.rang = true;
      el.innerHTML = '<div class="cd-num open">OPEN!</div>';
      if(!isMotionReduced()) el.classList.add('flash');
      Sound.play('drumRoll', { last: true });
      Sound.play('marketOpen');
    }, 3 * beat));
  };
  item.stop = item.skip = () => {
    (item.timers || []).forEach(clearTimeout);
    if(item.el){ item.el.remove(); item.el = null; }
    if(!item.rang){ item.rang = true; Sound.play('marketOpen'); }
  };
  Fx.enqueue(item);
}

/* (32) 장중 포지션: 틱마다 평가손익을 비교해 연속 상승 수·최고 손익을 센다 (표시만). 불꽃 단계는 renderPositions가 그린다 */
let posFx = { run: null, map: {} };
function notePosTicks(){
  if(posFx.run !== run) posFx = { run, map: {} };
  const J = JUICE_CONFIG, live = {};
  run.positions.forEach(p => {
    const pnl = posPnl(p), s = posFx.map[p.id] || { last: pnl, up: 0, best: pnl, highTick: -99 };
    s.up = pnl > s.last + 1e-9 ? s.up + 1 : pnl < s.last - 1e-9 ? 0 : s.up;
    if(pnl > s.best + 1e-9 && pnl > 0 && marketTickN - s.highTick >= J.newHighGapTicks && posFx.map[p.id]){
      s.highTick = marketTickN;
      const el = posRowEl(p.id);
      if(el){ el.classList.remove('fx-newhigh'); void el.offsetWidth; el.classList.add('fx-newhigh'); Fx.afterAnim(el, Fx.dur('newhigh'), () => el.classList.remove('fx-newhigh'), 'newHigh'); }
    }
    s.best = Math.max(s.best, pnl);
    s.last = pnl;
    live[p.id] = s;
  });
  posFx.map = live;
}
function flameLevel(p){
  const s = posFx.run === run && posFx.map[p.id];
  if(!s || run.phase !== 'market' || posPnl(p) <= 0) return 0;
  const F = JUICE_CONFIG.flameSteps;
  return s.up >= F[2] ? 3 : s.up >= F[1] ? 2 : s.up >= F[0] ? 1 : 0;
}
const posInDanger = p => run.phase === 'market' && isMarginable(p) && !isProtected(p) && marginWarn(p);
function dangerT(p){   // 위험 정도: 1 = 경고선 · 0 = 반대매매 직전 (건강도 1)
  const warn = MAINTENANCE_MARGIN_ON ? MAINT_WARN_HEALTH : MARGIN_WARN_RATIO / marginCallRatio(p);
  return Math.max(0, Math.min(1, (marginHealth(p) - 1) / Math.max(1e-6, warn - 1)));
}
function heartInterval(p){   // 건강도 경고선 → 1.0 사이를 느림 → 빠름으로
  const [slow, fast] = JUICE_CONFIG.heartMs;
  return Math.round(fast + (slow - fast) * dangerT(p));
}
/* 심장 박동: 장중 TR룸에서 위험 포지션이 있으면 가장 위험한 건강도로 간격을 정해 "쿵-쿵" + 가장자리 붉은 맥동 */
function heartLoop(){
  const edge = $('fxDangerEdge');
  const active = currentTab === 'play' && run && run.phase === 'market' && !overlayOpen;
  const danger = active ? run.positions.filter(posInDanger) : [];
  let wait = 400;
  const H = JUICE_CONFIG.dangerMuffleHz;
  if(danger.length){   // (D10) 위험할수록 BGM이 답답하게 (암시장 로우패스와 따로)
    const t = Math.min(...danger.map(dangerT));
    Music.setMuffle(Math.round((H[1] + (H[0] - H[1]) * t) / 50) * 50, { key: 'danger' });
  } else if(Music.dangerHz) Music.setMuffle(0, { key: 'danger' });
  if(danger.length){
    wait = Math.min(...danger.map(heartInterval));   // 가장 위험한 포지션 기준
    edge.classList.add('on');
    edge.classList.remove('beat'); void edge.offsetWidth; edge.classList.add('beat');
    Sound.play('heartbeat');
    document.documentElement.style.setProperty('--beat-ms', wait + 'ms');
  } else edge.classList.remove('on', 'beat');
  setTimeout(heartLoop, wait);
}

function juiceBought(d){
  const i = buySeq++;
  clearTimeout(buySeqTimer);
  buySeqTimer = setTimeout(() => { buySeq = 0; }, 0);   // 같은 동기 호출(한 카드) 안에서만 순번
  setTimeout(() => {
    Sound.play('buy', { lev: d.pos.lev, dir: d.pos.dir, pitch: Sound.semis(i) });
    if(i > 0) Fx.flash(posRowEl(d.pos.id), 'fx-hit');
  }, i * 110);
}

/* 큐가 비면 실행 (게임오버·결산 화면은 연쇄가 끝난 뒤에) */
function whenFxIdle(fn){
  if(!Fx.queueLength) return fn();
  const t = setInterval(() => { if(!Fx.queueLength){ clearInterval(t); fn(); } }, 80);
}

/* 카드 사용 + 연출: 엔진 호출은 playCard 그대로. 성공하면 손패 카드가 대상(포지션·시세 행, 종목 카드는 새 포지션)으로 날아간다 */
let lastBoughtPosId = -1;
function playCardFx(idx, targetId, opts){
  const el = $('handBox').querySelector(`[data-idx="${idx}"]`);
  const inst = run.hand[idx];
  const card = inst ? CARD_BY_ID[inst.id] : null;
  const rect = rectOf(el), ghost = el ? el.cloneNode(true) : null;
  if(ghost){ ghost.classList.remove('selected', 'tilt'); ghost.classList.add('played'); }
  lastBoughtPosId = -1;
  const ok = playCard(idx, targetId, opts);
  renderAll();
  if(!ok || !ghost || !card) return ok;
  const target = card.target === 'position' ? posRowEl(targetId) : card.target === 'asset' ? quoteRowEl(targetId)
               : lastBoughtPosId >= 0 ? posRowEl(lastBoughtPosId) : $('chartBox');   // 대상이 없으면 차트 쪽으로
  const n = noteCardChain();
  Fx.cardFly(ghost, rect, target, null, n >= 2 ? Math.min(3, n - 1) : 0);   // 2장째부터 잔상
  if(n >= 3) Fx.chip(n + '연속', rectOf($('handBox')), 'gold');   // 카드 연속 사용 (수익 콤보와 헷갈리지 않게 'COMBO'는 쓰지 않는다)
  return ok;
}

/* HUD 숫자 펀치 + 목표 달성 순간 (순자산·현금이 바뀐 만큼, 이번 주 목표를 처음 넘으면 초록 섬광 + 징글) */
let hudPrev = null;
function hudJuice(eq, target){
  const done = eq >= target, prev = hudPrev;
  hudPrev = { run, round: run.round, eq, cash: run.cash, done };
  if(!prev || prev.run !== run){ juiceMilestones(eq, null, target); return; }   // 새 판 첫 화면: 비교 대상 없음
  const dEq = eq - prev.eq, dCash = run.cash - prev.cash;
  if(Math.abs(dEq) >= Math.abs(eq) * FX_PUNCH_MIN) Fx.punch($('totalAssets'), dEq, Fx.intensity(dEq, eq));
  if(Math.abs(dCash) >= 1) Fx.punch($('availableCash'), dCash, Fx.intensity(dCash, eq));
  juiceMilestones(eq, prev, target);
}

function resetNews(){
  $('newsText').textContent = newsLine() || '시장이 평온한 흐름을 유지 중입니다.';
