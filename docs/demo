/* 장세 뱃지 (차트 제목 옆): 엔진 marketState를 읽기만. 평상시는 숨김 */
const STATE_BADGE = { BULL: ['▲강세', 'bull'], BEAR: ['▼약세', 'bear'], VOLATILE: ['⚡변동성', 'vol'] };
function renderStateBadge(){
  const b = STATE_BADGE[marketState], el = $('marketStateBadge');
