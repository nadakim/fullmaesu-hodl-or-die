function tunerReset(){
  tunerLeaves(JUICE_DEFAULTS, [], []).forEach(({ path, v }) => tunerSet(path, v));
  try { localStorage.removeItem(TUNER_KEY); } catch(e) {}
  $('tunerPanel').querySelectorAll('[data-tn]').forEach(el => { const v = tunerGet(JUICE_CONFIG, el.dataset.tn.split('.')); el.value = v; $('tunerPanel').querySelector(`[data-tnv="${el.dataset.tn}"]`).textContent = v; });
