let relicClackId = '';   // 방금 암시장에서 산 유물: renderShop 뒤 그 칸에 꽂는다

$('shopBox').addEventListener('click', e => {
  if(!run) return;
  const info = e.target.closest('[data-pack-info]');
  if(info){ e.stopPropagation(); showPackInfo(info.dataset.packInfo); return; }   // 구성 보기는 구매와 별개
  const pk = e.target.closest('[data-pack]');
  const single = e.target.closest('[data-single]');
  const rm = e.target.closest('[data-shop-remove]');
  const relic = e.target.closest('[data-buy-relic]');
  const rr = e.target.closest('[data-reroll]');
  if(rr){ if(!rr.disabled) doReroll(rr.dataset.reroll); return; }
  const own = e.target.closest('[data-own-move]'), sell = e.target.closest('[data-own-sell]');
  if(own){ shiftRelic(own.dataset.ownRelic, +own.dataset.ownMove); return; }
  if(sell){
    if(!sell.classList.contains('armed')){ sell.classList.add('armed'); sell.textContent = '정말 팔까요? 한 번 더'; return; }   // 두 번 눌러 확인
    sellRelic(sell.dataset.ownSell);
  }
  else if(relic){
    if(relicSlotsFull() && run.slush >= relicPrice(relic.dataset.buyRelic)){ showRelicSwap('shop', relic.dataset.buyRelic); return; }
    buyRelic(relic.dataset.buyRelic);
  }
  else if(pk) buyPack(pk.dataset.pack);
  else if(single) buySingle(+single.dataset.single);
  else if(rm){ const i = +rm.dataset.shopRemove; shopPickIdx = shopPickIdx === i ? -1 : i; }
  else if(e.target.closest('[data-service]')){
