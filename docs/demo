    ch.className = 'q-chg ' + (chg >= 0 ? 'pnl-up' : 'pnl-down');
    drawSpark(row.querySelector('canvas'), a.history, chg >= 0);
    // 찌라시: 장전에는 결과를 숨긴다
    const pm = run.pumps[s.id], tag = row.querySelector('.q-tag');
    const gap = assets[s.id].candles.slice(-GAP_TAG_CANDLES).reduce((g, c) => c.gap || g, 0);   // 최근 갭
    tag.textContent = gap ? (gap > 0 ? 'GAP▲' : 'GAP▼') : !pm ? '' : run.phase !== 'market' ? '찌라시?' : pm > 0 ? '작전▲' : '설거지▼';
    tag.className = 'q-tag ' + (gap ? 'gap' : !pm ? '' : run.phase !== 'market' ? 'hidden' : pm > 0 ? 'up' : 'down');
    row.classList.toggle('targetable', targets.indexOf(s.id) >= 0);
    row.classList.toggle('charted', chartTarget === s.id);
    const sigEl = row.querySelector('.q-sig'), sigHtml = signalHtml(s);
    if(sigEl.innerHTML !== sigHtml) sigEl.innerHTML = sigHtml;
    sigEl.title = signalHelp(s);
  });
}

