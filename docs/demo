.sh-steam i{position:absolute;bottom:0;width:calc(14 * var(--u));height:calc(14 * var(--u));background:color-mix(in srgb, var(--text) 55%, transparent);opacity:0;
  animation:steamUp var(--steam-ms, 1100ms) steps(8) infinite;}
.sh-steam i:nth-child(n + 1){left:calc(6% * var(--n));animation-delay:calc(-1 * var(--n) * 0.09s);}
.sh-steam i:nth-child(1){--n:1;} .sh-steam i:nth-child(2){--n:4;} .sh-steam i:nth-child(3){--n:7;} .sh-steam i:nth-child(4){--n:10;}
.sh-steam i:nth-child(5){--n:2;} .sh-steam i:nth-child(6){--n:5;} .sh-steam i:nth-child(7){--n:8;} .sh-steam i:nth-child(8){--n:11;}
.sh-steam i:nth-child(9){--n:3;} .sh-steam i:nth-child(10){--n:6;} .sh-steam i:nth-child(11){--n:9;} .sh-steam i:nth-child(12){--n:12;}
.sh-steam i:nth-child(n + 5){width:calc(9 * var(--u));height:calc(9 * var(--u));}
.stage-hero:not(.steaming) .sh-steam i{display:none;}
