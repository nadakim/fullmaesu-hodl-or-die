@keyframes ovRage{0%{background:var(--c1);}25%{background:var(--c2);}50%{background:var(--c3);}75%{background:var(--c4);}}
/* 과열 증기: 주인공 배수 위로 네모 김이 피어올라 옅어진다 (CSS만 — 파티클 예산 0). 개수는 티어별 --steam-n */
