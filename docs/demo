/* ── 찌라시 ── */
const fillTip = (text, stockId) => text.split('{stock}').join(stockId ? STOCK_BY_ID[stockId].name : '');

function tipChoiceMeta(tip, choice){
  const parts = [];
  const buy = choice.outcomes[0].effects.find(ef => ef.kind === 'buy');
  if(buy){
    const amount = Math.min(buy.amount * tipScale(), Math.max(0, run.cash));
    parts.push(`${STOCK_BY_ID[tipStockId(tip, buy.stock)].name} ₩${Math.round(amount).toLocaleString()}만 매수`);
  }
  parts.push(choice.outcomes.map(o => `${o.tag} ${Math.round(o.chance * 100)}%`).join(' · '));
  return parts.join(' · ');
}

function tipCardHtml(tip, wrap){
  const ev = TIP_BY_ID[tip.eventId];
  const body = `
    <div class="noti-headline">${fillTip(ev.headline, tip.stockId)}</div>
    <div class="noti-body">${fillTip(ev.body, tip.stockId)}</div>
    ${ev.choices.map((c, i) => `
      <button class="choice ${i === 0 ? 'risky' : 'safe'}" data-tip-choice="${i}">
        <span class="ch-label">${'AB'[i]}. ${fillTip(c.label, tip.stockId)}</span>
        <span class="ch-meta">${tipChoiceMeta(tip, c)}</span>
      </button>`).join('')}`;
  return wrap ? `<div class="phone-noti">${body}</div>` : body;
}

function tipResultHtml(r){
  const ev = TIP_BY_ID[r.eventId], outcome = ev.choices[r.choiceIdx].outcomes[r.outcomeIdx];
  const cls = Math.abs(r.delta) < 0.5 ? 'flat' : r.delta > 0 ? 'up' : 'down';
  return `<div class="tip-result ${cls}">${fillTip(outcome.text, r.stockId)}
    <b>순자산 ${Math.abs(r.delta) < 0.5 ? '±0만' : fmtSigned(r.delta)}</b></div>`;
}

function showTipOverlay(){
  showOverlay(`<div class="tip-card">${tipCardHtml(run.pendingTip, false)}</div>`);
}

function showTipResultOverlay(r){
  const ev = TIP_BY_ID[r.eventId];
  showOverlay(`
    <div class="noti-headline">${fillTip(ev.headline, r.stockId)}</div>
    <div class="noti-body">${'AB'[r.choiceIdx]}. ${fillTip(ev.choices[r.choiceIdx].label, r.stockId)}</div>
    ${tipResultHtml(r)}
    <button class="ov-btn" data-act="close">확인 — 장 계속</button>`);
}

function renderTipScreen(){
  const box = $('tipBox');
  if(!run){
    box.innerHTML = `<div class="tip-empty">📵 아직 받은 찌라시가 없습니다<small>게임을 시작하면 장중에 찌라시가 무작위로 날아옵니다.</small></div>`;
    return;
  }
  const head = run.pendingTip ? tipCardHtml(run.pendingTip, true)
    : `<div class="phone-noti"><div class="tip-empty">📵 지금 도착한 찌라시 없음
        <small>장중에 무작위로 도착합니다 (하루 최대 ${TIP_MAX_PER_DAY}개). 도착하면 시장이 멈추고 선택을 기다립니다.</small></div>
        ${run.tipLog.length ? tipResultHtml(run.tipLog[0]) : ''}</div>`;
  const log = run.tipLog.map(r => {
    const ev = TIP_BY_ID[r.eventId];
    return `<li><span>${fillTip(ev.headline, r.stockId)} → ${'AB'[r.choiceIdx]} · ${ev.choices[r.choiceIdx].outcomes[r.outcomeIdx].tag}</span>
      <span class="${r.delta >= 0 ? 'pnl-up' : 'pnl-down'}">${fmtSigned(r.delta)}</span></li>`;
  }).join('');
  box.innerHTML = head + (log ? `<div><div class="pile-title">▌ 최근 찌라시 결과</div><ul class="tip-log">${log}</ul></div>` : '');
}

