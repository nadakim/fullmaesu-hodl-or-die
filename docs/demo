/* ── 시장 지도 (전투 화면 종목 시세의 '지도' 보기, UI 전용) ──
   GROUP_ORDER 그룹마다 덩어리 → 그 안에 종목 타일. 배치 = 직접 구현한 squarified treemap(순서 유지), 타일은 DOM(클릭 = 목록 행과 같은 동작).
   크기: 균등 1, 보유 종목만 QMAP_HELD_WEIGHT배 — 가격은 안 쓴다. 배치는 보이는 종목·보유 종목·칸 크기가 바뀔 때만 다시 계산(그 밖엔 색·글자만 갱신).
   색 = 상승 초록 / 하락 빨강, 농도 4단계: |등락률| 경계 QMAP_BANDS — 실측 일일 등락폭 분포(12종목 × 1,000일, |하루 등락| 25·50·75% 지점 3.4%·8.0%·17.7%)의 사분위 */
const QMAP_HELD_WEIGHT = 1.5;
const QMAP_BANDS = [0.03, 0.08, 0.18];   // 이 경계로 1~4단계 (사분위)
const QMAP_FLAT = 0.0005;
const QMAP_WIDE = 2.4;                    // 가로/세로가 이보다 넓은 타일은 이름·등락률을 한 줄로                 // |등락| 0.05% 미만은 보합(회색) — 화면 표시 +0.0%와 같은 칸
let qmapSig = '';
function squarify(items, x, y, w, h){   // items [{key, v}] (v 합 = w×h) → [{key, x, y, w, h}], 순서 유지
  const out = [], rest = items.slice();
  const worst = (row, side) => { const sum = row.reduce((a, r) => a + r.v, 0), mx = Math.max(...row.map(r => r.v)), mn = Math.min(...row.map(r => r.v));
    return Math.max(side * side * mx / (sum * sum), sum * sum / (side * side * mn)); };
  while(rest.length){
    const side = Math.min(w, h);
    let row = [rest.shift()], best = worst(row, side);
    while(rest.length){ const cand = row.concat(rest[0]), wv = worst(cand, side); if(wv > best) break; row = cand; best = wv; rest.shift(); }
    const sum = row.reduce((a, r) => a + r.v, 0);
    if(w >= h){ const cw = rest.length ? sum / h : w; let cy = y; row.forEach(r => { const rh = r.v / sum * h; out.push({ key: r.key, x, y: cy, w: cw, h: rh }); cy += rh; }); x += cw; w -= cw; }
    else { const rh = rest.length ? sum / w : h; let cx = x; row.forEach(r => { const rw = r.v / sum * w; out.push({ key: r.key, x: cx, y, w: rw, h: rh }); cx += rw; }); y += rh; h -= rh; }
  }
  return out;
}
const qmapBand = c => Math.abs(c) < QMAP_FLAT ? 'flat' : (c > 0 ? 'up' : 'dn') + (1 + QMAP_BANDS.filter(b => Math.abs(c) >= b).length);
function renderQuoteMap(){
  const area = $('qmArea'), W = area.clientWidth, H = area.clientHeight;
  if(!W || !H) return;
  const visible = id => { const r = quoteRowEl(id); return r && getComputedStyle(r).display !== 'none'; };   // 해금 안 된 종목은 타일 없음 (목록의 잠금 규칙 그대로)
  const held = id => run.positions.some(p => p.assetId === id);
  const groups = QUOTE_GROUPS.map((g, gi) => ({ gi, name: g.name, ids: g.ids.filter(visible) })).filter(g => g.ids.length);
  const sig = groups.map(g => g.ids.map(id => id + (held(id) ? '*' : '')).join('.')).join('|') + '|' + W + 'x' + H;
  if(sig !== qmapSig){
    qmapSig = sig;
    const wt = id => held(id) ? QMAP_HELD_WEIGHT : 1, total = groups.reduce((a, g) => a + g.ids.reduce((b, id) => b + wt(id), 0), 0);
    const gap = Math.max(1, Math.round(2 * uiScale)), capH = Math.round(13 * uiScale);
    const gRects = squarify(groups.map(g => ({ key: g.gi, v: g.ids.reduce((b, id) => b + wt(id), 0) / total * W * H })), 0, 0, W, H);
    const pct = (v, of) => (v / of * 100).toFixed(3) + '%';
    area.innerHTML = gRects.map(gr => {
      const g = groups.find(x => x.gi === gr.key), iw = gr.w - gap * 2, ih = gr.h - gap * 2 - capH;
      const sum = g.ids.reduce((b, id) => b + wt(id), 0);
      const tiles = squarify(g.ids.map(id => ({ key: id, v: wt(id) / sum * iw * ih })), 0, 0, iw, ih);
      return `<div class="qm-group" data-g="${g.gi}" style="left:${pct(gr.x + gap, W)};top:${pct(gr.y + gap, H)};width:${pct(iw, W)};height:${pct(gr.h - gap * 2, H)}">
        <div class="qm-cap"><span>${g.name}</span><b data-f="avg"></b></div>
        <div class="qm-tiles">${tiles.map(t => `<div class="qm-tile${held(t.key) ? ' held' : ''}${t.w > t.h * QMAP_WIDE ? ' wide' : ''}" data-q="${t.key}" role="button" tabindex="0" style="left:${pct(t.x, iw)};top:${pct(t.y, ih)};width:${pct(t.w, iw)};height:${pct(t.h, ih)}">
          <span class="qm-name">${held(t.key) ? '★' : ''}${STOCK_BY_ID[t.key].name}</span><span class="qm-chg"><i data-f="arr"></i><span data-f="chg"></span></span></div>`).join('')}</div>
      </div>`;
    }).join('');
  }
  // 색·글자만 갱신 (배치는 그대로)
  const targets = selectedTargets('asset');
  let up = 0, dn = 0;
  groups.forEach(g => {
    const chs = g.ids.map(id => dispChg(assets[id])), avg = chs.reduce((a, c) => a + c, 0) / chs.length;
    const cap = area.querySelector(`.qm-group[data-g="${g.gi}"] [data-f=avg]`);
    if(cap){ const t = fmtPct(avg); if(cap.textContent !== t) cap.textContent = t; cap.className = avg > 0 ? 'pnl-up' : avg < 0 ? 'pnl-down' : ''; }
    g.ids.forEach((id, i) => {
      const c = chs[i], el = area.querySelector(`.qm-tile[data-q="${id}"]`);
      if(c >= QMAP_FLAT) up++; else if(c <= -QMAP_FLAT) dn++;
      if(!el) return;
      const cls = 'qm-tile ' + qmapBand(c) + (held(id) ? ' held' : '') + (el.classList.contains('wide') ? ' wide' : '') + (targets.indexOf(id) >= 0 ? ' targetable' : '') + (chartTarget === id ? ' charted' : '');
      if(el.className !== cls) el.className = cls;
      const t = fmtPct(c), ce = el.querySelector('[data-f=chg]'), ar = el.querySelector('[data-f=arr]'), a = c > 0 ? '▲' : c < 0 ? '▼' : '';
      if(ce.textContent !== t) ce.textContent = t;
      if(ar.textContent !== a) ar.textContent = a;   // ▲▼는 VT323에 글리프가 없어 따로 (Galmuri)
      const tip = `${STOCK_BY_ID[id].name} ${fmtPrice(assets[id].price)} ${fmtPct(c)}${showYday() ? ' (어제)' : ''}${held(id) ? ' · 보유 중' : ''}`;
      if(el.title !== tip) el.title = tip;
    });
  });
  const st = `<span class="pnl-up">상승 ${up}</span> · <span class="pnl-down">하락 ${dn}</span>${showYday() ? ' <small>어제 기준</small>' : ''}`;
  if($('qmSum').innerHTML !== st) $('qmSum').innerHTML = st;
}
function applyQuoteView(){
  document.body.classList.toggle('qv-map', settings.quoteView === 'map');
  document.querySelectorAll('[data-qview]').forEach(b => { b.classList.toggle('on', b.dataset.qview === settings.quoteView); b.setAttribute('aria-pressed', String(b.dataset.qview === settings.quoteView)); });
  qmapSig = '';
}

/* ── 행동력 · 더미 · 대기 효과 · 장 시작 ── */
function renderTurn(){
  const pre = run.phase === 'premarket';
  let pips = '';
  for(let i = 0; i < Math.max(run.ap, maxAp()); i++) pips += `<span class="ap-pip ${i < run.ap ? 'on' : ''}"></span>`;
  $('apPips').innerHTML = pips;
  $('apText').textContent = `${run.ap}/${maxAp()}`;
  $('pileText').textContent = `덱 ${run.drawPile.length} · 버림 ${run.discard.length} · 소멸 ${run.exhausted.length}`;
  $('pileDeckN').textContent = run.drawPile.length; $('pileDiscardN').textContent = run.discard.length; $('pileExhN').textContent = '소멸 ' + run.exhausted.length;
  renderMultPreview();

  const chips = [];
  const pd = run.pending, parts = [];
  if(pd.principalMult > 1) parts.push(`원금 ${pd.principalMult}배`);
  if(pd.lev > 1) parts.push(pd.lev === CREDIT_LEV ? `신용 ${pd.lev}x` : `영끌 ${pd.lev}x`);
  if(pd.dir < 0) parts.push('숏');
  if(parts.length) chips.push(`<span class="chip ${pd.dir < 0 ? 'short' : 'buy'}">다음 매수: ${parts.join(' · ')}</span>`);
  if(run.marketCard && run.phase === 'premarket') chips.push(`<span class="chip mod">${CARD_BY_ID[run.marketCard].name} 대기 — ${marketOddsText(run.marketCard)}</span>`);
  if(run.forcedState) chips.push(`<span class="chip mod">오늘 장: ${STATE_LABEL[run.forcedState]}</span>`);
  if(run.revertTicksLeft > 0) chips.push(`<span class="chip">차익실현 매물 대기 (개장 후 ${run.revertTicksLeft}틱)</span>`);
  if(run.buyBanToday) chips.push('<span class="chip short">☎ 금감원 제재: 오늘 신규 매수 금지</span>');
  if(run.interestFree) chips.push('<span class="chip">오늘 이자 면제</span>');
  if(run.noSellToday) chips.push('<span class="chip mod">계좌 잠금: 매도 불가 · 청산 면제</span>');
  if(run.week.antArmy) chips.push('<span class="chip buy">개미 군단: 이번 주 종목 카드 행동력 0 · 쓰면 1장 드로우</span>');
  if(run.week.topSpotter) chips.push('<span class="chip buy">상투 감별사: 이번 주 익절·트레일링 행동력 0 · 체결 수익 +30%</span>');
  if(run.week.valueGod) chips.push('<span class="chip buy">가치투자의 신: 이번 주 장 마감마다 장기 보유 배당</span>');
  if(hasRelic('timemachine') && pre){   // 타임머신: 오늘 판정 미리 보기
    const seen = [];
    run.hand.map(i => i.id).concat(run.marketCard ? [run.marketCard] : []).forEach(id => {
      if(MARKET_CARD_ODDS[id] && seen.indexOf(id) < 0){ seen.push(id); chips.push(`<span class="chip mod">🕰️ ${CARD_BY_ID[id].name} → ${STATE_LABEL[rollMarketCard(id)]}</span>`); }
    });
    STOCKS.filter(st => run.pumps[st.id] === 1 || run.pumps[st.id] === -1).forEach(st => chips.push(`<span class="chip mod">🕰️ ${st.name} ${run.pumps[st.id] > 0 ? '급등' : '설거지'}</span>`));
  }
  if(run.lossGuardToday) chips.push(`<span class="chip">손실 보전 약정: 오늘 청산 손실 ${pct(run.lossGuardToday)} 환급</span>`);
  if(run.circuitToday) chips.push(`<span class="chip">서킷브레이커: 오늘 −${pct(run.circuitToday)}에서 장 마감 · 청산 면제${run.circuitTripped ? ' (발동)' : ''}</span>`);
  $('chipBox').innerHTML = chips.join('');
  // 내일 뉴스 예고: 배너 옆 '📰 내일' 버튼 (호버 = 제목, 누르면 알림)
  const tmr = newsTomorrowLine(), nb = $('newsNextBtn');
  nb.hidden = !tmr;
  if(nb.title !== tmr) nb.title = tmr;

  const btn = $('openBtn');
  const shop = run.phase === 'shop';
  btn.disabled = !pre && !shop;
  btn.textContent = pre ? '▶ 장 시작' : shop ? '◈ 암시장에 들렀다가 다음 주 개장'
    : run.phase === 'market' ? `장중 · 캔들 ${run.tickInDay}/${TICKS_PER_DAY}` : '결산 중';
  $('handHint').textContent = selectedIdx >= 0 ? '대상을 클릭 · 다시 누르면 취소'
    : pre ? '카드를 눌러 사용' : '장중에는 카드 사용 불가';
}

/* N4 색 언어: 정산 설명의 배수(×N · 합산 배수 +N)는 금색 — 문구는 그대로, '정산' 이야기일 때만 칠한다 */
const SETTLE_MULT_RE = /(×\s?(?:\d[\d.,]*|콤보 수|배수|레버리지)(?:ⁿ|\^[^\s.,)]+)?|합산 배수 \+[\d.]+)/g;
const settleColor = text => /정산|배수/.test(text) ? text.replace(SETTLE_MULT_RE, '<span class="n-mult">$1</span>') : text;
/* 예상 정산 배수 (엔진 previewSettlement — 판정에 쓰는 계산 그대로). 오르면 숫자가 튄다 (큰 연출은 S6) */
const fmtMult = m => '×' + (m < 10 ? m.toFixed(2) : m < 1000 ? m.toFixed(1) : Math.round(m).toLocaleString());
let lastMultShown = 0;
function renderMultPreview(){
  const pv = previewSettlement();
  const txt = fmtMult(pv.mult), el = $('multText');
  if(el.textContent !== txt){
    el.textContent = txt;
    if(lastMultShown && pv.mult > lastMultShown + 1e-9) Fx.punch(el, 1, 0.3);
  }
  lastMultShown = pv.mult;
  const tip = '오늘 예상 정산 배수 — 장 마감에 포지션이 그날 번 돈 × 배수만큼 받는다 (보너스분은 현금으로)'
    + (pv.rows.length ? '\n' + pv.rows.map(r => `${r.name} ${r.dir < 0 ? '숏 ' : ''}${r.lev}x ${fmtMult(r.mult)} · 유리하게 +1%면 ${fmtSigned(r.per1pct)}`).join('\n') : '\n포지션 없음')
    + '\n' + critOddsText();
  if($('multPreview').getAttribute('aria-label') !== tip) $('multPreview').setAttribute('aria-label', tip);   // 화면 툴팁은 settleTipHtml (색 언어)
}
/* 예상 정산 툴팁: 포지션마다 [칩 = 유리하게 1%] × [배수] = [금액] 한 줄 */
function settleTipHtml(){
  const pv = previewSettlement();
  const rows = pv.rows.map(r => {
    const p = run.positions.find(x => x.id === r.posId), chip = p ? exposure(p) * 0.01 : 0;
    return `<span class="ct-meta">${r.name} ${r.dir < 0 ? '숏 ' : ''}${r.lev}x · <span class="n-chip">${fmtSigned(chip)}</span> × <span class="n-mult">${fmtMultNum(r.mult)}</span> = <span class="${signCls(chip * r.mult)}">${fmtSigned(chip * r.mult)}</span></span>`;
  }).join('');
  return `<b>오늘 예상 정산 <span class="n-mult">${fmtMult(pv.mult)}</span></b>
    <span class="ct-meta">장 마감에 <span class="n-chip">칩</span>(그날 번 돈 + 더하기) × <span class="n-mult">배수</span>(합산 + · 곱 ×) = 금액. 보너스분(금액 − 그날 번 돈)은 현금으로</span>
    ${rows ? `<span class="ct-meta">유리하게 1% 움직이면 — <span class="n-chip">칩</span> × <span class="n-mult">배수</span> = 금액</span>${rows}` : '<span class="ct-meta">포지션 없음</span>'}
    <span class="ct-meta">${settleColor(critOddsText())}</span>`;
}
/* (N2) 심지 게이지: 남은 길이 = 건강도(1 = 반대매매)를 1~FUSE_FULL_HEALTH 사이로. 경고선(엔진 marginWarn)이면 빨강 */
const FUSE_FULL_HEALTH = 2;     // 건강도가 이 이상이면 심지가 꽉 참 (= 담보유지비율 방식 화면 막대 MAINT_GAUGE_MAX와 같은 뜻)
const FUSE_WARM = 0.3;          // 남은 심지가 이 비율 아래면 주황 (새 2x ≈ 43% = 초록, 새 3x = 엔진 경고선 아래라 빨강)
const fuseLeft = p => Math.max(0, Math.min(1, (marginHealth(p) - 1) / (FUSE_FULL_HEALTH - 1)));
const fuseClass = (p, f) => isProtected(p) ? 'safe' : marginWarn(p) ? 'hot' : f < FUSE_WARM ? 'warm' : f >= 1 ? 'safe' : '';
/* 반대매매 기준 문구 (엔진 플래그 MAINTENANCE_MARGIN_ON에 따라 담보비율 / 증거금률) — 툴팁 안에만 */
function marginText(p){
  if(!MAINTENANCE_MARGIN_ON) return `증거금률 ${Math.round(marginRatio(p) * 100)}% / 청산 ${Math.round(marginCallRatio(p) * 100)}%`;
  const c = collateralRatio(p);
  return `담보비율 ${isFinite(c) ? Math.round(c * 100) + '%' : '—'} / 청산 ${Math.round(maintRatio(p) * 100)}% 미만`;
}
/* 크리티컬 정산 확률 (엔진 CRIT_* 그대로) — 정산 칩 툴팁·도감 */
function critOddsText(){
  const total = CRIT_TABLE.reduce((sum, c) => sum + c.weight, 0);
  return `💥 크리티컬: 수익 포지션 정산마다 ${Math.round(CRIT_CHANCE * 100)}% → ` + CRIT_TABLE.map(c => `×${c.mult} ${Math.round(c.weight / total * 100)}%`).join(' / ');
}
/* 종목 카드를 쓰면 배수가 어떻게 바뀌는지 (카드 툴팁) */
function cardSettleView(stockId){
  const before = previewSettlement().mult, after = previewSettlement(hypotheticalBuy(stockId)).mult;
  return `<span class="ct-ev settle">💰 쓰면 정산 배수 <span class="n-mult">${fmtMult(before)}</span> → <span class="n-mult">${fmtMult(after)}</span>${after > before + 1e-9 ? ' ▲' : ''}</span>`;
}

/* ── 손패 ── */
function cardUsable(idx){
  if(run.phase !== 'premarket') return false;
  const card = CARD_BY_ID[run.hand[idx].id];
  if(card.target) return validTargetIds(idx).length > 0;
  return checkPlay(idx, null) === null;
}

function renderHand(){
  const box = $('handBox');
  const usable = run.hand.map((_, i) => cardUsable(i) ? '1' : '0').join('');
  const sig = run.hand.map(c => c.uid + ':' + cardCost(CARD_BY_ID[c.id])).join() + '|' + usable + '|' + run.boss + '|' + selectedIdx + '|' + run.pending.principalMult + '|' + run.pending.lev
    + '|' + run.marketCard + '|' + handCompact() + '|' + document.body.dataset.layout + '|' + run.positions.map(p => p.id + ':' + Math.round(exposure(p))).join();   // 기대값이 포지션·대기 시장 카드에 따라 바뀐다
  const deal = dealReady();
  if(sig !== handSig || deal){
    handSig = sig;
    const compact = handCompact();
    const cols = compact ? HAND_COMPACT_COLS : run.hand.length > HAND_GRID_CELLS ? HAND_GRID_WIDE_COLS : HAND_GRID_COLS;   // 모바일: 10장(HAND_MAX)이면 4열
    const fan = document.body.classList.contains('lay-f');   // 확정 레이아웃: 하단 중앙 부채꼴 (슬롯 수 HAND_MAX는 그대로)
    box.classList.toggle('fan', fan);
    box.classList.toggle('compact', compact);
    box.classList.toggle('g4', !compact && cols === HAND_GRID_WIDE_COLS);
    const n = run.hand.length, fanStep = Math.min(3.2, 24 / Math.max(1, n));
    box.style.setProperty('--nm1', String(Math.max(1, n - 1)));
    const cells = fan ? n : compact ? cols * Math.max(1, Math.ceil(run.hand.length / cols)) : cols * HAND_GRID_ROWS;   // 컴팩트: 필요한 행만, 마지막 행의 빈 칸만 점선 슬롯
    box.innerHTML = run.hand.map((inst, i) => {
          const card = CARD_BY_ID[inst.id];
          const cls = (usable[i] === '1' ? '' : 'disabled' + (handBossBlock(i) ? ' boss-blocked' : '')) + (i === selectedIdx ? ' selected' : '') + (usable[i] === '1' && boostsSettle(i) ? ' boost' : '');
          const cost = card.stock ? stockCost(STOCK_BY_ID[card.stock]) : 0;
          const ft = i - (n - 1) / 2, fanStyle = fan ? ` style="--kx:${ft.toFixed(2)};--fr:${(ft * fanStep).toFixed(2)};--fy:${(ft * ft * (n > 6 ? 0.55 : 0.9)).toFixed(2)};--fi:${i + 1}"` : '';
          return handCardHtml(card, { attrs: `data-idx="${i}"${fanStyle}`, cls, cost, ap: cardCost(card), reason: usable[i] === '1' ? '' : cardReason(i) });
        }).join('') + '<div class="g-slot"></div>'.repeat(Math.max(0, cells - run.hand.length));   // 빈 칸 = 점선 슬롯
    if(deal) playDeal(box);
  }
}

/* (S5-25) 지금 쓰면 오늘 예상 정산 배수가 오르는 카드: 종목 카드는 hypotheticalBuy로 previewSettlement를 비교,
   정산 배수를 직접 곱하는 카드(곱하기 카드)는 보유 포지션이 있으면. 엔진 상태는 바꾸지 않는다 */
const SETTLE_BOOST_CARDS = ['levEtf', 'split', 'allIn', 'coinFlip', 'futures', 'timeLoop', 'reinvest'];
function boostsSettle(i){
  const card = CARD_BY_ID[run.hand[i].id];
  if(card.stock) return previewSettlement(hypotheticalBuy(card.stock)).mult > previewSettlement().mult + 1e-9;
  if(card.type === 'report') return run.positions.some(p => STOCK_BY_ID[p.assetId].sector === card.sector);   // (N3) 들고 있는 섹터의 리포트
  return SETTLE_BOOST_CARDS.indexOf(card.base) >= 0 && run.positions.length > 0;
}

/* 카드 기대값 표시 (엔진 expectedValue). 대상 카드(리딩방·작전 세력)는 수익률 + 보유 종목별 금액을 툴팁으로 */
const fmtEv = v => (v >= 0.5 ? '+' : v <= -0.5 ? '−' : '±') + '₩' + formatKrw(Math.abs(v));
const evCls = v => v >= 0.5 ? 'pos' : v <= -0.5 ? 'neg' : 'zero';
function cardEvView(card){
  const e = expectedValue(card, null);
  if(!e) return null;
  if(card.target === 'asset'){
    const held = STOCKS.filter(s => heldExposure(s.id) !== 0).map(s => `${s.name} ${fmtEv(expectedValue(card, s).ev)}`);
    return { text: `EV ${e.rate >= 0 ? '+' : '−'}${Math.abs(e.rate * 100).toFixed(1)}%`, cls: e.rate >= 0 ? 'pos' : 'neg',
             title: `${e.note} = 보유분의 ${fmtPct(e.rate)}` + (held.length ? '\n' + held.join('\n') : '\n(보유 종목 없음 — 대상 종목 보유분에만 적용)') };
  }
  return { text: 'EV ' + fmtEv(e.ev), cls: evCls(e.ev), title: `${e.note} (장세 확률 × 지수 기대 드리프트 → 보유 포지션, 갭·되돌림 제외)` };
}

/* ── 보유 포지션 ── */
/* 예약주문·존버·다이아·유물 태그 = 아이콘만 (설명은 호버) */
function orderIcons(p){
  const t = [];
  if(p.stopLoss)       t.push(['✂', `손절 예약 ${fmtPct(p.stopLoss)}`, 'stop']);
  if(p.takeProfit)     t.push(['🎯', `익절 예약 ${fmtPct(p.takeProfit)}`, 'take']);
  if(p.trailing)       t.push(['〰', `트레일링 스탑 ${Math.round(TRAIL_GAP * 100)}%p`, 'trail']);
  if(p.protectedToday) t.push(['🛡', '존버: 오늘 청산 면제', 'hodl']);
  if(p.diamond)        t.push(['💎', `다이아몬드 핸드: 이번 주 매도 불가 · 결산 보너스 ${pct(p.diamond)}`, 'diamond']);
  if(gukbapApplies(p)) t.push(['🍲', `국밥 정신: 그날 손실의 ${Math.round(RELIC_GUKBAP_LOSS_CUT * 100)}%를 장 마감 정산에서 환급`, 'relic-on']);
  if(sealApplies(p))   t.push(['🔏', `존버의 인장: 장 마감 정산 ×${1 + RELIC_SEAL_BONUS}`, 'relic-on']);
  return t.map(([ic, tip, c]) => `<span class="o-ic ${c}" title="${tip}">${ic}</span>`).join('');
}

/* ── 전투 화면(body.lay-f) 보유 패널: 포지션 단위 목록 (같은 종목·방향·레버리지는 엔진이 이미 합친 것 그대로) ──
   헤더 = 총 평가손익(금액·%) + 총 원금. 행 = 종목명 · 롱/숏 · 배율 · N일째 · 평단→현재가 · 손익(금액·%) · 가운데 기준 손익 막대 · 매도.
   순서 = 종목 시세 그룹 순서(GROUP_ORDER). 스크롤 없음: 1열에 다 안 들어가면 2열, 그래도 넘치면 손익 절댓값 큰 순 + '외 N건 합계' 한 줄 */
const HOLD_ROW_U = 18.29;   // 행 높이 (1080p 32px ÷ 1.75) — CSS --h-row와 같은 값
const HOLD_BAR_MIN = 0.05;
const HOLD_NAME_MIN = 4;     // 종목명은 최소 4글자 폭은 보이게  // 손익 막대 눈금: 보이는 행 중 가장 큰 |수익률|(최소 5%)이 막대 끝
function holdLayout(){
  const ps = run.positions, box = $('positionsBox');
  const rh = HOLD_ROW_U * uiScale, cap1 = box.clientHeight > 0 ? Math.max(1, Math.floor((box.clientHeight + 0.5) / rh)) : 8;
  const byGroup = ps.slice().sort((a, b) => quoteRank(a.assetId) - quoteRank(b.assetId) || a.id - b.id);
  if(ps.length <= cap1) return { mode: 'c1', shown: byGroup, rest: [] };
  if(ps.length <= cap1 * 2) return { mode: 'c2', shown: byGroup, rest: [] };
  const big = ps.slice().sort((a, b) => Math.abs(posPnl(b)) - Math.abs(posPnl(a)) || a.id - b.id);
  return { mode: 'c2', shown: big.slice(0, cap1 * 2 - 1), rest: big.slice(cap1 * 2 - 1) };
}
function renderHoldings(){
  const box = $('positionsBox'), ps = run.positions;
  const tot = ps.reduce((a, p) => a + posPnl(p), 0), prin = ps.reduce((a, p) => a + p.principal, 0);
  $('holdPanel').classList.toggle('empty', ps.length === 0);
  const tt = `${fmtSigned(tot)} (${fmtPct(prin ? tot / prin : 0)})`;
  if($('holdTotal').textContent !== tt) $('holdTotal').textContent = tt;
  $('holdTotal').className = 'hh-total ' + (tot >= 0 ? 'pnl-up' : 'pnl-down');
  const pt = `원금 ${fmtMoney(prin)}`;
  if($('holdPrin').textContent !== pt) $('holdPrin').textContent = pt;
  const L = ps.length ? holdLayout() : { mode: 'c1', shown: [], rest: [] };
  const sig = 'F|' + L.mode + '|' + L.shown.map(p => [p.id, p.lev, p.dir, p.daysHeld, p.diamond, p.protectedToday, canSell(p)].join(':')).join() + '|' + L.rest.length + '|' + run.noSellToday + run.allProtectedToday;
  if(sig !== posSig){
    posSig = sig;
    box.className = 'positions-wrap hold-list ' + L.mode;
    box.innerHTML = ps.length === 0
      ? `<div class="empty-note hold-empty">보유 종목 없음 · 종목 카드를 써서 매수</div>`
      : L.shown.map(p => `
        <div class="pos-item hold-row" data-id="${p.id}" data-asset="${p.assetId}">
          <span class="h-name">${p.name}</span>
          <span class="h-badges"><span class="h-dir ${p.dir < 0 ? 'short' : 'long'}">${p.dir < 0 ? '숏' : '롱'}</span><span class="h-lev${p.lev > 1 ? ' on' : ''}">${p.lev}x</span></span>
          <span class="h-days">${p.daysHeld}일째</span>
          <span class="h-price" data-f="price"></span>
          <span class="h-pnl" data-f="pnl"><span data-f="amt"></span> <span class="h-pct" data-f="pct"></span></span>
          <span class="h-bar" aria-hidden="true"><i data-f="bar"></i></span>
          <button class="btn-chunky sm sell-btn" data-sell="${p.id}" ${canSell(p) ? '' : 'disabled'}>매도</button>
        </div>`).join('')
        + (L.rest.length ? `<div class="hold-more" data-f="more"></div>` : '');
  }
  const scale = Math.max(HOLD_BAR_MIN, ...L.shown.map(p => Math.abs(posReturn(p))));
  const targets = selectedTargets('position');
  L.shown.forEach(p => {
    const el = box.querySelector(`[data-id="${p.id}"]`);
    if(!el) return;
    el.classList.toggle('targetable', targets.indexOf(p.id) >= 0);
    const fl = flameLevel(p);
    [1, 2, 3].forEach(k => el.classList.toggle('flame-' + k, fl === k));
    el.classList.toggle('fx-danger', posInDanger(p));
    const pnl = posPnl(p), r = posReturn(p);
    posPnlSnap[p.id] = pnl;   // (C9) 전량 매도 폭포용
    el.classList.toggle('h-up', pnl >= 0); el.classList.toggle('h-down', pnl < 0);
    const pr = `${fmtPrice(avgPrice(p))}→${fmtPrice(assets[p.assetId].price)}`, pe = el.querySelector('[data-f=price]');
    if(pe.textContent !== pr) pe.textContent = pr;
    const pv = el.querySelector('[data-f=pnl]'), amt = fmtSigned(pnl), pc = fmtPct(r);
    if(pv.firstElementChild.textContent !== amt) pv.firstElementChild.textContent = amt;
    if(pv.lastElementChild.textContent !== pc) pv.lastElementChild.textContent = pc;
    pv.className = 'h-pnl ' + (pnl >= 0 ? 'pnl-up' : 'pnl-down');
    const bar = el.querySelector('[data-f=bar]'), w = Math.min(50, Math.abs(r) / scale * 50).toFixed(1) + '%';
    bar.className = r >= 0 ? 'up' : 'down';
    if(bar.style.width !== w) bar.style.width = w;
    const tip = `${p.name} ${p.dir < 0 ? '숏' : '롱'} ${p.lev}x · 보유 ${p.daysHeld}일째 · 평단 ${fmtPrice(avgPrice(p))} → 현재 ${fmtPrice(assets[p.assetId].price)}`
      + ` · 원금 ₩${formatKrw(p.principal)} · 노출 ${fmtMoney(exposure(p))} · 손익 ${fmtSigned(pnl)} (${fmtPct(r)})`
      + (isMarginable(p) ? `\n심지 ${Math.round(fuseLeft(p) * 100)}% — ${marginText(p)}${isProtected(p) ? ' · 오늘 면제' : ''}` : '')
      + (orderIcons(p) ? '\n' + [...orderIcons(p).matchAll(/title="([^"]*)"/g)].map(m => m[1]).join(' · ') : '');   // 예약주문·보호 아이콘은 툴팁 글로
    if(el.title !== tip) el.title = tip;
  });
  // 칸이 좁아 종목명이 HOLD_NAME_MIN자보다 좁아지면: 평단→현재가 → N일째 순서로 행 툴팁에 넘긴다 (글자를 줄이지 않는다)
  if(L.shown.length){
    const fits = () => [...box.querySelectorAll('.h-name')].every(n => n.clientWidth >= n.scrollWidth - 1 || n.clientWidth >= HOLD_NAME_MIN * parseFloat(getComputedStyle(n).fontSize))
      && [...box.querySelectorAll('.hold-row')].every(r => { const b = r.querySelector('.sell-btn'); return !b || (b.getBoundingClientRect().right <= r.getBoundingClientRect().right + 1 && b.scrollWidth <= b.clientWidth + 1); });   // 매도 버튼까지 행 안에
    box.classList.remove('tight1', 'tight2');
    if(!fits()){ box.classList.add('tight1'); if(!fits()) box.classList.add('tight2'); }
  }
  const more = box.querySelector('[data-f=more]');
  if(more){
    const sum = L.rest.reduce((a, p) => a + posPnl(p), 0), t = `외 ${L.rest.length}건 합계 ${fmtSigned(sum)}`;
    if(more.textContent !== t) more.textContent = t;
    more.className = 'hold-more ' + (sum >= 0 ? 'pnl-up' : 'pnl-down');
  }
}

function renderPositions(){
  const box = $('positionsBox');
  if(document.body.classList.contains('lay-f')){
    renderHoldings();
    document.body.classList.toggle('no-pos', run.positions.length === 0);
    markHeldQuotes();
    return;
  }
  if(box.className !== 'positions-wrap px-panel tx-ledger') box.className = 'positions-wrap px-panel tx-ledger';   // 전투 화면에서 돌아오면 원래 패널로
  const sig = run.positions.map(p => [p.id, p.lev, p.dir, Math.round(p.principal), p.stopLoss, p.takeProfit, p.trailing, p.protectedToday, p.diamond, p.daysHeld].join(':')).join() + '|' + run.relics.join()
    + '|' + run.noSellToday + run.allProtectedToday + '|' + document.body.dataset.layout;
  if(sig !== posSig){
    posSig = sig;
    box.innerHTML = run.positions.length === 0
      ? `<div class="empty-note pos-empty">── NO POSITION ──<small>장전에 종목 카드를 써서 매수하세요</small></div>`
      : run.positions.map(p => `
        <div class="pos-item px-panel" data-id="${p.id}">
