}
.pack:hover{
  box-shadow:0 0 0 2px var(--purple),0 0 0 4px #000,5px 5px 0 #000;
  transform:translate(-2px,-2px);
}
.tabnav button.locked{color:var(--line);cursor:not-allowed;}
.tabnav button.alert{color:var(--red);animation:blink 1s step-end infinite;}

/* 유물 */
.relic-bar{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin:2px 0 8px;font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);}
.relic-bar .relic-label{color:var(--gold);margin-right:2px;}
.relic{
  width:30px;height:30px;padding:0;border:none;cursor:pointer;font-size:17px;font-family:'Press Start 2P','Galmuri-17px',monospace;line-height:30px;
  background:var(--panel2);box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;
}
.relic.uncommon{box-shadow:0 0 0 2px var(--green2),2px 2px 0 #000;}
.relic.rare{box-shadow:0 0 0 2px var(--blue),2px 2px 0 #000;}
.relic.legendary{box-shadow:0 0 0 2px var(--purple),2px 2px 0 #000;}
.relic.mythic{box-shadow:0 0 0 2px var(--gold),2px 2px 0 #000;}
.relic:hover,.relic.on{transform:translate(-1px,-2px);background:var(--panel);}
.relic.on{box-shadow:0 0 0 2px var(--text),3px 3px 0 #000;}
.relic-empty{font-family:'VT323','GalmuriV-15px',monospace;font-size:15px;}
.relic-tip{
  margin:0 0 8px;padding:8px 10px;background:#000;box-shadow:0 0 0 2px var(--gold2),3px 3px 0 #000;
  font-family:'VT323','GalmuriV-17px',monospace;font-size:17px;line-height:1.2;color:var(--text);
}
.relic-tip b{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;font-weight:normal;color:var(--gold);}
.relic-tip i{display:block;margin-top:4px;color:var(--muted);}
.relic-tile{
  width:170px;display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 8px;text-align:center;
  background:var(--panel2);box-shadow:0 0 0 2px var(--line),0 0 0 4px #000,3px 3px 0 #000;
}
.relic-tile.uncommon{box-shadow:0 0 0 2px var(--green2),0 0 0 4px #000,3px 3px 0 #000;}
.relic-tile.rare{box-shadow:0 0 0 2px var(--blue),0 0 0 4px #000,3px 3px 0 #000;}
.relic-tile.legendary{box-shadow:0 0 0 2px var(--purple),0 0 0 4px #000,3px 3px 0 #000;}
.relic-tile.mythic{box-shadow:0 0 0 2px var(--gold),0 0 0 4px #000,3px 3px 0 #000;}
.relic-tile[data-relic-reward]{cursor:pointer;}
.relic-tile[data-relic-reward]:hover{transform:translate(-2px,-2px);}
.relic-tile .rt-icon{font-size:26px;font-family:'VT323','GalmuriV-26px',monospace;}
.relic-tile .rt-name{font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;color:var(--text);line-height:1.5;}
.relic-tile .c-rar{font-family:'Press Start 2P','Galmuri-6px',monospace;font-size:6px;}
.relic-tile .rt-desc{font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;line-height:1.1;color:var(--text);}
.relic-tile .rt-flavor{font-family:'VT323','GalmuriV-14px',monospace;font-size:14px;line-height:1.1;color:var(--muted);}
.relic-row{display:flex;flex-wrap:wrap;gap:14px;padding:6px 4px 12px;}
.o-tag.relic-on{color:var(--gold);}
.tabnav button.locked:hover{color:var(--muted);}
.shop-locked{
  margin-top:24px;padding:28px 18px;text-align:center;background:var(--panel);
  box-shadow:0 0 0 2px var(--line),4px 4px 0 #000;
  font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;color:var(--muted);line-height:1.8;
}
.shop-locked small{display:block;margin-top:10px;font-family:'VT323','GalmuriV-18px',monospace;font-size:18px;}
.shop-bar{
  display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;
  padding:10px 12px;background:#000;box-shadow:0 0 0 2px var(--purple),3px 3px 0 #000;
  font-family:'Press Start 2P','Galmuri-8_5px',monospace;font-size:8.5px;line-height:2;color:var(--muted);
}
.shop-bar b{color:var(--gold);font-weight:normal;}
.slush-amt{color:var(--gold);font-weight:normal;}
.slush-line{font-family:'Press Start 2P','Galmuri-6_5px',monospace;font-size:6.5px;color:var(--muted);margin-top:6px;white-space:nowrap;}
.shop-bar .open-btn{width:auto;margin:0;padding:10px 14px;font-size:9px;font-family:'Press Start 2P','Galmuri-9px',monospace;}
.shop-note{font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;color:var(--muted);margin:6px 2px 0;}
.pack-row{gap:16px;padding:6px 6px 10px;flex-wrap:wrap;overflow:visible;}
.pack-col{display:flex;flex-direction:column;gap:8px;width:170px;}
.pack{width:100%;height:auto;min-height:150px;gap:7px;padding:12px 8px;border:none;color:var(--text);}
.pack .pk-icon{font-size:24px;font-family:'VT323','GalmuriV-24px',monospace;}
.pack .pk-price{color:var(--gold);font-size:9px;font-family:'Press Start 2P','Galmuri-9px',monospace;}
.pack .pk-odds{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 8px;font-size:7.5px;font-family:'Press Start 2P','Galmuri-7_5px',monospace;color:var(--muted);}
.pack .pk-desc{font-family:'VT323','GalmuriV-15px',monospace;font-size:15px;color:var(--muted);}
.pack.disabled,.pack:disabled{opacity:.4;cursor:not-allowed;transform:none;}
.pk-detail{font-family:'VT323','GalmuriV-15px',monospace;font-size:15px;color:var(--muted);}
.pk-detail summary{cursor:pointer;font-family:'Press Start 2P','Galmuri-6_5px',monospace;font-size:6.5px;color:var(--cyan);}
.pk-detail ol{margin:6px 0 0;padding-left:0;list-style:none;max-height:180px;overflow-y:auto;}
.pk-detail li{display:flex;justify-content:space-between;gap:6px;padding:1px 4px;}
.pk-detail li:nth-child(odd){background:var(--panel);}
.deck-list.shop-singles,.deck-list.shop-remove{justify-content:flex-start;max-height:none;overflow:visible;}
.shop-item{display:flex;flex-direction:column;align-items:center;gap:10px;}
.buy-btn{
  border:none;cursor:pointer;padding:7px 10px;min-width:108px;
  font-family:'Press Start 2P','Galmuri-7_5px',monospace;font-size:7.5px;background:var(--green-dim);color:var(--green);
  box-shadow:0 0 0 2px var(--green2),2px 2px 0 #000;
}
.buy-btn:disabled{background:var(--panel);color:var(--muted);box-shadow:0 0 0 2px var(--line);cursor:not-allowed;}
.shop-remove .card[data-shop-remove]{cursor:pointer;}
.shop-remove .card.picked{transform:translate(-2px,-5px);box-shadow:0 0 0 2px var(--red),0 0 0 4px #000,5px 7px 0 #000;}
.shop-remove-btn{max-width:360px;}

/* 팩 개봉: 카드가 한 번 뒤집히는 것뿐 */
.flip-stage{perspective:600px;display:flex;justify-content:center;padding:10px 0 16px;}
.flip-card{position:relative;width:108px;height:158px;transform-style:preserve-3d;animation:cardFlip .6s steps(6) .2s both;}
@keyframes cardFlip{from{transform:rotateY(180deg);}to{transform:rotateY(0);}}
.flip-face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;}
.flip-face .card{cursor:default;}
.flip-back{
  transform:rotateY(180deg);display:flex;align-items:center;justify-content:center;
  background:var(--panel2);box-shadow:0 0 0 2px var(--purple),0 0 0 4px #000,3px 3px 0 #000;
  font-family:'Press Start 2P','Galmuri-22px',monospace;font-size:22px;color:var(--purple);
}
@media (prefers-reduced-motion: reduce){ .flip-card{animation:none;} }

/* ═══════════════════════════════════════════════════════════
   04 EVENT
═══════════════════════════════════════════════════════════ */
#screen-event{
  min-height:calc(100vh - 40px);
  align-items:center;justify-content:center;
  padding:20px;
}
#screen-event.active{display:flex;}
.phone-noti{
  width:100%;max-width:360px;
  background:var(--panel);
  box-shadow:0 0 0 2px var(--gold2),0 0 0 4px #000,6px 6px 0 #000;
  padding:18px;
}
.noti-headline{
  font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;
  color:var(--gold);margin-bottom:8px;
  text-shadow:1px 1px 0 #5c3d00;
}
.noti-body{
  font-family:'VT323','GalmuriV-18px',monospace;font-size:18px;
  color:var(--text);line-height:1.4;margin-bottom:16px;
}
.choice{
  display:block;width:100%;text-align:left;border:none;color:var(--text);
  box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;
  padding:11px 13px;margin-bottom:10px;cursor:pointer;
  background:var(--panel2);
  font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;
  transition:none;
}
.choice .ch-label{display:block;line-height:1.6;}
.choice.risky .ch-label{color:var(--red);}
.choice.safe .ch-label{color:var(--green);}
.choice .ch-meta{display:block;margin-top:5px;font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;color:var(--muted);}
.tip-box{width:100%;max-width:420px;display:flex;flex-direction:column;gap:18px;}
.tip-box .phone-noti{max-width:none;}
.tip-empty{text-align:center;font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;color:var(--muted);line-height:1.8;}
.tip-empty small{display:block;margin-top:8px;font-family:'VT323','GalmuriV-17px',monospace;font-size:17px;}
.tip-result{
  margin-top:4px;padding:12px;text-align:center;background:#000;
  font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;line-height:1.8;
}
.tip-result b{display:block;margin-top:6px;font-size:14px;font-family:'Press Start 2P','Galmuri-14px',monospace;font-weight:normal;}
.tip-result.up{color:var(--green);box-shadow:0 0 0 2px var(--green2);}
.tip-result.down{color:var(--red);box-shadow:0 0 0 2px var(--red2);}
.tip-result.flat{color:var(--gold);box-shadow:0 0 0 2px var(--gold2);}
.tip-log{list-style:none;margin:0;padding:0;font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;color:var(--muted);}
.tip-log li{display:flex;justify-content:space-between;gap:10px;padding:4px 6px;}
.tip-log li span:last-child{white-space:nowrap;}
.tip-log li:nth-child(odd){background:var(--panel);}
.tip-log li:first-child{color:var(--text);}
.overlay-box .noti-headline{text-align:left;}
.overlay-box .noti-body{text-align:left;}
.choice:hover{
  box-shadow:0 0 0 2px var(--gold2),4px 4px 0 #000;
  transform:translate(-2px,-2px);
}

.footnote{
  text-align:center;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;
  color:var(--muted);padding:18px 20px 10px;
}

.px-corner-box{position:relative;}
.px-corner-box::before,.px-corner-box::after{
  content:'';position:absolute;width:8px;height:8px;
  border-color:var(--cyan);border-style:solid;
  z-index:5;pointer-events:none;
}
.px-corner-box::before{top:2px;left:2px;border-width:2px 0 0 2px;}
.px-corner-box::after{bottom:2px;right:2px;border-width:0 2px 2px 0;}

/* ═══════════════════════════════════════════════════════════
   RUN STRUCTURE / 종목 시세 / 덱 · 턴 / 포지션
═══════════════════════════════════════════════════════════ */
.hud{
  display:flex;align-items:center;gap:8px;margin-bottom:10px;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--cyan);
}
.day-track{flex:1;height:8px;background:#000;box-shadow:0 0 0 2px var(--line);}
.hud-col{margin-bottom:10px;}
.hud-col .hud{margin-bottom:8px;}
.fss{
  display:flex;align-items:center;gap:8px;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);
}
.fss-label{white-space:nowrap;}
.fss-track{flex:1;height:6px;background:#000;box-shadow:0 0 0 2px var(--line);}
.fss-fill{height:100%;width:0;background:var(--green2);}
.fss-state{white-space:nowrap;min-width:9em;text-align:right;}
.fss.warm .fss-fill{background:var(--gold2);}
.fss.warm .fss-state{color:var(--gold);}
.fss.hot .fss-fill{background:var(--red);}
.fss.hot .fss-label,.fss.hot .fss-state{color:var(--red);animation:blink 1s step-end infinite;}
.fss-verdict{
  margin:12px 0;padding:12px;background:#000;box-shadow:0 0 0 2px var(--red2);
  font-family:'VT323','GalmuriV-22px',monospace;font-size:22px;color:var(--text);text-align:center;line-height:1.3;
}
.fss-verdict b{color:var(--red);}
.fss-verdict small{font-size:16px;font-family:'VT323','GalmuriV-16px',monospace;color:var(--muted);}
.day-fill{height:100%;width:0;background:var(--cyan);}

.target-line{
  display:flex;justify-content:space-between;margin-top:9px;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);
}
.target-track{height:6px;background:#000;box-shadow:0 0 0 2px var(--line);margin-top:6px;}
.target-fill{height:100%;width:0;background:var(--gold2);}
.target-fill.done{background:var(--green);}

.quotes{display:flex;flex-direction:column;gap:5px;margin-bottom:4px;}
.quote-row{
  display:grid;grid-template-columns:1fr 64px 62px 50px;align-items:center;gap:6px;
  background:var(--panel);box-shadow:0 0 0 2px var(--line);
  padding:5px 8px;font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;
}
.q-name{font-size:8px;font-family:'Press Start 2P','Galmuri-8px',monospace;color:var(--text);}
.q-name small{display:block;font-size:6px;font-family:'Press Start 2P','Galmuri-6px',monospace;color:var(--muted);margin-top:3px;}
.quote-row canvas{width:64px;height:18px;display:block;image-rendering:pixelated;}
.q-price,.q-chg{text-align:right;}
.q-tag{font-size:6px;font-family:'Press Start 2P','Galmuri-6px',monospace;margin-left:5px;}
.q-tag.hidden{color:var(--purple);}
.q-tag.up{color:var(--green);}
.q-tag.down{color:var(--red);}
.q-tag.gap{color:var(--bg);background:var(--gold);padding:1px 2px;}
/* 읽을 수 있는 시장: 시그널 · 어제 채점 · 기대값 */
.q-sig{display:block;font-size:6px;font-family:'Press Start 2P','Galmuri-6px',monospace;color:var(--muted);margin-top:3px;line-height:1.4;white-space:nowrap;}
.q-sig .s-UP{color:var(--green);} .q-sig .s-DOWN{color:var(--red);} .q-sig .s-HOT{color:var(--gold);} .q-sig .s-FLAT{color:var(--text);}
.q-sig .s-rev{color:var(--cyan);}
.q-sig .hit{color:var(--green);} .q-sig .miss{color:var(--red);}
.c-ev{font-size:6px;font-family:'Press Start 2P','Galmuri-6px',monospace;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4;}
.c-ev.pos,.ch-ev.pos{color:var(--green);} .c-ev.neg,.ch-ev.neg{color:var(--red);} .c-ev.zero,.ch-ev.zero{color:var(--muted);}
.choice .ch-ev{display:block;margin-top:3px;font-family:'VT323','GalmuriV-16px',monospace;font-size:16px;}

/* 대상 지정 가능 */
.quote-row.targetable,.pos-item.targetable{
  cursor:pointer;background:rgba(255,215,0,.07);
  box-shadow:0 0 0 2px var(--gold),3px 3px 0 #000;
}

/* 행동력 · 더미 */
.turn-bar{
  display:flex;align-items:center;gap:8px;margin:14px 0 8px;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);
}
.ap-pips{display:flex;gap:4px;}
.ap-pip{width:10px;height:10px;background:#000;box-shadow:0 0 0 2px var(--gold2);}
.ap-pip.on{background:var(--gold);}
.ap-text{color:var(--gold);}
.pile-text{flex:1;text-align:right;}
.deck-btn,.back-btn{
  border:none;cursor:pointer;background:var(--panel);color:var(--cyan);
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;padding:5px 7px;white-space:nowrap;flex:none;
  box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;
}
.deck-btn:hover,.back-btn:hover{box-shadow:0 0 0 2px var(--cyan),2px 2px 0 #000;}

.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;}
.chips:empty{display:none;}
.chip{
  font-family:'Press Start 2P','Galmuri-6_5px',monospace;font-size:6.5px;padding:4px 6px;background:#000;
  color:var(--gold);box-shadow:0 0 0 2px var(--gold2);
}
.chip.buy{color:var(--green);box-shadow:0 0 0 2px var(--green2);}
.chip.short{color:var(--red);box-shadow:0 0 0 2px var(--red2);}
