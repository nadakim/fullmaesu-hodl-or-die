<script>
/* ══════════════════════════════════════════════════════════
   CONFIG — 밸런스 수치는 전부 여기서 조절
══════════════════════════════════════════════════════════ */
const START_CASH        = 10000;   // 시작 자금 (만원) = 1억
const TICK_MS           = 800;     // 캔들 1개 = 0.8초
const TICKS_PER_DAY     = 12;      // 하루 = 캔들 12개 (약 10초)
const DAYS_PER_ROUND    = 5;       // 1주(라운드) = 5거래일
const ROUND_TARGETS     = [11000, 12500, 14500, 17000, 20000, 24000, 29000, 35000]; // 주차별 순자산 목표 (만원)
const MAX_ROUND         = ROUND_TARGETS.length;
const DAILY_INTEREST    = 0.004;   // 신용이자: 장 마감마다 대출금의 0.4% (게임용 과장)
const MAINTENANCE_RATIO = 1.40;    // 담보비율 140% 미만 → 반대매매
const WARN_RATIO        = 1.70;    // 이 아래부터 위험 경고
const IDX_SENS          = 0.6;     // 지수 움직임이 종목에 전달되는 비율 (× beta)
const IDIO_SCALE        = 0.25;    // 종목 고유 변동 크기 (× volatility)
const ASSET_HISTORY     = 30;      // 시세 스파크라인 길이
const EVENT_DURATION    = 15;      // 시장 이벤트 지속 틱
const LEVERAGE_OPTIONS  = [1, 2, 3]; // 현금 / 신용 / 영끌

/* 카드 = 종목. 이제 종목마다 자기 가격(basePrice)을 따로 가진다. */
const CARD_DATABASE = [
  { id:'semi',   name:'반도체전자', sector:'우량주',   cost:1000, beta:1.0, volatility:0.02, basePrice:72000, desc:'안정형 / 지수 추종' },
  { id:'coin',   name:'대장코인',   sector:'암호화폐', cost:1500, beta:2.5, volatility:0.08, basePrice:95000, desc:'고위험 / 변동성 극대' },
  { id:'sc',     name:'초전도체',   sector:'테마주',   cost:800,  beta:3.8, volatility:0.12, basePrice:12000, desc:'하이리스크' },
  { id:'gukbap', name:'국밥제약',   sector:'방어주',   cost:500,  beta:0.4, volatility:0.01, basePrice:8500,  desc:'하락장에 강함' },
  { id:'meme',   name:'밈코인',     sector:'동전주',   cost:300,  beta:5.0, volatility:0.20, basePrice:420,   desc:'급등락 심함' }
];
const MIN_CARD_COST = Math.min(...CARD_DATABASE.map(c => c.cost));

/* 지수(메인 캔들 차트) — 시장 전체 분위기 */
let marketPrice = 1000;
let marketState = 'NORMAL';


/* ══════════════════════════════════════════════════════════
   PIXEL BACKGROUND CANVAS
══════════════════════════════════════════════════════════ */
const bgCanvas = document.getElementById('candleBg');
const bctx = bgCanvas.getContext('2d', {antialias: false});

function resizeBg(){
  bgCanvas.width = Math.floor(window.innerWidth);
  bgCanvas.height = Math.floor(window.innerHeight);
}
resizeBg();
window.addEventListener('resize', resizeBg);

function drawBgGrid(){
  const W = bgCanvas.width, H = bgCanvas.height;
  bctx.clearRect(0,0,W,H);

  bctx.fillStyle = 'rgba(2,4,10,0.88)';
  bctx.fillRect(0,0,W,H);

  bctx.fillStyle = 'rgba(26,34,64,0.4)';
  for(let x=0;x<W;x+=10){
    for(let y=0;y<H;y+=10){
      bctx.fillRect(x,y,1,1);
    }
  }
}
setInterval(drawBgGrid, 500);
drawBgGrid();

/* ══════════════════════════════════════════════════════════
   HIGH-DENSITY BACKGROUND CHART MANAGER
   수십 개의 정보가 양옆에서 상시 움직이는 레트로 증권 거래소 연출
══════════════════════════════════════════════════════════ */
class HighDensityBgManager {
  constructor() {
    this.container = document.getElementById('bgChartContainer');
    this.activeCharts = [];
    this.maxCharts = 36; // 밀도 높임 (최대 36개)
    this.symbols = ['KORX', 'TECH', 'MOON', 'DOGE', 'HODL', 'YOLO', 'NVDA', 'BTC', 'ETH', 'MEME', 'TSLA', 'SPY', 'SOXL', 'SQQQ', 'NQ1!'];
    this.phrases = ['BUY', 'SELL', 'HOLD', '▲ LIMIT UP', '▼ PANIC', 'FOMO', 'REKT', 'GAZUA', 'RALLY', 'DUMP', 'WHALE', 'SQUEEZE'];
    
    this.spawnTimer = null;
    this.animLoopId = null;
  }

  init() {
    if (!this.container) return;
    
    // 초기 시작 시 양쪽에 즉시 풍부한 배경 요소 생성 (비어보이지 않게 처리)
    for (let i = 0; i < 10; i++) {
      this.spawnChart('left', true);
      this.spawnChart('right', true);
    }

    this.startSpawning();
    this.startAnimationLoop();
  }

  startSpawning() {
    // 250ms ~ 600ms 간격으로 빠르게 계속 스폰
    const nextInterval = 250 + Math.random() * 350;
    this.spawnTimer = setTimeout(() => {
      if (this.activeCharts.length < this.maxCharts) {
        const side = Math.random() > 0.5 ? 'left' : 'right';
        this.spawnChart(side, false);
      }
      this.startSpawning();
    }, nextInterval);
  }

  spawnChart(side, isInitial = false) {
    const card = document.createElement('div');
    const isUp = Math.random() > 0.45;
    card.className = `ambient-chart-card ${isUp ? 'up' : 'down'}`;

    const sym = this.symbols[Math.floor(Math.random() * this.symbols.length)];
    const pct = (Math.random() * 35 + 0.1).toFixed(1);
    const sign = isUp ? '+' : '-';
    const tag = Math.random() > 0.5 ? this.phrases[Math.floor(Math.random() * this.phrases.length)] : `${sign}${pct}%`;

    const chartType = Math.floor(Math.random() * 4); // 0: 캔들, 1: 거래량, 2: 틱라인, 3: 미니 전광판/텍스트
    const isBig = Math.random() > 0.75;
    const width = isBig ? (110 + Math.floor(Math.random() * 40)) : (70 + Math.floor(Math.random() * 30));
    const height = isBig ? (50 + Math.floor(Math.random() * 25)) : (35 + Math.floor(Math.random() * 15));

    card.innerHTML = `
      <div class="ambient-hdr">
        <span class="sym">${sym}</span>
        <span class="${isUp ? 'chg-up' : 'chg-down'}">${tag}</span>
      </div>
      <canvas class="ambient-canvas" width="${width}" height="${height}"></canvas>
    `;

    this.container.appendChild(card);

    // 좌표 계산 (중앙 520px 메인 UI 영역 완벽 보호)
    const winWidth = window.innerWidth;
    const cabinetWidth = 540;
    const sideMargin = Math.max(10, (winWidth - cabinetWidth) / 2);

    let startX, startY, speedX, speedY;
    const isSticky = Math.random() > 0.65; // 반고정형 vs 이동형

    if (side === 'left') {
      const maxX = Math.max(10, sideMargin - width - 10);
      startX = Math.random() * maxX;
    } else {
      const minX = winWidth - sideMargin + 10;
      const maxX = Math.max(minX, winWidth - width - 10);
      startX = minX + Math.random() * (maxX - minX);
    }

    if (isInitial) {
      startY = Math.random() * (window.innerHeight - height - 40);
    } else {
      startY = Math.random() > 0.5 ? -height : window.innerHeight + 10;
    }

    // 다양한 이동 벡터
    if (isSticky) {
      speedX = (Math.random() - 0.5) * 0.08;
      speedY = (Math.random() - 0.5) * 0.12;
    } else {
      const dirY = startY < 0 ? 1 : -1;
      speedY = dirY * (0.2 + Math.random() * 0.45);
      speedX = (Math.random() - 0.5) * 0.2;
    }

    card.style.left = `${startX}px`;
    card.style.top = `${startY}px`;

    const canvas = card.querySelector('canvas');
    this.drawMiniChart(canvas, isUp, chartType);

    const lifeSpan = isSticky ? (12000 + Math.random() * 10000) : (6000 + Math.random() * 8000);
    const targetOpacity = 0.18 + Math.random() * 0.22;

    const chartObj = {
      el: card,
      x: startX,
      y: startY,
      speedX,
      speedY,
      life: isInitial ? Math.random() * (lifeSpan * 0.5) : 0,
      maxLife: lifeSpan,
      targetOpacity,
      isSticky
    };

    this.activeCharts.push(chartObj);

    requestAnimationFrame(() => {
      card.style.opacity = targetOpacity.toString();
    });
  }

  drawMiniChart(canvas, isUp, chartType) {
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    const mainColor = isUp ? '#00ff41' : '#ff1a3c';

    if (chartType === 0) { // 캔들
      const count = 6 + Math.floor(Math.random() * 5);
      const step = w / count;
      let prevPrice = h / 2;

      for (let i = 0; i < count; i++) {
        const change = (Math.random() - (isUp ? 0.38 : 0.62)) * (h * 0.35);
        const open = prevPrice;
        const close = Math.min(h - 3, Math.max(3, open + change));
        const high = Math.min(open, close) - Math.random() * 3;
        const low = Math.max(open, close) + Math.random() * 3;
        prevPrice = close;

        const candleX = Math.round(i * step + step / 4);
        const candleW = Math.max(2, Math.floor(step / 2));
        const cIsUp = close <= open;
        const col = cIsUp ? '#00ff41' : '#ff1a3c';

        ctx.fillStyle = col;
        ctx.fillRect(candleX + Math.floor(candleW / 2), Math.round(high), 1, Math.round(low - high));
        ctx.fillRect(candleX, Math.round(Math.min(open, close)), candleW, Math.max(2, Math.round(Math.abs(close - open))));
      }
    } else if (chartType === 1) { // 거래량
      const count = 9 + Math.floor(Math.random() * 4);
      const step = w / count;
      for (let i = 0; i < count; i++) {
        const barH = Math.random() * (h * 0.85) + 3;
        const barX = Math.round(i * step);
        const barW = Math.max(2, Math.floor(step - 2));
        const bIsUp = Math.random() > (isUp ? 0.3 : 0.7);

        ctx.fillStyle = bIsUp ? mainColor : '#ff1a3c';
        ctx.fillRect(barX, Math.round(h - barH), barW, Math.round(barH));
      }
    } else if (chartType === 2) { // 틱/라인
      ctx.beginPath();
      ctx.strokeStyle = mainColor;
      ctx.lineWidth = 1;

      let cx = 0;
      let cy = isUp ? h * 0.8 : h * 0.2;
      ctx.moveTo(cx, cy);

      const points = 8;
      const step = w / points;

      for (let i = 1; i <= points; i++) {
        cx = i * step;
        cy += (Math.random() - (isUp ? 0.6 : 0.4)) * (h * 0.35);
        cy = Math.min(h - 2, Math.max(2, cy));
        ctx.lineTo(cx, cy);
      }
      ctx.stroke();
    } else { // 호가/전광판 텍스트 정보
      ctx.fillStyle = mainColor;
      ctx.font = '6px "Press Start 2P"';
      const val1 = (Math.random()*9000 + 1000).toFixed(0);
      const val2 = (Math.random()*9000 + 1000).toFixed(0);
      ctx.fillText(`ASK:${val1}`, 2, Math.round(h*0.4));
      ctx.fillText(`BID:${val2}`, 2, Math.round(h*0.85));
    }
  }

  startAnimationLoop() {
    const update = () => {
      for (let i = this.activeCharts.length - 1; i >= 0; i--) {
        const c = this.activeCharts[i];
        c.life += 16;

        c.x += c.speedX;
        c.y += c.speedY;

        c.el.style.left = `${c.x}px`;
        c.el.style.top = `${c.y}px`;

        if (c.life > c.maxLife - 1200) {
          c.el.style.opacity = '0';
        }

        if (c.life >= c.maxLife || c.y < -120 || c.y > window.innerHeight + 120) {
          c.el.remove();
          this.activeCharts.splice(i, 1);
        }
      }
      this.animLoopId = requestAnimationFrame(update);
    };
    update();
  }
}

