}
.pack-row{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;}
.pack{
  min-width:108px;height:124px;flex-shrink:0;cursor:pointer;
  background:var(--panel2);
  box-shadow:0 0 0 2px #3a2a5c,0 0 0 4px #000,3px 3px 0 #000;
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;gap:8px;
