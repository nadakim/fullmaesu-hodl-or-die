const GAP_TAG_CANDLES = 4;   // 시세판 GAP 표시: 최근 캔들 몇 개 안에 갭이 있으면
let shopPickIdx = -1;
let pendingRewardToasts = [];   // 보상 선택 알림 → 암시장 화면에서 표시
let relicTipId = '', relicSig = '';   // 설명을 펼친 유물   // 보상 선택 알림 → 암시장 화면에서 표시      // 암시장 카드 제거에서 고른 덱 카드   // 큰 차트에 보이는 것: 'idx'(지수) 또는 종목 id
