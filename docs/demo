/* ── 카드 설명이 카드(124×180)에 다 안 들어가면: 첫 문장만 남기고(문구는 그대로, 뒤를 숨길 뿐) 전문은 툴팁으로 ──
   글꼴이 다 읽힌 뒤, 보이는 카드만 한 번씩 잰다 (숨은 화면의 카드는 보일 때 다시). 잘린 카드 id는 cardClampedIds에 모인다 */
const cardClampedIds = new Set();
let fontsReady = false;
function clampCards(){
  if(!fontsReady) return;
  document.querySelectorAll('.card[data-cid]:not([data-clamp])').forEach(el => {
    const d = el.querySelector('.c-desc');
    if(!d || !d.clientHeight) return;   // 안 보이는 화면
    el.dataset.clamp = '0';
    if(d.scrollHeight <= d.clientHeight + 1) return;
    const full = d.textContent.trim();
    const m = full.match(/^.*?[.!?](?=\s|$)/);
    d.textContent = m ? m[0] : full;
    d.classList.add('clamped');
    const lh = parseFloat(getComputedStyle(d).lineHeight) || 16, lines = Math.max(1, Math.floor(d.clientHeight / lh));
    d.style.webkitLineClamp = String(lines);
    d.style.maxHeight = (lines * lh) + 'px';   // flex:1로 늘어난 칸에 잘린 뒷줄이 비치지 않게
    el.dataset.clamp = '1';
    cardClampedIds.add(el.dataset.cid);
  });
}
let clampQueued = false;
const queueClamp = () => { if(clampQueued) return; clampQueued = true; requestAnimationFrame(() => { clampQueued = false; clampCards(); }); };
new MutationObserver(queueClamp).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'hidden'] });
if(document.fonts && document.fonts.ready) document.fonts.ready.then(() => { fontsReady = true; queueClamp(); }); else { fontsReady = true; }

/* 카드 툴팁: 설명 전문 · 행동력 · 종목 수치 · 기대값(손패). 마우스는 잠깐 올려 두면, 터치는 길게 누르면 */
const CARD_TIP_DELAY_MS = 280, CARD_LONGPRESS_MS = 450;
const cardTipEl = document.createElement('div');
cardTipEl.className = 'card-tip';
cardTipEl.hidden = true;
document.body.appendChild(cardTipEl);
let cardTipTimer = null, suppressClickUntil = 0;
function showCardTip(el){
  const card = CARD_BY_ID[el.dataset.cid];
  if(!card) return;
  const idx = el.dataset.idx !== undefined ? +el.dataset.idx : -1;
  const stock = card.stock ? STOCK_BY_ID[card.stock] : null;
  const ap = idx >= 0 && run ? cardCost(card) : card.ap;
  const ev = idx >= 0 && run && run.phase === 'premarket' ? cardEvView(card) : null;
  cardTipEl.innerHTML = `<b>${card.name}</b>
    <span class="ct-meta">${TYPE_LABEL[card.type]} · ${RARITY_LABEL[card.rarity]} · 행동력 ${card.type === 'status' ? '—' : ap}${card.exhaust ? ' · 소멸' : ''}${card.target ? ' · 대상 ' + TARGET_LABEL[card.target] : ''}${stock ? ` · ₩${(idx >= 0 && run ? stockCost(stock) : stock.cost).toLocaleString()}만${idx >= 0 && run ? ` · 현재가 ${fmtPrice(assets[stock.id].price)}` : ''} · ${stock.sector} · β ${stock.beta} · 변동성 ${stock.volatility}` : ''}</span>
    ${cardDesc(card)}${ev ? `<span class="ct-ev ${ev.cls}">${ev.text} — ${ev.title.replace(/\n/g, ' · ')}</span>` : ''}`;
  cardTipEl.hidden = false;
  const r = el.getBoundingClientRect(), t = cardTipEl.getBoundingClientRect();
  let x = r.left, y = r.top - t.height - 6;
  if(y < 4) y = r.bottom + 6;
  x = Math.max(4, Math.min(window.innerWidth - t.width - 4, x));
  y = Math.max(4, Math.min(window.innerHeight - t.height - 4, y));
  cardTipEl.style.left = x + 'px';
  cardTipEl.style.top = y + 'px';
}
function hideCardTip(){ clearTimeout(cardTipTimer); cardTipEl.hidden = true; }
document.addEventListener('mouseover', e => {
  const el = e.target.closest('.card[data-cid]');
  if(!el || el.closest('.card-tip')) return;
  if(e.relatedTarget && el.contains(e.relatedTarget)) return;
  clearTimeout(cardTipTimer);
  cardTipTimer = setTimeout(() => { if(el.isConnected) showCardTip(el); }, CARD_TIP_DELAY_MS);
});
document.addEventListener('mouseout', e => {
  const el = e.target.closest('.card[data-cid]');
  if(el && !(e.relatedTarget && el.contains(e.relatedTarget))) hideCardTip();
});
document.addEventListener('touchstart', e => {
  const el = e.target.closest('.card[data-cid]');
  if(!el) return;
  clearTimeout(cardTipTimer);
  cardTipTimer = setTimeout(() => { showCardTip(el); suppressClickUntil = performance.now() + 700; }, CARD_LONGPRESS_MS);
}, { passive: true });
document.addEventListener('touchend', () => { clearTimeout(cardTipTimer); setTimeout(hideCardTip, 1500); }, { passive: true });
document.addEventListener('touchmove', () => clearTimeout(cardTipTimer), { passive: true });
document.addEventListener('click', e => {   // 길게 눌러 툴팁을 본 직후의 클릭은 카드 사용으로 치지 않는다
  if(performance.now() < suppressClickUntil && e.target.closest('.card[data-cid]')){ e.stopPropagation(); e.preventDefault(); }
  hideCardTip();
}, true);
window.addEventListener('scroll', hideCardTip, true);

