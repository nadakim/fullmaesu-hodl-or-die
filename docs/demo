    BANKRUPT: { title:'반대매매 당했습니다',   color:'var(--red)',   sub:'순자산이 0원 아래로 떨어졌습니다. 계좌가 녹았습니다.' },
    MISSED:   { title:'목표 미달 · 강제 은퇴', color:'var(--gold)',  sub:`순자산 ${fmtMoney(run.endEquity)} / 목표 ${fmtMoney(currentTarget())}` },
    VICTORY:  { title:'개미 졸업!',            color:'var(--green)', sub:`${MAX_ROUND}주 연속 목표 달성. 이제 당신이 세력입니다.` }
  };
  const e = endings[reason];
  showOverlay(`
    <div class="ov-title" style="color:${e.color}">${e.title}</div>
    <div class="ov-sub">${e.sub}</div>
    <div class="ov-stats">
      ${statRow('도달 주차', `WEEK ${run.round}/${MAX_ROUND} · DAY ${run.day}`)}
      ${statRow('최종 순자산', fmtMoney(run.endEquity))}
      ${statRow('최고 순자산', fmtMoney(run.peakEquity))}
      ${statRow('확정손익', '₩ ' + fmtSigned(run.realized))}
      ${statRow('반대매매', run.liquidations + '회')}
      ${statRow('누적 이자', fmtMoney(run.interestPaid))}
      ${statRow('덱', run.masterDeck.length + '장')}
    </div>
    <button class="ov-btn" data-act="restart">▶ 다시 영끌</button>
    <button class="ov-btn alt" data-act="title">◀ 타이틀로</button>`);
  if(reason === 'VICTORY') cashRain();
}

/* ── 암시장 ── */
function renderTabs(){
  const b = document.querySelector('.tabnav button[data-s="shop"]');
  const locked = !shopOpenNow();
  b.classList.toggle('locked', locked);
  b.textContent = locked ? '03 암시장 🔒' : '03 암시장 ◈';
  b.title = locked ? '라운드 종료 후 이용 가능' : '다음 주 개장 전까지 이용 가능';
}

const fmtChance = c => (Math.round(c * 1000) / 10) + '%';

function packHtml(pk){
  const afford = run.cash >= pk.price;
  const odds = packRarityOdds(pk).map(o => `<span class="c-rar ${o.rarity}">${RARITY_LABEL[o.rarity]} ${fmtChance(o.chance)}</span>`).join('');
  const cards = packCardOdds(pk).sort((a, b) => b.chance - a.chance || CARD_ORDER[a.cardId] - CARD_ORDER[b.cardId]);
  return `
    <div class="pack-col">
      <button class="pack ${afford ? '' : 'disabled'}" data-pack="${pk.id}">
        <div class="pk-icon">${pk.icon}</div>
        <div>${pk.name}</div>
        <div class="pk-price">₩${pk.price.toLocaleString()}만</div>
        <div class="pk-odds">${odds}</div>
        <div class="pk-desc">${pk.desc}</div>
      </button>
      <details class="pk-detail">
        <summary>카드별 확률 (${cards.length}종)</summary>
        <ol>${cards.map(o => `<li><span class="c-rar ${CARD_BY_ID[o.cardId].rarity}">${CARD_BY_ID[o.cardId].name}</span><span>${fmtChance(o.chance)}</span></li>`).join('')}</ol>
      </details>
    </div>`;
}

function renderShop(){
  const box = $('shopBox');
  if(!shopOpenNow()){
    box.innerHTML = `<div class="shop-locked">🔒 라운드 종료 후 이용 가능
      <small>주간 결산에서 목표를 달성하고 보상을 고르면, 다음 주 개장 전까지 열립니다.</small></div>`;
    return;
  }
  const sh = run.shop, removeCost = shopRemoveCost();
  const singlesLeft = SHOP_SINGLE_LIMIT - sh.singlesBought.length;
  const canRemove = sh.removed < SHOP_REMOVE_LIMIT && run.masterDeck.length > MIN_DECK_SIZE;
  if(shopPickIdx >= run.masterDeck.length) shopPickIdx = -1;
  box.innerHTML = `
    <div class="shop-bar">
      <span>WEEK ${run.round} 결산 완료 · 현금 <b>${fmtMoney(run.cash)}</b> · 덱 <b>${run.masterDeck.length}장</b><br>
        다음 주 목표 <b>${fmtMoney(ROUND_TARGETS[run.round])}</b> · 순자산 <b>${fmtMoney(netEquity())}</b></span>
      <button class="open-btn" id="shopLeaveBtn">▶ WEEK ${run.round + 1} 개장</button>
    </div>
    <div class="shop-note">여기서 쓰는 돈은 현금(=순자산)에서 빠집니다. 다음 주 목표와 저울질하세요.</div>

    <span class="section-label">▌ 카드 팩 — 1장 무작위 · 희귀도 확률 공개</span>
    <div class="pack-row">${SHOP_PACKS.map(packHtml).join('')}</div>

    <span class="section-label">▌ 낱장 구매 — 원하는 카드 확정 구매 · 주 ${SHOP_SINGLE_LIMIT}장 (남은 ${singlesLeft})</span>
    <div class="deck-list shop-singles">${sh.singles.map((id, i) => {
      const bought = sh.singlesBought.indexOf(i) >= 0, price = singlePrice(id);
      const label = bought ? '구매 완료' : singlesLeft <= 0 ? '이번 주 마감' : `₩${price.toLocaleString()}만 구매`;
      return `<div class="shop-item">${cardHtml(CARD_BY_ID[id], {})}
        <button class="buy-btn" data-single="${i}" ${bought || singlesLeft <= 0 || run.cash < price ? 'disabled' : ''}>${label}</button></div>`;
    }).join('')}</div>

    <span class="section-label">▌ 카드 제거 (덱 압축) — 주 ${SHOP_REMOVE_LIMIT}회 · 이번 주 ₩${removeCost.toLocaleString()}만 (주차마다 +₩${SHOP_REMOVE_PER_WEEK}만)</span>
    <div class="deck-list shop-remove">${run.masterDeck.map((id, i) =>
      cardHtml(CARD_BY_ID[id], { attrs: canRemove ? `data-shop-remove="${i}"` : '', cls: i === shopPickIdx ? 'picked' : '' })).join('')}</div>
    <button class="ov-btn alt shop-remove-btn" id="shopRemoveBtn" ${canRemove && shopPickIdx >= 0 && run.cash >= removeCost ? '' : 'disabled'}>
      ${!canRemove ? (sh.removed >= SHOP_REMOVE_LIMIT ? '이번 주 제거 완료' : `덱 ${MIN_DECK_SIZE}장 이하 — 제거 불가`)
        : shopPickIdx < 0 ? '제거할 카드를 고르세요' : `✂ ${CARD_BY_ID[run.masterDeck[shopPickIdx]].name} 영구 제거 (₩${removeCost.toLocaleString()}만)`}
    </button>`;
}

function showPackResult(d){
  const pk = SHOP_PACK_BY_ID[d.packId], card = CARD_BY_ID[d.cardId];
  showOverlay(`
    <div class="ov-title" style="color:var(--purple)">${pk.icon} ${pk.name} 개봉</div>
    <div class="flip-stage"><div class="flip-card">
      <div class="flip-face flip-back">?</div>
      <div class="flip-face flip-front">${cardHtml(card, {})}</div>
    </div></div>
    <div class="ov-sub"><span class="c-rar ${card.rarity}">${RARITY_LABEL[card.rarity]}</span> · ${card.name} — 덱에 추가 (덱 ${d.deckSize}장)</div>
    <button class="ov-btn" data-act="close">확인</button>`);
}

$('shopBox').addEventListener('click', e => {
  if(!run) return;
  const pk = e.target.closest('[data-pack]');
  const single = e.target.closest('[data-single]');
  const rm = e.target.closest('[data-shop-remove]');
  if(pk) buyPack(pk.dataset.pack);
  else if(single) buySingle(+single.dataset.single);
  else if(rm){ const i = +rm.dataset.shopRemove; shopPickIdx = shopPickIdx === i ? -1 : i; }
  else if(e.target.closest('#shopRemoveBtn')){ if(shopRemoveCard(shopPickIdx)) shopPickIdx = -1; }
  else if(e.target.closest('#shopLeaveBtn')){
    if(shopOpenNow()){ switchTab('play'); leaveShop(); renderAll(); return; }   // 화면을 먼저 옮겨야 개장 알림이 남는다
  }
  else return;
  renderShop();
  renderTabs();
});

/* ── 카드 도감 ── */
function buildCollection(){
  const augments = CARDS.filter(c => c.type !== 'stock' && c.type !== 'status').length;
  $('collectionSub').textContent = `종목 ${STOCKS.length} · 증강 ${augments} · 상태 ${CARDS.filter(c => c.type === 'status').length}`;
  $('collectionBox').innerHTML = TYPE_ORDER.map(t => {
    const list = CARDS.filter(c => c.type === t);
    return `<div class="pile-title">▌ ${TYPE_LABEL[t]} (${list.length})</div>
      <div class="coll-grid">${list.map(c => cardHtml(c, {})).join('')}</div>`;
  }).join('');
}

/* ── 연출 (원본 유지) ── */
function showPopNum(text, isUp){
  const pop = document.createElement('div');
  pop.className = 'popnum';
  pop.style.left = (20+Math.random()*40)+'%';
  pop.style.top  = (25+Math.random()*30)+'%';
  pop.style.color = isUp ? 'var(--green)' : 'var(--red)';
  pop.style.textShadow = isUp ? '1px 1px 0 #003a14' : '1px 1px 0 #5c0010';
  pop.textContent = text;
  document.getElementById('chartBox').appendChild(pop);
  setTimeout(()=>pop.remove(), 900);
}

function cashRain(){
  const layer = document.getElementById('confettiLayer');
  const syms = ['$','₩','★','◆'];
  for(let i=0;i<18;i++){
    const b = document.createElement('div');
    b.className = 'bill';
    b.style.left = Math.random()*100+'vw';
    b.style.animationDelay = (Math.random()*.5)+'s';
    b.textContent = syms[Math.floor(Math.random()*syms.length)];
    layer.appendChild(b);
    setTimeout(()=>b.remove(), 2000);
  }
}

/* ══════════════════════════════════════════════════════════
   흐름 제어 — 탭 전환, 새 판 시작, 입력, 게임 루프
══════════════════════════════════════════════════════════ */
function startRun(){
  selectedIdx = -1;
  chartTarget = 'idx';
  handSig = ''; posSig = '';
  hideOverlay();
  resetNews();
  startNewRun();
  renderAll();
  toast(`WEEK 1 개장 — 목표 ${fmtMoney(currentTarget())} · DAY 1 장전`, 'good');
}

const tabBtns = document.querySelectorAll('.tabnav button');
const screens = document.querySelectorAll('.screen');

function switchTab(s){
  if(s === 'shop' && !shopOpenNow()){ toast(SHOP_REJECT_TEXT.phase, 'warn'); return; }
  // TR룸·암시장을 떠날 때는 그 화면의 알림을 지운다 (암시장 알림이 TR룸 차트 위에 남지 않게)
  if(s !== currentTab && (currentTab === 'play' || currentTab === 'shop')) clearToasts();
  currentTab = s;  // 게임 화면이 아니면 시장이 멈춘다
  tabBtns.forEach(x => x.classList.toggle('active', x.dataset.s === s));
  screens.forEach(x => x.classList.toggle('active', x.id === 'screen-' + s));
  if(s === 'play'){
    if(!run || (run.phase === 'over' && !overlayOpen)) startRun();
    renderAll();
  }
  if(s === 'shop') renderShop();
  renderTabs();
  syncOverlay();
}

tabBtns.forEach(b => b.addEventListener('click', () => switchTab(b.dataset.s)));

$('startBtn').addEventListener('click', () => {
  startRun();
  switchTab('play');
});
$('collectionBtn').addEventListener('click', () => switchTab('collection'));
$('collectionBack').addEventListener('click', () => switchTab('title'));

$('openBtn').addEventListener('click', () => {
  selectedIdx = -1;
  if(run && run.phase === 'shop'){ switchTab('shop'); return; }
  startMarket();
  renderAll();
});
$('deckBtn').addEventListener('click', () => { if(run) showDeck(); });
$('sellAllBtn').addEventListener('click', () => { sellAllPositions(); renderAll(); });

function playSelectedOn(targetId){
  const idx = selectedIdx;
  selectedIdx = -1;
  playCard(idx, targetId);
  renderAll();
}

$('handBox').addEventListener('click', e => {
  const c = e.target.closest('[data-idx]');
  if(!c || !run) return;
  const idx = +c.dataset.idx;
  const card = CARD_BY_ID[run.hand[idx].id];
  if(card.target && run.phase === 'premarket'){
    if(selectedIdx === idx) selectedIdx = -1;                     // 다시 누르면 취소
    else if(run.ap < card.ap) toast(REJECT_TEXT.ap, 'bad');
    else if(validTargetIds(idx).length === 0) toast('쓸 수 있는 대상이 없습니다', 'bad');
    else selectedIdx = idx;                                       // 대상 지정 모드
  } else {
    selectedIdx = -1;
    playCard(idx, null);
  }
  renderAll();
});

$('positionsBox').addEventListener('click', e => {
  const b = e.target.closest('[data-sell]');
  if(b){ sellPosition(+b.dataset.sell); renderAll(); return; }
  const item = e.target.closest('[data-id]');
  const card = run && selectedCard();
  if(item && card && card.target === 'position') playSelectedOn(+item.dataset.id);
});

$('quoteBox').addEventListener('click', e => {
  const row = e.target.closest('[data-q]');
  if(!row || !run) return;
  const card = selectedCard();
  if(card && card.target === 'asset') playSelectedOn(row.dataset.q);
  else showChart(chartTarget === row.dataset.q ? 'idx' : row.dataset.q);   // 같은 종목 다시 누르면 지수로
});
$('chartBackBtn').addEventListener('click', () => showChart('idx'));

document.addEventListener('keydown', e => {
  if(e.key === 'Escape' && selectedIdx >= 0){ selectedIdx = -1; renderAll(); }
});

$('overlay').addEventListener('click', e => {
  const r = e.target.closest('[data-reward]');
  if(r){ hideOverlay(); chooseReward('take', r.dataset.reward); renderAll(); return; }
  const rm = e.target.closest('[data-remove]');
  if(rm){ hideOverlay(); chooseReward('remove', +rm.dataset.remove); renderAll(); return; }
  const b = e.target.closest('[data-act]');
  if(!b || b.disabled) return;
  const act = b.dataset.act;
  if(act === 'skip'){ hideOverlay(); chooseReward('skip'); renderAll(); }
  else if(act === 'removeMode') showRemove();
  else if(act === 'backReward') showReward(lastRoundClear);
  else if(act === 'close') hideOverlay();
  else if(act === 'restart') startRun();
  else if(act === 'title'){ hideOverlay(); switchTab('title'); }
});

const tickerContent = '▶ 삼성전자 10만 전자 가즈아! &nbsp;·&nbsp; DOGE TO THE MOON 🚀 &nbsp;·&nbsp; 존버는 승리한다 &nbsp;·&nbsp; 풀매수 기원단 &nbsp;·&nbsp; 영끌 아니면 영원히 무주택 &nbsp;·&nbsp; HODL OR DIE &nbsp;·&nbsp; ';
document.getElementById('tickerText').innerHTML = tickerContent.repeat(3);

window.addEventListener('resize', () => { if(run) renderMainChart(); });
window.onload = () => {
  buildQuotes();
  buildCollection();
  renderTabs();
  ambientBg.init();
  setInterval(() => {   // 장중에만, TR룸 화면에서만 시장이 움직인다
    if(currentTab !== 'play' || !run || run.phase !== 'market') return;
    tick();
    renderAll();
  }, TICK_MS);
};
</script>
