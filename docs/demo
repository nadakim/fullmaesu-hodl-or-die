.pos-empty small{display:block;margin-top:calc(6 * var(--u));}
/* 증거금률 막대: 채움 = 증거금률(0~100%), 세로 선 = 반대매매 기준 */
/* (N2) 심지 게이지: 반대매매까지 남은 여유 = 심지 길이 (짧아질수록 임박). 초록 → 주황(--gold2) → 빨강, 끝에 불꽃. 숫자는 툴팁 */
.fuse{position:relative;display:inline-block;width:calc(48 * var(--u));height:calc(4 * var(--u));margin-right:calc(5 * var(--u));background:var(--line);cursor:help;}
.fuse .fz-cord{position:absolute;left:0;top:0;bottom:0;background:var(--green2);}
.fuse .fz-cord::after{content:'';position:absolute;right:calc(-4 * var(--u));top:calc(-2 * var(--u));width:calc(4 * var(--u));height:calc(8 * var(--u));background:var(--gold);box-shadow:0 0 0 calc(1 * var(--u)) #000;}
.fuse.warm .fz-cord{background:var(--gold2);}
.fuse.hot .fz-cord{background:var(--red);}
.fuse.hot .fz-cord::after{background:var(--red);animation:blink .4s step-end infinite;}
.fuse.safe .fz-cord::after{display:none;}   /* 넉넉하면 불이 안 붙어 있다 */
body.no-motion .fuse.hot .fz-cord::after{animation:none;}
.pnl-up{color:var(--green);text-shadow:calc(1 * var(--u)) calc(1 * var(--u)) 0 #003a14;}
.pnl-down{color:var(--red);text-shadow:calc(1 * var(--u)) calc(1 * var(--u)) 0 #5c0010;}

.sell-btn{
  background:var(--red-dim);
  --bk-ring:var(--red2);
  color:var(--text);
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);
