    progress: run.tickInDay / TICKS_PER_DAY,
    danger: run.positions.some(p => isMarginable(p) && !isProtected(p) && marginRatio(p) < MARGIN_WARN_RATIO),
    fss: run.fss >= FSS_WARN
  });
}

