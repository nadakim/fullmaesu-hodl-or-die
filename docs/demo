/* 청산 손익: 소리 + 수익이면 동전이 순자산으로 빨려 들어가고, 큰 익절은 히트스톱 / 큰 손실은 약한 흔들림 */
function juiceSell(pnl, fromRect){
  const i = Fx.intensity(pnl, netEquity()), lvl = Fx.level(i);
  Sound.play(pnl >= 0 ? 'sellWin' : 'sellLoss', { volume: 0.8 + 0.4 * i });
  if(pnl > 0){
    Fx.coinsTo(fromRect || rectOf($('positionsBox')), rectOf($('totalAssets')), Math.round(6 + 26 * i));
    if(lvl === 3) Fx.hitStop(Math.round(50 + 40 * i));
  } else if(pnl < 0 && lvl >= 2) Fx.shake(1);
}

/* ══ 연쇄 연출 (fx.js 큐) — 갭 경보 · 반대매매 · 유물 조명 · 마일스톤. 한 틱에 몰리면 발생 순서대로 하나씩 + CHAIN ×n ══
   tier 1~4로 세기를 통일한다 (히트스톱 ms · 흔들림 단계 · 파티클 수). 대부분은 1~2, 4는 반대매매·파산 직전 같은 순간만. */
const FX_TIER = { 1: { hs: 0, shake: 0, parts: 10 }, 2: { hs: 60, shake: 1, parts: 22 }, 3: { hs: 100, shake: 2, parts: 40 }, 4: { hs: 120, shake: 3, parts: 70 } };
const chainPitch = ctx => Sound.semis(Math.max(0, ctx.chain - 1));   // 체인이 이어질수록 반음씩 (결산 체인과 같은 규칙)

/* 갭 경보 밈 문구 — 상황별로 무작위 (연출용 난수 = Math.random, 엔진 rand()와 섞지 않는다). 여기에만 추가하면 된다 */
const GAP_MEMES = {
  longUp:    ['가즈아!!', '내가 산 게 오른다고?', '존버는 승리한다'],
  longDown:  ['깡통계좌 예약 완료', '평단이 우주로', '물타기 각?'],
  shortUp:   ['숏 스퀴즈 발생', '공매도 세력 털림 (나임)'],
  shortDown: ['공매도의 신', '떨어지는 칼날 잡았다'],
  noneUp:    ['구경만 했는데 심장이 뛴다', '안 산 게 손해'],
  noneDown:  ['구경만 했는데 심장이 뛴다', '안 산 게 이득']
};
const GAP_ALERT_MS = { 1: 800, 2: 1000, 3: 1500 };   // 약은 시장을 멈추지 않는다, 중 1초 · 강 1.5초 정지
const pickMeme = key => { const xs = GAP_MEMES[key]; return xs[Math.floor(Math.random() * xs.length)]; };

/* 갭 한 건의 강도: 약 = 미보유 / 중 = 보유 + 유리한 방향 / 강 = 보유 + 불리한 방향 */
function gapInfo(stockId, pct){
  const held = run.positions.filter(p => p.assetId === stockId);
  const up = pct > 0;
  const hurt = held.some(p => p.dir * pct < 0);
  const tier = settings.fxSpeed === 'min' || !held.length ? 1 : hurt ? 3 : 2;
  const dir = held.length ? (held.some(p => p.dir < 0) && !held.some(p => p.dir > 0) ? 'short' : 'long') : 'none';
  const danger = held.some(p => isMarginable(p) && marginRatio(p) < MARGIN_WARN_RATIO);
  return { stockId, pct, up, tier, meme: pickMeme(dir + (up ? 'Up' : 'Down')), danger: tier === 3 && danger,
           posIds: held.map(p => p.id), posRect: held.length ? rectOf(posRowEl(held[0].id)) : null };
}
function enqueueGap(stockId, pct){
  const g = gapInfo(stockId, pct);
  if(g.tier === 1){   // 약 경보는 아직 안 뜬 약 경보에 묶어서 한 번에
    const q = Fx.pending().find(it => it.kind === 'gap' && it.tier === 1);
    if(q){ q.payload.list.push(g); return; }
  }
  const item = { kind: 'gap', tier: g.tier, blocking: g.tier > 1, duration: GAP_ALERT_MS[g.tier], payload: { list: [g] } };
  item.play = ctx => showGapAlert(item, ctx);
  item.stop = item.skip = () => hideGapAlert(item);
  Fx.enqueue(item);
}
function showGapAlert(item, ctx){
  const list = item.payload.list, g = list[0], up = g.up, t = item.tier, T = FX_TIER[t];
  const name = list.map(x => STOCK_BY_ID[x.stockId].name).join(' · ');
  const el = document.createElement('div');
  el.className = `gap-alert ${up ? 'up' : 'down'} t${t}`;
  el.innerHTML = `<div class="ga-flash"></div><div class="ga-rays"></div>
    <div class="ga-box">
      <div class="ga-tape"><span>⚡ GAP ${up ? 'UP' : 'DOWN'} ⚡</span></div>
      <div class="ga-name">${name}</div>
      <div class="ga-pct">${list.length > 1 ? list.map(x => (x.pct > 0 ? '+' : '−') + Math.round(Math.abs(x.pct) * 100) + '%').join(' · ') : (up ? '+' : '−') + '0%'}</div>
      <div class="ga-meme">${g.meme}</div>
      ${g.danger ? '<div class="ga-warn">⚠ 반대매매 위험!</div>' : ''}
    </div>`;
  document.body.appendChild(el);
  item.el = el;
  if(list.length === 1){   // 변동률 0 → 최종값 카운트업 (8칸)
    const pctEl = el.querySelector('.ga-pct'), fin = Math.round(Math.abs(g.pct) * 100);
    for(let k = 1; k <= 8; k++) setTimeout(() => { pctEl.textContent = (up ? '+' : '−') + Math.round(fin * k / 8) + '%'; }, 60 + k * 35);
  }
  // 시세판·포지션 행이 같은 색으로 깜빡인다
  item.blinks = [];
  list.forEach(x => {
    [quoteRowEl(x.stockId)].concat(x.posIds.map(posRowEl)).forEach(r => { if(r){ r.classList.add(up ? 'fx-blink-up' : 'fx-blink-down'); item.blinks.push(r); } });
    Fx.sparks(rectOf(quoteRowEl(x.stockId)), x.pct > 0 ? 1 : -1, 10 + T.parts / 2, x.pct > 0 ? '--green' : '--red');
  });
  Sound.play(t === 3 ? 'gapAlarm' : up ? 'gapUp' : 'gapDown', { pitch: chainPitch(ctx), volume: t === 1 ? 0.6 : 1 });
  if(t === 3){ Sound.play(up ? 'gapUp' : 'gapDown', { pitch: chainPitch(ctx) }); Fx.hitStop(T.hs); Fx.afterStop(() => { Fx.shake(3); Fx.glitch(); }); }
  else if(t === 2){
    Fx.hitStop(T.hs); Fx.afterStop(() => Fx.shake(1));
    if(g.posRect) Fx.coinsTo(g.posRect, rectOf($('totalAssets')), 18);   // 유리한 갭: 코인이 순자산 쪽으로
  }
}
function hideGapAlert(item){
  if(item.el){ item.el.remove(); item.el = null; }
  (item.blinks || []).forEach(r => r.classList.remove('fx-blink-up', 'fx-blink-down'));
}

/* ══ 찌라시 결과 중앙 알림 (갭 경보와 같은 틀). 순자산 변화로 상승·횡보·하락 ══ */
const TIP_RESULT_FLAT_PCT = 0.005;   // |순자산 변화| ≤ 순자산의 0.5% → 횡보 (B로 비자금만 받은 경우 포함)
const TIP_RESULT_BIG_PCT  = 0.05;    // 순자산의 5% 이상 → tier 3, 그 미만 tier 2 (횡보는 tier 1)
const TIP_RESULT_MS = { 1: 1100, 2: 1500, 3: 2000 };
const TIP_RESULT_TAPE = { up: '📈 찌라시 적중!', flat: '➖ 본전 치기', down: '📉 찌라시 설거지' };
const TIP_RESULT_MEMES = {   // 연출용 무작위 (Math.random). 여기에만 추가
  up:   ['리딩방 형님 믿습니다', '이번엔 진짜였다', '찌라시도 가끔 맞는다'],
  flat: ['본전이면 승리', '아무 일도 없었다', '관망도 실력이다'],
  down: ['리딩방 탈퇴합니다', '아는 형 연락 두절', "출처는 늘 '아는 형'"]
};
const fmtTipMoney = v => Math.abs(v) < 0.5 ? '±0만' : (v > 0 ? '+' : '−') + '₩' + Math.abs(Math.round(v)).toLocaleString() + '만';
function tipResultKind(d){
  const eq = Math.max(1, Math.abs(netEquity()));
  const kind = d.delta > eq * TIP_RESULT_FLAT_PCT ? 'up' : d.delta < -eq * TIP_RESULT_FLAT_PCT ? 'down' : 'flat';
  const tier = kind === 'flat' ? 1 : Math.abs(d.delta) >= eq * TIP_RESULT_BIG_PCT ? 3 : 2;
  return { kind, tier };
}
function enqueueTipResult(d, fromOverlay){
  const k = tipResultKind(d), owner = run;
  const xs = TIP_RESULT_MEMES[k.kind];
  const item = { kind: 'tipResult', tier: k.tier, blocking: true, duration: TIP_RESULT_MS[k.tier],
                 payload: { d, kind: k.kind, meme: xs[Math.floor(Math.random() * xs.length)] } };
  let done = false;
  const finish = () => {
    hideGapAlert(item);
    (item.timers || []).forEach(clearTimeout);
    if(done) return;
    done = true;
    if(run !== owner || run.phase === 'over') return;   // 새 판을 시작하며 스킵된 경우
    if(fromOverlay && currentTab === 'play' && !overlayOpen) showTipResultOverlay(d);
    if(currentTab === 'event') renderTipScreen();
  };
  item.play = ctx => showTipResult(item, ctx);
  item.stop = item.skip = finish;
  Fx.enqueue(item);
}
function showTipResult(item, ctx){
  const { d, kind, meme } = item.payload, t = item.tier, T = FX_TIER[t];
  const ev = TIP_BY_ID[d.eventId], outcome = ev.choices[d.choiceIdx].outcomes[d.outcomeIdx];
  const el = document.createElement('div');
  el.className = `gap-alert tip-res ${kind} t${t}`;
  el.innerHTML = `<div class="ga-flash"></div>${kind === 'down' ? '<div class="ga-vig"></div>' : ''}${t > 1 ? '<div class="ga-rays"></div>' : ''}
    <div class="ga-box">
      <div class="ga-tape"><span>${TIP_RESULT_TAPE[kind]}</span></div>
      <div class="ga-name">${fillTip(outcome.text, d.stockId)}</div>
      <div class="ga-pct">${fmtTipMoney(0)}</div>
      ${d.slushDelta > 0 ? `<div class="ga-slush">💼 비자금 +${Math.round(d.slushDelta).toLocaleString()}만</div>` : ''}
      <div class="ga-meme">${meme}</div>
    </div>`;
  document.body.appendChild(el);
  item.el = el;
  item.timers = [];
  // 금액 카운트업 (알림 시간의 40% 동안 10칸). 상승이면 칸마다 지폐 세는 소리
  const pctEl = el.querySelector('.ga-pct'), steps = 10, span = ctx.duration * 0.4;
  for(let k = 1; k <= steps; k++) item.timers.push(setTimeout(() => {
    pctEl.textContent = fmtTipMoney(d.delta * k / steps);
    if(kind === 'up') Sound.play('billFlip', { count: 3, volume: 0.7 });
  }, 80 + span * k / steps));
  const pitch = chainPitch(ctx);
  if(kind === 'up'){
    Fx.hitStop(T.hs);
    cashRain(t === 3 ? 70 : 35);
    Sound.play('coinDrop', { count: t === 3 ? 8 : 5, pitch });
    if(t === 3) item.timers.push(setTimeout(() => Sound.play('cashRegister', { pitch }), 120 + span));
  } else if(kind === 'down'){
    Fx.hitStop(T.hs);
    Fx.afterStop(() => Fx.shake(T.shake));
    Sound.play('crashDown', { pitch });
    Sound.play('crowdScream', { volume: 0.8 });   // 파일(assets/sfx/scream.*)이 있을 때만 울린다 — 합성 비명은 넣지 않았다
  } else Sound.play('flatShrug', { pitch });
}

/* 반대매매 (tier 4 고정): 히트스톱 → 적색 섬광 → 행이 부서짐 → '반대매매' 도장 → '트라우마 카드 +1'이 덱 버튼으로 */
function enqueueLiquidation(d){
  const item = { kind: 'marginCall', tier: 4, blocking: true, duration: 1500, payload: { rect: rectOf(posRowEl(d.pos.id)), pnl: d.pnl } };
  item.timers = [];
  item.play = ctx => {
    const T = FX_TIER[4];
    Sound.play('marginCall', { pitch: chainPitch(ctx) });
    Fx.hitStop(T.hs);
    if(settings.shake){ const f = document.createElement('div'); f.className = 'red-flash'; document.body.appendChild(f); setTimeout(() => f.remove(), 600); }
    Fx.shatter(item.payload.rect, T.parts);
    Fx.afterStop(() => { Fx.shake(3); Fx.glitch(); });
    item.timers.push(setTimeout(() => Fx.stamp('반대매매'), Math.round(ctx.duration * 0.2)));
    item.timers.push(setTimeout(() => flyTrauma(), Math.round(ctx.duration * 0.55)));
  };
  item.stop = item.skip = () => item.timers.forEach(clearTimeout);
  Fx.enqueue(item);
}
function flyTrauma(){
  const holder = document.createElement('div');
  holder.innerHTML = cardHtml(CARD_BY_ID.trauma, {});
  const ghost = holder.firstElementChild;
  const w = 108, h = 158, r = { left: window.innerWidth / 2 - w / 2, top: window.innerHeight / 2 - h / 2, width: w, height: h, right: 0, bottom: 0 };
  Fx.cardFly(ghost, r, $('deckBtn'));
  Fx.chip('트라우마 카드 +1', rectOf($('deckBtn')), 'bad', 420);
}
/* 파산 직전 경고 (tier 4): 반대매매 뒤에도 남은 포지션이 위험하면 하루 한 번 */
let brinkKey = '';
function maybeBrink(){
  const key = run.round + '/' + run.day;
  if(brinkKey === key || run.phase === 'over') return;
  if(!run.positions.some(p => isMarginable(p) && !isProtected(p) && marginRatio(p) < MARGIN_WARN_RATIO)) return;
  brinkKey = key;
  const item = { kind: 'brink', tier: 4, blocking: true, duration: 1000, payload: {} };
  item.play = ctx => { Sound.play('gapAlarm', { pitch: chainPitch(ctx) }); Fx.hitStop(FX_TIER[4].hs); Fx.afterStop(() => Fx.shake(2)); Fx.stamp('파산 직전!', '', ''); };
  Fx.enqueue(item);
}

