<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title></title>
<script>
/* 게임 이름·메타 — 이름이 나오는 곳(탭 제목·타이틀 로고·전광판 등)은 전부 여기를 읽는다. 이름을 바꿀 땐 이 값만 */
const GAME_TITLE = { ko: '풀매수 기원단', en: 'BULL TRAP', sub: '' };
const GAME_META  = {
  version: 'Version 0.1 (DEMO)',
  author: '',                       // 제작자명 — 빈 문자열이면 타이틀의 'GAME BY' 줄을 숨긴다
  links: { steam: '', discord: '' } // 타이틀 오른쪽 아래 링크 버튼 — 비어 있으면 숨긴다
};
document.title = GAME_TITLE.ko + ': ' + GAME_TITLE.en + (GAME_TITLE.sub ? ' — ' + GAME_TITLE.sub : '');
</script>
<style>
/* ── 폰트 (전부 로컬 파일: docs/assets/fonts/, 라이선스 OFL 1.1 — 같은 폴더의 *-OFL.txt) ──
   글자 크기 체계 (기준 해상도 960×600 기준 px — 데스크톱은 이걸 통째로 정수·0.5배 확대한다):
   · Press Start 2P: 8 / 16 / 24만 (원래 calc(8 * var(--u)) 픽셀의 정수배라 선명). 화면 제목·큰 숫자·버튼·짧은 영문 태그(NORMAL·GAP)에만.
   · VT323 본문: 16 / 20 / 24 / 30 (최소 16).
   · 한글 Galmuri: 원래 픽셀 크기와 그 2배만 — 10(Galmuri9) · 12(Galmuri11) · 15(Galmuri14) · 16(Galmuri7×2) · 20(Galmuri9×2) · 24(Galmuri11×2) · 30(Galmuri14×2). 최소 10.
   font-size는 전부 아래 --fs-* 변수만 쓰고, font-family도 같은 역할 변수(--gf-* 한글 전용 · --gp-* Press Start 2P 옆 한글 · --gv-* VT323 옆 한글)를 쓴다.
   '글자 크기: 크게'(html[data-font="large"])는 변수를 한 단계씩 올린다. */
@font-face{font-family:'Press Start 2P';src:url('assets/fonts/PressStart2P-Regular.ttf') format('truetype');font-display:swap;}
@font-face{font-family:'VT323';src:url('assets/fonts/VT323-Regular.ttf') format('truetype');font-display:swap;}
/* 한글만 쓰는 곳: 파일 원래 크기(또는 2배)로만 쓰므로 size-adjust 100% */
@font-face{font-family:'Galmuri7';src:url('assets/fonts/Galmuri7.woff2') format('woff2');font-display:swap;}    /* 8px(아이콘성 짧은 라벨) · 16px(2배) */
@font-face{font-family:'Galmuri9';src:url('assets/fonts/Galmuri9.woff2') format('woff2');font-display:swap;}    /* 10px · 20px(2배) */
@font-face{font-family:'Galmuri11';src:url('assets/fonts/Galmuri11.woff2') format('woff2');font-display:swap;}  /* 12px · 24px(2배) */
@font-face{font-family:'Galmuri14';src:url('assets/fonts/Galmuri14.woff2') format('woff2');font-display:swap;}  /* 15px · 30px(2배) */
/* Press Start 2P 옆 한글: CSS 글자 크기 × size-adjust = Galmuri 원래 크기(또는 2배). 계산 = 목표 px ÷ CSS px */
@font-face{font-family:'GP8';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:125%;font-display:swap;}     /* PS2P 8px → 한글 Galmuri9 10px */
@font-face{font-family:'GP8L';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:150%;font-display:swap;}   /* PS2P 8px → 한글 Galmuri11 12px (글자 크게) */
@font-face{font-family:'GP16';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:100%;font-display:swap;}    /* PS2P 16px → 한글 Galmuri7×2 16px */
@font-face{font-family:'GP16L';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:125%;font-display:swap;}   /* PS2P 16px → 한글 Galmuri9×2 20px (글자 크게) */
@font-face{font-family:'GP24';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:100%;font-display:swap;}   /* PS2P 24px → 한글 Galmuri11×2 24px */
@font-face{font-family:'GP24L';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:125%;font-display:swap;}  /* PS2P 24px → 한글 Galmuri14×2 30px (글자 크게) */
/* VT323 옆 한글: VT323 글자가 작아서 약 75% (기존 규칙 그대로). 계산 = 목표 px ÷ CSS px */
@font-face{font-family:'GV16';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:75%;font-display:swap;}     /* VT323 16px → Galmuri11 12px */
@font-face{font-family:'GV20';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:75%;font-display:swap;}     /* VT323 20px → Galmuri14 15px */
@font-face{font-family:'GV24';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:66.6667%;font-display:swap;} /* VT323 24px → Galmuri7×2 16px */
@font-face{font-family:'GV30';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:66.6667%;font-display:swap;} /* VT323 30px → Galmuri9×2 20px */
:root{
  /* 화면 배율: 데스크톱은 layoutUi()가 --ui(창 높이 ÷ 600, 1~2.5)를 정한다. 모든 길이는 --u의 배수 */
  --ui:1;
  --u:calc(var(--ui) * 1px);
  --hand-row:calc(68 * var(--u));   /* 손패 컴팩트 격자(데스크톱)의 카드 한 장 높이 — 손패 크기는 여기 하나로 */
  /* 한글 전용 (Galmuri) */
  --fs-xs:calc(10 * var(--u));  --gf-xs:'Galmuri9';
  --fs-sm:calc(12 * var(--u));  --gf-sm:'Galmuri11';
  --fs-md:calc(15 * var(--u));  --gf-md:'Galmuri14';
  --fs-m16:calc(16 * var(--u)); --gf-m16:'Galmuri7';
  --fs-lg:calc(20 * var(--u));  --gf-lg:'Galmuri9';
  --fs-xl:calc(24 * var(--u));  --gf-xl:'Galmuri11';
  --fs-xxl:calc(30 * var(--u)); --gf-xxl:'Galmuri14';
  /* Press Start 2P (+ 옆 한글) */
  --fs-p1:calc(8 * var(--u));   --gp-p1:'GP8';
  --fs-p2:calc(16 * var(--u));  --gp-p2:'GP16';
  --fs-p3:calc(24 * var(--u));  --gp-p3:'GP24';
  --fs-p4:calc(40 * var(--u));  --gp-p4:'GP24';   /* 8의 5배 — 정산 무대 주인공 배수(숫자·×)만. 한글은 안 쓴다 */
  /* VT323 본문 (+ 옆 한글) */
  --fs-v1:calc(16 * var(--u));  --gv-v1:'GV16';
  --fs-v2:calc(20 * var(--u));  --gv-v2:'GV20';
  --fs-v3:calc(24 * var(--u));  --gv-v3:'GV24';
  --fs-v4:calc(30 * var(--u));  --gv-v4:'GV30';
}
/* 글자 크기: 크게 — 한 단계씩 (Press Start 2P는 8/16/24만 선명해서 크기는 그대로, 옆 한글만 한 단계 위) */
html[data-font="large"]{
  --fs-xs:calc(12 * var(--u));  --gf-xs:'Galmuri11';
  --fs-sm:calc(15 * var(--u));  --gf-sm:'Galmuri14';
  --fs-md:calc(16 * var(--u));  --gf-md:'Galmuri7';
  --fs-m16:calc(20 * var(--u)); --gf-m16:'Galmuri9';
  --fs-lg:calc(24 * var(--u));  --gf-lg:'Galmuri11';
  --fs-xl:calc(30 * var(--u));  --gf-xl:'Galmuri14';
  --gp-p1:'GP8L'; --gp-p2:'GP16L'; --gp-p3:'GP24L'; --gp-p4:'GP24L';
  --fs-v1:calc(20 * var(--u));  --gv-v1:'GV20';
  --fs-v2:calc(24 * var(--u));  --gv-v2:'GV24';
  --fs-v3:calc(30 * var(--u));  --gv-v3:'GV30';
}
button,input,select,textarea{font-family:inherit;}
small{font-size:inherit;}   /* 브라우저 기본 smaller(83%)는 허용 크기가 아니다 — 작은 글씨는 규칙마다 --fs-*로 정한다 */

/* ── PIXEL DESIGN SYSTEM ─────────────────────────────────── */
:root{
  --bg:#02040a;
  --panel:#080e1c;
  --panel2:#0c1428;
  --green:#00ff41;
  --green2:#00c832;
  --green-dim:#003a14;
  --red:#ff1a3c;
  --red2:#cc0028;
  --red-dim:#3a000e;
  --gold:#ffd700;
  --gold2:#e6a800;
  --purple:#9f5fff;
  --cyan:#00e5ff;
  --text:#d4deff;
  /* 대비(WCAG): --muted #8a96c4 = bg #02040a 7.07:1 · panel #080e1c 6.64:1 · panel2 #0c1428 6.32:1 (이전 #4a5580은 2.83·2.66·2.53)
     --text2 #acb6d4 = 카드 설명 등 보조 본문 (예전 --text opacity .8과 같은 색, panel2 대비 9.07:1). --line(1.24:1)은 글자색에 쓰지 않는다 */
  --muted:#8a96c4;
  --text2:#acb6d4;
  --line:#1a2240;
  --line2:#0f172a;
  --blue:#3d7bff;
  /* 카드 등급 (색 매핑 = DESIGN.md·CLAUDE.md 등급 문서): 색 · 프레임 두께(1080p 2px → 4px) — 카드·라벨·유물·팩 확률 막대가 전부 이 변수만 읽는다 */
  --rar-common:var(--muted);
  --rar-uncommon:var(--green2);
  --rar-rare:var(--cyan);
  --rar-legendary:var(--purple);
  --rar-mythic:var(--gold);
  --rar-status:var(--muted);   /* 상태 카드: 중립 회색 + 빗금 (등급 없음) */
  --rar-w-common:calc(1.15 * var(--u));
  --rar-w-uncommon:calc(1.45 * var(--u));
  --rar-w-rare:calc(1.75 * var(--u));
  --rar-w-legendary:calc(2 * var(--u));
  --rar-w-mythic:calc(2.3 * var(--u));
  /* 연출 시간 단일 출처 (motion-cleanup): CSS 애니메이션과 그 뒷정리 JS가 같은 값을 쓴다 — JS는 Fx.dur('이름')으로 읽는다.
     뒷정리는 Fx.afterAnim(animationend, 안 오면 이 값 + 여유 뒤). JUICE_CONFIG와 묶인 값(haze-in·pack-flip·myth-spin·combo-cool)은
     여기 값으로 JUICE_CONFIG를 채우고, 튜너로 바꾸면 syncDurVars가 다시 여기에 쓴다 */
  --dur-toast:2600ms;      /* 알림 (toastIn·toastInUp) */
  --dur-red-flash:500ms;   /* 청산 적색 섬광 */
  --dur-newhigh:600ms;     /* 포지션 신고가 번쩍 */
  --dur-hit:450ms;         /* Fx.flash fx-hit */
  --dur-goal:600ms;        /* Fx.flash fx-goal */
  --dur-jiggle:300ms;      /* Fx.jiggle 금감원 게이지 */
  --dur-relic-on:500ms;    /* Fx.flash 유물 발동 */
  --dur-rm-up:600ms;       /* Fx.flash 내일 뉴스 버튼 */
  --dur-shake-1:250ms;     /* .cabinet.shake-1 · .overlay-box.ov-shake-1 */
  --dur-shake-2:400ms;     /* .cabinet.shake-2(.shake) · ov-shake-2 */
  --dur-shake-3:560ms;     /* .cabinet.shake-3 · ov-shake-3 */
  --dur-glitch:380ms;      /* .cabinet.fx-glitch · .fx-scan */
  --dur-stamp:950ms;       /* 화면 가운데 도장 */
  --dur-pop:900ms;         /* .popnum · COMBO ×n 태그 (pixelPop) */
  --dur-chip:1100ms;       /* 효과 칩 */
  --dur-shine:700ms;       /* 희귀 카드 드로우 반짝 (2회 반복) */
  --dur-lost:1100ms;       /* 성장형 유물 초기화: 떨어지는 숫자 */
  --dur-haze-in:1200ms;    /* 암시장 입장 (JUICE hazeInMs) */
  --dur-pack-flip:600ms;   /* 팩 카드 뒤집기 (JUICE packFlipMs) */
  --dur-myth-spin:1200ms;  /* 신화 회전 등장 (JUICE mythSpinMs) */
  --dur-combo-cool:1600ms; /* 콤보 끊김 '최대 ×N' (JUICE comboCoolMs) */
}

.px-border{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--line),
    inset 0 0 0 calc(1 * var(--u)) rgba(255,255,255,.04);
  image-rendering:pixelated;
}
.px-border-gold{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--gold2),
    0 0 0 calc(4 * var(--u)) #000,
    inset 0 0 0 calc(1 * var(--u)) rgba(255,215,0,.12);
}
.px-border-green{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--green2),
    0 0 0 calc(4 * var(--u)) #000,
    inset 0 0 0 calc(1 * var(--u)) rgba(0,255,65,.08);
}
.px-border-red{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--red2),
    0 0 0 calc(4 * var(--u)) #000;
}

/* ── TACTILE: 손에 잡히는 화면 (버튼 · 패널 · 명찰 · 구역 배경 · 카드 기울기) ──────────
   새 UI는 이 클래스를 쓴다. 색은 :root 변수만, 모서리는 직각, 그림자는 픽셀 오프셋, 무늬는 hard-stop만. */
/* 묵직한 버튼: 버튼마다 --bk-ring(테두리 색)만 바꾼다. 아래·오른쪽 그림자 깊이 --bk-d (기본 4, .sm 작은 버튼 2)
   호버 = 1칸 떠오르며 그림자 +1 · 누름 = 그림자만큼 내려앉고 그림자 0 · 비활성 = 그림자 없이 흐림 */
.btn-chunky{
  --bk-ring:var(--line); --bk-d:calc(4 * var(--u));
  --bk-hi:color-mix(in srgb, var(--bk-ring) 45%, var(--text));   /* 윗면 1픽셀 밝은 테두리 */
  --bk-side:color-mix(in srgb, var(--bk-ring) 38%, var(--bg));    /* 두께(옆면): 버튼 색의 어두운 톤 — 검은 그림자는 어두운 배경에 묻힌다 */
  box-shadow:0 0 0 calc(2 * var(--u)) var(--bk-ring),inset 0 calc(1 * var(--u)) 0 var(--bk-hi),
    var(--bk-d) var(--bk-d) 0 calc(2 * var(--u)) var(--bk-side),calc(var(--bk-d) + var(--u)) calc(var(--bk-d) + var(--u)) 0 calc(2 * var(--u)) #000;
  transform:none;transition:none;
}
.btn-chunky.sm{--bk-d:calc(2 * var(--u));}
.btn-chunky:hover:not(:disabled){
  transform:translate(calc(-1 * var(--u)),calc(-1 * var(--u)));
  box-shadow:0 0 0 calc(2 * var(--u)) var(--bk-ring),inset 0 calc(1 * var(--u)) 0 var(--bk-hi),
    calc(var(--bk-d) + var(--u)) calc(var(--bk-d) + var(--u)) 0 calc(2 * var(--u)) var(--bk-side),calc(var(--bk-d) + calc(2 * var(--u))) calc(var(--bk-d) + calc(2 * var(--u))) 0 calc(2 * var(--u)) #000;
}
.btn-chunky:active:not(:disabled){transform:translate(var(--bk-d),var(--bk-d));box-shadow:0 0 0 calc(2 * var(--u)) var(--bk-ring),inset 0 calc(1 * var(--u)) 0 #000;}
.btn-chunky:disabled{transform:none;opacity:.5;cursor:not-allowed;box-shadow:0 0 0 calc(2 * var(--u)) var(--bk-ring);}
/* 숨쉬기: 누를 수 있는 중요 버튼(장 시작 · 정산 ▶ 다음 날) — 1.5초 주기 밝기, 흔들림 끔·동작 줄이기면 정지 */
.btn-chunky.breathe:not(:disabled){animation:bkBreathe 1.5s steps(6) infinite;}
@keyframes bkBreathe{0%,100%{filter:brightness(1);}50%{filter:brightness(1.35);}}
body.no-motion .btn-chunky.breathe{animation:none;}   /* body.no-motion = isMotionReduced() (흔들림 끔 · 시스템 동작 줄이기 · 모션 0%) — 모션 끔 CSS는 전부 이 클래스 하나로 */

/* 패널 틀 3종: 기본 .px-panel(얇은 틀, 강조색 --pc로 바꿀 수 있음) · 강조 .px-panel-gold(보상·정산) · 위험 .px-panel-red(반대매매 경고) */
.px-panel{--pc:var(--line);background:var(--panel);box-shadow:0 0 0 calc(2 * var(--u)) var(--pc),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.px-panel-gold,.px-panel-red{background:var(--panel);box-shadow:0 0 0 calc(2 * var(--u)) var(--pc),0 0 0 calc(4 * var(--u)) #000,calc(6 * var(--u)) calc(6 * var(--u)) 0 #000;}
.px-panel-gold{--pc:var(--gold2);}
.px-panel-red{--pc:var(--red2);}
/* 명찰: 패널 왼쪽 위에 걸친 제목 띠 (relative로 2칸 내려 아래 패널 테두리에 겹친다 — 흐름은 그대로) */
.px-tag{display:inline-block;position:relative;top:calc(3 * var(--u));z-index:3;padding:calc(3 * var(--u)) calc(8 * var(--u)) calc(2 * var(--u));
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.3;color:var(--bg);background:var(--gold2);text-shadow:none;white-space:nowrap;
  box-shadow:0 0 0 calc(2 * var(--u)) #000,calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.px-tag::before{content:'';display:inline-block;width:calc(4 * var(--u));height:calc(4 * var(--u));margin-right:calc(6 * var(--u));vertical-align:middle;background:var(--bg);}   /* 명찰 구멍 */

/* 구역 배경 무늬 (대비 아주 낮게, hard-stop만): 손패 = 초록 펠트 점 · 시장 = 모니터 격자 · 포지션 = 장부 줄 · 암시장 = 보라 벨벳 체크(#screen-shop::after) */
.tx-felt{background-color:color-mix(in srgb, var(--green-dim) 28%, var(--bg));
  background-image:conic-gradient(from 0deg at calc(1 * var(--u)) calc(1 * var(--u)), transparent 75%, color-mix(in srgb, var(--green) 10%, transparent) 0);
  background-size:calc(4 * var(--u)) calc(4 * var(--u));}
.tx-grid{background-image:linear-gradient(0deg, color-mix(in srgb, var(--cyan) 6%, transparent) calc(1 * var(--u)), transparent 0),
  linear-gradient(90deg, color-mix(in srgb, var(--cyan) 6%, transparent) calc(1 * var(--u)), transparent 0);
  background-size:calc(12 * var(--u)) calc(12 * var(--u));}
.tx-ledger{background-color:var(--bg);background-attachment:local;
  background-image:linear-gradient(90deg, transparent calc(9 * var(--u)), color-mix(in srgb, var(--red) 25%, transparent) 0 calc(10 * var(--u)), transparent 0),
  repeating-linear-gradient(180deg, transparent 0 calc(13 * var(--u)), color-mix(in srgb, var(--text) 7%, transparent) calc(13 * var(--u)) calc(14 * var(--u)));}

*{box-sizing:border-box; image-rendering:pixelated;}
html,body{
  margin:0;padding:0;
  background:var(--bg);
  color:var(--text);
  font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);
  overflow-x:hidden;
}

/* ── CRT 화면 효과 레이어 (#crtLayer, UI 전용) ───────────────────────────
   맨 위에 덮는 효과 4개 — 각각 CSS 변수 하나로 세기를 정한다 (applyCrt가 설정값을 넣는다):
   --crt-vig 비네트(0~1) · --crt-scan 스캔라인(0~1, 1080p 기준 선 간격 3px = --crt-pitch, JS가 화면 픽셀 정수로) · --crt-round 둥근 모서리 + 검은 베젤(0/1) · --crt-glass 유리 반사(아주 약하게).
   포인터는 전부 통과(pointer-events:none). 끄면 레이어 자체를 숨겨(hidden) 효과 없을 때와 픽셀까지 같다 */
.crt-layer{position:fixed;inset:0;z-index:9999;pointer-events:none;
  --crt-vig:.3;--crt-scan:.2;--crt-round:1;--crt-glass:1;--crt-pitch:3px;--crt-line:1px;}
.crt-layer[hidden]{display:none;}
.crt-layer > i{position:absolute;inset:0;pointer-events:none;display:block;}
.crt-scan{opacity:calc(var(--crt-scan) * .45);
  background:repeating-linear-gradient(180deg, transparent 0 calc(var(--crt-pitch) - var(--crt-line)), #000 0 var(--crt-pitch));}   /* 가는 가로줄 — 세기 100%여도 45%까지만 어둡게 */
.crt-vig{opacity:var(--crt-vig);background:radial-gradient(ellipse at center, transparent 55%, #000 115%);}
.crt-glass{opacity:var(--crt-glass);background:radial-gradient(ellipse 45% 35% at 22% 14%, color-mix(in srgb, var(--text) 5%, transparent), transparent 70%);}
.perf-hud{position:fixed;top:calc(4 * var(--u));right:calc(60 * var(--u));z-index:10000;pointer-events:none;
  padding:calc(2 * var(--u)) calc(6 * var(--u));background:var(--bg);color:var(--green);
  font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);box-shadow:0 0 0 calc(1 * var(--u)) var(--line2);}
.crt-bezel{opacity:var(--crt-round);border-radius:calc(22 * var(--u));box-shadow:0 0 0 calc(60 * var(--u)) #000, inset 0 0 calc(10 * var(--u)) calc(2 * var(--u)) rgba(0,0,0,.6);}   /* 둥근 화면 바깥(모서리)은 검은 베젤 — CRT 유리 테두리라 픽셀 직각 규칙의 예외 */

/* ── CABINET (MAIN UI CONTAINER) ────────────────────────── */
.cabinet{
  position:relative;
  max-width:calc(520 * var(--u));margin:0 auto;min-height:100vh;
  background:linear-gradient(180deg,#080e1c,#02040a 60%);
  border-left:calc(3 * var(--u)) solid #1a2240;
  border-right:calc(3 * var(--u)) solid #1a2240;
  box-shadow:0 0 calc(80 * var(--u)) rgba(0,0,0,.9) inset,0 0 calc(2 * var(--u)) var(--cyan) inset;
  overflow:hidden;z-index:1;
}


.screen{display:none;position:relative;z-index:1;min-height:100vh;}
.screen.active{display:block;}

/* ═══════════════════════════════════════════════════════════
   01 TITLE
═══════════════════════════════════════════════════════════ */
/* 타이틀: 전체 화면. 배경 = 흐르는 캔들(20~30%) + CRT 노이즈·스캔라인·비네팅 + 모서리 청록 테두리.
   왼쪽 위 로고 · 왼쪽 아래 [대괄호 메뉴] · 오른쪽 위 버전 · 오른쪽 아래 아이콘 · 맨 아래 전광판 */
#screen-title{position:relative;overflow:hidden;background:var(--bg);}
#screen-title.active{display:block;}
.t-chart{position:absolute;left:0;right:0;bottom:0;width:100%;height:66%;opacity:.25;image-rendering:pixelated;pointer-events:none;}
.t-noise{position:absolute;inset:0;width:100%;height:100%;opacity:.07;image-rendering:pixelated;pointer-events:none;}
.t-scan{position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg, rgba(0,0,0,.28) 0, rgba(0,0,0,.28) calc(1 * var(--u)), transparent calc(1 * var(--u)), transparent calc(3 * var(--u)));
  box-shadow:inset 0 0 calc(160 * var(--u)) calc(50 * var(--u)) #000;}
.t-frame{position:absolute;inset:calc(8 * var(--u));pointer-events:none;box-shadow:inset 0 0 0 calc(1 * var(--u)) rgba(0,229,255,.28);}
.t-frame i{position:absolute;width:calc(22 * var(--u));height:calc(22 * var(--u));border:0 solid var(--cyan);}
.t-frame i:nth-child(1){top:0;left:0;border-width:calc(2 * var(--u)) 0 0 calc(2 * var(--u));}
.t-frame i:nth-child(2){top:0;right:0;border-width:calc(2 * var(--u)) calc(2 * var(--u)) 0 0;}
.t-frame i:nth-child(3){bottom:0;left:0;border-width:0 0 calc(2 * var(--u)) calc(2 * var(--u));}
.t-frame i:nth-child(4){bottom:0;right:0;border-width:0 calc(2 * var(--u)) calc(2 * var(--u)) 0;}

/* 로고: 한글 이름(Galmuri14 원래 크기의 정수배 — JS가 --logo-ko를 정한다) + 영문(Press Start 2P 8의 배수) + 떡상 기원부적 */
.t-logo{position:absolute;left:6%;top:9%;z-index:2;}
.t-ko{position:relative;font-family:'Galmuri14',monospace;font-size:var(--logo-ko, 60px);line-height:1.15;color:var(--green);white-space:nowrap;}
.t-ko .t-ch{position:relative;display:inline-block;text-shadow:0 .1em 0 #003a14, .06em .06em 0 #000;}
.t-ko .t-ch::after{content:'';position:absolute;left:50%;bottom:-.14em;width:max(calc(2 * var(--u)), .06em);height:.2em;margin-left:-.03em;background:var(--green2);box-shadow:.03em .03em 0 #000;}   /* 글자마다 캔들 아래꼬리 */
.t-ko .t-sp{display:inline-block;width:.45em;}
.t-ko .t-ch.pop{animation:tPop .6s steps(6);}
@keyframes tPop{0%{transform:none;}25%{transform:translateY(-.3em);color:var(--gold);}45%{transform:translateY(-.34em);color:var(--gold);}80%{transform:translateY(.04em);}100%{transform:none;}}
.t-logo.limitdown .t-ko{color:var(--red);transform:translateX(calc(3 * var(--u)));}
.t-logo.limitdown .t-ko .t-ch{text-shadow:0 .1em 0 #3a000e, calc(-3 * var(--u)) 0 0 var(--cyan);}
.t-logo.limitdown .t-ko .t-ch::after{background:var(--red2);}
.t-logo.limitdown .t-limit{display:block;}
.t-limit{display:none;position:absolute;left:0;top:-1.6em;font-family:var(--gf-md),monospace;font-size:var(--fs-md);color:#000;background:var(--red);padding:0 calc(6 * var(--u));}
.t-en{margin-top:.55em;font-family:'Press Start 2P',monospace;font-size:var(--logo-en, 24px);line-height:1.2;color:var(--gold);letter-spacing:.08em;
  text-shadow:.12em .12em 0 #5c3d00;white-space:nowrap;}
.t-logo .jibu-badge{
  position:absolute;top:-.1em;right:-1.25em;font-size:var(--logo-ko, 60px);
  width:calc(82 * var(--u));height:calc(82 * var(--u));
  background:var(--red-dim);
  box-shadow:0 0 0 calc(3 * var(--u)) var(--red),0 0 0 calc(6 * var(--u)) #000,0 0 0 calc(8 * var(--u)) var(--gold2),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;
  transform:rotate(12deg);
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  font-family:var(--gf-md),monospace;color:var(--gold);line-height:1.2;
  animation:badgeFloat 2.4s steps(4) infinite;
}
.t-logo .jibu-badge b{font-weight:normal;font-family:var(--gf-md),monospace;font-size:var(--fs-md);}
.t-logo .jibu-badge span{font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;color:var(--text);margin-top:calc(4 * var(--u));}
@keyframes badgeFloat{
  0%{transform:rotate(12deg) translateY(0);}
  50%{transform:rotate(8deg) translateY(calc(-5 * var(--u)));}
  100%{transform:rotate(12deg) translateY(0);}
}

/* 메뉴: [대괄호] 세로 목록. 선택(호버·키보드 공용 .sel) = 바가 왼쪽부터 초록으로 차오름 + 캔들 커서 ▮ 깜빡임 */
.t-menu{position:absolute;left:6%;bottom:calc(92 * var(--u));width:48%;display:flex;flex-direction:column;gap:calc(6 * var(--u));z-index:2;}
.t-item{position:relative;display:block;width:100%;text-align:left;border:none;cursor:pointer;overflow:hidden;
  background:rgba(2,4,10,.72);box-shadow:0 0 0 calc(1 * var(--u)) var(--line);
  padding:calc(8 * var(--u)) calc(14 * var(--u)) calc(8 * var(--u)) calc(34 * var(--u));
  font-family:var(--gf-lg),monospace;font-size:var(--fs-lg);line-height:1.3;color:var(--text2);letter-spacing:.04em;}
.t-item[hidden]{display:none;}
.t-item::before{content:'';position:absolute;inset:0;background:var(--green-dim);box-shadow:inset 0 0 0 calc(1 * var(--u)) var(--green2);
  transform:scaleX(0);transform-origin:left;transition:transform .18s steps(6);}
.t-item > span{position:relative;}
.t-item .t-cur{position:absolute;left:calc(14 * var(--u));top:50%;margin-top:-.62em;color:var(--green);visibility:hidden;}
.t-item.sel{color:var(--green);text-shadow:0 0 calc(8 * var(--u)) rgba(0,255,65,.6);}
.t-item.sel::before{transform:scaleX(1);}
.t-item.sel .t-cur{visibility:visible;animation:blink .5s step-end infinite;}
.t-item.armed{color:var(--red);}
.t-item.armed::before{background:var(--red-dim);box-shadow:inset 0 0 0 calc(1 * var(--u)) var(--red2);}
.t-item.flash::before{background:var(--green);animation:tFlash .2s steps(2);}
.t-item.flash{color:#000;text-shadow:none;}
@keyframes tFlash{50%{background:var(--text);}}
.t-gap{height:calc(10 * var(--u));}

.t-meta{position:absolute;top:calc(22 * var(--u));right:calc(28 * var(--u));text-align:right;z-index:2;
  font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);line-height:1.3;color:var(--muted);}
.t-meta div[hidden]{display:none;}
.t-corner{position:absolute;right:calc(28 * var(--u));bottom:calc(92 * var(--u));z-index:2;display:flex;flex-direction:column;align-items:flex-end;gap:calc(10 * var(--u));}
.t-links{display:flex;gap:calc(8 * var(--u));}
.t-links a{padding:calc(4 * var(--u)) calc(8 * var(--u));background:rgba(2,4,10,.8);box-shadow:0 0 0 calc(1 * var(--u)) var(--line);color:var(--cyan);text-decoration:none;
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);}
.t-links a[hidden]{display:none;}
.t-icons{display:flex;gap:calc(10 * var(--u));}
.t-icon{width:calc(44 * var(--u));height:calc(44 * var(--u));border:none;cursor:pointer;background:rgba(2,4,10,.8);color:var(--cyan);
  font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);line-height:1;}
.t-icon:hover,.t-icon.sel{--bk-ring:var(--cyan);color:var(--text);}
.t-press{position:absolute;left:0;right:0;bottom:calc(52 * var(--u));text-align:center;z-index:2;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);color:var(--text2);animation:blink 1.1s step-end infinite;}
.t-press[hidden]{display:none;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}

/* 등장: CRT 켜짐(가운데 가로선이 펴지며 위아래로 열림) → 차트 페이드인 → 로고 타자 → 메뉴가 위부터 미끄러져 들어옴 */
.t-crt{position:absolute;inset:0;z-index:30;pointer-events:none;display:none;}
.t-crt::before,.t-crt::after{content:'';position:absolute;left:0;right:0;height:50%;background:#000;}
.t-crt::before{top:0;transform-origin:top;}
.t-crt::after{bottom:0;transform-origin:bottom;}
.t-crt i{position:absolute;left:0;right:0;top:50%;height:calc(2 * var(--u));margin-top:calc(-1 * var(--u));background:var(--text);box-shadow:0 0 calc(12 * var(--u)) var(--cyan);}
#screen-title.intro-full .t-crt,#screen-title.intro-short .t-crt{display:block;}
#screen-title.intro-full .t-crt::before,#screen-title.intro-full .t-crt::after{animation:crtOpen .4s steps(8) forwards;}
#screen-title.intro-full .t-crt i{animation:crtLine .4s steps(8) forwards;}
#screen-title.intro-short .t-crt::before,#screen-title.intro-short .t-crt::after{animation:crtOpen .25s steps(5) forwards;}
#screen-title.intro-short .t-crt i{animation:crtLine .25s steps(5) forwards;}
@keyframes crtOpen{0%,30%{transform:scaleY(1);}100%{transform:scaleY(0);}}
@keyframes crtLine{0%{transform:scaleX(0);opacity:1;}30%{transform:scaleX(1);opacity:1;}100%{transform:scaleX(1);opacity:0;}}
#screen-title.intro-full .t-chart{animation:tFadeChart .35s steps(5) .35s backwards;}
@keyframes tFadeChart{from{opacity:0;}to{opacity:.25;}}
#screen-title.intro-full .t-ko .t-ch,#screen-title.intro-full .t-ko .t-sp,#screen-title.intro-full .t-en,#screen-title.intro-full .t-logo .jibu-badge{animation:tType .01s steps(1) var(--d, 0s) backwards;}
@keyframes tType{from{visibility:hidden;}to{visibility:visible;}}
#screen-title.intro-full .t-menu > *{animation:tSlide .2s steps(4) var(--d, 0s) backwards;}
@keyframes tSlide{from{transform:translateY(calc(-14 * var(--u)));opacity:0;}to{transform:none;opacity:1;}}
/* 흔들림 끔 · 동작 줄이기: 튀는 모션·글리치·부적 흔들림 없이 정적으로 */
#screen-title.t-static .jibu-badge{animation:none;}
#screen-title.t-static .t-press{animation:none;}

.ticker-wrap{
  position:absolute;left:0;right:0;bottom:0;z-index:3;
  border-top:calc(3 * var(--u)) solid var(--green-dim);
  border-bottom:calc(3 * var(--u)) solid var(--green-dim);
  padding:calc(6 * var(--u)) 0;overflow:hidden;white-space:nowrap;
  background:#000;
}
.ticker{
  display:inline-block;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);
  color:var(--green);
  text-shadow:0 0 calc(4 * var(--u)) rgba(0,255,65,.6);
  animation:scrollLeft 22s linear infinite;
}
@keyframes scrollLeft{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* 모바일(세로): 로고 위 → 메뉴 → 아이콘(오른쪽 정렬) → 안내 → 전광판. 배경 레이어만 겹친다 */
@media (max-width: 900px){
  #screen-title.active{display:flex;flex-direction:column;gap:calc(14 * var(--u));padding:calc(20 * var(--u)) calc(16 * var(--u)) 0;min-height:100vh;box-sizing:border-box;}
  .t-meta{position:relative;top:auto;right:auto;align-self:flex-end;order:-1;}
  .t-logo .jibu-badge{width:calc(54 * var(--u));height:calc(54 * var(--u));top:calc(-2 * var(--u));right:calc(-66 * var(--u));}
  .t-logo{position:relative;left:auto;top:auto;margin:calc(10 * var(--u)) 0 calc(6 * var(--u));align-self:flex-start;}
  .t-menu{position:relative;left:auto;bottom:auto;width:100%;}
  .t-corner{position:relative;right:auto;bottom:auto;align-self:flex-end;}
  .t-press{position:relative;bottom:auto;}
  .ticker-wrap{position:relative;margin:auto calc(-16 * var(--u)) 0;}
}

/* ═══════════════════════════════════════════════════════════
   02 GAMEPLAY
═══════════════════════════════════════════════════════════ */
#screen-play{padding:calc(14 * var(--u)) calc(14 * var(--u)) calc(28 * var(--u));}


.news-banner{
  background:#000;
  border:0;
  box-shadow:0 0 0 calc(2 * var(--u)) var(--red2),calc(2 * var(--u)) calc(2 * var(--u)) 0 #000;
  color:var(--gold);
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);
  padding:calc(8 * var(--u)) calc(10 * var(--u));margin-bottom:calc(10 * var(--u));
  display:flex;justify-content:space-between;align-items:center;
  line-height:1.8;
}
.news-title{color:var(--red);text-shadow:0 0 calc(6 * var(--u)) var(--red);}
.news-row{display:flex;align-items:stretch;gap:calc(6 * var(--u));margin-bottom:calc(10 * var(--u));}
.news-row .news-banner{flex:1;min-width:0;margin:0;}
.news-next{flex:none;border:none;cursor:help;background:#000;color:var(--cyan);padding:0 calc(8 * var(--u));
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);white-space:nowrap;}
.news-next:hover{--bk-ring:var(--cyan);}
.news-next[hidden]{display:none;}
/* 차트 제목 옆 장세 뱃지 (평상시 숨김) */
.chart-header .state-badge{margin-left:calc(6 * var(--u));padding:0 calc(5 * var(--u));font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);text-shadow:none;color:#000;vertical-align:middle;}
.chart-header .state-badge.bull{background:var(--green);}
.chart-header .state-badge.bear{background:var(--red);color:var(--text);}
.chart-header .state-badge.vol{background:var(--purple);color:var(--text);}
.chart-header .state-badge[hidden]{display:none;}

.balance-main{
  padding:calc(10 * var(--u));text-align:center;margin-bottom:calc(10 * var(--u));
}
.balance-main .label{
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);
  letter-spacing:.05em;
}
.balance-main .total{
  font-family:'Press Start 2P',var(--gp-p2),monospace;font-size:var(--fs-p2);
  color:var(--green);margin-top:calc(6 * var(--u));
  text-shadow:calc(2 * var(--u)) calc(2 * var(--u)) 0 #003a14, 0 0 calc(12 * var(--u)) rgba(0,255,65,.5);
}

.assets-grid{
  display:grid;grid-template-columns:1fr;gap:calc(8 * var(--u));margin-bottom:calc(10 * var(--u));
}
.asset-card{
  padding:calc(8 * var(--u));text-align:center;
}
.asset-card .label{
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);
  margin-bottom:calc(6 * var(--u));letter-spacing:.03em;
}
.asset-card .val{
  font-family:'Press Start 2P',var(--gp-p1),monospace;font-size:var(--fs-p1);color:var(--text);
}
.asset-card .val.highlight{color:var(--gold);}

/* ── PIXEL CANDLESTICK CHART ─────────────────────────────── */
.chart-box{
  position:relative;height:calc(164 * var(--u));
  background:#000;
  box-shadow:0 0 0 calc(2 * var(--u)) var(--cyan),0 0 0 calc(4 * var(--u)) #000,calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;
  margin-bottom:calc(12 * var(--u));overflow:hidden;
}
.chart-box canvas{
  width:100%;height:100%;display:block;
  image-rendering:pixelated;
  image-rendering:crisp-edges;
}
.chart-header{
  position:absolute;top:calc(5 * var(--u));left:calc(8 * var(--u));z-index:10;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);color:var(--muted);
  text-shadow:calc(1 * var(--u)) calc(1 * var(--u)) 0 #000;
}
.chart-header span{color:var(--cyan);text-shadow:0 0 calc(6 * var(--u)) var(--cyan);}
.chart-header .ch-name{color:var(--gold);text-shadow:calc(1 * var(--u)) calc(1 * var(--u)) 0 #000;}
.chart-header .ch-chg.pnl-up{color:var(--green);text-shadow:none;}
.chart-header .ch-chg.pnl-down{color:var(--red);text-shadow:none;}
.chart-back{
  position:absolute;top:calc(5 * var(--u));right:calc(8 * var(--u));z-index:10;border:none;cursor:pointer;
  background:#000;color:var(--cyan);font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);padding:calc(4 * var(--u)) calc(6 * var(--u));
  --bk-ring:var(--cyan);
}
.chart-back:hover{background:var(--panel2);}
.chart-back[hidden]{display:none;}
.quote-row{cursor:pointer;}
.quote-row:hover{box-shadow:0 0 0 calc(2 * var(--u)) var(--muted);}
.quote-row.charted{background:var(--panel2);box-shadow:0 0 0 calc(2 * var(--u)) var(--cyan),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}

.section-title{
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);
  color:var(--gold);
  margin:calc(12 * var(--u)) 0 calc(6 * var(--u));
  display:flex;justify-content:space-between;align-items:baseline;
  text-shadow:calc(1 * var(--u)) calc(1 * var(--u)) 0 #5c3d00;
}
.section-title span:last-child{
  font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;color:var(--muted);
