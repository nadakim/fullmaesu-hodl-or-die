    posSig = sig;
    box.innerHTML = run.positions.length === 0
      ? `<div style="text-align:center;padding:14px;color:var(--muted);font-family:'Press Start 2P';font-size:7px;">── NO POSITION ──</div>`
      : run.positions.map(p => `
        <div class="pos-item" data-id="${p.id}">
          <div class="pos-info">
            <div class="name">${p.name}${p.side === 'inverse' ? `<span class="lev-badge inv">${posLabel(p.side, p.lev)}</span>` : p.lev > 1 ? `<span class="lev-badge lev${p.lev}">${p.lev}x</span>` : ''}</div>
            <div class="detail" data-f="price"></div>
            <div class="detail" data-f="basis">원금 ₩${p.ownCost}만${p.loan > 0 ? ` · 대출 ₩${p.loan}만` : ''}</div>
            ${p.loan > 0 ? '<div class="ratio" data-f="ratio"></div>' : ''}
          </div>
          <div class="pos-pnl">
            <div class="val" data-f="pnl"></div>
            <button class="sell-btn" data-sell="${p.id}">매도</button>
          </div>
        </div>`).join('');
  }
  run.positions.forEach(p => {
    const el = box.querySelector(`[data-id="${p.id}"]`);
    if(!el) return;
    const cur = assets[p.assetId].price;
    const pnl = positionValue(p) - p.loan - p.ownCost;
    el.querySelector('[data-f=price]').textContent = `${fmtPrice(p.buyPrice)} → ${fmtPrice(cur)}`;
    const pv = el.querySelector('[data-f=pnl]');
    pv.textContent = `${fmtSigned(pnl)} (${fmtPct(pnl / p.ownCost)})`;
    pv.className = 'val ' + (pnl >= 0 ? 'pnl-up' : 'pnl-down');
    const rEl = el.querySelector('[data-f=ratio]');
    if(rEl){
      const r = collateralRatio(p);
      rEl.textContent = `담보비율 ${Math.round(r * 100)}% / 반대매매 ${Math.round(MAINTENANCE_RATIO * 100)}%`;
      rEl.className = 'ratio ' + (r < WARN_RATIO ? 'danger' : 'safe');
    }
  });
}

function renderAll(){
  if(!run) return;
  renderChart();
  renderHud();
  renderQuotes();
  renderLeverage();
  renderHand();
  renderPositions();
}

/* ── 결산 / 게임오버 오버레이 ── */
function syncOverlay(){ $('overlay').classList.toggle('show', overlayOpen && currentTab === 'play'); }
function showOverlay(html){ $('overlayBox').innerHTML = html; overlayOpen = true; syncOverlay(); }
function hideOverlay(){ overlayOpen = false; syncOverlay(); }

function statRow(label, value){ return `<div>${label}<b>${value}</b></div>`; }

function showRoundClear(d){
  showOverlay(`
    <div class="ov-title" style="color:var(--green)">WEEK ${run.round} 결산 ✓</div>
    <div class="ov-sub">목표 달성! 다음 주 목표는 <span style="color:var(--gold)">${fmtMoney(ROUND_TARGETS[run.round])}</span></div>
    <div class="ov-stats">
      ${statRow('이번 주 순자산', fmtMoney(d.eq))}
      ${statRow('이번 주 목표', fmtMoney(d.target))}
      ${statRow('보유 포지션', run.positions.length + '개 (이월)')}
      ${statRow('신용대출', fmtMoney(totalDebt()))}
      ${statRow('반대매매', run.liquidations + '회')}
    </div>
    <button class="ov-btn" data-act="next">▶ 다음 주 개장</button>`);
}

function showRunOver(reason){
  const endings = {
    BANKRUPT: { title:'반대매매 당했습니다', color:'var(--red)',   sub:'순자산이 0원 아래로 떨어졌습니다. 계좌가 녹았습니다.' },
    BROKE:    { title:'깡통 계좌',           color:'var(--red)',   sub:'남은 현금으로 살 수 있는 종목이 없습니다. 이번 생은 개미.' },
    MISSED:   { title:'목표 미달 · 강제 은퇴', color:'var(--gold)', sub:`순자산 ${fmtMoney(run.endEquity)} / 목표 ${fmtMoney(currentTarget())}` },
    VICTORY:  { title:'개미 졸업!',          color:'var(--green)', sub:`${MAX_ROUND}주 연속 목표 달성. 이제 당신이 세력입니다.` }
  };
  const e = endings[reason];
  showOverlay(`
    <div class="ov-title" style="color:${e.color}">${e.title}</div>
    <div class="ov-sub">${e.sub}</div>
    <div class="ov-stats">
      ${statRow('도달 주차', `WEEK ${run.round}/${MAX_ROUND} · DAY ${run.day}`)}
      ${statRow('최종 순자산', fmtMoney(run.endEquity))}
      ${statRow('최고 순자산', fmtMoney(run.peakEquity))}
      ${statRow('확정손익', '₩ ' + fmtSigned(run.realized))}
      ${statRow('반대매매', run.liquidations + '회')}
      ${statRow('누적 신용이자', fmtMoney(run.interestPaid))}
    </div>
    <button class="ov-btn" data-act="restart">▶ 다시 영끌</button>
    <button class="ov-btn alt" data-act="title">◀ 타이틀로</button>`);
  if(reason === 'VICTORY') cashRain();
}

/* ── 연출 (원본 유지) ── */
function showPopNum(text, isUp){
  const pop = document.createElement('div');
  pop.className = 'popnum';
  pop.style.left = (20+Math.random()*40)+'%';
  pop.style.top  = (25+Math.random()*30)+'%';
  pop.style.color = isUp ? 'var(--green)' : 'var(--red)';
  pop.style.textShadow = isUp ? '1px 1px 0 #003a14' : '1px 1px 0 #5c0010';
  pop.textContent = text;
  document.getElementById('chartBox').appendChild(pop);
  setTimeout(()=>pop.remove(), 900);
}

function cashRain(){
  const layer = document.getElementById('confettiLayer');
  const syms = ['$','₩','★','◆'];
  for(let i=0;i<18;i++){
    const b = document.createElement('div');
    b.className = 'bill';
    b.style.left = Math.random()*100+'vw';
    b.style.animationDelay = (Math.random()*.5)+'s';
    b.textContent = syms[Math.floor(Math.random()*syms.length)];
    layer.appendChild(b);
    setTimeout(()=>b.remove(), 2000);
  }
}

/* ══════════════════════════════════════════════════════════
   흐름 제어 — 탭 전환, 새 판 시작, 게임 루프
══════════════════════════════════════════════════════════ */
function startRun(){
  marketState = 'NORMAL';
  marketPrice = 1000;
  initChartData();
  initAssets();
  run = newRun();
  handSig = ''; posSig = '';
  hideOverlay();
  resetNews();
  renderAll();
  toast(`WEEK 1 개장 — 목표 ${fmtMoney(currentTarget())}`, 'good');
}

const tabBtns = document.querySelectorAll('.tabnav button');
const screens = document.querySelectorAll('.screen');

function switchTab(s){
  currentTab = s;  // 게임 화면이 아니면 시장이 멈춘다
  tabBtns.forEach(x => x.classList.toggle('active', x.dataset.s === s));
  screens.forEach(x => x.classList.toggle('active', x.id === 'screen-' + s));
  if(s === 'play'){
    if(!run || (run.phase === 'over' && !overlayOpen)) startRun();
    renderAll();
  }
  syncOverlay();
}

tabBtns.forEach(b => b.addEventListener('click', () => switchTab(b.dataset.s)));

document.getElementById('startBtn').addEventListener('click', () => {
  startRun();
  switchTab('play');
});

$('sellAllBtn').addEventListener('click', () => { sellAllPositions(); renderAll(); });

$('handBox').addEventListener('click', e => {
  const c = e.target.closest('[data-idx]');
  if(!c) return;
  buyPosition(+c.dataset.idx);
  renderAll();
});

$('positionsBox').addEventListener('click', e => {
  const b = e.target.closest('[data-sell]');
  if(!b) return;
  sellPosition(+b.dataset.sell);
  renderAll();
});

$('sideBar').addEventListener('click', e => {
  const b = e.target.closest('[data-side]');
  if(!b || !run) return;
  run.side = b.dataset.side;
  renderAll();
});

$('levBar').addEventListener('click', e => {
  const b = e.target.closest('[data-lev]');
  if(!b || !run) return;
  run.leverage = +b.dataset.lev;
  renderAll();
});

$('overlay').addEventListener('click', e => {
  const b = e.target.closest('[data-act]');
  if(!b) return;
  const act = b.dataset.act;
  if(act === 'next'){ hideOverlay(); startNextRound(); renderAll(); }
  else if(act === 'restart'){ startRun(); }
  else if(act === 'title'){ hideOverlay(); switchTab('title'); }
});

const tickerContent = '▶ 삼성전자 10만 전자 가즈아! &nbsp;·&nbsp; DOGE TO THE MOON 🚀 &nbsp;·&nbsp; 존버는 승리한다 &nbsp;·&nbsp; 풀매수 기원단 &nbsp;·&nbsp; 영끌 아니면 영원히 무주택 &nbsp;·&nbsp; HODL OR DIE &nbsp;·&nbsp; ';
document.getElementById('tickerText').innerHTML = tickerContent.repeat(3);

window.addEventListener('resize', () => { if(run) renderChart(); });
window.onload = () => {
  buildQuotes();
  ambientBg.init();
  setInterval(() => {
    if(currentTab !== 'play' || !run) return;
    tick();
    renderAll();
  }, TICK_MS);
};
</script>
</body>
