      break;
    case 'shopRejected': toast(SHOP_REJECT_TEXT[d.reason] || d.reason, 'bad'); Sound.play('cardReject'); break;
    case 'packOpened':   showPackResult(d); juicePack(d); break;
    case 'singleBought': toast(`${CARD_BY_ID[d.cardId].name} 구매 −${fmtSlush(d.price)} · 덱 ${d.deckSize}장`, 'good'); break;
    case 'shopRerolled': Sound.play('shopShuffle'); break;
    case 'shopServiced': toast(d.kind === 'upgrade' ? `✦ ${CARD_BY_ID[d.to].name} 리모델링 −${fmtSlush(d.price)}`
        : d.kind === 'transform' ? `🔀 ${CARD_BY_ID[d.from].name} → ${CARD_BY_ID[d.to].name} −${fmtSlush(d.price)}`
