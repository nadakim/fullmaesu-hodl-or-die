    <div><div class="sr-label">${label}</div><div class="sr-desc">${desc}</div></div>
    <div class="stepper"><button class="btn-chunky sm" data-step="${key}" data-d="-${CRT_STEP}" aria-label="${label} 낮추기" ${disabled || v <= 0 ? 'disabled' : ''}>−</button>
      <span class="st-val">${v}%</span>
      <button class="btn-chunky sm" data-step="${key}" data-d="${CRT_STEP}" aria-label="${label} 높이기" ${disabled || v >= 100 ? 'disabled' : ''}>+</button></div>
  </div>`;
}
function settingRow(key, label, desc, disabled){
