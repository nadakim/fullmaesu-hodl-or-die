const RELIC_FX = {   // 유물 → [도착 요소, 칩 문구]
  payday:     [() => $('availableCash'), a => `+₩${Math.round(a).toLocaleString()}만`],
  parents:    [() => $('totalAssets'),   a => `+₩${Math.round(a).toLocaleString()}만`],
  hotline:    [() => $('totalAssets'),   a => `투매 손실 −${Math.round(a).toLocaleString()}만 면제`],
  coldwallet: [() => $('positionsBox'),  () => '반대매매 회피'],
  inverse:    [() => $('handBox'),       a => `카드 +${a}장`],
  daytrader:  [() => $('apText'),        a => `행동력 −${a}`],
  fssconnect: [() => $('fssBox'),        a => `감시 −${Math.round(a)}`],
  lawyer:     [() => $('fssBox'),        a => `감시 −${Math.round(a)}`],
  capital:    [() => $('availableCash'), a => `이자 −₩${Math.round(a).toLocaleString()}만`],
  gukbap:     [() => $('positionsBox'),  a => `손실 ${fmtSigned(a)}`],
  seal:       [() => $('positionsBox'),  a => fmtSigned(a)],
  theme:      [() => $('positionsBox'),  a => fmtSigned(a)],
  moonSavings:    [() => $('positionsBox'), a => fmtSigned(a)],
  traumaSurvivor: [() => $('positionsBox'), a => fmtSigned(a)]
};
let relicSeen = {};   // 콜드월렛: 같은 포지션은 하루 한 번만 조명
function enqueueRelic(d){
  const fx = RELIC_FX[d.id];
  if(!fx) return;
  if(d.id === 'coldwallet'){
    const k = run.round + '/' + run.day + '/' + d.posId;
    if(relicSeen[k]) return;
    relicSeen[k] = true;
  }
  const item = { kind: 'relic', tier: 1, blocking: true, duration: 700, payload: d };
  item.play = ctx => {
    const icon = $('relicBar').querySelector(`[data-relic="${d.id}"]`) || $('relicBar');
    Fx.flash(icon, 'fx-relic-on');
    const target = fx[0]();
    Fx.streak(rectOf(icon), rectOf(target), 12, ['--text', '--gold', '--cyan']);
    Fx.chip(fx[1](d.amount) + ' ' + RELIC_BY_ID[d.id].icon, rectOf(target), d.id === 'gukbap' ? '' : 'up', 380);
