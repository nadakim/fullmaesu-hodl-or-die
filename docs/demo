  cardTipEl.innerHTML = `<b>${card.name}</b>
    <span class="ct-meta">${TYPE_LABEL[card.type]} · ${RARITY_LABEL[card.rarity]} · 행동력 ${card.type === 'status' ? '—' : ap}${card.exhaust ? ' · 소멸' : ''}${card.target ? ' · 대상 ' + TARGET_LABEL[card.target] : ''}${stock ? ` · ₩${formatKrw(idx >= 0 && run ? stockCost(stock) : stock.cost)}${idx >= 0 && run ? ` · 현재가 ${fmtPrice(assets[stock.id].price)}` : ''} · ${stock.sector} · β ${stock.beta} · 변동성 ${stock.volatility}` : ''}</span>
    ${card.tags.length ? `<span class="ct-meta">태그 ${tagNames(card.tags)}${topTags().some(t => card.tags.indexOf(t) >= 0) ? ' — 내 덱 주력 태그 (보상·암시장 +' + Math.round(TAG_BIAS * 100) + '%)' : ''}</span>` : ''}${card.upgraded ? `<span class="ct-meta">✦ 강화판 — 원래: ${CARD_BY_ID[card.base].desc}</span>` : canUpgrade(card.id) ? `<span class="ct-meta">✦ 강화하면: ${CARD_BY_ID[card.id + '+'].desc}${CARD_BY_ID[card.id + '+'].ap !== card.ap ? ` (행동력 ${CARD_BY_ID[card.id + '+'].ap})` : ''}</span>` : ''}
    ${el.classList.contains('disabled') && el.querySelector('.cv-reason') && el.querySelector('.cv-reason').textContent ? `<span class="ct-meta" style="color:var(--red)">🔒 ${el.querySelector('.cv-reason').textContent}</span>` : ''}${settleColor(cardDesc(card))}${cardBossNote(card, idx)}${ev ? `<span class="ct-ev ${ev.cls}">${ev.text} — ${ev.title.replace(/\n/g, ' · ')}</span>` : ''}${stock && idx >= 0 && run && run.phase === 'premarket' ? cardSettleView(stock.id) : ''}`;
