/* ── 찌라시 ── */
const fillTip = (text, stockId) => text.split('{stock}').join(stockId ? STOCK_BY_ID[stockId].name : '');

function tipChoiceMeta(tip, choice, idx){
  const parts = [];
  const buy = choice.outcomes[0].effects.find(ef => ef.kind === 'buy');
  if(buy){
    const amount = Math.min(buy.amount * tipScale(), Math.max(0, run.cash));
    parts.push(`${STOCK_BY_ID[tipStockId(tip, buy.stock)].name} ₩${Math.round(amount).toLocaleString()}만 매수`);
  }
  const slush = choice.outcomes[0].effects.find(ef => ef.kind === 'slush');
  if(slush) parts.push(`비자금 +${fmtSlush(slush.amount)}`);
  const chances = tipChances(idx, choice);   // 표시 확률 = 판정 확률 (개미 커뮤니티 반영)
  parts.push(choice.outcomes.map((o, k) => `${o.tag} ${Math.round(chances[k] * 100)}%`).join(' · '));
  return parts.join(' · ');
}
function tipEvHtml(idx){
  const e = run.pendingTip ? tipExpectedValue(idx) : null;
  if(!e) return '';
  return `<span class="ch-ev ${evCls(e.ev)}">EV 순자산 ${fmtEv(e.ev)}${e.slush >= 1 ? ` · 비자금 +${fmtSlush(e.slush)}` : ''}</span>`;
}

function tipCardHtml(tip, wrap){
  const ev = TIP_BY_ID[tip.eventId];
  const body = `
    <div class="noti-headline">${fillTip(ev.headline, tip.stockId)}</div>
    <div class="noti-body">${fillTip(ev.body, tip.stockId)}</div>
    ${ev.choices.map((c, i) => `
      <button class="choice ${i === 0 ? 'risky' : 'safe'}" data-tip-choice="${i}">
        <span class="ch-label">${'AB'[i]}. ${fillTip(c.label, tip.stockId)}</span>
        <span class="ch-meta">${tipChoiceMeta(tip, c, i)}</span>
        ${tipEvHtml(i)}
      </button>`).join('')}`;
  return wrap ? `<div class="phone-noti">${body}</div>` : body;
}

function tipResultHtml(r){
  const ev = TIP_BY_ID[r.eventId], outcome = ev.choices[r.choiceIdx].outcomes[r.outcomeIdx];
  const cls = Math.abs(r.delta) < 0.5 ? 'flat' : r.delta > 0 ? 'up' : 'down';
  return `<div class="tip-result ${cls}">${fillTip(outcome.text, r.stockId)}
    <b>순자산 ${Math.abs(r.delta) < 0.5 ? '±0만' : fmtSigned(r.delta)}${r.slushDelta > 0 ? ` · 비자금 +${fmtSlush(r.slushDelta)}` : ''}</b></div>`;
}

