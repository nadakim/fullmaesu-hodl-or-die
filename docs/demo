/* ── 카드 도감 ── */
let collectionRarity = '';   // 도감 등급 필터 ('' = 전체)
function buildCollection(){
  const augments = CARDS.filter(c => c.type !== 'stock' && c.type !== 'status').length;
  $('collectionSub').textContent = `종목 ${STOCKS.length} · 증강 ${augments} · 상태 ${CARDS.filter(c => c.type === 'status').length}`;
  $('collectionSub').textContent += ` · 유물 ${RELICS.length}`;
  const count = r => CARDS.filter(c => c.type !== 'status' && c.rarity === r).length + RELICS.filter(x => x.rarity === r).length;
  $('collectionFilter').innerHTML = [''].concat(RARITIES).map(r =>
    `<button class="${r === collectionRarity ? 'on' : ''}" data-rarity="${r}">${r ? `<span class="c-rar ${r}">${RARITY_LABEL[r]}</span> ${count(r)}` : '전체'}</button>`).join('');
  const show = x => !collectionRarity || x.rarity === collectionRarity;
  $('collectionBox').innerHTML = TYPE_ORDER.map(t => {
    const list = CARDS.filter(c => c.type === t && (t === 'status' ? !collectionRarity : show(c)));
    if(list.length === 0) return '';
    return `<div class="pile-title">▌ ${TYPE_LABEL[t]} (${list.length})</div>
      <div class="coll-grid">${list.map(c => cardHtml(c, {})).join('')}</div>`;
  }).join('') + (() => { const rl = RELICS.filter(show); return rl.length ? `<div class="pile-title">▌ 유물 (${rl.length})</div>
      <div class="relic-row">${rl.map(r => relicTile(r, {})).join('')}</div>` : ''; })();
}
/* ── 환경 설정 (UI 전용 — 엔진 규칙에는 영향 없음) ── */
const SETTINGS_KEY = 'hodl.settings';
const SETTING_OPTIONS = {
  speed: [[1, '1x'], [2, '2x'], [4, '4x']],
  shake: [[true, '켜기'], [false, '끄기']],
  crt:   [['off', '끄기'], ['weak', '약'], ['strong', '강']],
  bgFx:  [[true, '켜기'], [false, '끄기']],
  sound: [[true, '켜기'], [false, '끄기']]
};
const DEFAULT_SETTINGS = { speed: 1, shake: true, crt: 'strong', bgFx: true, sound: false };
function loadSettings(){
  const s = Object.assign({}, DEFAULT_SETTINGS);
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(SETTINGS_KEY)); } catch(e) {}
  if(saved && typeof saved === 'object'){
    Object.keys(SETTING_OPTIONS).forEach(k => {   // 허용된 값만 받는다 (깨진 값이면 기본값)
      if(SETTING_OPTIONS[k].some(o => o[0] === saved[k])) s[k] = saved[k];
    });
  }
  return s;
}
let settings = loadSettings();
function saveSettings(){
  try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); } catch(e) {}
}
function applySettings(){
  document.body.dataset.crt = settings.crt;
  document.body.dataset.bgfx = settings.bgFx ? 'on' : 'off';
  if(settings.bgFx){
    ambientBg.init();
    if(!bgGridTimer) bgGridTimer = setInterval(drawBgGrid, 500);
  } else {
    ambientBg.stop();
    clearInterval(bgGridTimer); bgGridTimer = null;
    drawBgGrid();   // 정지된 격자 한 장만
  }
}
function settingRow(key, label, desc, disabled){
  return `<div class="set-row ${disabled ? 'disabled' : ''}" data-row="${key}">
    <div><div class="sr-label">${label}</div><div class="sr-desc">${desc}</div></div>
    <div class="seg">${SETTING_OPTIONS[key].map(([v, t]) =>
      `<button data-set="${key}" data-val="${JSON.stringify(v).replace(/"/g, '&quot;')}" class="${settings[key] === v ? 'on' : ''}" ${disabled ? 'disabled' : ''}>${t}</button>`).join('')}</div>
  </div>`;
}
function buildSettings(){
  $('settingsBox').innerHTML = `<div class="set-list">
    ${settingRow('speed', '장중 속도', `캔들 1개 ${TICK_MS}ms 기준 배율. 결과·확률은 그대로, 시간만 빨라집니다.`)}
    ${settingRow('shake', '화면 흔들림 · 빨간 번쩍임', '반대매매 때 화면이 흔들리고 붉게 번쩍입니다. 어지러우면 끄세요.')}
    ${settingRow('crt', 'CRT 효과', '스캔라인·가장자리 어두움(비네팅) 강도.')}
    ${settingRow('bgFx', '배경 연출', '양옆에 떠다니는 시세 창·배경 격자 애니메이션. 저사양 PC면 끄세요.')}
    ${settingRow('sound', '사운드', '준비 중 — 아직 게임에 소리가 없습니다.', true)}
    <div class="set-row" data-row="reset">
      <div><div class="sr-label">기록 초기화</div><div class="sr-desc">파산 기록(엔딩 도감·최근 판·누적 통계)과 개미 회차를 지웁니다. 설정은 남습니다.</div></div>
      <div class="seg"><button class="set-danger" id="settingsReset">✕ 기록 초기화</button></div>
    </div>
  </div>`;
}
$('settingsBox').addEventListener('click', e => {
  const b = e.target.closest('button');
  if(!b || b.disabled) return;
  if(b.id === 'settingsReset'){
    if(!b.classList.contains('armed')){ b.classList.add('armed'); b.textContent = '정말 지울까요? 한 번 더 누르면 삭제'; return; }
    clearRecords();
    b.classList.remove('armed'); b.textContent = '✓ 기록을 지웠습니다';
    return;
  }
  if(!b.dataset.set) return;
  settings[b.dataset.set] = JSON.parse(b.dataset.val);
  saveSettings();
  applySettings();
  buildSettings();
});

/* ── 파산 기록 화면 ── */
const ENDING_GROUPS = [['bust', '파산'], ['miss', '목표 미달'], ['win', '졸업']];
function fmtWhen(t){
  const d = new Date(t), p = v => String(v).padStart(2, '0');
  return `${p(d.getMonth() + 1)}/${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}
function buildRecords(){
  const r = loadRecords(), t = r.totals;
  const causes = Object.keys(ENDINGS);
  const total = t.runs;
  const unlocked = causes.filter(k => r.counts[k]).length;
  const bust = causes.filter(k => ENDINGS[k].group === 'bust').reduce((sum, k) => sum + (r.counts[k] || 0), 0);
  const h = r.history;
  const top = causes.filter(k => r.counts[k]).sort((a, b) => r.counts[b] - r.counts[a])[0];   // 가장 많이 본 엔딩
  $('recordsSub').textContent = `엔딩 ${unlocked} / ${causes.length} 해금 · 개미 ${total}회차`;
  const summary = `<div class="stat-grid">
      ${statTile('총 판 수', total + '판')}
      ${statTile('최고 생존', `${t.bestWeeks} / ${MAX_ROUND}주`)}
      ${statTile('최고 순자산', t.bestPeak ? fmtMoney(t.bestPeak) : '—')}
      ${statTile('총 반대매매', t.liq + '회')}
      ${statTile('파산 · 졸업', `<span class="${bust ? 'pnl-down' : ''}">${bust}</span> · ${r.counts.VICTORY || 0}회`)}
      ${statTile('가장 많이 본 엔딩', top ? `<span style="color:${ENDINGS[top].color}">${ENDINGS[top].title}</span> ×${r.counts[top]}` : '—', 'wide')}
    </div>`;
  const tiles = ENDING_GROUPS.map(([g, label]) => {
    const list = causes.filter(k => ENDINGS[k].group === g);
    const got = list.filter(k => r.counts[k]).length;
    return `<div class="pile-title">▌ ${label} (${got} / ${list.length})</div>
      <div class="end-grid">${list.map(k => {
        const e = ENDINGS[k], c = r.counts[k] || 0;
        return c
          ? `<div class="end-tile" data-ending="${k}" style="--ec:${e.color}"><div class="et-title">${e.title}</div><div class="et-count">×${c}</div><div class="et-sub">${e.sub}</div></div>`
          : `<div class="end-tile locked" data-ending="${k}"><div class="et-title">??? 미해금</div><div class="et-hint">조건: ${e.hint}</div></div>`;
      }).join('')}</div>`;
  }).join('');
  const rows = h.length ? `<div class="rec-list">${h.map(x => {
      const e = ENDINGS[x.cause] || { title: x.cause, color: 'var(--muted)' };
      return `<div class="rec-row">
        <span class="rr-n">#${x.n}</span>
        <span class="rr-end" style="color:${e.color}">${e.title}</span>
        <span>W${x.round} D${x.day}</span>
        <span class="rr-eq ${signCls(x.eq - START_CASH)}">${fmtMoney(x.eq)}</span>
        <span class="rr-when">${fmtWhen(x.at)}</span>
        <span class="rr-stats">생존 ${x.weeks}주 · 최고 ${fmtMoney(x.peak)} · 반대매매 ${x.liq}회${x.deck !== undefined ? ` · 유물 ${x.relics}개 · 덱 ${x.deck}장` : ''}</span>
      </div>`; }).join('')}</div>`
    : `<div class="rec-empty">아직 끝낸 판이 없습니다. 첫 반대매매는 누구에게나 찾아옵니다.</div>`;
  $('recordsBox').innerHTML = summary + tiles +
    `<div class="pile-title">▌ 최근 ${RECORDS_HISTORY}판</div>` + rows +
    (total ? `<button class="back-btn rec-reset" id="recordsReset">✕ 기록 초기화</button>` : '');
}
$('recordsBox').addEventListener('click', e => {
  const b = e.target.closest('#recordsReset');
  if(!b) return;
  if(!b.dataset.armed){ b.dataset.armed = '1'; b.textContent = '✕ 정말 지울까요? 한 번 더 누르면 삭제'; return; }
  clearRecords();
  buildRecords();
});

$('collectionFilter').addEventListener('click', e => {
  const b = e.target.closest('[data-rarity]');
  if(!b) return;
  collectionRarity = b.dataset.rarity;
  buildCollection();
});

/* ── 연출 (원본 유지) ── */
function showPopNum(text, isUp){
  const pop = document.createElement('div');
  pop.className = 'popnum';
  pop.style.left = (20+Math.random()*40)+'%';
  pop.style.top  = (25+Math.random()*30)+'%';
  pop.style.color = isUp ? 'var(--green)' : 'var(--red)';
  pop.style.textShadow = isUp ? '1px 1px 0 #003a14' : '1px 1px 0 #5c0010';
  pop.textContent = text;
  document.getElementById('chartBox').appendChild(pop);
  setTimeout(()=>pop.remove(), 900);
}

function cashRain(){
  const layer = document.getElementById('confettiLayer');
  const syms = ['$','₩','★','◆'];
  for(let i=0;i<18;i++){
    const b = document.createElement('div');
    b.className = 'bill';
    b.style.left = Math.random()*100+'vw';
    b.style.animationDelay = (Math.random()*.5)+'s';
    b.textContent = syms[Math.floor(Math.random()*syms.length)];
    layer.appendChild(b);
    setTimeout(()=>b.remove(), 2000);
  }
}

/* ══════════════════════════════════════════════════════════
   흐름 제어 — 탭 전환, 새 판 시작, 입력, 게임 루프
══════════════════════════════════════════════════════════ */
function startRun(){
  selectedIdx = -1;
  relicTipId = ''; relicSig = '';
  chartTarget = 'idx';
  handSig = ''; posSig = '';
  hideOverlay();
  resetNews();
  startNewRun();
  renderAll();
  toast(`WEEK 1 개장 — 목표 ${fmtMoney(currentTarget())} · DAY 1 장전`, 'good');
}

const tabBtns = document.querySelectorAll('.tabnav button');
const screens = document.querySelectorAll('.screen');

function switchTab(s){
  if(s === 'shop' && !shopOpenNow()){ toast(SHOP_REJECT_TEXT.phase, 'warn'); return; }
  // TR룸·암시장을 떠날 때는 그 화면의 알림을 지운다 (암시장 알림이 TR룸 차트 위에 남지 않게)
  if(s !== currentTab && (currentTab === 'play' || currentTab === 'shop')) clearToasts();
  currentTab = s;  // 게임 화면이 아니면 시장이 멈춘다
  tabBtns.forEach(x => x.classList.toggle('active', x.dataset.s === s));
  screens.forEach(x => x.classList.toggle('active', x.id === 'screen-' + s));
  if(s === 'play'){
    if(!run || (run.phase === 'over' && !overlayOpen)) startRun();
    renderAll();
  }
  if(s === 'shop') renderShop();
  if(s === 'records') buildRecords();
  if(s === 'settings') buildSettings();
  if(s === 'event') renderTipScreen();
  if(s === 'play' && run && run.pendingTip && !overlayOpen) showTipOverlay();
  renderTabs();
  syncOverlay();
}

tabBtns.forEach(b => b.addEventListener('click', () => switchTab(b.dataset.s)));

$('startBtn').addEventListener('click', () => {
  startRun();
  switchTab('play');
});
$('collectionBtn').addEventListener('click', () => switchTab('collection'));
$('collectionBack').addEventListener('click', () => switchTab('title'));
$('recordsBtn').addEventListener('click', () => switchTab('records'));
$('settingsBtn').addEventListener('click', () => switchTab('settings'));
$('settingsBack').addEventListener('click', () => switchTab('title'));
$('recordsBack').addEventListener('click', () => switchTab('title'));

$('openBtn').addEventListener('click', () => {
  selectedIdx = -1;
  if(run && run.phase === 'shop'){ switchTab('shop'); return; }
  startMarket();
  renderAll();
});
$('deckBtn').addEventListener('click', () => { if(run) showDeck(); });
$('sellAllBtn').addEventListener('click', () => { sellAllPositions(); renderAll(); });

function playSelectedOn(targetId){
  const idx = selectedIdx;
  selectedIdx = -1;
  playCard(idx, targetId);
  renderAll();
}

$('handBox').addEventListener('click', e => {
  const c = e.target.closest('[data-idx]');
  if(!c || !run) return;
  const idx = +c.dataset.idx;
  const card = CARD_BY_ID[run.hand[idx].id];
  if(card.target && run.phase === 'premarket'){
    if(selectedIdx === idx) selectedIdx = -1;                     // 다시 누르면 취소
    else if(run.ap < cardCost(card)) toast(REJECT_TEXT.ap, 'bad');
    else if(validTargetIds(idx).length === 0) toast('쓸 수 있는 대상이 없습니다', 'bad');
    else selectedIdx = idx;                                       // 대상 지정 모드
  } else {
    selectedIdx = -1;
    playCard(idx, null);
  }
  renderAll();
});

$('positionsBox').addEventListener('click', e => {
  const b = e.target.closest('[data-sell]');
  if(b){ sellPosition(+b.dataset.sell); renderAll(); return; }
  const item = e.target.closest('[data-id]');
  const card = run && selectedCard();
  if(item && card && card.target === 'position') playSelectedOn(+item.dataset.id);
});

$('quoteBox').addEventListener('click', e => {
  const row = e.target.closest('[data-q]');
  if(!row || !run) return;
  const card = selectedCard();
  if(card && card.target === 'asset') playSelectedOn(row.dataset.q);
  else showChart(chartTarget === row.dataset.q ? 'idx' : row.dataset.q);   // 같은 종목 다시 누르면 지수로
});
$('chartBackBtn').addEventListener('click', () => showChart('idx'));

document.addEventListener('keydown', e => {
  if(e.key === 'Escape' && selectedIdx >= 0){ selectedIdx = -1; renderAll(); }
});

$('overlay').addEventListener('click', e => {
  const tc = e.target.closest('[data-tip-choice]');
  if(tc){ chooseTip(+tc.dataset.tipChoice); return; }
  const rr = e.target.closest('[data-relic-reward]');
  if(rr){ hideOverlay(); chooseRelicReward(rr.dataset.relicReward); renderAll(); return; }
  const r = e.target.closest('[data-reward]');
  if(r){ hideOverlay(); chooseReward('take', r.dataset.reward); renderAll(); return; }
  const rm = e.target.closest('[data-remove]');
  if(rm){ hideOverlay(); chooseReward('remove', +rm.dataset.remove); renderAll(); return; }
  const b = e.target.closest('[data-act]');
  if(!b || b.disabled) return;
  const act = b.dataset.act;
  if(act === 'skip'){ hideOverlay(); chooseReward('skip'); renderAll(); }
  else if(act === 'skipRelic'){ hideOverlay(); chooseRelicReward(''); renderAll(); }
  else if(act === 'removeMode') showRemove();
  else if(act === 'backReward') showReward(lastRoundClear);
  else if(act === 'close') hideOverlay();
  else if(act === 'restart') startRun();
  else if(act === 'toReward') showReward(lastRoundClear);
  else if(act === 'restartAsk'){ b.dataset.act = 'restart'; b.textContent = '↺ 정말 처음부터? 한 번 더 누르면 새 판'; }
  else if(act === 'title'){ hideOverlay(); switchTab('title'); }
});

const tickerContent = '▶ 반도체전자 10만 전자 가즈아! &nbsp;·&nbsp; 밈코인 TO THE MOON 🚀 &nbsp;·&nbsp; 존버는 승리한다 &nbsp;·&nbsp; 풀매수 기원단 &nbsp;·&nbsp; 영끌 아니면 영원히 무주택 &nbsp;·&nbsp; HODL OR DIE &nbsp;·&nbsp; ';
document.getElementById('tickerText').innerHTML = tickerContent.repeat(3);

window.addEventListener('resize', () => { if(run) renderMainChart(); });
window.onload = () => {
  buildQuotes();
  buildCollection();
  renderTabs();
  applySettings();
  const loop = () => {   // 장중에만, TR룸 화면에서만 시장이 움직인다. 간격 = TICK_MS ÷ 장중 속도
    if(currentTab === 'play' && run && run.phase === 'market' && !overlayOpen){ tick(); renderAll(); }
    setTimeout(loop, TICK_MS / settings.speed);
  };
  setTimeout(loop, TICK_MS / settings.speed);
};
