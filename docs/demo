/* 파산 직전 경고 (tier 4): 반대매매 뒤에도 남은 포지션이 위험하면 하루 한 번 */
let brinkKey = '';
function maybeBrink(){
  const key = run.round + '/' + run.day;
  if(brinkKey === key || run.phase === 'over') return;
  if(!run.positions.some(p => isMarginable(p) && !isProtected(p) && marginWarn(p))) return;
  brinkKey = key;
  const item = { kind: 'brink', tier: 4, blocking: true, duration: 1000, payload: {} };
  item.play = ctx => { Sound.play('gapAlarm', { pitch: chainPitch(ctx) }); Fx.hitStop(FX_TIER[4].hs); Fx.afterStop(() => Fx.shake(2)); Fx.stamp('파산 직전!', '', ''); };
  Fx.enqueue(item);
}

/* 유물 조명: 아이콘이 번쩍 → 픽셀이 영향받는 숫자로 → 도착 지점에 효과 칩. 여러 개면 큐로 하나씩 */
const RELIC_FX = {   // 유물 → [도착 요소, 칩 문구]
