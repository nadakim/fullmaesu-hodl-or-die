};
let relicSeen = {};   // 콜드월렛: 같은 포지션은 하루 한 번만 조명
function enqueueRelic(d){
  const fx = RELIC_FX[d.id];
  if(!fx) return;
  if(d.id === 'coldwallet'){
    const k = run.round + '/' + run.day + '/' + d.posId;
    if(relicSeen[k]) return;
    relicSeen[k] = true;
  }
  const item = { kind: 'relic', tier: 1, blocking: true, duration: 700, payload: d };
  item.play = ctx => {
    const icon = $('relicBar').querySelector(`[data-relic="${d.id}"]`) || $('relicBar');
    Fx.flash(icon, 'fx-relic-on');
    const target = fx[0]();
    Fx.streak(rectOf(icon), rectOf(target), 12, ['--text', '--gold', '--cyan']);
    Fx.chip(fx[1](d.amount) + ' ' + RELIC_BY_ID[d.id].icon, rectOf(target), d.id === 'gukbap' ? '' : 'up', 380);
    Sound.play('chainStep', { pitch: chainPitch(ctx) });
  };
  Fx.enqueue(item);
}

/* 마일스톤: 신고가(작은 도장, 연속이면 3틱에 한 번) · 이번 주 목표 돌파(tier 3) · 시작 자금 2·5·10배(tier 3·4·4) */
const MILESTONE_MULTS = [[2, 3], [5, 4], [10, 4]];
const NEW_HIGH_EVERY_TICKS = 3;
let milestone = { run: null, peak: 0, lastHighTick: -99, mults: {} }, marketTickN = 0;
function juiceMilestones(eq, prev, target){
  if(milestone.run !== run){ milestone = { run, peak: Math.max(START_CASH, eq), lastHighTick: -99, mults: {} }; return; }
  const live = run.phase === 'market' || run.phase === 'premarket';
  if(live && eq > milestone.peak && eq > START_CASH && marketTickN - milestone.lastHighTick >= NEW_HIGH_EVERY_TICKS && run.phase === 'market'){
    milestone.lastHighTick = marketTickN;
    Fx.stamp('신고가!', 'gold', 'sm');
    const r = rectOf($('totalAssets'));
    if(r) Fx.burst(r.left + r.width / 2, r.top + r.height / 2, 14, ['--gold', '--gold2']);
  }
  milestone.peak = Math.max(milestone.peak, eq);
  if(live && prev && prev.round === run.round && !prev.done && eq >= target){
    const item = { kind: 'goal', tier: 3, blocking: true, duration: 1100, payload: {} };
    item.play = ctx => {
      Fx.flash(document.querySelector('.balance-main'), 'fx-goal');
      Fx.flash(document.querySelector('.target-track'), 'fx-goal');
      Sound.play('goalReach', { pitch: chainPitch(ctx) });
      Fx.hitStop(FX_TIER[3].hs); Fx.afterStop(() => Fx.shake(FX_TIER[3].shake));
      Fx.stamp('목표 돌파!', 'up');
      cashRain();
    };
    Fx.enqueue(item);
  }
  MILESTONE_MULTS.forEach(([m, tier]) => {
    if(!live || milestone.mults[m] || eq < START_CASH * m) return;
    milestone.mults[m] = true;
    const item = { kind: 'mult', tier, blocking: true, duration: 1200, payload: { m } };
    item.play = ctx => {
      Sound.play('weekClear', { pitch: chainPitch(ctx) });
      Fx.hitStop(FX_TIER[tier].hs); Fx.afterStop(() => Fx.shake(FX_TIER[tier].shake));
      Fx.stamp(`${m}배 달성`, 'gold');
      Fx.burst(window.innerWidth / 2, window.innerHeight * 0.44, FX_TIER[tier].parts, ['--gold', '--gold2', '--green', '--cyan']);
      cashRain();
    };
    Fx.enqueue(item);
  });
}

/* 장중 콤보: 보유 포지션 합산 평가손익이 연속으로 오른(내린) 캔들 수. 3연속부터 표시, 5·10에서 효과음 + 작은 흔들림 */
let streak = { run: null, dir: 0, n: 0, last: null };
function juiceStreak(){
  const el = $('fxStreak'), vig = $('fxVignette');
  if(!run.positions.length || streak.run !== run){ streak = { run, dir: 0, n: 0, last: run.positions.length ? sumPnl() : null }; el.className = 'fx-streak'; vig.style.opacity = 0; return; }
  const now = sumPnl(), dir = streak.last === null ? 0 : Math.sign(now - streak.last);
  streak.last = now;
  if(!dir) return;
  if(dir === streak.dir) streak.n++;
  else {
    if(streak.n >= 3){ el.classList.add('broken'); setTimeout(() => el.classList.remove('broken'), 500); }   // 끊김: 금이 가며 부서진다
    streak.dir = dir; streak.n = 1;
  }
  const n = streak.n;
  if(n < 3){ if(!el.classList.contains('broken')) el.className = 'fx-streak'; vig.style.opacity = 0; return; }
  const up = dir > 0;
  el.className = 'fx-streak on ' + (up ? (n >= 10 ? 'u3' : n >= 5 ? 'u2' : 'u1') : (n >= 5 ? 'd2' : 'd1'));
  el.textContent = `${up ? '상승' : '하락'} 콤보 ×${n}`;
  el.style.setProperty('--streak-scale', String(Math.min(1.8, 1 + (n - 3) * 0.08)));
  vig.style.opacity = up ? 0 : String(Math.min(0.85, (n - 2) * 0.12));   // 하락이 이어질수록 가장자리가 어두워진다
  if(n === 5 || n === 10){ Sound.play(up ? 'goalReach' : 'sellLoss', { pitch: Sound.semis(n === 10 ? 4 : 0) }); Fx.shake(1); }
}
const sumPnl = () => run.positions.reduce((s, p) => s + posPnl(p), 0);

/* 카드 연쇄: 한 장전에서 연달아 쓰면 2장째부터 잔상, 3장째부터 COMBO. 풀매수처럼 한 번에 여러 종목을 사면 매수를 하나씩 */
let cardChain = { run: null, key: '', n: 0 }, buySeq = 0, buySeqTimer = null;
function noteCardChain(){
  const key = run.round + '/' + run.day;
  if(cardChain.run !== run || cardChain.key !== key) cardChain = { run, key, n: 0 };
  return ++cardChain.n;
}
function juiceBought(d){
  const i = buySeq++;
  clearTimeout(buySeqTimer);
  buySeqTimer = setTimeout(() => { buySeq = 0; }, 0);   // 같은 동기 호출(한 카드) 안에서만 순번
  setTimeout(() => {
    Sound.play('buy', { lev: d.pos.lev, dir: d.pos.dir, pitch: Sound.semis(i) });
    if(i > 0) Fx.flash(posRowEl(d.pos.id), 'fx-hit');
  }, i * 110);
}

/* 큐가 비면 실행 (게임오버·결산 화면은 연쇄가 끝난 뒤에) */
function whenFxIdle(fn){
  if(!Fx.queueLength) return fn();
  const t = setInterval(() => { if(!Fx.queueLength){ clearInterval(t); fn(); } }, 80);
}

/* 카드 사용 + 연출: 엔진 호출은 playCard 그대로. 성공하면 손패 카드가 대상(포지션·시세 행, 종목 카드는 새 포지션)으로 날아간다 */
let lastBoughtPosId = -1;
function playCardFx(idx, targetId){
  const el = $('handBox').querySelector(`[data-idx="${idx}"]`);
  const inst = run.hand[idx];
  const card = inst ? CARD_BY_ID[inst.id] : null;
  const rect = rectOf(el), ghost = el ? el.cloneNode(true) : null;
  lastBoughtPosId = -1;
  const ok = playCard(idx, targetId);
  renderAll();
  if(!ok || !ghost || !card) return ok;
  const target = card.target === 'position' ? posRowEl(targetId) : card.target === 'asset' ? quoteRowEl(targetId)
               : lastBoughtPosId >= 0 ? posRowEl(lastBoughtPosId) : null;
  const n = noteCardChain();
  Fx.cardFly(ghost, rect, target, null, n >= 2 ? Math.min(3, n - 1) : 0);   // 2장째부터 잔상
  if(n >= 3) Fx.chip('COMBO ×' + n, rectOf($('handBox')), 'gold');
  return ok;
}

/* HUD 숫자 펀치 + 목표 달성 순간 (순자산·현금이 바뀐 만큼, 이번 주 목표를 처음 넘으면 초록 섬광 + 징글) */
let hudPrev = null;
function hudJuice(eq, target){
  const done = eq >= target, prev = hudPrev;
  hudPrev = { run, round: run.round, eq, cash: run.cash, done };
  if(!prev || prev.run !== run){ juiceMilestones(eq, null, target); return; }   // 새 판 첫 화면: 비교 대상 없음
  const dEq = eq - prev.eq, dCash = run.cash - prev.cash;
  if(Math.abs(dEq) >= Math.abs(eq) * FX_PUNCH_MIN) Fx.punch($('totalAssets'), dEq, Fx.intensity(dEq, eq));
  if(Math.abs(dCash) >= 1) Fx.punch($('availableCash'), dCash, Fx.intensity(dCash, eq));
  juiceMilestones(eq, prev, target);
}

