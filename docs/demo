function bossRejectText(){
  const b = BOSS_BY_ID[run.boss];
  if(!b) return REJECT_TEXT.invalid;
  return bossBlockText(b.mods.positionCap ? 'posCap' : b.mods.levCap ? 'levCap' : '') || `${b.icon} ${b.name} — 이번 주에는 쓸 수 없는 카드입니다`;
}
/* 보스 주 시작: 중앙 경보 (막는 연출 — 스킵 가능). 갭 경보와 같은 틀 */
