function onGameEvent(type, d){
  switch(type){
    case 'insufficient':
      toast(`현금 부족! ${d.card.name} 매수에 ₩${d.card.cost}만 필요`, 'bad'); break;
    case 'sold':
      showPopNum(fmtSigned(d.pnl), d.pnl >= 0);
      if(d.pnl > 500) cashRain();
      break;
    case 'soldAll':
      showPopNum('청산: ' + fmtSigned(d.pnl), d.pnl >= 0);
      if(d.pnl > 1000) cashRain();
      break;
    case 'marginCall':
      toast(`⚠ 반대매매! ${d.pos.name} ${posLabel(d.pos.side, d.pos.lev)} 강제청산 ${fmtSigned(d.pnl)}`, 'bad');
      flashLiquidation();
      break;
    case 'event':
      $('newsText').textContent = d.text;
      $('marketStateTag').textContent = '■ ' + d.state;
      break;
    case 'eventEnd': resetNews(); break;
    case 'dayStart':
      toast(`DAY ${d.day} 개장` + (d.interest > 0.5 ? ` · 신용이자 −${Math.round(d.interest).toLocaleString()}만` : ''), d.interest > 0.5 ? 'warn' : 'info');
      break;
    case 'roundClear': showRoundClear(d); break;
    case 'roundStart': toast(`WEEK ${d.round} 개장 — 목표 ${fmtMoney(d.target)}`, 'good'); break;
    case 'runOver': showRunOver(d.reason); break;
  }
}

