const MAX_CANDLES = 22;
let candleData = [];

function initChartData(){
  candleData = [];
  let base = marketPrice;
  for(let i=0;i<MAX_CANDLES;i++){
    const c = generateNextCandle(base);
    candleData.push(c);
    base = c.close;
  }
  marketPrice = base;
}

function generateNextCandle(openPrice, extraDrift = 0){
  let drift = extraDrift, volMult = 1.0;
  if(marketState==='BULL'){drift+=12;volMult=1.2;}
  else if(marketState==='BEAR'){drift-=12;volMult=1.2;}
  else if(marketState==='VOLATILE'){volMult=2.8;}

  const change = drift + (rand()-INDEX_TICK_CENTER)*40*volMult;
  const closePrice = Math.max(100, Math.round(openPrice+change));
  const highExtra = rand()*20*volMult;
  const lowExtra  = rand()*20*volMult;
  const high = Math.round(Math.max(openPrice,closePrice)+highExtra);
  const low  = Math.round(Math.min(openPrice,closePrice)-lowExtra);
  return {open:Math.round(openPrice), high:Math.max(10,high), low:Math.max(10,low), close:Math.round(closePrice)};
}

function pushNewCandle(extraDrift = 0){
  const lastClose = candleData.length>0 ? candleData[candleData.length-1].close : marketPrice;
  const newCandle = generateNextCandle(lastClose, extraDrift);
  marketPrice = newCandle.close;
  candleData.push(newCandle);
  if(candleData.length > MAX_CANDLES) candleData.shift();
  return Math.log(newCandle.close / lastClose); // 지수 로그수익률 → 개별 종목에 전달
}


const cc = document.getElementById('candlestickChart');
const cctx = cc.getContext('2d', {antialias: false});

function renderChart(data = candleData){
  if(!cc.clientWidth) return;
  cc.width  = Math.floor(cc.clientWidth);
  cc.height = Math.floor(cc.clientHeight);
  cctx.imageSmoothingEnabled = false;

  cctx.fillStyle = '#000';
  cctx.fillRect(0,0,cc.width,cc.height);

  cctx.fillStyle = 'rgba(26,34,64,0.8)';
  for(let x=0;x<cc.width;x+=6){
    for(let y=0;y<cc.height;y+=6){
      cctx.fillRect(x,y,1,1);
    }
  }

  cctx.fillStyle = '#1a2240';
  for(let i=1;i<4;i++){
    const y = Math.round((cc.height/4)*i);
    cctx.fillRect(0,y,cc.width,1);
  }

  if(data.length===0) return;

  const allH = data.map(c=>c.high);
  const allL = data.map(c=>c.low);
  let maxP = Math.max(...allH)*1.02;
  let minP = Math.min(...allL)*0.98;
  let range = maxP-minP||1;

  const stepX  = cc.width/MAX_CANDLES;
  const candleW = Math.max(2, Math.floor(stepX*0.55));

  data.forEach((c,i) => {
    const cx = Math.round(i*stepX + stepX/2 - candleW/2);

    const scaleY = v => Math.round(cc.height - ((v-minP)/range)*(cc.height-16) - 8);
    const openY  = scaleY(c.open);
    const closeY = scaleY(c.close);
    const highY  = scaleY(c.high);
    const lowY   = scaleY(c.low);
    const isUp   = c.close >= c.open;

    const col    = isUp ? '#00ff41' : '#ff1a3c';
    const shadow = isUp ? '#003a14' : '#3a000e';

    cctx.fillStyle = col;
    cctx.fillRect(cx + Math.floor(candleW/2), highY, 1, lowY-highY);

    const bodyTop = Math.min(openY,closeY);
    const bodyH   = Math.max(2, Math.abs(openY-closeY));
    cctx.fillStyle = shadow;
    cctx.fillRect(cx+2, bodyTop+2, candleW, bodyH);

    cctx.fillStyle = col;
    cctx.fillRect(cx, bodyTop, candleW, bodyH);

    cctx.fillStyle = 'rgba(255,255,255,0.4)';
    cctx.fillRect(cx, bodyTop, candleW, 1);
  });

  if(data.length>0){
    const lastClose = data[data.length-1].close;
    const scaleY = v => Math.round(cc.height - ((v-minP)/range)*(cc.height-16) - 8);
    const py = scaleY(lastClose);
    cctx.fillStyle = '#00e5ff';
    for(let x=0;x<cc.width;x+=4) cctx.fillRect(x,py,2,1);
  }
}

