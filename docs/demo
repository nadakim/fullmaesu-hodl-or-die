const SHOP_SERVICES = [['upgrade', '✦ 리모델링', '고른 카드를 강화(+)'], ['transform', '🔀 변환', '같은 등급의 다른 카드로 무작위 교체 (태그 가중)'],
                       ['duplicate', '📑 복제', '고른 카드 1장을 덱에 한 장 더 (신화 제외)']];
const PACK_BURST = { common: [8, ['--muted', '--line2']], uncommon: [16, ['--green2', '--green']], rare: [26, ['--blue', '--cyan']],
                     legendary: [42, ['--purple', '--gold']], mythic: [80, ['--gold', '--gold2', '--text']] };   // 등급별 파티클 수 · 색
/* (S8-33) 팩 개봉: 공중에서 흔들림(달그락) → 터짐(펑 + 파티클 + 등급 색 빛기둥) → 기둥 속에서 카드가 내려오며 뒤집힘(등급 음).
   신화 = 암전 → 금빛 기둥 + 합창 → 회전 등장 → 화면이 돌아온다. 시간은 JUICE_CONFIG (CSS 변수 --pk-shake로 넘김) */
const packTiming = rarity => {
  const J = JUICE_CONFIG, myth = rarity === 'mythic', start = myth ? J.mythDarkMs : J.packShakeMs;
  return { myth, start, reveal: start + (myth ? J.mythSpinMs : J.packFlipMs / 2) };
};
function juicePack(d){
  const rarity = CARD_BY_ID[d.cardId].rarity, pb = PACK_BURST[rarity], T = packTiming(rarity);
  const burstAt = () => {
    const el = $('overlayBox').querySelector('.flip-card'), r = rectOf(el);
    if(r) Fx.burst(r.left + r.width / 2, r.top + r.height / 2, pb[0], pb[1]);
  };
  if(!T.myth) Sound.play('packShake');
  setTimeout(() => { Sound.play('packBurst', { rarity }); if(T.myth) Sound.play('choir'); burstAt(); }, T.start);
  setTimeout(() => Sound.play('packFlip', { rarity }), T.reveal - 220);   // 휘릭(0.22초) 끝에 등급 음
  if(T.myth) setTimeout(() => { burstAt(); if(overlayOpen) $('overlay').classList.remove('pk-dark'); }, T.reveal);
}
function showPackResult(d){
  const pk = SHOP_PACK_BY_ID[d.packId], card = CARD_BY_ID[d.cardId], T = packTiming(card.rarity);
  showOverlay(`
    <div class="ov-title" style="color:var(--purple)">${pk.icon} ${pk.name} 개봉</div>
    <div class="flip-stage pk ${card.rarity}" style="--pk-shake:${T.start}ms"><div class="pk-pillar"></div>
      <div class="pk-float"><div class="pk-shake"><div class="flip-card">
        <div class="flip-face flip-back">?</div>
        <div class="flip-face flip-front">${cardHtml(card, {})}</div>
      </div></div></div>
    </div>
    <div class="ov-sub"><span class="c-rar ${card.rarity}">${RARITY_LABEL[card.rarity]}</span> · ${card.name} — 덱에 추가 (덱 ${d.deckSize}장)</div>
    <button class="btn-chunky ov-btn" data-act="close">확인</button>`);
  if(T.myth && !isMotionReduced()) $('overlay').classList.add('pk-dark');   // 신화: 암전 (juicePack이 회전 등장 끝에 걷는다)
  packAnimUntil = performance.now() + T.reveal + 300;
}
let packAnimUntil = 0;   // 팩 개봉 연출이 끝나는 시각 (스킵 ▶ 버튼 표시용)
function skipPackAnim(){
