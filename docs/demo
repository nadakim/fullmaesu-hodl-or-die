  ctx.imageSmoothingEnabled = false;
  ctx.fillStyle = '#000'; ctx.fillRect(0, 0, cv.width, cv.height);
  const ser = chartSeries(zoomTarget, zoomMode);
  drawCandles(ctx, cv.width, cv.height, ser.data, k, { slots: ser.slots, grid: true, priceLine: true, refLine: ser.ref });
}
