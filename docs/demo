}
function showSettleTip(el){ if(!run) return; cardTipEl.innerHTML = settleTipHtml(); cardTipEl.hidden = false; placeTip(el); }
function hideCardTip(){ clearTimeout(cardTipTimer); cardTipEl.hidden = true; }
document.addEventListener('mouseover', e => {
  const mp = e.target.closest('#multPreview');
  if(mp){ if(!(e.relatedTarget && mp.contains(e.relatedTarget))){ clearTimeout(cardTipTimer); cardTipTimer = setTimeout(() => { if(mp.isConnected) showSettleTip(mp); }, CARD_TIP_DELAY_MS); } return; }
  const el = e.target.closest('.card[data-cid]');
  if(!el || el.closest('.card-tip')) return;
  if(e.relatedTarget && el.contains(e.relatedTarget)) return;
  clearTimeout(cardTipTimer);
  cardTipTimer = setTimeout(() => { if(el.isConnected) showCardTip(el); }, CARD_TIP_DELAY_MS);
});
document.addEventListener('mouseout', e => {
  const mp = e.target.closest('#multPreview');
  if(mp && !(e.relatedTarget && mp.contains(e.relatedTarget))){ hideCardTip(); return; }
