  }
  else if(e.target.closest('#shopRemoveBtn')){
    const before = shopRemoveCost();
    if(shopRemoveCard(shopPickIdx)){   // 바로 제거 → 다음 가격이 튀어 오르며 빨갛게 (올랐다는 걸 체감)
      shopPickIdx = -1;
      renderShop(); renderNav();
      Fx.punch($('rmNext'), -(shopRemoveCost() - before), 0.8);
      Fx.flash($('rmNext'), 'rm-up');
      return;
    }
  }
  else if(e.target.closest('#shopLeaveBtn')){
    if(shopOpenNow()){ switchTab('play'); leaveShop(); renderAll(); return; }   // 화면을 먼저 옮겨야 개장 알림이 남는다
  }
  else return;
  renderShop();
  renderNav();
});

