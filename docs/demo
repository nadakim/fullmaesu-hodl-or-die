function drawSpark(cv, hist, up){
  const dpr = window.devicePixelRatio || 1, k = Math.max(1, Math.round(uiScale * dpr));   // 점 크기 = 배율 × 화면 밀도
  const cw = Math.round((cv.clientWidth || 64) * dpr), ch = Math.round((cv.clientHeight || 18) * dpr);
  if(cv.width !== cw || cv.height !== ch){ cv.width = cw; cv.height = ch; }
  const ctx = cv.getContext('2d');
  const w = cv.width, h = cv.height, d = 2 * k;
  ctx.clearRect(0, 0, w, h);
  const mx = Math.max(...hist), mn = Math.min(...hist), rg = (mx - mn) || 1;
  ctx.fillStyle = up ? '#00ff41' : '#ff1a3c';
  hist.forEach((v, i) => {
    const x = Math.round(i * (w - d) / (hist.length - 1));
    const y = Math.round(h - d - k - (v - mn) / rg * (h - d - 2 * k));
    ctx.fillRect(x, y, d, d);
  });
}

/* 시그널: 엔진 run.signals(오늘, 장전에 고정)·run.signalResults(어제 채점). 적중률은 엔진 값(sg.acc)을 그대로 */
const SIGNAL_LABEL = { UP: '📈 매수세', FLAT: '➖ 보합', DOWN: '📉 매도세', HOT: '🔥 과열' };
const SIGNAL_ICON = { UP: '📈', FLAT: '➖', DOWN: '📉', HOT: '🔥' };
const perDay = drift => Math.exp(drift * TICKS_PER_DAY) - 1;   // 틱당 드리프트 → 하루 등락률
function signalHtml(s){   // 시세판: 아이콘 + 적중률만 (라벨·어제 채점은 툴팁 signalHelp)
  if(!hasRegime(s)) return '지수 연동';
  const sg = run.signals[s.id];
  if(!sg) return '';
  return `<span class="sig-chip s-${sg.shown}">${SIGNAL_ICON[sg.shown]}</span> ` + (sg.revealed ? '<span class="s-rev">확정 100%</span>' : `적중 ${Math.round(sg.acc * 100)}%`);
}
function signalHelp(s){
  if(!hasRegime(s)) return '인버스는 추세가 따로 없고 지수를 반대로 따라간다';
  const y = run.signalResults[s.id], sg = run.signals[s.id];
  return (sg ? `오늘 시그널: ${SIGNAL_LABEL[sg.shown]} · ${sg.revealed ? '확정 100%' : `적중률 ${Math.round(sg.acc * 100)}%`}\n` : '') + `시그널은 ${Math.round(signalAccNow() * 100)}% 확률로 실제 추세, 아니면 나머지 셋 중 하나.\n` +
    `추세별 하루 추가 등락: 매수세 ${fmtPct(perDay(REGIME_DRIFT.UP))} · 보합 0% · 매도세 ${fmtPct(perDay(REGIME_DRIFT.DOWN))} · 과열 ${fmtPct(perDay(REGIME_DRIFT.HOT))} (갭하락 확률 ×${GAP_HOT_MULT})` +
    (y ? `\n어제: ${SIGNAL_LABEL[y.shown]} 표시 → 실제 ${SIGNAL_LABEL[y.actual]} ${y.hit ? '✓' : '✗'}` : '');
}

