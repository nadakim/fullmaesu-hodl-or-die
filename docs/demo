/* (ui-tactile) 카드 기울기: 손패·보상·암시장 카드에 마우스 위치 따라 3D 기울기. mousemove를 rAF 한 번으로 묶고 CSS 변수(--rx·--ry·--sx)만 바꾼다
   (transform 하나 — 레이아웃 재계산 없음, 크기는 카드에 들어갈 때 한 번만 읽는다). 대상 지정 중·드래그 중·흔들림 끔·동작 줄이기·터치 기기(hover: none)면 끔 */
const TILT_SEL = '#handBox .card.gcard, #overlayBox .card[data-reward], #overlayBox .card[data-upgrade], #overlayBox .card[data-remove], #shopBox .shop-item .card, #shopBox .card[data-shop-remove], '
  + '#shopBox .pack, #shopBox .relic-row:not(.own-relics) .relic-tile, #overlayBox .relic-tile[data-relic-reward], #overlayBox .relic-tile[data-swap-pick]';   // 고를 수 있는 카드·팩·유물만 (덱 확인·도감·팩 구성·보유 유물은 제외)
const HOVER_NONE = !!(window.matchMedia && window.matchMedia('(hover: none)').matches);
let tiltEl = null, tiltRect = null, tiltPt = null, tiltRaf = 0;
const tiltAllowed = () => !isMotionReduced() && !HOVER_NONE && selectedIdx < 0 && relicDragFrom < 0;
function tiltClear(){
  if(!tiltEl) return;
  tiltEl.classList.remove('tilt');
  ['--rx', '--ry', '--sx'].forEach(k => tiltEl.style.removeProperty(k));
  tiltEl = null;
}
function tiltFrame(){
  tiltRaf = 0;
  const pt = tiltPt, card = pt && pt.target && pt.target.closest ? pt.target.closest(TILT_SEL) : null;
  if(!card || card.classList.contains('disabled') || !tiltAllowed()){ tiltClear(); return; }
  if(card !== tiltEl){
    tiltClear();
    if(pt.buttons) return;   // 누른 채 들어온 카드는 기울이지 않는다 (드래그)
    tiltRect = card.getBoundingClientRect();
    tiltEl = card;
    card.classList.add('tilt');
  }
  const r = tiltRect, M = JUICE_CONFIG.tiltMaxDeg;
  const x = Math.max(-0.5, Math.min(0.5, (pt.x - r.left) / r.width - 0.5)), y = Math.max(-0.5, Math.min(0.5, (pt.y - r.top) / r.height - 0.5));
  card.style.setProperty('--ry', (x * 2 * M).toFixed(2) + 'deg');
  card.style.setProperty('--rx', (-y * 2 * M).toFixed(2) + 'deg');
  card.style.setProperty('--sx', Math.round(50 - x * 90) + '%');   // 반짝이는 기울기 반대 방향
}
document.addEventListener('mousemove', e => {
  tiltPt = { x: e.clientX, y: e.clientY, target: e.target, buttons: e.buttons };
  if(!tiltRaf) tiltRaf = requestAnimationFrame(tiltFrame);
}, { passive: true });
document.addEventListener('mouseout', e => { if(!e.relatedTarget){ tiltPt = null; tiltClear(); } });   // 창 밖으로

document.addEventListener('keydown', e => {
  if(Fx.queueLength && (e.code === 'Space' || e.key === ' ' || e.key === 'Enter')){ e.preventDefault(); Fx.skipQueue(); return; }   // 연쇄 연출 스킵
  if(stage && !stage.hold && (e.code === 'Space' || e.key === ' ' || e.key === 'Enter')){ e.preventDefault(); stageSkip(); return; }
  if(stage && stage.hold && (e.key === 'Enter' || e.code === 'Space' || e.key === ' ')){ e.preventDefault(); if(e.key === 'Enter') stageNext(); return; }
  if(chainPlay && (e.code === 'Space' || e.key === ' ')){ e.preventDefault(); skipSettlementChain(); return; }
  if(chainHold && (e.code === 'Space' || e.key === ' ' || e.key === 'Enter')){ e.preventDefault(); if(e.key === 'Enter') chainNext(); return; }   // 스페이스는 결과를 넘기지 않는다
  if((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && relicTipId && currentTab === 'play' && !overlayOpen && run && canArrangeRelics()){   // 선택한 유물 칸 옮기기
    e.preventDefault(); shiftRelic(relicTipId, e.key === 'ArrowLeft' ? -1 : 1); return;
  }
  if(amtCtx && e.key === 'Enter'){ e.preventDefault(); confirmAmount(); return; }
  if(amtCtx && e.key === 'Escape'){ e.preventDefault(); cancelAmount(); return; }
  if(upgradePickMode && e.key === 'Escape'){ e.preventDefault(); upgradePickMode = false; showReward(lastRoundClear); return; }
  if(e.key === 'Escape' && zoomTarget){ e.preventDefault(); closeChartZoom(); return; }
  if(e.key === 'Escape' && glossaryOpen){ e.preventDefault(); hideOverlay(); return; }
  if(currentTab === 'play' && !overlayOpen && !e.ctrlKey && !e.metaKey && !e.altKey && /^[1-4]$/.test(e.key) && !(e.target && /INPUT|TEXTAREA/.test(e.target.tagName))){ setSpeed(speedKeys()[+e.key - 1]); return; }
  if(e.key === 'Escape'){
    if(selectedIdx >= 0){ selectedIdx = -1; renderAll(); return; }   // 대상 지정 취소가 먼저
    if(menuOpen()){ closeMenu(); return; }
    if(currentTab === 'play' && !overlayOpen && run){ openMenu(); return; }
  }
});

$('overlay').addEventListener('click', e => {
  if(stage && !stage.hold){ stageSkip(); return; }
  if(stage && stage.hold){ if(e.target.closest('[data-act="stageNext"]')) stageNext(); return; }   // 결과 화면에선 '▶ 다음 날'만
  if(chainPlay){ skipSettlementChain(); return; }
  if(chainHold){ if(e.target.closest('[data-act="chainNext"]')) chainNext(); return; }   // 결과 화면에선 '▶ 다음'만
  if(performance.now() - chainSkippedAt < CHAIN_SKIP_GUARD_MS) return;
  const gc = e.target.closest('[data-gloss-cat]');
  if(gc){ showGlossary(gc.dataset.glossCat); return; }
  const aq = e.target.closest('[data-amt-q]');
  if(aq && amtCtx){ setAmount(amtCtx.max * +aq.dataset.amtQ); return; }
  const up = e.target.closest('[data-upgrade]');
  if(up){ upgradePickMode = false; hideOverlay(); chooseReward('upgrade', +up.dataset.upgrade); renderAll(); return; }
  const tc = e.target.closest('[data-tip-choice]');
  if(tc){ chooseTip(+tc.dataset.tipChoice); return; }
  const pb = e.target.closest('[data-pack-buy]');
  if(pb){ if(!pb.disabled){ buyPack(pb.dataset.packBuy); renderShop(); renderNav(); } return; }   // 성공하면 packOpened가 개봉 화면으로 바꾼다
  const rr = e.target.closest('[data-relic-reward]');
  if(rr){
    if(relicSlotsFull()){ showRelicSwap('reward', rr.dataset.relicReward); return; }   // 칸이 가득 → 교체할 유물 고르기
    hideOverlay(); chooseRelicReward(rr.dataset.relicReward); renderAll(); return;
  }
  const sw = e.target.closest('[data-swap-pick]');
  if(sw && relicSwapCtx){
    const c = relicSwapCtx; relicSwapCtx = null;
    hideOverlay();
    if(c.mode === 'reward') chooseRelicReward(c.id, sw.dataset.swapPick);
    else { buyRelic(c.id, sw.dataset.swapPick); renderShop(); }
    renderAll(); return;
  }
  const r = e.target.closest('[data-reward]');
  if(r){ hideOverlay(); chooseReward('take', r.dataset.reward); renderAll(); return; }
  const rm = e.target.closest('[data-remove]');
  if(rm){ hideOverlay(); chooseReward('remove', +rm.dataset.remove); renderAll(); return; }
  const ptq = e.target.closest('[data-pt-q]');
  if(ptq){ playtestSurvey(ptq.dataset.ptQ, +ptq.dataset.ptV); return; }
  const b = e.target.closest('[data-act]');
  if(!b || b.disabled) return;
  const act = b.dataset.act;
  if(act === 'ptCopy'){ const r = playtestCurrent(); if(r) copyText(playtestCopyOne(r)); return; }
  if(act === 'amtOk') confirmAmount();
  else if(act === 'amtCancel') cancelAmount();
  else if(act === 'upgradeMode') showUpgradePick();
  else if(act === 'skip'){ hideOverlay(); chooseReward('skip'); renderAll(); }
  else if(act === 'skipRelic'){ hideOverlay(); chooseRelicReward(''); renderAll(); }
  else if(act === 'swapBack'){ relicSwapCtx = null; showRelicReward(); }
  else if(act === 'swapGiveUp'){
    const c = relicSwapCtx; relicSwapCtx = null;
    hideOverlay();
    if(c && c.mode === 'reward'){ chooseRelicReward(''); renderAll(); }
  }
  else if(act === 'removeMode') showRemove();
  else if(act === 'backReward'){ upgradePickMode = false; showReward(lastRoundClear); }
  else if(act === 'close') hideOverlay();
  else if(act === 'unlockNext'){ hideOverlay(); renderAll(); showNextUnlock(); }
  else if(act === 'restart') startRun();
  else if(act === 'toReward') showReward(lastRoundClear);
  else if(act === 'restartAsk'){ b.dataset.act = 'restart'; b.textContent = '↺ 정말 처음부터? 한 번 더 누르면 새 판'; }
  else if(act === 'title'){ hideOverlay(); switchTab('title'); }
});

/* ══ 타이틀 화면 ══
   배경 캔들은 엔진 generateNextCandle과 같은 식(INDEX_STATE·INDEX_TICK_CENTER·INDEX_TICK_RANGE)을 타이틀 전용 상태로 따라 한다.
   엔진 함수는 rand()를 쓰고 marketPrice를 바꾸므로 부르지 않는다 — 연출용 난수는 Math.random. 그리기는 drawCandles 공용 */
const TITLE_CANDLE_SLOT = 14;            // 캔들 한 칸 폭 (--u 배수)
const TITLE_SCROLL_SPEED = 16;           // 초당 흐르는 폭 (--u)
const TITLE_SPIKE_MIN_S = 10, TITLE_SPIKE_MAX_S = 20;   // 큰 장대양봉·갭이 튀는 간격
const TITLE_SPIKE_MULT = 9;              // 장대양봉 = 보통 캔들 변화폭 × 이 값
const TITLE_GAP_PCT = 0.06;              // 갭 크기
const TITLE_POP_MIN_S = 5, TITLE_POP_MAX_S = 8;         // 로고 글자 하나가 '상한가'로 튀는 간격
const TITLE_LIMITDOWN_CHANCE = 0.25;     // 그 차례에 대신 전체가 '하한가'로 번쩍일 확률
const TITLE_LIMITDOWN_MS = 90;           // 하한가 번쩍 (글리치 1프레임 남짓)
const TITLE_LOGO_WIDTH = 0.5, TITLE_LOGO_WIDTH_MAX = 0.55, TITLE_LOGO_WIDTH_MOBILE = 0.74, TITLE_LOGO_WIDTH_MOBILE_MAX = 0.8;   // 로고 폭 = 화면 폭 × 이 값
const TITLE_KO_BASE_PX = 15, TITLE_EN_BASE_PX = 8, TITLE_EN_RATIO = 0.3;   // Galmuri14 원래 크기 · Press Start 2P 원래 크기의 정수배만
const TITLE_INTRO_MS = 1500, TITLE_INTRO_SHORT_MS = 300, TITLE_CONFIRM_MS = 200, TITLE_ARM_MS = 3000;
const TITLE_NOISE_MS = 90;

const titleMotion = () => !isMotionReduced();
let titleEntered = false, titleWoke = false, titleSwallowClick = false;
let titleRaf = 0, titleLastT = 0, titleIntroTimer = null, titlePopTimer = null, titleNoiseTimer = null;
let titleSel = -1, startArmed = false, startArmTimer = null;
const tchart = { data: [], offset: 0, minP: 0, maxP: 0, price: 1000, nextSpike: 0 };

function titleCandle(open, kind){   // kind: '' | 'spike' | 'gap'
  const st = INDEX_STATE.NORMAL;
  let o = open, gap = 0;
  if(kind === 'gap'){ gap = Math.random() < 0.65 ? 1 : -1; o = Math.round(open * (1 + gap * TITLE_GAP_PCT)); }
  const change = kind === 'spike' ? INDEX_TICK_RANGE * TITLE_SPIKE_MULT * (0.8 + Math.random() * 0.4)
    : st.drift + (Math.random() - INDEX_TICK_CENTER) * INDEX_TICK_RANGE * st.vol;
  const close = Math.max(100, Math.round(o + change));
  const high = Math.round(Math.max(o, close) + Math.random() * 20 * st.vol);
  const low = Math.round(Math.min(o, close) - Math.random() * 20 * st.vol);
  const c = { open: o, high, low: Math.max(10, low), close };
  if(gap) c.gap = gap;
  return c;
}
function titleChartFill(n){
  while(tchart.data.length < n){
    const last = tchart.data.length ? tchart.data[tchart.data.length - 1].close : tchart.price;
    tchart.data.push(titleCandle(last, ''));
  }
}
function titleSpikeDelay(){ return (TITLE_SPIKE_MIN_S + Math.random() * (TITLE_SPIKE_MAX_S - TITLE_SPIKE_MIN_S)) * 1000; }
function drawTitleChart(dtMs){
  const cv = $('titleChart');
  if(!cv.clientWidth) return;
  const dpr = window.devicePixelRatio || 1, k = Math.max(1, Math.round(uiScale * dpr));
  const W = Math.floor(cv.clientWidth * dpr), H = Math.floor(cv.clientHeight * dpr);
  if(cv.width !== W || cv.height !== H){ cv.width = W; cv.height = H; }
  const slot = TITLE_CANDLE_SLOT * uiScale * dpr, slots = W / slot;
  titleChartFill(Math.ceil(slots) + 2);
  if(dtMs > 0 && !isMotionReduced()){
    tchart.offset += TITLE_SCROLL_SPEED * uiScale * dpr * dtMs / 1000;
    while(tchart.offset >= slot){   // 한 칸 지나가면 맨 왼쪽을 버리고 오른쪽에 새 캔들
      tchart.offset -= slot;
      tchart.data.shift();
      const now = performance.now();
      let kind = '';
      if(now >= tchart.nextSpike){ kind = Math.random() < 0.6 ? 'spike' : 'gap'; tchart.nextSpike = now + titleSpikeDelay(); }
      tchart.data.push(titleCandle(tchart.data[tchart.data.length - 1].close, kind));
    }
  }
  const hi = Math.max(...tchart.data.map(c => c.high)), lo = Math.min(...tchart.data.map(c => c.low));
  if(!tchart.maxP){ tchart.maxP = hi; tchart.minP = lo; }
  tchart.maxP += (hi * 1.02 - tchart.maxP) * 0.05;   // 범위는 천천히 따라간다 (튀어도 화면이 덜컥이지 않게)
  tchart.minP += (lo * 0.98 - tchart.minP) * 0.05;
  const ctx = cv.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  ctx.clearRect(0, 0, W, H);
  drawCandles(ctx, W, H, tchart.data, k, { slots, offsetX: tchart.offset, minP: tchart.minP, maxP: tchart.maxP, candleW: Math.max(2 * k, Math.floor(slot * 0.55)) });
}
function titleFrame(t){
  const dt = titleLastT ? Math.min(100, t - titleLastT) : 0;
  titleLastT = t;
  drawTitleChart(dt);
  titleRaf = currentTab === 'title' ? requestAnimationFrame(titleFrame) : 0;
}
function drawTitleNoise(){   // CRT 지글거림: 작은 캔버스에 무작위 회색 점 → 화면 전체로 늘려 7%
  const cv = $('titleNoise'), ctx = cv.getContext('2d'), img = ctx.createImageData(cv.width, cv.height);
  for(let i = 0; i < img.data.length; i += 4){ const v = Math.random() * 255; img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255; }
  ctx.putImageData(img, 0, 0);
}

/* 로고: 이름은 GAME_TITLE에서. 글자 크기 = 원래 크기의 정수배 중 화면 폭 45~55%에 맞는 값 */
function buildTitleLogo(){
  let i = 0;
  $('titleKo').innerHTML = [...GAME_TITLE.ko].map(ch => ch === ' ' ? '<span class="t-sp"> </span>'
    : `<span class="t-ch" style="--d:${(0.5 + (i++) * 0.06).toFixed(2)}s">${ch}</span>`).join('');
  $('titleEn').textContent = GAME_TITLE.en;
  $('titleEn').style.setProperty('--d', (0.55 + i * 0.06).toFixed(2) + 's');
  document.querySelector('#titleLogo .jibu-badge').style.setProperty('--d', (0.6 + i * 0.06).toFixed(2) + 's');
  $('titleLogo').setAttribute('aria-label', GAME_TITLE.ko + ' ' + GAME_TITLE.en);
  layoutTitleLogo();
}
function layoutTitleLogo(){
  const ko = $('titleKo'), logo = $('titleLogo');
  if(!ko.clientWidth && currentTab !== 'title') return;
  const W = window.innerWidth, mobile = isMobileLayout();
  const target = W * (mobile ? TITLE_LOGO_WIDTH_MOBILE : TITLE_LOGO_WIDTH), max = W * (mobile ? TITLE_LOGO_WIDTH_MOBILE_MAX : TITLE_LOGO_WIDTH_MAX);
  const setPx = n => {
    const px = TITLE_KO_BASE_PX * n;
    logo.style.setProperty('--logo-ko', px + 'px');
    logo.style.setProperty('--logo-en', TITLE_EN_BASE_PX * Math.max(1, Math.round(px * TITLE_EN_RATIO / TITLE_EN_BASE_PX)) + 'px');
  };
  setPx(1);
  const per = ko.scrollWidth || TITLE_KO_BASE_PX * GAME_TITLE.ko.length;   // 배율 1일 때 폭
  let n = Math.max(1, Math.round(target / per));
  while(n > 1 && per * n > max) n--;
  setPx(n);
}
function titlePopSchedule(){
  clearTimeout(titlePopTimer);
  titlePopTimer = setTimeout(() => {
    if(currentTab === 'title' && titleMotion()){
      const logo = $('titleLogo');
      if(Math.random() < TITLE_LIMITDOWN_CHANCE){   // 하한가 번쩍 → 다시 초록
        logo.classList.add('limitdown');
        setTimeout(() => logo.classList.remove('limitdown'), TITLE_LIMITDOWN_MS);
      } else {   // 글자 하나 상한가 — 위로 툭 튀었다가 떨어짐
        const chs = logo.querySelectorAll('.t-ch'), ch = chs[Math.floor(Math.random() * chs.length)];
        ch.classList.remove('pop'); void ch.offsetWidth; ch.classList.add('pop');
      }
    }
    if(currentTab === 'title') titlePopSchedule();
  }, (TITLE_POP_MIN_S + Math.random() * (TITLE_POP_MAX_S - TITLE_POP_MIN_S)) * 1000);
}

/* 메뉴: 호버·키보드가 같은 선택(.sel)을 쓴다. ↑↓ 이동 · Enter 확정 · Esc 무시. 아이콘(⚙·🌐)도 ↓로 이어서 간다 */
const hasQuit = () => !!(window.electronAPI && typeof window.electronAPI.quit === 'function');   // 데스크톱 앱(Electron)만
const titleItems = () => [...document.querySelectorAll('#titleMenu .t-item, #screen-title .t-icon')].filter(b => !b.hidden);
function setTitleSel(i, sound){
  const items = titleItems();
  if(!items.length) return;
  i = (i + items.length) % items.length;
  if(i === titleSel && items[i].classList.contains('sel')) return;
  items.forEach((b, j) => b.classList.toggle('sel', j === i));
  titleSel = i;
  if(sound) Sound.play('uiMove');
}
function titleActivate(b){
  if(b.classList.contains('t-icon')){ b.click(); return; }
  if(b.id === 'startBtn' && run && run.phase !== 'over' && !startArmed){   // 진행 중인 판이 있으면 한 번 더 확인
    startArmed = true;
    b.classList.add('armed');
    b.querySelector('.t-lbl').textContent = '[진행 중인 판이 사라집니다. 정말? — 한 번 더]';
    Sound.play('cardReject');
    clearTimeout(startArmTimer);
    startArmTimer = setTimeout(disarmStart, TITLE_ARM_MS);
    return;
  }
  b.classList.add('flash');
  Sound.play('uiConfirm');
  setTimeout(() => {
    b.classList.remove('flash');
    if(b.id === 'startBtn') disarmStart();
    b.dataset.pass = '1';
    b.click();   // 원래 버튼 동작 (startBtn·continueBtn·collectionBtn·recordsBtn·settingsBtn·quitBtn)
  }, TITLE_CONFIRM_MS);
}
function disarmStart(){
  startArmed = false;
  clearTimeout(startArmTimer);
  const b = $('startBtn');
  b.classList.remove('armed');
  b.querySelector('.t-lbl').textContent = '[영끌 출격]';
}
$('titleMenu').addEventListener('click', e => {   // 캡처: 바를 번쩍이고 0.2초 뒤 원래 동작으로 넘긴다
  const b = e.target.closest('.t-item');
  if(!b) return;
  if(b.dataset.pass){ delete b.dataset.pass; return; }
  e.stopPropagation(); e.preventDefault();
  titleActivate(b);
}, true);
$('titleMenu').addEventListener('mouseover', e => {
  const b = e.target.closest('.t-item');
  if(b) setTitleSel(titleItems().indexOf(b), true);
});
document.querySelectorAll('#screen-title .t-icon').forEach(b => b.addEventListener('mouseenter', () => setTitleSel(titleItems().indexOf(b), true)));
$('titleSettingsIcon').addEventListener('click', () => { settingsReturn = 'title'; switchTab('settings'); });
$('langBtn').addEventListener('click', () => toast('English — 준비 중', 'info'));
$('quitBtn').addEventListener('click', () => { if(hasQuit()) window.electronAPI.quit(); });
document.addEventListener('keydown', e => {
  if(currentTab !== 'title' || !titleWoke || overlayOpen) return;
  if(e.key === 'ArrowDown' || e.key === 'ArrowUp'){
    e.preventDefault();
    setTitleSel(titleSel < 0 ? 0 : titleSel + (e.key === 'ArrowDown' ? 1 : -1), true);
  } else if(e.key === 'Enter'){
    e.preventDefault();
    const b = titleItems()[titleSel];
    if(b) titleActivate(b);
  }
});

/* 첫 입력: 오디오를 켜고(Sound.attachUnlock) 등장 연출을 끝낸다 — 메뉴 선택으로는 쓰지 않는다 (그 클릭·키는 버린다) */
function wakeTitle(){
  titleWoke = true;
  $('titlePress').hidden = true;
  finishTitleIntro();
  updateMusic();
  if(titleSel < 0) setTitleSel(0, false);
}
document.addEventListener('pointerdown', e => {
  if(titleWoke || currentTab !== 'title') return;
  wakeTitle();
  titleSwallowClick = true;
}, true);
document.addEventListener('click', e => {
  if(!titleSwallowClick) return;
  titleSwallowClick = false;
  e.stopPropagation(); e.preventDefault();
}, true);
document.addEventListener('keydown', e => {
  if(currentTab !== 'title') return;
  if(!titleWoke){ wakeTitle(); e.stopImmediatePropagation(); e.preventDefault(); return; }
  if($('screen-title').classList.contains('intro-full') || $('screen-title').classList.contains('intro-short')) finishTitleIntro();   // 아무 키나 → 연출 스킵
}, true);
$('screen-title').addEventListener('pointerdown', () => finishTitleIntro());

/* 등장: 첫 진입 = CRT 켜짐 → 차트 → 로고 타자 → 메뉴 (1.5초), 다시 들어오면 CRT만 짧게. 동작 줄이기면 없음 */
function enterTitle(){
  const sc = $('screen-title');
  sc.classList.toggle('t-static', !titleMotion());
  sc.classList.remove('intro-full', 'intro-short');
  let i = 0;
  titleItems().forEach(b => { if(b.parentElement.id === 'titleMenu') b.style.setProperty('--d', (0.95 + (i++) * 0.07).toFixed(2) + 's'); });
  if(titleMotion()){
    void sc.offsetWidth;
    sc.classList.add(titleEntered ? 'intro-short' : 'intro-full');
    clearTimeout(titleIntroTimer);
    titleIntroTimer = setTimeout(finishTitleIntro, titleEntered ? TITLE_INTRO_SHORT_MS : TITLE_INTRO_MS);
  }
  titleEntered = true;
  disarmStart();
  $('quitBtn').hidden = !hasQuit();
  $('quitGap').hidden = !hasQuit();
  layoutTitleLogo();
  if(titleSel >= 0) setTitleSel(Math.min(titleSel, titleItems().length - 1), false);
  titleLastT = 0;
  if(!titleRaf) titleRaf = requestAnimationFrame(titleFrame);
  clearInterval(titleNoiseTimer);
  drawTitleNoise();
  if(!isMotionReduced()) titleNoiseTimer = setInterval(drawTitleNoise, TITLE_NOISE_MS);
  titlePopSchedule();
}
/* ── 연출 스킵 ▶ (클릭 전용 조작): Space/Enter로 넘기던 연출마다 같은 동작의 버튼을 화면 아래 가운데에 띄운다 ──
   연쇄 연출 큐(갭 경보·카운트다운·보스 경보·찌라시 결과) · 장 마감 정산 무대(재생 중) · 주간 결산 체인(재생 중) · 팩 개봉 · 타이틀 등장 */
function skipTarget(){
  if(Fx.queueLength) return () => Fx.skipQueue();
  if(stage && !stage.hold) return () => stageSkip();
  if(chainPlay) return () => skipSettlementChain();
  if(packAnimUntil > performance.now()) return () => skipPackAnim();
  const t = $('screen-title');
  if(currentTab === 'title' && (t.classList.contains('intro-full') || t.classList.contains('intro-short'))) return () => finishTitleIntro();
  return null;
}
(function skipLoop(){
  const b = $('fxSkipBtn'), on = !!skipTarget();
  if(b.hidden === on) b.hidden = !on;
  requestAnimationFrame(skipLoop);
})();
$('fxSkipBtn').addEventListener('click', e => { e.stopPropagation(); const f = skipTarget(); if(f) f(); });
$('fxSkipBtn').addEventListener('pointerdown', e => e.stopPropagation());

function finishTitleIntro(){
  clearTimeout(titleIntroTimer);
  $('screen-title').classList.remove('intro-full', 'intro-short');
}
function leaveTitle(){
  disarmStart();
  clearInterval(titleNoiseTimer);
  clearTimeout(titlePopTimer);
  finishTitleIntro();
}
function initTitle(){
  $('titleVersion').textContent = GAME_META.version;
  $('titleAuthor').textContent = GAME_META.author ? 'GAME BY ' + GAME_META.author : '';
  $('titleAuthor').hidden = !GAME_META.author;
  [['steamLink', GAME_META.links.steam], ['discordLink', GAME_META.links.discord]].forEach(([id, url]) => { $(id).hidden = !url; if(url) $(id).href = url; });
  tchart.nextSpike = performance.now() + titleSpikeDelay();
  buildTitleLogo();
}

const tickerContent = `▶ 반도체전자 10만 전자 가즈아! &nbsp;·&nbsp; 밈코인 TO THE MOON 🚀 &nbsp;·&nbsp; 존버는 승리한다 &nbsp;·&nbsp; ${GAME_TITLE.ko} &nbsp;·&nbsp; 영끌 아니면 영원히 무주택 &nbsp;·&nbsp; ${GAME_TITLE.en.toUpperCase()} &nbsp;·&nbsp; `;
document.getElementById('tickerText').innerHTML = tickerContent.repeat(3);

window.onload = () => {
  $('marginRuleText').title = MAINTENANCE_MARGIN_ON   // 반대매매 기준 (엔진 수치 그대로) — 화면에는 '심지', 전문용어는 툴팁
    ? `담보비율 ${Math.round(MAINTENANCE_RATIO * 100)}%(숏 ${Math.round(SHORT_MAINTENANCE_RATIO * 100)}%) 미만 = 청산`
    : `증거금률 ${Math.round(MARGIN_CALL_RATIO * 100)}% 미만 = 청산`;
  buildQuotes();
  $('menuSectors').hidden = !SECTOR_LEVELS_ON;   // (N3) 플래그가 꺼져 있으면 메뉴도 없음
  buildCollection();
  renderNav();
  applySettings();
  initTitle();
  enterTitle();
  updateMusic();   // 타이틀 곡 (소리는 첫 클릭·키 입력 뒤부터)
  const loop = () => {   // 장중에만, TR룸 화면에서만 시장이 움직인다. 간격 = TICK_MS ÷ 장중 속도
    const frozen = Fx.frozenFor();   // 히트스톱: 다음 tick을 그만큼 미룰 뿐 (tick 순서·횟수·결과는 그대로)
    if(frozen > 0){ setTimeout(loop, frozen); return; }
    if(currentTab === 'play' && run && run.phase === 'market' && !overlayOpen && !Fx.queueBusy){   // 연쇄 연출 중엔 시장 정지 (tick을 미룰 뿐)
      tick();
      marketTickN++;
      notePosTicks();   // (32) 불꽃·신고가 번쩍 (표시만)
      juiceRockets(); juiceSurvive(); juiceClosing();   // (B5·D10·B8) 급등 로켓 · 간신히 생존 · 마감 임박 (표시·소리만)
      if(!run.positions.length) hideDownStreak();
      if(settings.tickSound) Sound.play('tick', { volume: 0.6, pitch: Sound.semis(streak.dir * Math.min(12, streak.n)) });   // 틱 음높이가 보유 손익 콤보를 따라간다
      renderAll();
    }
    setTimeout(loop, TICK_MS / settings.speed);
  };
  setTimeout(loop, TICK_MS / settings.speed);
  heartLoop();   // (32) 반대매매 위험 심장 박동
  if(TUNER_ON){ tunerLoad(); buildTuner(); }   // (46) ?debug=1 · ?tuner=1 연출 조정 패널
  document.addEventListener('keydown', e => {   // UI 규칙 7: 백틱(`) 키로 디버그 패널 열기/닫기
    if(e.key !== '`' || (e.target && /INPUT|TEXTAREA/.test(e.target.tagName))) return;
    const p = $('tunerPanel');
    if(p) p.hidden = !p.hidden; else { tunerLoad(); buildTuner(); }
  });
  if(SOUNDLAB_ON) loadSoundLab();   // ?soundlab=1 Sound Lab
};
</script>
