/* 생존 주 수에 따른 등급 */
function antGrade(weeks){
  if(weeks >= MAX_ROUND) return '세력';
  if(weeks >= 6) return '고수 개미';
  if(weeks >= 3) return '중수 개미';
  if(weeks >= 1) return '주린이';
  return '1주 컷';
}

/* 이 브라우저에서 끝낸 판 수 ("개미 N회차") — 저장이 막혀 있으면 이번 세션만 센다 */
let antRunsFallback = 0;
function countFinishedRun(){
  let n = antRunsFallback + 1;
  try { n = (parseInt(localStorage.getItem('hodl.antRuns'), 10) || 0) + 1; localStorage.setItem('hodl.antRuns', String(n)); } catch(e) {}
  antRunsFallback = n;
  return n;
}

/* ── 파산 기록: 끝낸 판을 이 브라우저에 저장 (엔딩별 횟수 + 최근 판 목록) ──
   저장이 막혀 있으면(시크릿 모드 등) 이번 세션 동안만 메모리에 남긴다 */
const RECORDS_KEY = 'hodl.records';
const RECORDS_HISTORY = 30;   // 최근 판 목록 길이
const emptyRecords = () => ({ counts: {}, history: [], totals: { runs: 0, bestWeeks: 0, bestPeak: 0, liq: 0 } });
let recordsFallback = emptyRecords();
function loadRecords(){
  let r = null;
  try { r = JSON.parse(localStorage.getItem(RECORDS_KEY)); } catch(e) {}
  if(!r || !r.counts || !Array.isArray(r.history)) return recordsFallback;
  if(!r.totals){   // 누적 통계가 없던 옛 기록: 남아 있는 목록으로 채운다
    const h = r.history;
    r.totals = { runs: Object.keys(r.counts).reduce((s, k) => s + r.counts[k], 0),
      bestWeeks: h.reduce((m, x) => Math.max(m, x.weeks), 0), bestPeak: h.reduce((m, x) => Math.max(m, x.peak), 0),
      liq: h.reduce((s, x) => s + x.liq, 0) };
  }
  return r;
}
function saveRecords(r){
  recordsFallback = r;
  try { localStorage.setItem(RECORDS_KEY, JSON.stringify(r)); } catch(e) {}
}
/* 끝난 판 하나를 기록. 반환: 이번이 이 엔딩 첫 해금인지 */
function recordRun(n, cause){
  const r = loadRecords();
  const first = !r.counts[cause];
  r.counts[cause] = (r.counts[cause] || 0) + 1;
  const peak = Math.round(run.peakEquity);
  r.history.unshift({
    n, cause, round: run.round, day: run.day, weeks: run.weeksCleared,
    eq: Math.round(run.endEquity), peak, liq: run.liquidations,
    relics: run.relics.length, deck: run.masterDeck.length, at: Date.now()
  });
  const t = r.totals;   // 목록(최근 30판)과 달리 전체 판 누적
  t.runs = Math.max(t.runs + 1, n);   // n = '개미 N회차' 카운터 (hodl.antRuns)
  t.bestWeeks = Math.max(t.bestWeeks, run.weeksCleared);
  t.bestPeak = Math.max(t.bestPeak, peak);
  t.liq += run.liquidations;
  if(r.history.length > RECORDS_HISTORY) r.history.length = RECORDS_HISTORY;
  saveRecords(r);
  return first;
}
function clearRecords(){
  saveRecords(emptyRecords());
  antRunsFallback = 0;
  try { localStorage.removeItem('hodl.antRuns'); } catch(e) {}
}

function statTile(label, value, cls){ return `<div class="${cls || ''}">${label}<b>${value}</b></div>`; }
const signCls = v => v >= 0 ? 'pnl-up' : 'pnl-down';

function showRunOver(reason){
  overPending = false;
  updateMusic();   // desired → records (스팅어가 끝나면 이어서 튼다)
  const cause = run.endCause || reason, e = ENDINGS[cause], w = run.lastWeek;
  const n = countFinishedRun();
  const firstTime = recordRun(n, cause);
  const unlocked = Object.keys(loadRecords().counts).filter(k => ENDINGS[k]).length;
  const weeks = run.weeksCleared;
  showOverlay(`
    <div class="result-kicker">GAME OVER · WEEK ${run.round} DAY ${run.day}</div>
    <div class="ov-title ending-title" style="color:${e.color}" data-cause="${cause}">${e.title}</div>
    <div class="ov-sub">${e.sub}</div>
    <div class="ending-cause">${e.cause(w)}</div>
    <div class="ending-badge">${cause === 'VICTORY' ? `개미 ${n}회차 만에 졸업` : `당신은 이제 개미 ${n}회차`} · 등급: ${antGrade(weeks)}</div>
    ${firstTime ? `<div class="ending-badge ending-new">★ 새 엔딩 해금 · 파산 기록 ${unlocked} / ${Object.keys(ENDINGS).length}</div>` : ''}
    <div class="stat-grid">
      ${statTile('최종 순자산', `<span class="${signCls(run.endEquity - START_CASH)}">${fmtMoney(run.endEquity)}</span>`)}
      ${statTile('최고 순자산', fmtMoney(run.peakEquity))}
      ${statTile('생존 라운드', `${weeks} / ${MAX_ROUND}주`)}
      ${statTile('반대매매', run.liquidations + '회')}
      ${statTile('확정손익', `<span class="${signCls(run.realized)}">₩ ${fmtSigned(run.realized)}</span>`)}
      ${statTile('누적 이자', fmtMoney(run.interestPaid))}
      ${statTile('수익률 (시작 대비)', `<span class="${signCls(run.endEquity - START_CASH)}">${fmtPct(run.endEquity / START_CASH - 1)}</span>`)}
      ${statTile('덱 · 유물', `${run.masterDeck.length}장 · ${run.relics.length}개`)}
    </div>
    <button class="ov-btn" data-act="restart">↺ 다시 시작</button>
    <button class="ov-btn alt" data-act="title">◀ 타이틀로</button>`);
  if(reason === 'VICTORY') cashRain();
}

/* 주간 결산 결과 → 보상 → 암시장 */
function roundResultLine(w){
  if(w.bailout > 0) return '부모님 카드로 겨우 통과. 다음 주엔 기댈 곳이 없습니다.';
  if(w.pct >= 1.5) return '떡상! 리딩방에서 스카우트 연락이 올 수준.';
  if(w.pct >= 1.2) return '여유 있게 통과. 오늘만큼은 개미 탈출.';
  return '턱걸이 통과. 심장은 이미 반대매매 당했습니다.';
}

/* ── 결산 체인: 통과한 결산에서 유물·보너스가 포지션 손익을 불린 순서를 재생 ──
   값은 엔진이 이미 확정한 run.lastWeek.settlementChain을 그대로 보여줄 뿐이다 (계산 없음).
   보정 없는 포지션은 숫자만, 보정 있는 포지션만 칩 연출. 클릭 · SPACE = 전체 건너뛰기. */
const CHAIN_MAX_ROWS    = 4;     // 포지션이 이보다 많으면
const CHAIN_TOP_ROWS    = 3;     //   손익 절댓값 상위 이만큼만 재생하고 나머지는 요약 한 줄
const CHAIN_COUNT_STEPS = 8;     // 숫자 카운트업 칸 수 (픽셀 톤: 부드럽게 말고 8칸)
const CHAIN_MS = { row: 280, base: 360, chip: 480, hitstop: 60, stamp: 520, plain: 220, end: 900 };
const CHAIN_ROW_SEMIS  = 2;      // 소리: 두 번째 포지션부터 체인 시작음을 이만큼(반음)씩 높여 결산 전체가 고조된다
const CHAIN_MULT_SEMIS = 2;      //   곱연산(×) 스텝은 덧셈 스텝보다 이만큼 더 높게 + 약한 흔들림 + 큰 숫자 펀치
const CHAIN_SKIP_GUARD_MS = 300; // 건너뛴 직후 연타가 결산 화면 버튼을 누르지 않게
const CHAIN_NEXT_GUARD_MS = 500; // 최종 결과가 뜬 뒤 이 시간 동안은 '▶ 다음'·엔터를 무시 (스페이스 연타로 결과를 건너뛰지 않게)
let chainPlay = null;            // 재생 중: { run, timers, onDone, sum }
let chainHold = null;            // 최종 결과에서 멈춤: { run, onDone, skipped, readyAt } — '▶ 다음'·엔터만 onDone을 부른다
let chainSkippedAt = 0;

const chainHasMods = c => c.steps.length > 1;
const chainChipText = st => st.kind === 'mult' ? `${st.label} ×${st.value.toFixed(2)}` : `${st.label} +${fmtMoney(st.value)}`;
const chainChipCls  = st => st.kind === 'add' ? 'add' : st.value < 1 ? 'cut' : '';

/* 재생이 없어도(설정 끔·보정 없음) 같은 틀로 최종 손익 요약을 보여주고 '▶ 다음'을 기다린다 */
function playSettlementChain(chain, onDone){
  chain = chain || [];
  let rows = chain, rest = [];
  if(chain.length > CHAIN_MAX_ROWS){
    const sorted = chain.slice().sort((a, b) => Math.abs(b.finalPnl) - Math.abs(a.finalPnl));
    rows = sorted.slice(0, CHAIN_TOP_ROWS);
    rest = sorted.slice(CHAIN_TOP_ROWS);
  }
  const animate = settings.chainFx && rows.some(chainHasMods);
  const restSum = rest.reduce((sum, c) => sum + c.finalPnl, 0);
  const sum = chain.reduce((s2, c) => s2 + c.finalPnl, 0);
  showOverlay(`
    <div class="result-kicker">WEEK ${run.round} / ${MAX_ROUND} 결산 · ${animate ? '정산 중' : '최종 손익'}</div>
    <div class="ov-title" style="color:var(--gold)">${animate ? '결산 체인' : '결산 요약'}</div>
    <div class="chain-list" id="chainList">
      ${rows.map((c, i) => `<div class="chain-row pending" id="chainRow${i}">
        <div class="chain-head"><span class="chain-name">${c.posName} <small>${posLabel(c)}</small></span><span class="chain-total" id="chainTotal${i}"></span></div>
        <div class="chain-chips ${chainHasMods(c) ? '' : 'none'}"></div></div>`).join('')}
      ${rest.length ? `<div class="chain-rest pending">▌ 외 포지션 ${rest.length}개 · 합계 <span class="${signCls(restSum)}">${fmtSigned(restSum)}</span></div>` : ''}
      ${chain.length ? '' : '<div class="chain-rest">▌ 보유 포지션 없음 — 이번 주 손익은 모두 확정됨</div>'}
      <div class="chain-sum pending">정산 합계 <span class="${signCls(sum)}">${fmtSigned(sum)}</span></div>
    </div>
    ${animate ? '<div class="chain-skip">클릭 · SPACE = 건너뛰기</div>' : ''}`);
  chainPlay = { run, timers: [], onDone, sum, rows };
  if(!animate){ enterChainHold(false); return; }
  Music.duck('chain', 0.2);   // 결산 체인 효과음이 주인공
  const list = $('chainList');
  let t = 0;
  const at = (ms, fn) => chainPlay.timers.push(setTimeout(() => { if(chainPlay && $('chainList')) fn(); }, ms));   // 오버레이가 바뀌었으면 아무것도 안 한다
  const setTotal = (el, v) => { el.textContent = fmtSigned(v); el.className = 'chain-total ' + (v >= 0 ? 'up' : 'down'); };
  const countUp = (elFn, from, to, start, dur, semi) => {   // 8칸 카운트업 + 칸마다 블립, 마지막 칸은 정확한 값
    for(let k = 1; k <= CHAIN_COUNT_STEPS; k++) at(start + dur * k / CHAIN_COUNT_STEPS, () => {
      setTotal(elFn(), k === CHAIN_COUNT_STEPS ? to : from + (to - from) * k / CHAIN_COUNT_STEPS);
      Sound.play('countTick', { pitch: Sound.semis(semi + k / 4) });
    });
  };
  rows.forEach((c, i) => {
    const id = 'chainRow' + i;
    const rowSemi = i * CHAIN_ROW_SEMIS;
    const eqNow = Math.max(1, netEquity());
    at(t, () => {
      list.querySelectorAll('.chain-row.playing').forEach(r => r.classList.remove('playing'));
      $(id).classList.remove('pending');
      if(chainHasMods(c)) $(id).classList.add('playing');
    });
    const total = () => $(id).querySelector('.chain-total');
    if(!chainHasMods(c)){   // 보정 없음: 숫자만
      at(t, () => { setTotal(total(), c.finalPnl); Sound.play('countTick', { pitch: Sound.semis(rowSemi) }); });
      t += CHAIN_MS.plain;
      return;
    }
    t += CHAIN_MS.row;
    at(t, () => { setTotal(total(), 0); Sound.play('chainStep', { pitch: Sound.semis(rowSemi) }); });
    countUp(total, 0, c.steps[0].runningTotal, t, CHAIN_MS.base, rowSemi);
    t += CHAIN_MS.base;
    c.steps.slice(1).forEach((st, k) => {
      const prev = c.steps[k].runningTotal, mult = st.kind === 'mult';
      const semi = rowSemi + k + 1 + (mult ? CHAIN_MULT_SEMIS : 0);   // 스텝마다 반음씩, 곱연산은 한 단계 더
      at(t, () => {
        $(id).querySelector('.chain-chips').insertAdjacentHTML('beforeend', `<span class="chain-chip ${chainChipCls(st)}">${chainChipText(st)}</span>`);
        Sound.play('chainStep', { pitch: Sound.semis(semi), volume: mult ? 1.15 : 0.9 });
        if(mult) Fx.shake(1);
        Fx.punch(total(), st.runningTotal - prev || 1, mult ? 0.8 : 0.3);
      });
      countUp(total, prev, st.runningTotal, t + CHAIN_MS.chip / 3, CHAIN_MS.chip * 2 / 3, semi);
      t += CHAIN_MS.chip;
    });
    at(t, () => {   // 최종값 도달 → 히트스톱
      setTotal(total(), c.finalPnl);   // 카운트업 마지막 칸과 같은 값 — 순서가 뒤바뀌어도 최종 숫자는 정확히
      Fx.hitStop(CHAIN_MS.hitstop);
    });
    t += CHAIN_MS.hitstop;
    at(t, () => {   // → 도장 쾅 → 파티클
      const el = total(), win = c.finalPnl >= 0;
      setTotal(el, c.finalPnl);
      el.classList.add('final');
      $(id).insertAdjacentHTML('beforeend', `<span class="chain-stamp ${win ? '' : 'down'}">${win ? '떡상!' : '물림'}</span>`);
      Sound.play(win ? 'stampWin' : 'stampLoss', { pitch: Sound.semis(rowSemi) });
      Fx.punch(el, c.finalPnl || 1, Fx.intensity(c.finalPnl, eqNow));
      const r = rectOf($(id).querySelector('.chain-stamp'));
      if(r) Fx.burst(r.left + r.width / 2, r.top + r.height / 2, Math.round(12 + 30 * Fx.intensity(c.finalPnl, eqNow)), win ? ['--gold', '--green', '--gold2'] : ['--red', '--red2', '--muted']);
    });
    t += CHAIN_MS.stamp;
  });
  at(t, () => {
    list.querySelectorAll('.chain-row.playing').forEach(r => r.classList.remove('playing'));
    list.querySelectorAll('.chain-rest, .chain-sum').forEach(e => e.classList.remove('pending'));
  });
  chainPlay.timers.push(setTimeout(() => enterChainHold(false), t));   // 다 보여주면 그대로 멈춘다 (자동으로 넘어가지 않음)
}
/* 최종 프레임: 모든 행의 칩·최종 손익·도장을 채운다 (스킵했을 때 여기로 점프) */
function renderChainFinal(rows){
  const list = $('chainList');
  if(!list) return;
  rows.forEach((c, i) => {
    const row = $('chainRow' + i);
    if(!row) return;
    row.classList.remove('pending', 'playing');
    const chips = row.querySelector('.chain-chips');
    if(chainHasMods(c) && chips.children.length < c.steps.length - 1)
      chips.innerHTML = c.steps.slice(1).map(st => `<span class="chain-chip ${chainChipCls(st)}">${chainChipText(st)}</span>`).join('');
    const tot = row.querySelector('.chain-total');
    tot.textContent = fmtSigned(c.finalPnl);
    tot.className = 'chain-total final ' + (c.finalPnl >= 0 ? 'up' : 'down');
    if(chainHasMods(c) && !row.querySelector('.chain-stamp'))
      row.insertAdjacentHTML('beforeend', `<span class="chain-stamp ${c.finalPnl >= 0 ? '' : 'down'}">${c.finalPnl >= 0 ? '떡상!' : '물림'}</span>`);
  });
  list.querySelectorAll('.pending').forEach(e => e.classList.remove('pending'));
}
function enterChainHold(skipped){
  if(!chainPlay) return;
  const cp = chainPlay;
  chainPlay = null;
  cp.timers.forEach(clearTimeout);
  Music.unduck('chain');
  renderChainFinal(cp.rows);
  const hint = $('overlayBox').querySelector('.chain-skip');
  if(hint) hint.remove();
  $('overlayBox').insertAdjacentHTML('beforeend', '<button class="ov-btn chain-next" data-act="chainNext">▶ 다음</button>');
  chainHold = { run: cp.run, onDone: cp.onDone, skipped: !!skipped, readyAt: performance.now() + CHAIN_NEXT_GUARD_MS };
}
function chainNext(){   // '▶ 다음' · 엔터
  if(!chainHold || performance.now() < chainHold.readyAt) return;
  const h = chainHold;
  chainHold = null;
  if(h.run === run) h.onDone(h.skipped);   // 그 사이 새 판을 시작했으면 옛 결산 화면은 띄우지 않는다
}
function cancelSettlementChain(){   // 결과 화면 없이 재생·대기만 멈춘다 (새 판 시작)
  chainHold = null;
  if(!chainPlay) return;
  chainPlay.timers.forEach(clearTimeout);
  chainPlay = null;
  Music.unduck('chain');
}
function skipSettlementChain(){
  if(!chainPlay) return;
  chainSkippedAt = performance.now();
  const win = chainPlay.sum >= 0;
  Sound.stopAll();                              // 남은 소리는 즉시 끊고
  Sound.play(win ? 'stampWin' : 'stampLoss');   // 최종 도장 소리 1번만
  enterChainHold(true);                         // 최종 결과로 점프해서 멈춘다 (다음 화면은 '▶ 다음')
}

