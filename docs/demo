  $('czHead').innerHTML = isIdx ? `IDX ${Math.round(marketPrice).toLocaleString()}`
    : `${STOCK_BY_ID[zoomTarget].name} ${fmtPrice(a.price)} <span class="${chg >= 0 ? 'pnl-up' : 'pnl-down'}">${showYday() ? '<small class="yd">어제</small> ' : ''}${fmtPct(chg)}</span> · ${signalHtml(STOCK_BY_ID[zoomTarget])}`;
  const cv = $('czCanvas'), ctx = cv.getContext('2d');
  if(!cv.clientWidth) return;
  const dpr = window.devicePixelRatio || 1, k = Math.max(1, Math.round(uiScale * dpr * 1.5));
