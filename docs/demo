  0%{opacity:0;transform:translateY(calc(4 * var(--u))) scale(.7);}
  15%{opacity:1;transform:translateY(0) scale(1);}
  80%{opacity:1;transform:translateY(calc(-24 * var(--u))) scale(1);}
  100%{opacity:0;transform:translateY(calc(-32 * var(--u))) scale(1);}
}

