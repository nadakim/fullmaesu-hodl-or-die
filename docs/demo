<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>풀매수 기원단: HODL or Die — PIXEL EDITION</title>
<style>
/* ── 폰트 (전부 로컬 파일: docs/assets/fonts/, 라이선스 OFL 1.1 — 같은 폴더의 *-OFL.txt) ──
   영문·숫자 = Press Start 2P(제목·라벨) / VT323(본문·숫자), 한글은 Galmuri로 떨어진다.
   글자 크기별 한글 폰트: 아주 작은 라벨 Galmuri7 · 작은 글씨 Galmuri9 · 본문 Galmuri11 · 제목 Galmuri14 (아래 크기 표) */
@font-face{font-family:'Press Start 2P';src:url('assets/fonts/PressStart2P-Regular.ttf') format('truetype');font-display:swap;}
@font-face{font-family:'VT323';src:url('assets/fonts/VT323-Regular.ttf') format('truetype');font-display:swap;}
/* 한글 = Galmuri. 픽셀 폰트라 원래 픽셀 크기(Galmuri7 8px · 9 10px · 11 12px · 14 15px)나 그 2배에서만 획이 빠지지 않는다.
   그래서 CSS 글자 크기마다 size-adjust로 한글만 그 크기에 맞춘 얼굴을 따로 둔다 (Galmuri-<CSS 크기>px). 영문·숫자는 Press Start 2P / VT323 그대로 */
@font-face{font-family:'Galmuri-6px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:133.3333%;font-display:swap;}  /* 6px → Galmuri7 8px */
@font-face{font-family:'Galmuri-6_5px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:123.0769%;font-display:swap;}  /* 6.5px → Galmuri7 8px */
@font-face{font-family:'Galmuri-7px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:114.2857%;font-display:swap;}  /* 7px → Galmuri7 8px */
@font-face{font-family:'Galmuri-7_5px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:106.6667%;font-display:swap;}  /* 7.5px → Galmuri7 8px */
@font-face{font-family:'Galmuri-8px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:100.0000%;font-display:swap;}  /* 8px → Galmuri7 8px */
@font-face{font-family:'Galmuri-8_5px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:117.6471%;font-display:swap;}  /* 8.5px → Galmuri9 10px */
@font-face{font-family:'Galmuri-9px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:111.1111%;font-display:swap;}  /* 9px → Galmuri9 10px */
@font-face{font-family:'Galmuri-10px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:100.0000%;font-display:swap;}  /* 10px → Galmuri9 10px */
@font-face{font-family:'Galmuri-11px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:109.0909%;font-display:swap;}  /* 11px → Galmuri11 12px */
@font-face{font-family:'Galmuri-12px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:100.0000%;font-display:swap;}  /* 12px → Galmuri11 12px */
@font-face{font-family:'Galmuri-13px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:92.3077%;font-display:swap;}  /* 13px → Galmuri11 12px */
@font-face{font-family:'Galmuri-14px';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:107.1429%;font-display:swap;}  /* 14px → Galmuri14 15px */
@font-face{font-family:'Galmuri-16px';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:93.7500%;font-display:swap;}  /* 16px → Galmuri14 15px */
@font-face{font-family:'Galmuri-17px';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:88.2353%;font-display:swap;}  /* 17px → Galmuri14 15px */
@font-face{font-family:'Galmuri-18px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:111.1111%;font-display:swap;}  /* 18px → Galmuri9 20px */
@font-face{font-family:'Galmuri-19px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:105.2632%;font-display:swap;}  /* 19px → Galmuri9 20px */
@font-face{font-family:'Galmuri-20px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:100.0000%;font-display:swap;}  /* 20px → Galmuri9 20px */
@font-face{font-family:'Galmuri-30px';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:100.0000%;font-display:swap;}  /* 30px → Galmuri14 15px의 2배 */
@font-face{font-family:'Galmuri-24px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:100.0000%;font-display:swap;}  /* 24px → Galmuri11 12px의 2배 */
@font-face{font-family:'Galmuri-22px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:109.0909%;font-display:swap;}  /* 22px → Galmuri11 24px */
@font-face{font-family:'Galmuri-5_5px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:145.4545%;font-display:swap;}  /* 5.5px → Galmuri7 8px */
/* VT323 옆의 한글: VT323 글자가 작게 그려지므로(글자 크기의 약 60%) 한글도 글자 크기의 약 75% 근처 Galmuri 원래 크기로 */
@font-face{font-family:'GalmuriV-14px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:71.4286%;font-display:swap;}  /* VT323 14px → Galmuri9 10px */
@font-face{font-family:'GalmuriV-15px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:80.0000%;font-display:swap;}  /* VT323 15px → Galmuri11 12px */
@font-face{font-family:'GalmuriV-16px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:75.0000%;font-display:swap;}  /* VT323 16px → Galmuri11 12px */
@font-face{font-family:'GalmuriV-17px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:70.5882%;font-display:swap;}  /* VT323 17px → Galmuri11 12px */
@font-face{font-family:'GalmuriV-18px';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:66.6667%;font-display:swap;}  /* VT323 18px → Galmuri11 12px */
@font-face{font-family:'GalmuriV-19px';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:78.9474%;font-display:swap;}  /* VT323 19px → Galmuri14 15px */
@font-face{font-family:'GalmuriV-20px';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:75.0000%;font-display:swap;}  /* VT323 20px → Galmuri14 15px */
@font-face{font-family:'GalmuriV-22px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:72.7273%;font-display:swap;}  /* VT323 22px → Galmuri7 16px */
@font-face{font-family:'GalmuriV-24px';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:66.6667%;font-display:swap;}  /* VT323 24px → Galmuri7 16px */
@font-face{font-family:'GalmuriV-26px';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:76.9231%;font-display:swap;}  /* VT323 26px → Galmuri9 20px */
@font-face{font-family:'Galmuri-desc';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:85.7143%;font-display:swap;}  /* 카드 설명 14px → Galmuri11 12px (좁은 카드에 줄 수를 맞추려고 한 단계 작게) */
button,input,select,textarea{font-family:inherit;}

/* ── PIXEL DESIGN SYSTEM ─────────────────────────────────── */
:root{
  --bg:#02040a;
  --panel:#080e1c;
  --panel2:#0c1428;
  --green:#00ff41;
  --green2:#00c832;
  --green-dim:#003a14;
  --red:#ff1a3c;
  --red2:#cc0028;
  --red-dim:#3a000e;
  --gold:#ffd700;
  --gold2:#e6a800;
  --purple:#9f5fff;
  --cyan:#00e5ff;
  --text:#d4deff;
  --muted:#4a5580;
  --line:#1a2240;
  --line2:#0f172a;
  --blue:#3d7bff;
}

.px-border{
  box-shadow:
    0 0 0 2px var(--line),
    inset 0 0 0 1px rgba(255,255,255,.04);
  image-rendering:pixelated;
}
.px-border-gold{
  box-shadow:
    0 0 0 2px var(--gold2),
    0 0 0 4px #000,
    inset 0 0 0 1px rgba(255,215,0,.12);
}
.px-border-green{
  box-shadow:
    0 0 0 2px var(--green2),
    0 0 0 4px #000,
    inset 0 0 0 1px rgba(0,255,65,.08);
}
.px-border-red{
  box-shadow:
    0 0 0 2px var(--red2),
    0 0 0 4px #000;
}

*{box-sizing:border-box; image-rendering:pixelated;}
html,body{
  margin:0;padding:0;
  background:var(--bg);
  color:var(--text);
  font-family:'VT323','GalmuriV-16px',monospace;
  overflow-x:hidden;
}

/* ── CRT LAYER ───────────────────────────────────────────── */
body::before{
  content:'';
  position:fixed;inset:0;z-index:9999;
  pointer-events:none;
  background:repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0,0,0,.08) 2px,
    rgba(0,0,0,.08) 4px
  );
}
body::after{
  content:'';
  position:fixed;inset:0;z-index:9998;
  pointer-events:none;
  background:radial-gradient(ellipse at center,transparent 60%,rgba(0,0,0,.55) 100%);
}

/* ── PIXEL BG CANVAS ─────────────────────────────────────── */
#candleBg{
  position:fixed;inset:0;z-index:0;
  pointer-events:none;
  image-rendering:pixelated;
}

/* ── AMBIENT AMBIENT FLOATING BG CHARTS CONTAINER ────────── */
#bgChartContainer {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.ambient-chart-card {
  position: absolute;
  background: rgba(8, 14, 28, 0.78);
  border: 1px solid rgba(0, 229, 255, 0.3);
  box-shadow: 0 0 10px rgba(0,0,0,0.85);
  padding: 5px;
  font-family:'Press Start 2P','Galmuri-6px',monospace;
  font-size: 6px;
  color: var(--text);
  opacity: 0;
  transition: opacity 0.8s ease-in-out;
  image-rendering: pixelated;
  pointer-events: none;
  border-radius: 0;
  will-change: transform, opacity;
}

.ambient-chart-card.up { border-color: rgba(0, 255, 65, 0.4); }
.ambient-chart-card.down { border-color: rgba(255, 26, 60, 0.4); }

.ambient-hdr {
  display: flex;
  justify-content: space-between;
  margin-bottom: 3px;
  font-size: 6px;font-family:'Press Start 2P','Galmuri-6px',monospace;
  white-space: nowrap;
}
.ambient-hdr .sym { color: var(--gold); }
.ambient-hdr .chg-up { color: var(--green); }
.ambient-hdr .chg-down { color: var(--red); }

.ambient-canvas {
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* ── CABINET (MAIN UI CONTAINER) ────────────────────────── */
.cabinet{
  position:relative;
  max-width:520px;margin:0 auto;min-height:100vh;
  background:linear-gradient(180deg,#080e1c,#02040a 60%);
  border-left:3px solid #1a2240;
  border-right:3px solid #1a2240;
  box-shadow:0 0 80px rgba(0,0,0,.9) inset,0 0 2px var(--cyan) inset;
  overflow:hidden;z-index:1;
}

/* ── TAB NAV ─────────────────────────────────────────────── */
.tabnav{
  position:sticky;top:0;z-index:50;
  display:flex;
  background:#000;
  border-bottom:3px solid var(--line);
}
.tabnav button{
  flex:1;padding:10px 4px;
  background:none;border:none;cursor:pointer;
  color:var(--muted);
  font-family:'Press Start 2P','Galmuri-7px',monospace;
  font-size:7px;
  border-bottom:3px solid transparent;
  transition:none;
  letter-spacing:.02em;
}
.tabnav button.active{
  color:var(--gold);
  border-bottom-color:var(--gold);
  background:rgba(255,215,0,.05);
  text-shadow:0 0 6px rgba(255,215,0,.8);
}
.tabnav button:hover{color:var(--cyan);}

.screen{display:none;position:relative;z-index:1;min-height:calc(100vh - 40px);}
.screen.active{display:block;}

/* ═══════════════════════════════════════════════════════════
   01 TITLE
═══════════════════════════════════════════════════════════ */
#screen-title{padding:28px 18px 24px;text-align:center;}

.eyebrow{
  font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;
  color:var(--red);
  letter-spacing:.06em;
  text-shadow:2px 2px 0 #8b0000, 0 0 10px var(--red);
  animation:blink 1.4s step-end infinite;
}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}

.badge-wrap{position:relative;height:72px;margin:18px 0 0;}   /* 회전한 부적 모서리가 위 문구를 가리지 않도록 */
.jibu-badge{
  position:absolute;top:0;right:12%;
  width:82px;height:82px;
  background:var(--red-dim);
  border:0 solid transparent;
  box-shadow:
    0 0 0 3px var(--red),
    0 0 0 6px #000,
    0 0 0 8px var(--gold2),
    4px 4px 0 #000;
  border-radius:0;
  transform:rotate(12deg);
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  font-family:'Press Start 2P','Galmuri-10px',monospace;color:var(--gold);font-size:10px;line-height:1.2;
  animation:badgeFloat 2.4s steps(4) infinite;
  cursor:default;
}
.jibu-badge span{font-size:7px;font-family:'Press Start 2P','Galmuri-7px',monospace;color:var(--text);margin-top:4px;}
@keyframes badgeFloat{
  0%{transform:rotate(12deg) translateY(0);}
  50%{transform:rotate(8deg) translateY(-5px);}
  100%{transform:rotate(12deg) translateY(0);}
}

.title-main{
  font-family:'Press Start 2P','Galmuri-18px',monospace;
  font-size:18px;line-height:1.6;
  margin:18px 0 4px;
  color:var(--green);
  text-shadow:
    3px 3px 0 #003a14,
    -1px -1px 0 #000,
    0 0 20px rgba(0,255,65,.5);
  letter-spacing:.03em;
}
.title-hodl{
  font-family:'Press Start 2P','Galmuri-14px',monospace;
  font-size:14px;
  color:var(--gold);
  text-shadow:
    2px 2px 0 #5c3d00,
    0 0 14px rgba(255,215,0,.6);
  margin-bottom:6px;
  letter-spacing:.05em;
}
.title-tagline{
  font-family:'VT323','GalmuriV-20px',monospace;font-size:20px;
  color:var(--muted);margin-bottom:22px;
}
.title-tagline b{color:var(--cyan);}

.menu{display:flex;flex-direction:column;gap:8px;padding:0 4px;}
.menu button{
  position:relative;padding:14px 16px;text-align:left;
  background:var(--panel);
  border:0 solid transparent;
  box-shadow:
    0 0 0 2px var(--green2),
    4px 4px 0 #000;
  color:var(--text);
  font-family:'Press Start 2P','Galmuri-10px',monospace;font-size:10px;
  cursor:pointer;
  border-radius:0;
  transition:none;
}
.menu button:hover{
  background:var(--green-dim);
  transform:translate(-2px,-2px);
  box-shadow:0 0 0 2px var(--green),6px 6px 0 #000;
  color:var(--green);
}
.menu button:active{
  transform:translate(2px,2px);
  box-shadow:0 0 0 2px var(--green2),2px 2px 0 #000;
}
.menu button small{
  display:block;font-family:'VT323','GalmuriV-15px',monospace;font-size:15px;
  color:var(--muted);margin-top:5px;
}

.ticker-wrap{
  margin-top:24px;
  border-top:3px solid var(--green-dim);
  border-bottom:3px solid var(--green-dim);
  padding:6px 0;overflow:hidden;white-space:nowrap;
  background:#000;
}
.ticker{
  display:inline-block;
  font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;
  color:var(--green);
  text-shadow:0 0 4px rgba(0,255,65,.6);
  animation:scrollLeft 22s linear infinite;
}
@keyframes scrollLeft{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* ═══════════════════════════════════════════════════════════
   02 GAMEPLAY
═══════════════════════════════════════════════════════════ */
#screen-play{padding:14px 14px 28px;}

.hdr{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:8px;
}
.hdr h2{
  font-family:'Press Start 2P','Galmuri-9px',monospace;font-size:9px;margin:0;
  color:var(--gold);
  text-shadow:1px 1px 0 #5c3d00;
}
.state-tag{
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;
  color:var(--green);
  background:#000;
  border:0;
  box-shadow:0 0 0 2px var(--green2),2px 2px 0 #000;
  padding:4px 7px;
}

.news-banner{
  background:#000;
  border:0;
  box-shadow:0 0 0 2px var(--red2),2px 2px 0 #000;
  color:var(--gold);
  font-family:'Press Start 2P','Galmuri-7_5px',monospace;font-size:7.5px;
  padding:8px 10px;margin-bottom:10px;
  display:flex;justify-content:space-between;align-items:center;
  line-height:1.8;
}
.news-title{color:var(--red);text-shadow:0 0 6px var(--red);}

.balance-main{
  background:var(--panel);
  box-shadow:0 0 0 2px var(--gold2),0 0 0 4px #000,4px 4px 0 #000;
  padding:10px;text-align:center;margin-bottom:10px;
}
.balance-main .label{
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);
  letter-spacing:.05em;
}
.balance-main .total{
  font-family:'Press Start 2P','Galmuri-19px',monospace;font-size:19px;
  color:var(--green);margin-top:6px;
  text-shadow:2px 2px 0 #003a14, 0 0 12px rgba(0,255,65,.5);
}

.assets-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px;
}
.asset-card{
  background:var(--panel);
  box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;
  padding:8px;text-align:center;
}
.asset-card .label{
  font-family:'Press Start 2P','Galmuri-6_5px',monospace;font-size:6.5px;color:var(--muted);
  margin-bottom:6px;letter-spacing:.03em;
}
.asset-card .val{
  font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;color:var(--text);
}
.asset-card .val.highlight{color:var(--gold);}

/* ── PIXEL CANDLESTICK CHART ─────────────────────────────── */
.chart-box{
  position:relative;height:164px;
  background:#000;
  box-shadow:0 0 0 2px var(--cyan),0 0 0 4px #000,4px 4px 0 #000;
  margin-bottom:12px;overflow:hidden;
}
.chart-box canvas{
  width:100%;height:100%;display:block;
  image-rendering:pixelated;
  image-rendering:crisp-edges;
}
.chart-header{
  position:absolute;top:5px;left:8px;z-index:10;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;color:var(--muted);
  text-shadow:1px 1px 0 #000;
}
.chart-header span{color:var(--cyan);text-shadow:0 0 6px var(--cyan);}
.chart-header .ch-name{color:var(--gold);text-shadow:1px 1px 0 #000;}
.chart-header .ch-chg.pnl-up{color:var(--green);text-shadow:none;}
.chart-header .ch-chg.pnl-down{color:var(--red);text-shadow:none;}
.chart-back{
  position:absolute;top:5px;right:8px;z-index:10;border:none;cursor:pointer;
  background:#000;color:var(--cyan);font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;padding:4px 6px;
  box-shadow:0 0 0 2px var(--cyan),2px 2px 0 #000;
}
.chart-back:hover{background:var(--panel2);}
.chart-back[hidden]{display:none;}
.quote-row{cursor:pointer;}
.quote-row:hover{box-shadow:0 0 0 2px var(--muted);}
.quote-row.charted{background:var(--panel2);box-shadow:0 0 0 2px var(--cyan),3px 3px 0 #000;}

.section-title{
  font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;
  color:var(--gold);
  margin:12px 0 6px;
  display:flex;justify-content:space-between;align-items:baseline;
  text-shadow:1px 1px 0 #5c3d00;
}
.section-title span:last-child{
  font-size:7px;font-family:'Press Start 2P','Galmuri-7px',monospace;color:var(--muted);
}

.hand{display:flex;gap:8px;overflow-x:auto;padding-bottom:10px;}
.hand::-webkit-scrollbar{height:4px;background:#000;}
.hand::-webkit-scrollbar-thumb{background:var(--gold2);}

.card{
  --cc:var(--gold2);                 /* 카드 종류 색 (안쪽 테두리) */
  --rc:#000;                         /* 카드 등급 색 (바깥 테두리) */
  position:relative;
  width:108px;min-width:108px;height:158px;
  background:var(--panel2);
  box-shadow:0 0 0 2px var(--cc),0 0 0 4px var(--rc),3px 3px 0 #000;
  display:flex;flex-direction:column;gap:5px;
  padding:7px 7px 6px;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;
  color:var(--text);cursor:pointer;flex-shrink:0;
  transition:none;
}
.card:hover{
  background:var(--panel);
  box-shadow:0 0 0 2px var(--cc),0 0 0 4px var(--rc),5px 5px 0 #000;
  transform:translate(-2px,-2px);
}
.card:active{transform:translate(2px,2px);box-shadow:0 0 0 2px var(--cc),1px 1px 0 #000;}
.card::before,.card::after{
  content:'';position:absolute;width:6px;height:6px;
  border-color:var(--cc);border-style:solid;
}
.card::before{top:2px;left:2px;border-width:2px 0 0 2px;}
.card::after{bottom:2px;right:2px;border-width:0 2px 2px 0;}

.card.t-buy{--cc:var(--green2);}
.card.t-sell{--cc:var(--red2);}
.card.t-hold{--cc:var(--cyan);}
.card.t-action{--cc:var(--purple);}
.card.t-defense{--cc:var(--blue);}
.card.t-status{--cc:var(--muted);cursor:not-allowed;}

.c-top{display:flex;justify-content:space-between;align-items:center;}
.c-ap{background:var(--cc);color:#000;padding:2px 4px;font-size:8px;font-family:'Press Start 2P','Galmuri-8px',monospace;}
.c-type{color:var(--cc);font-size:6px;font-family:'Press Start 2P','Galmuri-6px',monospace;}
.card .sym{font-size:9px;font-family:'Press Start 2P','Galmuri-9px',monospace;line-height:1.5;color:var(--text);text-align:center;text-shadow:1px 1px 0 #000;}
.c-cost{font-size:8px;font-family:'Press Start 2P','Galmuri-8px',monospace;color:var(--gold);text-align:center;}
.c-price{font-size:6.5px;font-family:'Press Start 2P','Galmuri-6_5px',monospace;color:var(--cyan);text-align:center;}
.c-desc{flex:1;overflow:hidden;font-family:'VT323','Galmuri-desc',monospace;font-size:14px;line-height:1.1;padding-top:1px;color:var(--text);opacity:.8;text-align:center;}
.c-foot{display:flex;justify-content:space-between;gap:4px;font-size:5.5px;font-family:'Press Start 2P','Galmuri-5_5px',monospace;color:var(--muted);}
.card.r-common{--rc:var(--muted);}
.card.r-uncommon{--rc:var(--green2);}
.card.r-rare{--rc:var(--blue);}
.card.r-legendary{--rc:var(--purple);}
.card.r-mythic{--rc:var(--gold);}
.card.r-mythic .sym{color:var(--gold);}
.card.t-status{--rc:#000;}
.c-rar.common{color:var(--muted);}
.c-rar.uncommon{color:var(--green);}
.c-rar.rare{color:var(--blue);}
.c-rar.legendary{color:var(--purple);}
.c-rar.mythic{color:var(--gold);text-shadow:0 0 4px var(--gold2);}
.coll-filter{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 4px;}
.coll-filter button{
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;padding:6px 8px;cursor:pointer;
  background:#000;color:var(--muted);border:0;box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;
}
.coll-filter button.on{color:var(--text);box-shadow:0 0 0 2px var(--gold),2px 2px 0 #000;}

.card.disabled{opacity:.35;cursor:not-allowed;}
.card.disabled:hover{background:var(--panel2);transform:none;box-shadow:0 0 0 2px var(--cc),0 0 0 4px var(--rc),3px 3px 0 #000;}
.card.selected{
  background:var(--panel);transform:translate(-2px,-5px);
  box-shadow:0 0 0 2px var(--gold),0 0 0 4px #000,5px 7px 0 #000;
}

.positions-wrap{
  display:flex;flex-direction:column;gap:6px;
  max-height:130px;overflow-y:auto;margin-bottom:10px;
}
.positions-wrap::-webkit-scrollbar{width:4px;background:#000;}
.positions-wrap::-webkit-scrollbar-thumb{background:var(--muted);}

.pos-item{
  background:var(--panel);
  box-shadow:0 0 0 2px var(--line),2px 2px 0 #000;
  padding:7px 9px;
  display:flex;justify-content:space-between;align-items:center;
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;
}
.pos-info .name{font-size:9px;font-family:'Press Start 2P','Galmuri-9px',monospace;color:var(--text);}
.pos-info .detail{font-size:6.5px;font-family:'Press Start 2P','Galmuri-6_5px',monospace;color:var(--muted);margin-top:3px;}
.pos-pnl{text-align:right;}
.pos-pnl .val{font-weight:bold;font-size:8px;font-family:'Press Start 2P','Galmuri-8px',monospace;}
.pnl-up{color:var(--green);text-shadow:1px 1px 0 #003a14;}
.pnl-down{color:var(--red);text-shadow:1px 1px 0 #5c0010;}

.sell-btn{
  background:var(--red-dim);
  box-shadow:0 0 0 2px var(--red2),2px 2px 0 #000;
  color:var(--text);
  font-family:'Press Start 2P','Galmuri-7px',monospace;font-size:7px;
  padding:4px 7px;cursor:pointer;
  border:none;margin-left:8px;
  border-radius:0;
}
.sell-btn:hover{background:var(--red2);transform:translate(-1px,-1px);}
.sell-btn:active{transform:translate(1px,1px);box-shadow:0 0 0 2px var(--red2),1px 1px 0 #000;}

.sell-all-btn{
  width:100%;padding:14px;
  font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;
  background:var(--red-dim);
  box-shadow:0 0 0 2px var(--red),0 0 0 4px #000,5px 5px 0 #000;
  color:var(--gold);border:none;
  cursor:pointer;letter-spacing:.05em;
  text-shadow:2px 2px 0 #5c0010;
  border-radius:0;
  transition:none;
}
.sell-all-btn:hover{
  background:var(--red2);
  transform:translate(-2px,-2px);
  box-shadow:0 0 0 2px var(--red),0 0 0 4px #000,7px 7px 0 #000;
}
.sell-all-btn:active{
  transform:translate(3px,3px);
  box-shadow:0 0 0 2px var(--red2),2px 2px 0 #000;
}

.popnum{
  position:absolute;
  font-family:'Press Start 2P','Galmuri-11px',monospace;font-size:11px;
  pointer-events:none;z-index:10;
  animation:pixelPop .9s steps(8) forwards;
  image-rendering:pixelated;
}
@keyframes pixelPop{
  0%{opacity:0;transform:translateY(4px) scale(.7);}
  15%{opacity:1;transform:translateY(0) scale(1);}
  80%{opacity:1;transform:translateY(-24px) scale(1);}
  100%{opacity:0;transform:translateY(-32px) scale(1);}
}

.confetti-layer{position:fixed;inset:0;pointer-events:none;z-index:80;}
.bill{
  position:absolute;top:-30px;
  font-family:'Press Start 2P','Galmuri-12px',monospace;font-size:12px;
  color:var(--gold);text-shadow:1px 1px 0 #5c3d00;
  animation:pixelFall 1.6s steps(16) forwards;
}
@keyframes pixelFall{to{transform:translateY(560px) rotate(180deg);opacity:0;}}

/* ═══════════════════════════════════════════════════════════
   03 SHOP
═══════════════════════════════════════════════════════════ */
#screen-shop{
  padding:18px 14px 28px;
}
.shop-title{
  font-family:'Press Start 2P','Galmuri-14px',monospace;font-size:14px;
  color:var(--purple);
  text-shadow:2px 2px 0 #2d006b,0 0 12px rgba(159,95,255,.6);
  margin-bottom:4px;
}
.shop-sub{
  font-family:'VT323','GalmuriV-18px',monospace;font-size:18px;
  color:var(--muted);margin-bottom:16px;
}
.section-label{
  font-family:'Press Start 2P','Galmuri-8px',monospace;font-size:8px;
  color:var(--gold);
  box-shadow:inset 3px 0 0 0 var(--gold);
  padding-left:10px;margin:18px 0 10px;
