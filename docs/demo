function drawSpark(cv, hist, up){
  const dpr = window.devicePixelRatio || 1, k = Math.max(1, Math.round(uiScale * dpr));   // 점 크기 = 배율 × 화면 밀도
  const cw = Math.round((cv.clientWidth || 64) * dpr), ch = Math.round((cv.clientHeight || 18) * dpr);
  if(cv.width !== cw || cv.height !== ch){ cv.width = cw; cv.height = ch; }
  const ctx = cv.getContext('2d');
  const w = cv.width, h = cv.height, d = 2 * k;
  ctx.clearRect(0, 0, w, h);
  const mx = Math.max(...hist), mn = Math.min(...hist), rg = (mx - mn) || 1;
  ctx.fillStyle = up ? '#00ff41' : '#ff1a3c';
  hist.forEach((v, i) => {
    const x = Math.round(i * (w - d) / (hist.length - 1));
    const y = Math.round(h - d - k - (v - mn) / rg * (h - d - 2 * k));
    ctx.fillRect(x, y, d, d);
  });
}

/* 시그널: 엔진 run.signals(오늘, 장전에 고정)·run.signalResults(어제 채점). 적중률은 엔진 값(sg.acc)을 그대로 */
const SIGNAL_LABEL = { UP: '📈 매수세', FLAT: '➖ 보합', DOWN: '📉 매도세', HOT: '🔥 과열' };
const SIGNAL_ICON = { UP: '📈', FLAT: '➖', DOWN: '📉', HOT: '🔥' };
const perDay = drift => Math.exp(drift * TICKS_PER_DAY) - 1;   // 틱당 드리프트 → 하루 등락률
function signalHtml(s){   // 시세판: 아이콘 + 적중률만 (라벨·어제 채점은 툴팁 signalHelp)
  if(!hasRegime(s)) return '지수 연동';
  const sg = run.signals[s.id];
  if(!sg) return '';
  return `<span class="s-${sg.shown}">${SIGNAL_ICON[sg.shown]}</span> ` + (sg.revealed ? '<span class="s-rev">확정 100%</span>' : `적중 ${Math.round(sg.acc * 100)}%`);
}
function signalHelp(s){
  if(!hasRegime(s)) return '인버스는 추세가 따로 없고 지수를 반대로 따라간다';
  const y = run.signalResults[s.id], sg = run.signals[s.id];
  return (sg ? `오늘 시그널: ${SIGNAL_LABEL[sg.shown]} · ${sg.revealed ? '확정 100%' : `적중률 ${Math.round(sg.acc * 100)}%`}\n` : '') + `시그널은 ${Math.round(SIGNAL_ACCURACY * 100)}% 확률로 실제 추세, 아니면 나머지 셋 중 하나.\n` +
    `추세별 하루 추가 등락: 매수세 ${fmtPct(perDay(REGIME_DRIFT.UP))} · 보합 0% · 매도세 ${fmtPct(perDay(REGIME_DRIFT.DOWN))} · 과열 ${fmtPct(perDay(REGIME_DRIFT.HOT))} (갭하락 확률 ×${GAP_HOT_MULT})` +
    (y ? `\n어제: ${SIGNAL_LABEL[y.shown]} 표시 → 실제 ${SIGNAL_LABEL[y.actual]} ${y.hit ? '✓' : '✗'}` : '');
}

/* 뉴스: 엔진 run.newsToday(개장 때 판정)·run.newsTomorrow(장 마감에 예고) */
function newsEffectText(n){
  const ids = newsTargetIds(n);
  const who = n.target === 'market' ? '전 종목' : ids.length === 1 && n.target.indexOf('stock:') === 0 ? STOCK_BY_ID[ids[0]].name : n.target.slice(7) + ' 섹터';
  const e = n.effect, parts = [];
  if(e.volMult !== 1) parts.push(`변동성 ×${e.volMult}`);
  if(e.drift) parts.push(`추세 ${fmtPct(perDay(e.drift))}/일`);
  if(e.gapMult !== 1) parts.push(`갭 확률 ×${e.gapMult}`);
  return `${who} ${parts.join(' · ')}`;
}
const newsRelText = n => n.reliability === 'confirmed' ? '확정' : `루머 ${Math.round(newsChance(n) * 100)}%`;
function newsLine(){
  if(!run) return '';
  if(run.phase === 'premarket' || !run.newsResolved){
    const n = NEWS_BY_ID[run.newsToday];
    return n ? `📰 오늘 개장: ${n.text} — ${newsEffectText(n)} · ${newsRelText(n)}` : '';
  }
  const n = NEWS_BY_ID[run.newsToday];
  if(!n) return '';
  return run.newsActive ? `📰 사실로 확인: ${n.text} — ${newsEffectText(n)}` : `📰 루머로 판명: ${n.text} — 오늘 효과 없음`;
}
const newsTomorrowLine = () => { const n = run && NEWS_BY_ID[run.newsTomorrow]; return n ? `📰 내일: ${n.text} — ${newsEffectText(n)} · ${newsRelText(n)}` : ''; };

function renderQuotes(){
  const targets = selectedTargets('asset');
  STOCKS.forEach(s => {
    const row = document.querySelector(`[data-q="${s.id}"]`);
    if(!row) return;
    const a = assets[s.id];
    const chg = a.price / a.dayOpen - 1;
    row.querySelector('.q-price').textContent = fmtPrice(a.price);
    const ch = row.querySelector('.q-chg');
    ch.textContent = fmtPct(chg);
    ch.className = 'q-chg ' + (chg >= 0 ? 'pnl-up' : 'pnl-down');
    drawSpark(row.querySelector('canvas'), a.history, chg >= 0);
    // 찌라시: 장전에는 결과를 숨긴다
    const pm = run.pumps[s.id], tag = row.querySelector('.q-tag');
    const gap = assets[s.id].candles.slice(-GAP_TAG_CANDLES).reduce((g, c) => c.gap || g, 0);   // 최근 갭
    tag.textContent = gap ? (gap > 0 ? 'GAP▲' : 'GAP▼') : !pm ? '' : run.phase !== 'market' ? '찌라시?' : pm > 0 ? '작전▲' : '설거지▼';
    tag.className = 'q-tag ' + (gap ? 'gap' : !pm ? '' : run.phase !== 'market' ? 'hidden' : pm > 0 ? 'up' : 'down');
    row.classList.toggle('targetable', targets.indexOf(s.id) >= 0);
    row.classList.toggle('charted', chartTarget === s.id);
    const sigEl = row.querySelector('.q-sig'), sigHtml = signalHtml(s);
    if(sigEl.innerHTML !== sigHtml) sigEl.innerHTML = sigHtml;
    sigEl.title = signalHelp(s);
  });
}

/* ── 행동력 · 더미 · 대기 효과 · 장 시작 ── */
function renderTurn(){
  const pre = run.phase === 'premarket';
  let pips = '';
  for(let i = 0; i < Math.max(run.ap, maxAp()); i++) pips += `<span class="ap-pip ${i < run.ap ? 'on' : ''}"></span>`;
  $('apPips').innerHTML = pips;
  $('apText').textContent = `${run.ap}/${maxAp()}`;
  $('pileText').textContent = `덱 ${run.drawPile.length} · 버림 ${run.discard.length} · 소멸 ${run.exhausted.length}`;

  const chips = [];
  const pd = run.pending, parts = [];
  if(pd.principalMult > 1) parts.push(`원금 ${pd.principalMult}배`);
  if(pd.lev > 1) parts.push(pd.lev === CREDIT_LEV ? `신용 ${pd.lev}x` : `영끌 ${pd.lev}x`);
  if(pd.dir < 0) parts.push('숏');
  if(parts.length) chips.push(`<span class="chip ${pd.dir < 0 ? 'short' : 'buy'}">다음 매수: ${parts.join(' · ')}</span>`);
  if(run.marketCard && run.phase === 'premarket') chips.push(`<span class="chip mod">${CARD_BY_ID[run.marketCard].name} 대기 — ${marketOddsText(run.marketCard)}</span>`);
  if(run.forcedState) chips.push(`<span class="chip mod">오늘 장: ${STATE_LABEL[run.forcedState]}</span>`);
  if(run.revertTicksLeft > 0) chips.push(`<span class="chip">차익실현 매물 대기 (개장 후 ${run.revertTicksLeft}틱)</span>`);
  if(run.buyBanToday) chips.push('<span class="chip short">☎ 금감원 제재: 오늘 신규 매수 금지</span>');
  if(run.interestFree) chips.push('<span class="chip">오늘 이자 면제</span>');
  if(run.noSellToday) chips.push('<span class="chip mod">계좌 잠금: 매도 불가 · 반대매매 면제</span>');
  if(run.week.antArmy) chips.push('<span class="chip buy">개미 군단: 이번 주 종목 카드 행동력 0 · 쓰면 1장 드로우</span>');
  if(run.week.topSpotter) chips.push('<span class="chip buy">상투 감별사: 이번 주 익절·트레일링 행동력 0 · 체결 수익 +30%</span>');
  if(run.week.valueGod) chips.push('<span class="chip buy">가치투자의 신: 이번 주 장 마감마다 장기 보유 배당</span>');
  if(hasRelic('timemachine') && pre){   // 타임머신: 오늘 판정 미리 보기
    const seen = [];
    run.hand.map(i => i.id).concat(run.marketCard ? [run.marketCard] : []).forEach(id => {
      if(MARKET_CARD_ODDS[id] && seen.indexOf(id) < 0){ seen.push(id); chips.push(`<span class="chip mod">🕰️ ${CARD_BY_ID[id].name} → ${STATE_LABEL[rollMarketCard(id)]}</span>`); }
    });
    STOCKS.filter(st => run.pumps[st.id] === 1 || run.pumps[st.id] === -1).forEach(st => chips.push(`<span class="chip mod">🕰️ ${st.name} ${run.pumps[st.id] > 0 ? '급등' : '설거지'}</span>`));
  }
  if(run.lossGuardToday) chips.push('<span class="chip">손실 보전 약정: 오늘 반대매매 손실 50% 환급</span>');
  if(run.circuitToday) chips.push(`<span class="chip">서킷브레이커: 오늘 −${pct(CIRCUIT_DROP)}에서 장 마감 · 반대매매 면제${run.circuitTripped ? ' (발동)' : ''}</span>`);
  $('chipBox').innerHTML = chips.join('');
  // 내일 뉴스 예고: 배너 옆 '📰 내일' 버튼 (호버 = 제목, 누르면 알림)
  const tmr = newsTomorrowLine(), nb = $('newsNextBtn');
  nb.hidden = !tmr;
  if(nb.title !== tmr) nb.title = tmr;

  const btn = $('openBtn');
  const shop = run.phase === 'shop';
  btn.disabled = !pre && !shop;
  btn.textContent = pre ? '▶ 장 시작' : shop ? '◈ 암시장에 들렀다가 다음 주 개장'
    : run.phase === 'market' ? `장중 · 캔들 ${run.tickInDay}/${TICKS_PER_DAY}` : '결산 중';
  $('handHint').textContent = selectedIdx >= 0 ? '대상을 클릭 · 다시 누르면 취소'
    : pre ? '카드를 눌러 사용' : '장중에는 카드 사용 불가';
}

/* ── 손패 ── */
function cardUsable(idx){
  if(run.phase !== 'premarket') return false;
  const card = CARD_BY_ID[run.hand[idx].id];
  if(card.target) return validTargetIds(idx).length > 0;
  return checkPlay(idx, null) === null;
}

function renderHand(){
  const box = $('handBox');
  const usable = run.hand.map((_, i) => cardUsable(i) ? '1' : '0').join('');
  const sig = run.hand.map(c => c.uid + ':' + cardCost(CARD_BY_ID[c.id])).join() + '|' + usable + '|' + selectedIdx + '|' + run.pending.principalMult
    + '|' + run.marketCard + '|' + run.positions.map(p => p.id + ':' + Math.round(exposure(p))).join();   // 기대값이 포지션·대기 시장 카드에 따라 바뀐다
  if(sig !== handSig){
    handSig = sig;
    const cols = run.hand.length > HAND_GRID_CELLS ? HAND_GRID_WIDE_COLS : HAND_GRID_COLS;   // 10장(HAND_MAX)이면 4열
    box.classList.toggle('g4', cols === HAND_GRID_WIDE_COLS);
    const cells = cols * HAND_GRID_ROWS;
    box.innerHTML = run.hand.map((inst, i) => {
          const card = CARD_BY_ID[inst.id];
          const cls = (usable[i] === '1' ? '' : 'disabled') + (i === selectedIdx ? ' selected' : '');
          const cost = card.stock ? stockCost(STOCK_BY_ID[card.stock]) : 0;
          return handCardHtml(card, { attrs: `data-idx="${i}"`, cls, cost, ap: cardCost(card) });
        }).join('') + '<div class="g-slot"></div>'.repeat(Math.max(0, cells - run.hand.length));   // 빈 칸 = 점선 슬롯
  }
  box.querySelectorAll('[data-p]').forEach(el => { el.textContent = '@' + fmtPrice(assets[el.dataset.p].price); });
}

/* 카드 기대값 표시 (엔진 expectedValue). 대상 카드(리딩방·작전 세력)는 수익률 + 보유 종목별 금액을 툴팁으로 */
const fmtEv = v => (v >= 0.5 ? '+' : v <= -0.5 ? '−' : '±') + '₩' + Math.abs(Math.round(v)).toLocaleString() + '만';
const evCls = v => v >= 0.5 ? 'pos' : v <= -0.5 ? 'neg' : 'zero';
function cardEvView(card){
  const e = expectedValue(card, null);
  if(!e) return null;
  if(card.target === 'asset'){
    const held = STOCKS.filter(s => heldExposure(s.id) !== 0).map(s => `${s.name} ${fmtEv(expectedValue(card, s).ev)}`);
    return { text: `EV ${e.rate >= 0 ? '+' : '−'}${Math.abs(e.rate * 100).toFixed(1)}%`, cls: e.rate >= 0 ? 'pos' : 'neg',
             title: `${e.note} = 보유분의 ${fmtPct(e.rate)}` + (held.length ? '\n' + held.join('\n') : '\n(보유 종목 없음 — 대상 종목 보유분에만 적용)') };
  }
  return { text: 'EV ' + fmtEv(e.ev), cls: evCls(e.ev), title: `${e.note} (장세 확률 × 지수 기대 드리프트 → 보유 포지션, 갭·되돌림 제외)` };
}

/* ── 보유 포지션 ── */
/* 예약주문·존버·다이아·유물 태그 = 아이콘만 (설명은 호버) */
function orderIcons(p){
  const t = [];
  if(p.stopLoss)       t.push(['✂', `손절 예약 ${fmtPct(STOP_LOSS_PCT)}`, 'stop']);
  if(p.takeProfit)     t.push(['🎯', `익절 예약 ${fmtPct(TAKE_PROFIT_PCT)}`, 'take']);
  if(p.trailing)       t.push(['〰', `트레일링 스탑 ${Math.round(TRAIL_GAP * 100)}%p`, 'trail']);
  if(p.protectedToday) t.push(['🛡', '존버: 오늘 반대매매 면제', 'hodl']);
  if(p.diamond)        t.push(['💎', `다이아몬드 핸드: 이번 주 매도 불가 · 결산 보너스`, 'diamond']);
  if(gukbapApplies(p)) t.push(['🍲', `국밥 정신: 손실 −${Math.round(RELIC_GUKBAP_LOSS_CUT * 100)}%`, 'relic-on']);
  if(sealApplies(p))   t.push(['🔏', `존버의 인장: 이익 +${Math.round(RELIC_SEAL_BONUS * 100)}%`, 'relic-on']);
  return t.map(([ic, tip, c]) => `<span class="o-ic ${c}" title="${tip}">${ic}</span>`).join('');
}

function renderPositions(){
  const box = $('positionsBox');
  const sig = run.positions.map(p => [p.id, p.lev, p.dir, Math.round(p.principal), p.stopLoss, p.takeProfit, p.trailing, p.protectedToday, p.diamond, p.daysHeld].join(':')).join() + '|' + run.relics.join()
    + '|' + run.noSellToday + run.allProtectedToday;
  if(sig !== posSig){
    posSig = sig;
    box.innerHTML = run.positions.length === 0
      ? `<div class="empty-note pos-empty">── NO POSITION ──<small>장전에 종목 카드를 써서 매수하세요</small></div>`
      : run.positions.map(p => `
        <div class="pos-item" data-id="${p.id}">
          <div class="p-l1">
            <span class="name">${p.name}${p.dir < 0 ? '<span class="lev-badge short">숏</span>' : ''}${p.lev > 1 ? `<span class="lev-badge lev${p.lev}">${p.lev}x</span>` : ''}</span>
            <span class="val" data-f="pnl"></span>
            <button class="sell-btn" data-sell="${p.id}" ${canSell(p) ? '' : 'disabled'}>매도</button>
          </div>
          <div class="p-l2">
            <span class="detail" data-f="price"></span>
            <span class="detail">원금 ${Math.round(p.principal).toLocaleString()}만 · ${p.daysHeld}일째</span>
            ${orderIcons(p) ? `<span class="p-icons">${orderIcons(p)}</span>` : ''}
            ${isMarginable(p) ? '<span class="p-margin"><span class="mgauge" data-f="gauge"><i class="mg-fill"></i><i class="mg-call"></i></span></span>' : ''}
          </div>
        </div>`).join('');
  }
  const targets = selectedTargets('position');
  run.positions.forEach(p => {
    const el = box.querySelector(`[data-id="${p.id}"]`);
    if(!el) return;
    el.classList.toggle('targetable', targets.indexOf(p.id) >= 0);
    el.querySelector('[data-f=price]').textContent = `평단 ${fmtPrice(avgPrice(p))} → ${fmtPrice(assets[p.assetId].price)}`;
    const tip = `${p.name} · 원금 ₩${Math.round(p.principal).toLocaleString()}만 · 노출 ${fmtMoney(exposure(p))} · 보유 ${p.daysHeld}일`
      + (isMarginable(p) ? ` · 증거금률 ${Math.round(marginRatio(p) * 100)}% (반대매매 ${Math.round(MARGIN_CALL_RATIO * 100)}%)${isProtected(p) ? ' · 면제' : ''}` : '');
    if(el.title !== tip) el.title = tip;   // 노출액은 행 툴팁으로
    const pnl = posPnl(p);
    const pv = el.querySelector('[data-f=pnl]');
    pv.textContent = `${fmtSigned(pnl)} (${fmtPct(posReturn(p))})`;
    pv.className = 'val ' + (pnl >= 0 ? 'pnl-up' : 'pnl-down');
    const g = el.querySelector('[data-f=gauge]');   // 증거금률 미니 막대: 0~100%, 반대매매 선(MARGIN_CALL_RATIO)에 표시선. 숫자는 호버
    if(g){
      const r = marginRatio(p);
      const danger = r < MARGIN_WARN_RATIO && !isProtected(p);
      g.className = 'mgauge ' + (danger ? 'danger' : 'safe');
      g.title = `증거금률 ${Math.round(r * 100)}% / 반대매매 ${Math.round(MARGIN_CALL_RATIO * 100)}%` + (isProtected(p) ? ' · 오늘 면제' : '');
      g.firstElementChild.style.width = Math.max(0, Math.min(100, r * 100)) + '%';
      g.lastElementChild.style.left = (MARGIN_CALL_RATIO * 100) + '%';
    }
  });
}

/* 배경음악: 화면과 게임 상태를 읽기만 해서 트랙 · 적응형 무드를 넘긴다 (엔진은 모른다) */
const musicOn = () => settings.sound && settings.bgm;
let overPending = false;   // runOver가 왔지만 연쇄 연출이 끝나길 기다리는 중
function musicTrackFor(){
  if(currentTab === 'title') return 'title';
  if(currentTab === 'shop') return 'shop';
  if(currentTab === 'records' || currentTab === 'collection' || currentTab === 'settings') return 'records';
  if(!run) return 'title';
  if(run.phase === 'over') return overPending ? null : 'records';   // 게임오버 화면(스팅어) 전까지는 지금 곡 유지
  if(run.phase === 'market') return 'market';
  if(run.phase === 'premarket') return 'premarket';
  if(run.phase === 'shop') return 'shop';
  return null;   // 결산·보상 중: 지금 곡 유지
}
function updateMusic(){
  const t = musicTrackFor();
  if(t) Music.setTrack(t);
  if(run && run.phase === 'market') Music.setMood({
