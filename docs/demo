        Sound.play('settleMult', { pitch: stagePitch(d.nth) });
        comboHit('settle');
      }
      break;
    case 'waterAdded': toast(`🌊 물타기 장인: ${d.pos.name} 물 ${d.water} → 수익 마감 정산 ×${Math.pow(WATER_X_PER_STACK, d.water)}`, 'info'); break;
    case 'loanInterest': toast(`🏦 영끌 대출 주말 이자 −${formatKrw(d.amount)} (빚 ${formatKrw(d.debt)})`, 'bad'); break;
    case 'relicReplaced': toast(`${RELIC_BY_ID[d.id].icon} ${RELIC_BY_ID[d.id].name} 버림 → ${RELIC_BY_ID[d.by].icon} ${RELIC_BY_ID[d.by].name}`, 'warn'); break;
    case 'relicSold': toast(`${RELIC_BY_ID[d.id].icon} ${RELIC_BY_ID[d.id].name} 판매 +${fmtSlush(d.price)}`, 'good'); Sound.play('sellWin'); break;
    case 'relicMoved': Sound.play('uiMove'); break;
    case 'relicReset': enqueueRelicShatter(d); break;
    case 'comboChanged': juiceStreak(d); break;
      break;
  }
}

