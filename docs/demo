const PREFERS_REDUCED_MOTION = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
const DEFAULT_SETTINGS = { speed: 1, shake: !PREFERS_REDUCED_MOTION, crt: 'strong', bgFx: true, sound: true, chainFx: true,
                           sfxVol: 50, tickSound: false, hitStop: true, bgm: true, bgmVol: 40, fxSpeed: 'normal' };
function loadSettings(){
  const s = Object.assign({}, DEFAULT_SETTINGS);
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(SETTINGS_KEY)); } catch(e) {}
  if(saved && typeof saved === 'object'){
    Object.keys(SETTING_OPTIONS).forEach(k => {   // 허용된 값만 받는다 (깨진 값이면 기본값)
      if(SETTING_OPTIONS[k].some(o => o[0] === saved[k])) s[k] = saved[k];
    });
  }
  return s;
}
let settings = loadSettings();
function saveSettings(){
  try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); } catch(e) {}
}
function applySettings(){
  Sound.setEnabled(settings.sound);
  Sound.setVolume(settings.sfxVol / 100);
  Music.setEnabled(settings.sound && settings.bgm);   // 사운드를 끄면 배경음악도 꺼진다
  Music.setVolume(settings.bgmVol / 100);
  Fx.setOptions({ motion: settings.shake, hitStop: settings.hitStop });
  Fx.setSpeed(settings.fxSpeed);   // 흔들림을 끄면 글리치·히트스톱도 꺼진다
  document.body.dataset.crt = settings.crt;
  document.body.dataset.bgfx = settings.bgFx ? 'on' : 'off';
  if(settings.bgFx){
    ambientBg.init();
    if(!bgGridTimer) bgGridTimer = setInterval(drawBgGrid, 500);
  } else {
    ambientBg.stop();
    clearInterval(bgGridTimer); bgGridTimer = null;
    drawBgGrid();   // 정지된 격자 한 장만
  }
}
