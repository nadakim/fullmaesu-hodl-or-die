/* 갭 중앙 경보: 줄무늬 테이프 · 종목명 · 변동률 카운트업 · 밈 문구. t1 약(작게, 시장 안 멈춤) · t2 중 · t3 강 */
.gap-alert{position:fixed;inset:0;z-index:94;pointer-events:none;display:flex;align-items:center;justify-content:center;padding:calc(16 * var(--u));}
.ga-flash{position:absolute;inset:0;background:var(--green);opacity:0;animation:gaFlash .45s steps(3) forwards;}
.gap-alert.down .ga-flash{background:var(--red);}
@keyframes gaFlash{0%{opacity:.35;}100%{opacity:0;}}
.ga-rays{   /* 가장자리 방사형 집중선 */
  position:absolute;inset:-20%;opacity:.28;
  background:repeating-conic-gradient(from 0deg at 50% 50%,var(--green) 0deg 1.5deg,transparent 1.5deg 9deg);
  -webkit-mask:radial-gradient(circle at 50% 50%,transparent 32%,#000 60%);mask:radial-gradient(circle at 50% 50%,transparent 32%,#000 60%);
  animation:gaRays .6s steps(3) infinite;
}
.gap-alert.down .ga-rays{background:repeating-conic-gradient(from 0deg at 50% 50%,var(--red) 0deg 1.5deg,transparent 1.5deg 9deg);}
@keyframes gaRays{50%{transform:rotate(3deg) scale(1.03);}}
.gap-alert.t1 .ga-rays{display:none;}
.ga-box{
  position:relative;width:min(calc(560 * var(--u)),100%);text-align:center;background:#000;padding:0 0 calc(14 * var(--u));
  box-shadow:0 0 0 calc(4 * var(--u)) var(--green2),0 0 0 calc(8 * var(--u)) #000,calc(10 * var(--u)) calc(10 * var(--u)) 0 #000;animation:gaInUp .42s steps(7) both;
}
.gap-alert.down .ga-box{box-shadow:0 0 0 calc(4 * var(--u)) var(--red2),0 0 0 calc(8 * var(--u)) #000,calc(10 * var(--u)) calc(10 * var(--u)) 0 #000;animation-name:gaInDown;}
@keyframes gaInUp{0%{opacity:0;transform:translateY(55vh) scale(2.4);}60%{opacity:1;transform:translateY(calc(-10 * var(--u))) scale(1.08);}100%{opacity:1;transform:none;}}
@keyframes gaInDown{0%{opacity:0;transform:translateY(-55vh) scale(2.4);}60%{opacity:1;transform:translateY(calc(10 * var(--u))) scale(1.08);}100%{opacity:1;transform:none;}}
.ga-tape{
  padding:calc(8 * var(--u)) 0 calc(6 * var(--u));margin-bottom:calc(12 * var(--u));overflow:hidden;
  background:repeating-linear-gradient(-45deg,var(--gold) 0 calc(10 * var(--u)),#000 calc(10 * var(--u)) calc(20 * var(--u)));background-size:calc(28 * var(--u)) calc(28 * var(--u));animation:gaTape .5s steps(4) infinite;
}
.ga-tape span{display:inline-block;padding:calc(4 * var(--u)) calc(10 * var(--u)) calc(3 * var(--u));background:#000;color:var(--gold);font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.3;}
@keyframes gaTape{to{background-position:calc(28 * var(--u)) 0;}}
.ga-name{font-family:var(--gf-xxl),monospace;font-size:var(--fs-xxl);line-height:1.3;padding:calc(4 * var(--u)) calc(12 * var(--u)) 0;color:var(--text);word-break:keep-all;}
.ga-pct{font-family:'Press Start 2P',var(--gp-p3),monospace;font-size:var(--fs-p3);line-height:1.3;margin-top:calc(8 * var(--u));color:var(--green);text-shadow:calc(3 * var(--u)) calc(3 * var(--u)) 0 var(--green-dim);}
.gap-alert.down .ga-pct{color:var(--red);text-shadow:calc(3 * var(--u)) calc(3 * var(--u)) 0 var(--red-dim);}
.ga-meme{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.6;margin-top:calc(10 * var(--u));padding:0 calc(12 * var(--u));color:var(--gold);}
.ga-warn{display:inline-block;margin-top:calc(10 * var(--u));padding:calc(5 * var(--u)) calc(8 * var(--u)) calc(3 * var(--u));font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.4;color:#000;background:var(--red);animation:blink .4s step-end infinite;}
.gap-alert.t2 .ga-box{width:min(calc(440 * var(--u)),100%);}
.gap-alert.t2 .ga-name,.gap-alert.t2 .ga-pct{font-family:var(--gf-lg),monospace;font-size:var(--fs-lg);}
.gap-alert.t1 .ga-box{width:min(calc(320 * var(--u)),100%);padding-bottom:calc(10 * var(--u));box-shadow:0 0 0 calc(2 * var(--u)) var(--green2),calc(5 * var(--u)) calc(5 * var(--u)) 0 #000;}
.gap-alert.t1.down .ga-box{box-shadow:0 0 0 calc(2 * var(--u)) var(--red2),calc(5 * var(--u)) calc(5 * var(--u)) 0 #000;}
.gap-alert.t1 .ga-name,.gap-alert.t1 .ga-pct{font-family:var(--gf-m16),monospace;font-size:var(--fs-m16);}
.gap-alert.t1 .ga-meme{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);}
.gap-alert.t1 .ga-flash{animation:none;}
/* 찌라시 결과 알림: 갭 경보와 같은 틀 (상승 up · 횡보 flat · 하락 down) */
.gap-alert.tip-res .ga-name{font-family:var(--gf-md),monospace;font-size:var(--fs-md);line-height:1.6;padding:calc(8 * var(--u)) calc(14 * var(--u)) 0;}
.gap-alert.tip-res.t1 .ga-name{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);}
.gap-alert.tip-res .ga-slush{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.5;margin-top:calc(6 * var(--u));color:var(--gold);}
.gap-alert.flat .ga-box,.gap-alert.t1.flat .ga-box{box-shadow:0 0 0 calc(2 * var(--u)) var(--muted),calc(5 * var(--u)) calc(5 * var(--u)) 0 #000;}
.gap-alert.flat .ga-pct{color:var(--text);text-shadow:calc(3 * var(--u)) calc(3 * var(--u)) 0 var(--line);}
.gap-alert.flat .ga-flash{animation:none;}
.ga-vig{position:absolute;inset:0;box-shadow:inset 0 0 0 calc(40 * var(--u)) rgba(0,0,0,.55),inset 0 0 0 calc(90 * var(--u)) rgba(0,0,0,.3);opacity:0;animation:gaVig .3s steps(3) forwards;}
@keyframes gaVig{to{opacity:1;}}
@media (max-width:900px){
  .ga-name,.ga-pct{font-family:var(--gf-xl),monospace;font-size:var(--fs-xl);}
  .gap-alert.t2 .ga-name,.gap-alert.t2 .ga-pct{font-family:var(--gf-lg),monospace;font-size:var(--fs-lg);}
  .ga-meme{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);}
}

/* (S8-46) 수익 콤보 (화면의 콤보 숫자는 이것 하나): c1 초록 → c2 밝은 초록 → c3 금 → c4 무지개 → c5 JACKPOT(금 바탕 번쩍) · 끊기면 '최대 ×N'(cool)이 금 가며 떨어진다
   하락 콤보 d1 빨강 → d2 검붉음 + 가장자리 어둠 */
.fx-streak{
  position:fixed;left:calc(16 * var(--u));bottom:calc(16 * var(--u));z-index:93;pointer-events:none;display:none;padding:calc(7 * var(--u)) calc(10 * var(--u)) calc(5 * var(--u));
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.3;background:#000;color:var(--green);
  box-shadow:0 0 0 calc(2 * var(--u)) var(--green2),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;transform:scale(var(--streak-scale,1));transform-origin:left bottom;
}
.fx-streak.on,.fx-streak.cool{display:block;}
.fx-streak.c2{color:var(--green);box-shadow:0 0 0 calc(2 * var(--u)) var(--green),0 0 0 calc(4 * var(--u)) var(--green-dim),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;}
.fx-streak.c3{color:var(--gold);box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;}
.fx-streak.c4{animation:rainbow .6s steps(4) infinite;}
.fx-streak.c5{color:#000;background:var(--gold);box-shadow:0 0 0 calc(3 * var(--u)) var(--gold2),0 0 0 calc(6 * var(--u)) #000,calc(6 * var(--u)) calc(6 * var(--u)) 0 #000;animation:jackpotFlash .7s steps(2) infinite;}
@keyframes jackpotFlash{50%{background:#000;color:var(--gold);}}
.fx-streak.bump:not(.c4):not(.c5){animation:comboBump .22s steps(3);}
@keyframes comboBump{0%{transform:scale(calc(var(--streak-scale,1) * 1.35));}100%{transform:scale(var(--streak-scale,1));}}
.fx-streak.cool{color:var(--muted);box-shadow:0 0 0 calc(2 * var(--u)) var(--muted),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;animation:streakBreak var(--dur-combo-cool) steps(8) forwards;}
@keyframes rainbow{0%{color:var(--green);box-shadow:0 0 0 calc(2 * var(--u)) var(--green);}25%{color:var(--gold);box-shadow:0 0 0 calc(2 * var(--u)) var(--gold);}50%{color:var(--cyan);box-shadow:0 0 0 calc(2 * var(--u)) var(--cyan);}75%{color:var(--purple);box-shadow:0 0 0 calc(2 * var(--u)) var(--purple);}}
.fx-streak.d1{color:var(--red);box-shadow:0 0 0 calc(2 * var(--u)) var(--red2),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;}
.fx-streak.d2{color:var(--red2);background:var(--red-dim);box-shadow:0 0 0 calc(2 * var(--u)) var(--red2),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;}
@keyframes streakBreak{0%,55%{clip-path:none;transform:none;}70%{clip-path:polygon(0 0,55% 0,40% 100%,0 100%);transform:rotate(-4deg);}100%{opacity:0;transform:translateY(calc(24 * var(--u))) rotate(-12deg);}}
body.no-motion .fx-streak.c4,body.no-motion .fx-streak.c5,body.no-motion .fx-streak.bump{animation:none !important;}
.fx-vignette{position:fixed;inset:0;z-index:84;pointer-events:none;opacity:0;box-shadow:inset 0 0 calc(140 * var(--u)) calc(40 * var(--u)) #000;}

/* (S9) 보스 주간: HUD 배지 · 예고 상자(결산·보상·암시장) · 도감 타일 · 거래정지 시세 · 중앙 경보 */
.boss-chip{white-space:nowrap;padding:calc(2 * var(--u)) calc(6 * var(--u)) calc(1 * var(--u));font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.4;
  color:var(--red);background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--red2);cursor:help;}
.boss-chip.final{color:var(--gold);box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2);}
.boss-notice{margin:calc(10 * var(--u)) 0;padding:calc(8 * var(--u)) calc(10 * var(--u));text-align:left;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.4;}
.boss-notice.final{--pc:var(--gold2);}
.boss-notice .bn-lead{color:var(--red);font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);}
.boss-notice.final .bn-lead{color:var(--gold);}
.boss-notice .bn-name{color:var(--text);font-family:var(--gf-md),monospace;font-size:var(--fs-md);line-height:1.5;}
.boss-notice .bn-kind{color:var(--muted);font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);}
.boss-notice .bn-desc{color:var(--text2);}
.boss-notice.compact{padding:calc(5 * var(--u)) calc(8 * var(--u));margin:calc(6 * var(--u)) 0;}
.boss-notice.compact .bn-name{font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);}
.boss-beaten{margin:calc(4 * var(--u)) 0 calc(10 * var(--u));color:var(--gold);font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.4;}
.boss-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(calc(170 * var(--u)),1fr));gap:calc(12 * var(--u));margin-bottom:calc(16 * var(--u));}
.boss-tile{background:var(--panel2);padding:calc(10 * var(--u));box-shadow:0 0 0 calc(2 * var(--u)) var(--red2),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.4;color:var(--text2);}
.boss-tile.counter{box-shadow:0 0 0 calc(2 * var(--u)) var(--purple),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.boss-tile.final{box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.boss-tile .bt-icon{font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);}
.boss-tile .bt-name{color:var(--text);font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);}
.boss-tile .bt-kind{color:var(--red);}
.boss-tile.counter .bt-kind{color:var(--purple);}
.boss-tile.final .bt-kind{color:var(--gold);}
.boss-tile.build{box-shadow:0 0 0 calc(2 * var(--u)) var(--blue),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.boss-tile.build .bt-kind{color:var(--text);}
.b-vs{margin-top:calc(4 * var(--u));font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.4;color:var(--text2);}
.b-vs-k{display:inline-block;padding:calc(1 * var(--u)) calc(3 * var(--u)) 0;color:#000;background:var(--red);}
.b-vs-k.ok{background:var(--green);}
.rl-seize{position:absolute;left:calc(-4 * var(--u));right:calc(-4 * var(--u));top:40%;padding:calc(1 * var(--u)) 0 0;font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.1;color:#000;background:var(--red);box-shadow:0 0 0 calc(1 * var(--u)) #000;transform:rotate(-12deg);pointer-events:none;}
.relic.seized{filter:grayscale(.6);}
.rt-seize{display:block;margin:calc(4 * var(--u)) 0;color:var(--red);}
.quote-row.halted{opacity:.55;}
.ending-boss{color:var(--red);}
.rr-boss{color:var(--red);}
.boss-alert .ga-name{font-family:var(--gf-lg),monospace;font-size:var(--fs-lg);}
.boss-alert .ga-meme{color:var(--text);}
.boss-alert.final .ga-box{box-shadow:0 0 0 calc(4 * var(--u)) var(--gold2),0 0 0 calc(8 * var(--u)) #000,calc(10 * var(--u)) calc(10 * var(--u)) 0 #000;}
.boss-alert.final .ga-flash{background:var(--gold);}

/* (S8-46) ?tuner=1 연출 조정 패널: 오른쪽 위 떠 있는 창 (─ = 접기) */
.tuner{position:fixed;right:calc(8 * var(--u));top:calc(8 * var(--u));z-index:130;width:calc(320 * var(--u));max-height:calc(100dvh - 16 * var(--u));overflow-y:auto;   /* no-scroll-ok: 디버그 패널(?debug=1)은 스크롤 허용 */
  background:var(--panel);color:var(--text);padding:calc(8 * var(--u));font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.3;
  box-shadow:0 0 0 calc(2 * var(--u)) var(--cyan),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;}
.tuner.folded{width:auto;}
.tuner.folded .tn-body{display:none;}
.tn-head{display:flex;justify-content:space-between;align-items:center;gap:calc(8 * var(--u));font-family:'Press Start 2P',var(--gp-p1),monospace;font-size:var(--fs-p1);color:var(--cyan);margin-bottom:calc(6 * var(--u));}
.tn-btns{display:flex;gap:calc(6 * var(--u));flex-wrap:wrap;margin-bottom:calc(8 * var(--u));}
.tn-btn{border:none;cursor:pointer;background:#000;color:var(--gold);padding:calc(4 * var(--u)) calc(7 * var(--u)) calc(3 * var(--u));font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:1.3;box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2);}
.tn-out{width:100%;height:calc(120 * var(--u));margin-bottom:calc(8 * var(--u));background:#000;color:var(--text);border:none;box-shadow:0 0 0 calc(2 * var(--u)) var(--line2);font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);}
.tn-row{display:grid;grid-template-columns:1fr calc(110 * var(--u)) calc(44 * var(--u));align-items:center;gap:calc(4 * var(--u));padding:calc(2 * var(--u)) 0;}
.tn-k{color:var(--text2);overflow-wrap:anywhere;}
.tn-row input{width:100%;accent-color:var(--gold);}
.tn-v{font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);font-weight:normal;color:var(--gold);text-align:right;}

/* ── TR룸 메뉴 (≡): 탭 대신. 타이틀로 · 찌라시 기록 · 덱 확인 · 환경 설정 ── */
.menu-wrap{position:relative;grid-area:menu;align-self:stretch;display:flex;}
.menu-btn{position:relative;min-width:calc(36 * var(--u));padding:0 calc(8 * var(--u));border:none;cursor:pointer;background:#000;color:var(--gold);
  font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);line-height:1;}
.menu-btn:hover,.menu-btn[aria-expanded="true"]{color:var(--cyan);--bk-ring:var(--cyan);}
.menu-dot{position:absolute;top:calc(3 * var(--u));right:calc(3 * var(--u));width:calc(7 * var(--u));height:calc(7 * var(--u));background:var(--red);box-shadow:0 0 0 calc(1 * var(--u)) #000;}
.menu-panel{position:absolute;top:calc(100% + calc(6 * var(--u)));left:0;z-index:60;display:flex;flex-direction:column;gap:calc(4 * var(--u));
  min-width:calc(230 * var(--u));padding:calc(6 * var(--u));--pc:var(--cyan);}
.menu-panel[hidden]{display:none;}
.menu-panel button{position:relative;text-align:left;border:none;cursor:pointer;background:var(--panel2);color:var(--text);padding:calc(8 * var(--u)) calc(10 * var(--u));
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.4;box-shadow:0 0 0 calc(1 * var(--u)) var(--line);}
.menu-panel button:hover{color:var(--gold);box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2);}
.menu-panel button small{display:block;font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);}
.menu-panel .menu-dot{top:50%;right:calc(10 * var(--u));margin-top:calc(-3 * var(--u));}
.tip-log-box{text-align:left;}
.tip-log-box .tip-empty{padding:calc(14 * var(--u)) 0;}

/* ═══════════════════════════════════════════════════════════
   DESKTOP (가로) 레이아웃 — calc(901 * var(--u)) 이상
   게임 영역(.cabinet)이 창 전체(100vw × 100dvh)를 채운다. 크기는 전부 --u(= --ui × calc(1 * var(--u))) 배수라서
   창 높이에 맞춘 배율 --ui(layoutUi: 창 높이 ÷ 600, 1~2.5, 0.25 단위)를 따라 글자·카드·여백이 같이 커진다.
   TR룸: 넓은 창(폭 ≥ 1200 · 폭/높이 ≥ 1.45) = 3단 [시장 | 행동 | 포지션], 그 밖 = 2단 [시장 | 손패·포지션].
   calc(900 * var(--u)) 이하는 --ui 1, 세로 스택.
═══════════════════════════════════════════════════════════ */
@media (min-width: 901px){
  html,body{height:100%;overflow:hidden;}
  .cabinet{
    display:flex;flex-direction:column;
    width:100vw;height:100vh;height:100dvh;max-width:none;
    box-sizing:border-box;min-height:0;margin:0;
    border:calc(3 * var(--u)) solid var(--line);
  }
  .footnote{display:none;}

  /* 화면마다 게임 영역 안에서만 스크롤 */
  .screen{min-height:0;}
  .screen.active{flex:1;min-height:0;overflow-y:auto;}
  #screen-shop,#screen-collection,#screen-records,#screen-settings{padding:calc(22 * var(--u)) calc(28 * var(--u)) calc(28 * var(--u));}
  .set-list,.rec-list{max-width:none;}
  .pack-row{display:grid;grid-template-columns:repeat(auto-fill, minmax(calc(190 * var(--u)), 1fr));}
  .pack-col{width:auto;}


  /* ── 찌라시 탭 · 오버레이: 창에 맞춰 넓게 ── */
  .phone-noti{max-width:calc(440 * var(--u));}
  .overlay-box{max-width:min(70vw, calc(760 * var(--u)));}

  /* ── TR룸 2단 (기본): 상단 HUD / 좌 시장 / 우 손패·포지션 ── */
  #screen-play.active{
    display:grid;
    grid-template-columns:minmax(0, 42fr) minmax(0, 58fr);   /* 손패가 줄어든 폭만큼 시장 칸 +4 */
    grid-template-rows:auto minmax(0, 1fr);
    grid-template-areas:"top top" "left right";
    gap:calc(8 * var(--u)) calc(12 * var(--u));
    padding:calc(8 * var(--u)) calc(12 * var(--u)) calc(8 * var(--u));
    overflow:hidden;
  }
  /* 상단: [제목·장세 / 주차·감시] [순자산] [현금·대출·확정·이자 2×2] — 한 줄 */
  .play-top{
    grid-area:top;
    display:grid;grid-template-columns:auto minmax(0, 1fr) calc(200 * var(--u)) calc(150 * var(--u));
    grid-template-areas:"menu hud bal assets";
    gap:calc(4 * var(--u)) calc(10 * var(--u));align-items:center;
  }
  .play-top .hud-col{grid-area:hud;margin:0;display:flex;flex-direction:column;gap:calc(5 * var(--u));min-width:0;}
  .play-top .hud{margin:0;white-space:nowrap;gap:calc(4 * var(--u)) calc(6 * var(--u));flex-wrap:wrap;}   /* 좁으면 배속 버튼이 다음 줄로 */
  .play-top .day-track{min-width:calc(40 * var(--u));}
  .play-top .fss{gap:calc(6 * var(--u));}
  .play-top .fss-state{min-width:0;}
  .play-top .balance-main{grid-area:bal;margin:0;padding:calc(5 * var(--u)) calc(9 * var(--u));}
  .play-top .balance-main .total{margin-top:calc(2 * var(--u));}
  .play-top .target-line{margin-top:calc(3 * var(--u));}
  .play-top .target-track{margin-top:calc(3 * var(--u));}
  .play-top .assets-grid{grid-area:assets;margin:0;grid-template-columns:minmax(0, 1fr);gap:calc(5 * var(--u));align-self:stretch;}
  .play-top .asset-card{display:flex;flex-direction:column;justify-content:center;padding:calc(3 * var(--u)) calc(7 * var(--u));min-height:0;}
  .play-top .asset-card .label{margin:0;}
  .play-top .asset-card .val{margin-top:calc(2 * var(--u));font-family:'Press Start 2P',var(--gp-p2),monospace;font-size:var(--fs-p2);line-height:1.2;white-space:nowrap;}   /* (N2) 상시 숫자는 순자산·현금뿐 — 현금을 한 단계 크게 */
  .play-top .asset-card .slush-line{margin-top:calc(1 * var(--u));}
  .play-left,.play-right{min-height:0;min-width:0;}
  .play-left{grid-area:left;display:flex;flex-direction:column;overflow:hidden;}

  /* 왼쪽: 뉴스 전광판 → (3단: 오늘/내일 뉴스) → 지수 차트(남는 높이) → 종목 시세 7행 */
  .play-left .news-row{flex:none;margin:0 0 calc(6 * var(--u));}
  .play-left .news-banner{margin:0;padding:calc(4 * var(--u)) calc(8 * var(--u));display:block;white-space:nowrap;overflow:hidden;}
  .play-left .news-banner > span{display:inline-block;}
  .play-left .news-banner.marquee > span{animation:newsMarquee var(--mq-dur, 10s) linear infinite;}
  .play-left .news-banner.wrap{white-space:normal;}
  .play-left .news-banner.wrap > span{display:inline;}
  .play-left .chart-box{flex:1 1 0;height:auto;min-height:calc(52 * var(--u));margin-bottom:calc(4 * var(--u));}
  .play-left .section-title{flex:none;margin:calc(4 * var(--u)) 0 calc(4 * var(--u));}
  .play-left .quotes{flex:0 1 auto;min-height:0;overflow:hidden;gap:calc(3 * var(--u));}   /* 차트가 최소 높이까지 먼저 줄고, 그래도 모자랄 때만 스크롤 */
  .play-left .quote-row{grid-template-columns:minmax(0, 1fr) calc(64 * var(--u)) calc(66 * var(--u)) calc(50 * var(--u));padding:calc(2 * var(--u)) calc(6 * var(--u));gap:calc(5 * var(--u));}
  .play-left .quote-row canvas{width:calc(64 * var(--u));height:calc(16 * var(--u));}
  .play-left .q-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.25;}
  .play-left .q-sig{margin-top:calc(1 * var(--u));}

  /* 오른쪽(2단): [유물 | 행동력·덱] / 칩 / 손패 / 포지션(최소 화면 35%) / [장 시작 | 전량 매도] — 모자라면 이 칸만 스크롤 */
  .play-right{
    grid-area:right;display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    grid-template-rows:auto auto auto auto auto auto minmax(35vh, 1fr) auto;   /* 손패 행은 카드 줄 수만큼만(auto) — 줄어든 높이는 포지션 칸으로 */
    grid-template-areas:"relic turn" "tip tip" "chips chips" "ht ht" "hand hand" "pt pt" "pos pos" "open sell";
    gap:0 calc(8 * var(--u));overflow:hidden;
  }
  .play-right .relic-bar{grid-area:relic;margin:0 0 calc(4 * var(--u));min-width:0;flex-wrap:nowrap;overflow:hidden;padding:calc(6 * var(--u)) calc(6 * var(--u)) calc(6 * var(--u)) calc(2 * var(--u));}
  .play-right .relic-empty{white-space:nowrap;min-width:0;}
  .play-right .relic-tip{grid-area:tip;}
  .play-right .turn-bar{grid-area:turn;margin:0 0 calc(4 * var(--u));gap:calc(6 * var(--u));}
  .play-right .chips{grid-area:chips;flex-wrap:wrap;overflow:hidden;margin:0 0 calc(2 * var(--u));padding-bottom:calc(2 * var(--u));}
  .play-right .chips .chip{flex:none;white-space:nowrap;}
  .play-right .hand-title{grid-area:ht;margin:calc(2 * var(--u)) 0 calc(4 * var(--u));}
  .play-right .hand{grid-area:hand;}
  .play-right .pos-title{grid-area:pt;margin:calc(4 * var(--u)) 0 calc(4 * var(--u));}
  .play-right .positions-wrap{grid-area:pos;min-height:0;max-height:none;margin:0 0 calc(6 * var(--u));padding:calc(2 * var(--u));overflow:hidden;}
  .play-right .open-btn{grid-area:open;margin:0;padding:calc(8 * var(--u));}
  .play-right .sell-all-btn{grid-area:sell;margin:0;padding:calc(8 * var(--u));}
  /* 칸이 모자라 스크롤돼도 장 시작·전량 매도는 늘 보이게 */
  .play-right .open-btn,.play-right .sell-all-btn{position:sticky;bottom:0;z-index:2;}
  .play-right .section-title,.play-left .section-title{align-items:baseline;}

  /* 알림은 왼쪽 아래(시세표 하단) — 상단 HUD·차트·장 시작·전량 매도를 안 가린다 (2.6초, pointer-events:none). 새 알림이 맨 아래에 쌓이고 오래된 것이 위로 밀린다.
     (예전엔 왼쪽 차트 위였는데 차트를 계속 가려서 옮김. 후보 비교: 포지션 하단·손패 하단은 매수/매도 대상이라 시세표 하단이 가장 덜 해롭다) */
  .toast-layer{
    top:auto;bottom:calc(16 * var(--u));left:calc(24 * var(--u));
    transform:none;justify-content:flex-end;
    width:min(30vw, calc(420 * var(--u)));
  }
  .toast{animation-name:toastInUp;}
}

/* 좁은 2단(4:3 등): 시장 칸이 좁아 스파크라인을 빼고 종목명·시그널에 폭을 준다 */
@media (min-width: 901px) and (max-aspect-ratio: 144/100){
  .play-left .quote-row{grid-template-columns:minmax(0, 1fr) calc(66 * var(--u)) calc(50 * var(--u));}
  .play-left .quote-row canvas{display:none;}
}

/* 뉴스 전광판: 처음 15% 멈춤 → 끝까지 흐름 → 끝에서 15% 멈춤 → 처음으로 */
@keyframes newsMarquee{0%,15%{transform:translateX(0);}85%,100%{transform:translateX(var(--mq-shift, 0px));}}

/* ── TR룸 3단: 넓은 창 — [시장 32] [행동 38] [포지션 30] ──
   .play-right를 display:contents로 풀어서 그 안의 요소를 가운데(행동)·오른쪽(포지션) 칸에 나눠 놓는다 */
@media (min-width: 901px){
  /* (S7-17) 종목 13개: 시세판 2열 격자 — 스파크라인은 빼고 이름·시그널 / 가격·등락 */
  .play-left .quotes{min-height:0;display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:calc(3 * var(--u)) calc(4 * var(--u));overflow:hidden;}
  .play-left .quote-row{grid-template-columns:minmax(0, 1fr) auto;gap:calc(1 * var(--u)) calc(4 * var(--u));padding:calc(1 * var(--u)) calc(5 * var(--u));}
  .play-left .quote-row canvas{display:none;}
  .play-left .quote-row .q-price{grid-column:2;grid-row:1;}
  .play-left .quote-row .q-chg{grid-column:2;grid-row:2;}
  .play-left .quote-row .q-name{grid-row:1 / span 2;}
}
@media (min-width: 1200px) and (min-aspect-ratio: 145/100){
  /* 손패가 줄어든 높이는 시장으로: 왼쪽 칸은 뉴스 + 차트만(차트가 칸 높이를 전부 씀), 시세표는 손패 아래 가운데 칸으로 올라온다.
     .play-left를 display:contents로 풀어서 뉴스·차트·시세 제목·시세표가 각자 격자 칸에 앉는다 (DOM·id는 그대로) */
  #screen-play.active{
    grid-template-columns:minmax(0, 34fr) minmax(0, 36fr) minmax(0, 30fr);
    grid-template-rows:auto auto auto auto auto auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      "top   top    top"
      "news  turn   relic"
      "chart tip    ."
      "chart chips  ."
      "chart ht     pt"
      "chart hand   pos"
      "chart qt     pos"
      "chart quotes pos"
      "chart open   sell";   /* 유물 줄은 오른쪽(포지션) 위로 — 가운데 세로를 시세표에 */
    gap:0 calc(14 * var(--u));
  }
  .play-left{display:contents;}
  /* 알림: 3단에선 왼쪽 아래가 차트라서 가운데 칸 아래(시세표 하단, 장 시작 버튼 위)로 — 가운데 칸 x·폭 = 격자 열 비율 34:36:30을 그대로 계산 */
  .toast-layer{
    left:calc(12 * var(--u) + (100vw - 52 * var(--u)) * 0.34 + 14 * var(--u));
    width:calc((100vw - 52 * var(--u)) * 0.36);bottom:calc(60 * var(--u));
  }
  .play-left .news-row{grid-area:news;min-width:0;}
  .play-left .chart-box{grid-area:chart;height:auto;min-height:0;margin:0 0 calc(6 * var(--u));}
  .play-left .section-title{grid-area:qt;margin:calc(4 * var(--u)) 0 calc(4 * var(--u));}
  .play-left .quotes{grid-area:quotes;min-height:0;margin:0 0 calc(4 * var(--u));align-content:start;overflow:hidden;scrollbar-width:thin;gap:calc(2 * var(--u)) calc(4 * var(--u));   /* 7행 = 평소(5장) 스크롤 없음. 손패 10장이면 행이 모자라 스크롤 */

    background-image:linear-gradient(0deg, color-mix(in srgb, var(--cyan) 6%, transparent) calc(1 * var(--u)), transparent 0), linear-gradient(90deg, color-mix(in srgb, var(--cyan) 6%, transparent) calc(1 * var(--u)), transparent 0);
    background-size:calc(12 * var(--u)) calc(12 * var(--u));}   /* .tx-grid 무늬를 시세표가 이어받는다 (.play-left 상자가 사라졌으므로) */
  .play-top{margin-bottom:calc(8 * var(--u));grid-template-columns:auto minmax(0, 1fr) calc(240 * var(--u)) calc(180 * var(--u));}
  .play-right{display:contents;}
  .play-right .relic-bar{margin:0 0 calc(4 * var(--u));}
  .play-right .turn-bar{margin:0 0 calc(4 * var(--u));}
  .play-right .hand-title{margin:0 0 calc(2 * var(--u));}
  .play-right .chips{margin:0 0 calc(4 * var(--u));}
  .play-right .open-btn{padding:calc(8 * var(--u));}
  .play-right .pos-title{margin:0 0 calc(6 * var(--u));}
  .play-right .positions-wrap{margin:0 0 calc(6 * var(--u));gap:calc(8 * var(--u));}
  .play-right .sell-all-btn{padding:calc(8 * var(--u));}
  .play-left .quote-row{padding-top:calc(1 * var(--u));padding-bottom:calc(1 * var(--u));}
  .play-left .q-name{line-height:1.15;}
  .play-left .q-sig{margin-top:0;line-height:1.2;}
  .play-left .q-sig .sig-chip{line-height:1.1;}
  .chip.news{display:none;}

  .pos-empty{padding:calc(40 * var(--u)) calc(14 * var(--u));font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);}
  /* 포지션 행 (3단): 1줄 글자만 한 단계 크게 — 행 높이는 2줄 그대로 */
  .play-right .p-l1 .name{font-family:var(--gf-md),monospace;font-size:var(--fs-md);}
  .play-right .p-l1 .val{font-family:'VT323',var(--gv-v2),monospace;font-size:var(--fs-v2);}
  .play-right .positions-wrap{gap:calc(5 * var(--u));}
}

/* ══ 공용 카드 컴포넌트 .card.cv (cardView) ═════════════════════════════════════════════
   2:3 세로. 등급 = 4중 표시 (색만으로 구분하지 않는다, 흑백에서도 구분):
     (a) 프레임 두께 --rw(일반 2px → 신화 4px) + 전설 이상 안쪽 계단 발광, 신화는 보석이 가끔 반짝 (b) 코스트 배지 바로 아래 보석 — 모양 ○ ◇ ◆ ★ ✦
     (c) 왼쪽 가장자리 8px 색 띠 .cv-band (d) 이름판 배경 = 등급 색 + 그 아래 등급 글자 .cv-rar(16px 이상).
   부채꼴 손패에서 오른쪽 카드가 덮어도 보이도록 코스트·보석·띠·이름 첫 줄은 카드 왼쪽 40% 안. 색은 :root --rar-* 한 곳.
   선택 = 등급 링 바깥 흰 윤곽선 + 상승 · 비활성 = 안쪽만 어둡게(프레임·보석·띠는 위에 남고 채도 70%) + 자물쇠. 종류는 색이 아니라 아이콘. */
.card.cv{
  --cv-lift:calc(8 * var(--u));
  --rc:var(--rar-common);
  --rw:var(--rar-w-common);
  --cv-glow:0 0 0 0 transparent;
  --cv-band-w:calc(4.5 * var(--u));   /* 1080p 8px */
  --cv-left:calc(var(--cv-band-w) + 3 * var(--u));
  display:grid;grid-template-rows:minmax(0, 1fr) auto auto auto auto;gap:calc(2 * var(--u));
  padding:calc(6 * var(--u)) calc(6 * var(--u)) calc(6 * var(--u)) var(--cv-left);box-sizing:border-box;overflow:visible;
  background:var(--panel2);cursor:pointer;
  box-shadow:var(--cv-glow),0 0 0 var(--rw) var(--rc),calc(5 * var(--u)) calc(5 * var(--u)) 0 #000;
  transform:none;animation:none;
}
.card.cv::before,.card.cv::after{display:none;}
.card.cv.r-common{--rc:var(--rar-common);--rw:var(--rar-w-common);}
.card.cv.r-uncommon{--rc:var(--rar-uncommon);--rw:var(--rar-w-uncommon);}
.card.cv.r-rare{--rc:var(--rar-rare);--rw:var(--rar-w-rare);}
.card.cv.r-legendary{--rc:var(--rar-legendary);--rw:var(--rar-w-legendary);
  --cv-glow:inset 0 0 0 calc(2 * var(--u)) color-mix(in srgb, var(--rc) 45%, transparent),inset 0 0 0 calc(4 * var(--u)) color-mix(in srgb, var(--rc) 18%, transparent);}   /* 안쪽 계단 발광 (부드러운 그림자 대신 픽셀 링 2단) */
.card.cv.r-mythic{--rc:var(--rar-mythic);--rw:var(--rar-w-mythic);
  --cv-glow:inset 0 0 0 calc(2 * var(--u)) color-mix(in srgb, var(--rc) 55%, transparent),inset 0 0 0 calc(4 * var(--u)) color-mix(in srgb, var(--rc) 25%, transparent),inset 0 0 0 calc(6 * var(--u)) color-mix(in srgb, var(--rc) 10%, transparent);}
.card.cv.t-status{--rc:var(--rar-status);--rw:var(--rar-w-common);--cv-glow:0 0 0 0 transparent;}
/* (c) 왼쪽 8px 색 띠 — 위는 코스트 배지 밑까지. 상태 카드는 회색 빗금 */
.cv-band{position:absolute;left:0;top:0;bottom:0;width:var(--cv-band-w);z-index:2;background:var(--rc);}
.card.cv.t-status .cv-band{background:repeating-linear-gradient(135deg, var(--rc) 0 calc(2 * var(--u)), var(--bg) 0 calc(4 * var(--u)));}
/* (d) 이름판(등급 색 배경, 어두운 글자) + 등급 글자 */
.cv-rar{font-family:var(--gf-m16),monospace;font-size:var(--fs-m16);line-height:1.1;color:var(--rc);text-align:left;white-space:nowrap;overflow:hidden;}
.card.cv.t-status .cv-rar{color:var(--text2);}
.card.cv.up{--cc:var(--rc);}
/* 크기: 표준(보상·암시장·덱·도감) 152×228 / 손패는 칸 너비 × 2:3 */
.card.cv-std{width:calc(152 * var(--u));min-width:calc(152 * var(--u));height:calc(228 * var(--u));}
.card.cv-hand{width:100%;height:auto;aspect-ratio:2 / 3;min-width:0;min-height:0;padding:calc(4 * var(--u)) calc(4 * var(--u)) calc(4 * var(--u)) var(--cv-left);gap:calc(1 * var(--u));}
.hand,.hand.compact,.hand.g4{grid-auto-rows:auto;}
.hand .g-slot{aspect-ratio:2 / 3;}
/* (b) 보석: 코스트 배지 바로 아래, 등급마다 모양이 다르다 (7×7 픽셀 SVG — ○ 일반 · ◇ 고급 · ◆ 희귀 · ★ 전설 · ✦ 신화 · ✕ 상태). 색 = 등급, 검은 오프셋 그림자 */
.cv-gem{position:absolute;z-index:3;left:calc(-3 * var(--u));top:calc(29 * var(--u));width:calc(16 * var(--u));height:calc(16 * var(--u));color:var(--rc);
  background:var(--bg);box-shadow:0 0 0 calc(1 * var(--u)) var(--rc);padding:calc(2 * var(--u));box-sizing:border-box;}
.cv-gem svg{display:block;width:100%;height:100%;}
.cv-hand .cv-gem{left:calc(-2 * var(--u));top:calc(25 * var(--u));width:calc(15 * var(--u));height:calc(15 * var(--u));}
.card.cv.r-mythic .cv-gem{animation:gemTwinkle 3.2s steps(1) infinite;}   /* 신화: 3초에 한 번 짧게 반짝 (절제) */
@keyframes gemTwinkle{0%,88%,100%{background:var(--bg);color:var(--rc);}90%,94%{background:var(--rc);color:var(--bg);}}
body.no-motion .card.cv.r-mythic .cv-gem{animation:none;}
/* 코스트 배지 (좌상단, 큰 숫자 VT323) */
.cv-cost{position:absolute;left:calc(-5 * var(--u));top:calc(-5 * var(--u));z-index:2;min-width:calc(30 * var(--u));height:calc(30 * var(--u));padding:0 calc(3 * var(--u));box-sizing:border-box;
  display:flex;align-items:center;justify-content:center;background:var(--bg);color:var(--text);box-shadow:0 0 0 calc(2 * var(--u)) var(--rc);z-index:3;
  font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);line-height:1;}
.cv-hand .cv-cost{min-width:calc(26 * var(--u));height:calc(26 * var(--u));left:calc(-4 * var(--u));top:calc(-4 * var(--u));}
/* 아트 슬롯: 지금은 이모지, CARD_ART에 경로를 넣으면 스프라이트 */
.cv-art{min-height:0;display:flex;align-items:center;justify-content:center;background:var(--panel);overflow:hidden;}
.cv-glyph{font-size:calc(46 * var(--u));line-height:1;}
.cv-hand .cv-glyph{font-size:calc(28 * var(--u));}
.cv-img{width:100%;height:100%;object-fit:contain;image-rendering:pixelated;}
.cv-name{font-family:var(--gf-md),monospace;font-size:var(--fs-md);line-height:1.2;text-align:left;color:var(--bg);background:var(--rc);
