/* ── 손패 ── */
function cardUsable(idx){
  if(run.phase !== 'premarket') return false;
  const card = CARD_BY_ID[run.hand[idx].id];
  if(card.target) return validTargetIds(idx).length > 0;
  return checkPlay(idx, null) === null;
}

function renderHand(){
  const box = $('handBox');
  const usable = run.hand.map((_, i) => cardUsable(i) ? '1' : '0').join('');
  const sig = run.hand.map(c => c.uid + ':' + cardCost(CARD_BY_ID[c.id])).join() + '|' + usable + '|' + selectedIdx + '|' + run.pending.principalMult
    + '|' + run.marketCard + '|' + run.positions.map(p => p.id + ':' + Math.round(exposure(p))).join();   // 기대값이 포지션·대기 시장 카드에 따라 바뀐다
  if(sig !== handSig){
    handSig = sig;
    box.innerHTML = run.hand.length === 0
      ? `<div class="empty-note">── 손패 없음 ──</div>`
      : run.hand.map((inst, i) => {
          const card = CARD_BY_ID[inst.id];
          const cls = (usable[i] === '1' ? '' : 'disabled') + (i === selectedIdx ? ' selected' : '');
          const cost = card.stock ? stockCost(STOCK_BY_ID[card.stock]) : 0;
          return cardHtml(card, { attrs: `data-idx="${i}"`, cls, cost, live: true, ap: cardCost(card), ev: cardEvView(card) });
        }).join('');
  }
  box.querySelectorAll('[data-p]').forEach(el => { el.textContent = '@' + fmtPrice(assets[el.dataset.p].price); });
}

/* 카드 기대값 표시 (엔진 expectedValue). 대상 카드(리딩방·작전 세력)는 수익률 + 보유 종목별 금액을 툴팁으로 */
const fmtEv = v => (v >= 0.5 ? '+' : v <= -0.5 ? '−' : '±') + '₩' + Math.abs(Math.round(v)).toLocaleString() + '만';
const evCls = v => v >= 0.5 ? 'pos' : v <= -0.5 ? 'neg' : 'zero';
function cardEvView(card){
  const e = expectedValue(card, null);
  if(!e) return null;
  if(card.target === 'asset'){
    const held = STOCKS.filter(s => heldExposure(s.id) !== 0).map(s => `${s.name} ${fmtEv(expectedValue(card, s).ev)}`);
    return { text: `EV ${e.rate >= 0 ? '+' : '−'}${Math.abs(e.rate * 100).toFixed(1)}%`, cls: e.rate >= 0 ? 'pos' : 'neg',
             title: `${e.note} = 보유분의 ${fmtPct(e.rate)}` + (held.length ? '\n' + held.join('\n') : '\n(보유 종목 없음 — 대상 종목 보유분에만 적용)') };
  }
  return { text: 'EV ' + fmtEv(e.ev), cls: evCls(e.ev), title: `${e.note} (장세 확률 × 지수 기대 드리프트 → 보유 포지션, 갭·되돌림 제외)` };
}

/* ── 보유 포지션 ── */
function orderTags(p){
  const t = [];
  if(p.stopLoss)       t.push(`<span class="o-tag stop">손절 ${fmtPct(STOP_LOSS_PCT)}</span>`);
  if(p.takeProfit)     t.push(`<span class="o-tag take">익절 ${fmtPct(TAKE_PROFIT_PCT)}</span>`);
  if(p.trailing)       t.push(`<span class="o-tag trail">트레일 ${Math.round(TRAIL_GAP * 100)}%p</span>`);
  if(p.protectedToday) t.push('<span class="o-tag hodl">존버</span>');
  if(p.diamond)        t.push('<span class="o-tag diamond">💎 다이아몬드</span>');
  if(gukbapApplies(p)) t.push(`<span class="o-tag relic-on">🍲 손실 −${Math.round(RELIC_GUKBAP_LOSS_CUT * 100)}%</span>`);
  if(sealApplies(p))   t.push(`<span class="o-tag relic-on">🔏 이익 +${Math.round(RELIC_SEAL_BONUS * 100)}%</span>`);
  return t.join('');
}

