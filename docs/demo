}
function markHeldQuotes(){
  STOCKS.forEach(st => {   // 보유 종목 행: 왼쪽 강조 바 색(수익 초록 · 손실 빨강)
    const row = document.querySelector(`[data-q="${st.id}"]`);
    if(!row) return;
    const mine = run.positions.filter(p => p.assetId === st.id), sum = mine.reduce((a, p) => a + posPnl(p), 0);
    const pb = [...new Set(mine.map(p => (p.dir < 0 ? '<span class="lev-badge short">숏</span>' : '') + (p.lev > 1 ? `<span class="lev-badge lev${p.lev}">${p.lev}x</span>` : '')).filter(Boolean))].join('');   // 레버리지·숏 배지는 종목 행 이름 옆에
    const pbEl = row.querySelector('.q-pb');
    if(pbEl && pbEl.innerHTML !== pb) pbEl.innerHTML = pb;
    row.classList.toggle('held', mine.length > 0);
    row.classList.toggle('held-up', mine.length > 0 && sum >= 0);
    row.classList.toggle('held-down', mine.length > 0 && sum < 0);
  });
}
function updatePositionRows(){
  const box = $('positionsBox');
  const targets = selectedTargets('position');
  run.positions.forEach(p => {
    const el = box.querySelector(`[data-id="${p.id}"]`);
    if(!el) return;
    el.classList.toggle('targetable', targets.indexOf(p.id) >= 0);
    const fl = flameLevel(p);   // (32) 연속 상승 불꽃 · 반대매매 위험 맥동
    [1, 2, 3].forEach(k => el.classList.toggle('flame-' + k, fl === k));
    const danger = posInDanger(p);
    el.classList.toggle('fx-danger', danger);
    el.classList.toggle('px-panel-red', danger); el.classList.toggle('px-panel', !danger);   // 반대매매 경고 = 위험 패널
    el.querySelector('[data-f=price]').textContent = document.body.classList.contains('lay-f') ? `평단 ${fmtPrice(avgPrice(p))}→${fmtPrice(assets[p.assetId].price)}` : `평단 ${fmtPrice(avgPrice(p))} → ${fmtPrice(assets[p.assetId].price)}`;
    const tip = `${p.name} · 원금 ₩${formatKrw(p.principal)} · 노출 ${fmtMoney(exposure(p))} · 보유 ${p.daysHeld}일`
      + (isMarginable(p) ? ` · ${marginText(p)}${isProtected(p) ? ' · 면제' : ''}` : '');
    if(el.title !== tip) el.title = tip;   // 노출액은 행 툴팁으로
    const pnl = posPnl(p);
    posPnlSnap[p.id] = pnl;   // (C9) 전량 매도 폭포용
    const pv = el.querySelector('[data-f=pnl]');
    pv.textContent = `${fmtSigned(pnl)} (${fmtPct(posReturn(p))})`;
    pv.className = 'val ' + (pnl >= 0 ? 'pnl-up' : 'pnl-down');
    const g = el.querySelector('[data-f=gauge]');   // (N2) 심지: 반대매매까지 남은 여유. 전문용어·숫자는 툴팁
    if(g){
      const f = fuseLeft(p), cls = fuseClass(p, f);
      if(g.className !== 'fuse ' + cls) g.className = 'fuse ' + cls;
      const tip = `심지 ${Math.round(f * 100)}% — 다 타면 청산\n${marginText(p)}${isProtected(p) ? ' · 오늘 면제' : ''}`;
      if(g.title !== tip) g.title = tip;
      g.firstElementChild.style.width = Math.round(f * 100) + '%';
    }
  });
}

