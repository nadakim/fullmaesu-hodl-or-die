.fss.hot .fss-label,.fss.hot .fss-state{color:var(--red);animation:blink 1s step-end infinite;}
.fss-verdict{
  margin:calc(12 * var(--u)) 0;padding:calc(12 * var(--u));background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--red2);
  font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);color:var(--text);text-align:center;line-height:1.3;
}
.fss-verdict b{color:var(--red);}
.fss-verdict small{font-size:var(--fs-v1);font-family:'VT323',var(--gv-v1),monospace;color:var(--muted);}
.day-fill{height:100%;width:0;background:var(--cyan);}

.target-line{
  display:flex;justify-content:space-between;margin-top:calc(9 * var(--u));
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);
}
.target-track{height:calc(6 * var(--u));background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--line);margin-top:calc(6 * var(--u));}
#targetPct{font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);line-height:.8;color:var(--text2);}
.target-fill{height:100%;width:0;background:var(--gold2);}
.target-fill.done{background:var(--green);}

.quotes{display:flex;flex-direction:column;gap:calc(5 * var(--u));margin-bottom:calc(4 * var(--u));}
.quote-row{
  display:grid;grid-template-columns:1fr calc(64 * var(--u)) calc(62 * var(--u)) calc(50 * var(--u));align-items:center;gap:calc(6 * var(--u));
  background:var(--panel);box-shadow:0 0 0 calc(2 * var(--u)) var(--line);
  padding:calc(5 * var(--u)) calc(8 * var(--u));font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);line-height:1;   /* 가격·등락 = VT323 */
}
.q-name{font-size:var(--fs-sm);font-family:var(--gf-sm),monospace;color:var(--text);}
.quote-row canvas{width:calc(64 * var(--u));height:calc(18 * var(--u));display:block;image-rendering:pixelated;}
.q-price,.q-chg{text-align:right;}
.q-tag{font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;margin-left:calc(5 * var(--u));}
.q-tag.hidden{color:var(--purple);}
.q-tag.up{color:var(--green);}
.q-tag.down{color:var(--red);}
.q-chg .yd,.ch-chg .yd,#czHead .yd{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);}
.quote-hint-yd{display:none;color:var(--muted);}
@media (min-width: 901px) and (not ((min-width: 1200px) and (min-aspect-ratio: 145/100))){
  .play-left .q-chg .yd{display:none;}
  .play-left .quote-hint-yd{display:inline;}
}
.q-chg.limit-up .yd{color:var(--bg);}
.q-chg.limit-down .yd{color:var(--text);}
.q-chg.limit-up{color:var(--bg);background:var(--green);padding:0 calc(2 * var(--u));}
.q-chg.limit-down{color:var(--text);background:var(--red2);padding:0 calc(2 * var(--u));}
.q-tag.gap{color:var(--bg);background:var(--gold);padding:calc(1 * var(--u)) calc(2 * var(--u));}
/* 읽을 수 있는 시장: 시그널 · 어제 채점 · 기대값 */
.q-sig{display:block;font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;color:var(--muted);margin-top:calc(3 * var(--u));line-height:1.4;white-space:nowrap;}
.q-sig .sig-chip{display:inline-block;padding:0 calc(3 * var(--u));font-size:var(--fs-m16);line-height:1.2;box-shadow:0 0 0 calc(1 * var(--u)) #000;}
.q-sig .s-UP{background:var(--green-dim);box-shadow:0 0 0 calc(1 * var(--u)) var(--green);} .q-sig .s-DOWN{background:var(--red-dim);box-shadow:0 0 0 calc(1 * var(--u)) var(--red);}
.q-sig .s-HOT{background:var(--gold2);box-shadow:0 0 0 calc(1 * var(--u)) var(--gold);} .q-sig .s-FLAT{background:var(--panel2);box-shadow:0 0 0 calc(1 * var(--u)) var(--muted);}
.q-sig .s-rev{color:var(--cyan);}
.q-sig .hit{color:var(--green);} .q-sig .miss{color:var(--red);}
.c-ev{font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.4;}
.c-ev.pos,.ch-ev.pos{color:var(--green);} .c-ev.neg,.ch-ev.neg{color:var(--red);} .c-ev.zero,.ch-ev.zero{color:var(--muted);}
.choice .ch-ev{display:block;margin-top:calc(3 * var(--u));font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);}

/* 대상 지정 가능 */
.quote-row.targetable,.pos-item.targetable{
  cursor:pointer;background:rgba(255,215,0,.07);
  box-shadow:0 0 0 calc(2 * var(--u)) var(--gold),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;
}

/* 행동력 · 더미 */
.turn-bar{
  display:flex;align-items:center;gap:calc(8 * var(--u));margin:calc(14 * var(--u)) 0 calc(8 * var(--u));
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);
}
.ap-pips{display:flex;gap:calc(4 * var(--u));}
.ap-pip{width:calc(10 * var(--u));height:calc(10 * var(--u));background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2);}
.ap-pip.on{background:var(--gold);}
.ap-text{color:var(--gold);font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);line-height:1;}
.mult-preview{display:inline-block;padding:0 calc(6 * var(--u));white-space:nowrap;cursor:help;
  font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);line-height:1.1;color:var(--gold);
  box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2);}
.mult-preview .mp-label{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--text2);margin-right:calc(4 * var(--u));}
.pile-text{flex:1;text-align:right;}
.deck-btn,.back-btn{
  border:none;cursor:pointer;background:var(--panel);color:var(--cyan);
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);padding:calc(5 * var(--u)) calc(7 * var(--u));white-space:nowrap;flex:none;
}
.deck-btn:hover,.back-btn:hover{--bk-ring:var(--cyan);}

.chips{display:flex;flex-wrap:wrap;gap:calc(6 * var(--u));margin-bottom:calc(8 * var(--u));}
.chips:empty{display:none;}
.chip{
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);padding:calc(4 * var(--u)) calc(6 * var(--u));background:#000;
  color:var(--gold);box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2);
}
.chip.buy{color:var(--green);box-shadow:0 0 0 calc(2 * var(--u)) var(--green2);}
.chip.short{color:var(--red);box-shadow:0 0 0 calc(2 * var(--u)) var(--red2);}
.chip.mod{color:var(--purple);box-shadow:0 0 0 calc(2 * var(--u)) var(--purple);}

.empty-note{
  width:100%;text-align:center;padding:calc(14 * var(--u));color:var(--muted);
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);
}

.open-btn{
  width:100%;padding:calc(13 * var(--u));margin:calc(4 * var(--u)) 0 calc(6 * var(--u));border:none;cursor:pointer;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);letter-spacing:.05em;
  background:var(--green-dim);color:var(--green);text-shadow:calc(2 * var(--u)) calc(2 * var(--u)) 0 #000;
  --bk-ring:var(--green);
}
.open-btn:disabled{cursor:default;background:var(--panel);color:var(--muted);--bk-ring:var(--line);}

/* 포지션 배지 · 예약주문 태그 */
.lev-badge{font-size:var(--fs-p1);font-family:'Press Start 2P',var(--gp-p1),monospace;padding:calc(1 * var(--u)) calc(3 * var(--u));margin-left:calc(5 * var(--u));background:var(--gold2);color:#000;vertical-align:middle;}
.lev-badge.lev3{background:var(--red);color:var(--text);}
.lev-badge.short{background:var(--red2);color:var(--text);}
.o-ic.stop{color:var(--red);} .o-ic.take{color:var(--green);} .o-ic.trail,.o-ic.hodl{color:var(--cyan);} .o-ic.diamond{color:var(--gold);}
.positions-wrap{max-height:calc(240 * var(--u));}

.toast-layer{
  position:fixed;top:calc(48 * var(--u));left:50%;transform:translateX(-50%);z-index:95;
  display:flex;flex-direction:column;gap:calc(6 * var(--u));width:min(calc(480 * var(--u)),92vw);pointer-events:none;
}
.toast{
  background:#000;color:var(--cyan);
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1.7;padding:calc(8 * var(--u)) calc(10 * var(--u));
  box-shadow:0 0 0 calc(2 * var(--u)) var(--cyan),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;
  animation:toastIn var(--dur-toast) steps(13) forwards;
}
.toast.bad{color:var(--red);box-shadow:0 0 0 calc(2 * var(--u)) var(--red),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.toast.good{color:var(--green);box-shadow:0 0 0 calc(2 * var(--u)) var(--green2),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
.toast.warn{color:var(--gold);box-shadow:0 0 0 calc(2 * var(--u)) var(--gold2),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;}
@keyframes toastInUp{0%{opacity:0;transform:translateY(calc(6 * var(--u)));}8%{opacity:1;transform:none;}85%{opacity:1;}100%{opacity:0;}}
@keyframes toastIn{0%{opacity:0;transform:translateY(calc(-6 * var(--u)));}8%{opacity:1;transform:none;}85%{opacity:1;}100%{opacity:0;}}

.overlay{
  position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.84);
  display:none;align-items:center;justify-content:center;padding:calc(20 * var(--u));
}
.overlay.show{display:flex;}
.fx-skip{position:fixed;left:50%;bottom:calc(14 * var(--u));transform:translateX(-50%);z-index:200;--bk-ring:var(--text);background:var(--panel2);color:var(--text);
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);padding:calc(5 * var(--u)) calc(14 * var(--u));}
.fx-skip[hidden]{display:none;}
.ov-row{display:flex;gap:calc(8 * var(--u));}
.ov-row .ov-btn{flex:1 1 0;margin-top:0;margin-bottom:0;min-width:0;}
/* 스크롤 없는 화면: 쪽 넘김 (fitPages) */
.pg-hide{display:none !important;}
.pg-bar{display:flex;align-items:center;justify-content:center;gap:calc(10 * var(--u));margin:calc(6 * var(--u)) 0;font-family:'VT323',var(--gv-v2),monospace;font-size:var(--fs-v2);color:var(--text);}
.pg-bar button{border:0;cursor:pointer;background:var(--panel2);color:var(--text);font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);line-height:1;padding:calc(5 * var(--u)) calc(10 * var(--u));box-shadow:0 0 0 calc(1 * var(--u)) var(--line);}
.pg-bar button:hover:not(:disabled),.pg-bar button:focus-visible{background:var(--panel);box-shadow:0 0 0 calc(1 * var(--u)) var(--text);}
.pg-bar button:disabled{opacity:.35;cursor:default;}
.overlay-box{
  width:100%;max-width:calc(440 * var(--u));max-height:92vh;overflow:hidden;   /* 스크롤 없음 — 넘치면 fitOverlay가 쪽으로 나눈다 */
  text-align:center;padding:calc(18 * var(--u));
}
.ov-title{font-family:var(--gf-md),monospace;font-size:var(--fs-md);line-height:1.6;margin-bottom:calc(8 * var(--u));}
.ov-sub{font-family:'VT323',var(--gv-v2),monospace;font-size:var(--fs-v2);color:var(--text);margin-bottom:calc(14 * var(--u));line-height:1.3;}
.ov-stats{
  text-align:left;background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--line);
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);line-height:2.3;color:var(--muted);
  padding:calc(8 * var(--u)) calc(10 * var(--u));margin-bottom:calc(12 * var(--u));
}
.ov-stats b{float:right;color:var(--text);font-weight:normal;}
.ov-btn{
  width:100%;padding:calc(12 * var(--u));margin-top:calc(8 * var(--u));border:none;cursor:pointer;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);
  background:var(--green-dim);color:var(--green);
  --bk-ring:var(--green2);
}
.ov-btn.alt{background:var(--panel2);color:var(--muted);--bk-ring:var(--line);}
.ov-btn.alt:hover:not(:disabled){color:var(--text);}
.ov-btn.warn{background:var(--red-dim);color:var(--red);--bk-ring:var(--red2);}

/* 라운드 결과 · 게임오버 */
.result-kicker{font-family:'Press Start 2P',var(--gp-p1),monospace;font-size:var(--fs-p1);color:var(--muted);margin-bottom:calc(6 * var(--u));}
.result-hero{font-family:'Press Start 2P',var(--gp-p3),monospace;font-size:var(--fs-p3);margin:calc(6 * var(--u)) 0 calc(4 * var(--u));text-shadow:calc(2 * var(--u)) calc(2 * var(--u)) 0 #000;}
.result-bar{position:relative;height:calc(12 * var(--u));margin:calc(8 * var(--u)) 0 calc(4 * var(--u));background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--line);}
.result-bar i{position:absolute;inset:0 auto 0 0;background:var(--gold2);}
.result-bar i.done{background:var(--green);}
.result-bar b{position:absolute;top:calc(-2 * var(--u));bottom:calc(-2 * var(--u));left:calc(100% / 1.5 - calc(1 * var(--u)));width:calc(2 * var(--u));background:var(--text);}
.result-pct{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);text-align:right;margin-bottom:calc(12 * var(--u));}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:calc(8 * var(--u));margin:calc(10 * var(--u)) 0 calc(12 * var(--u));text-align:left;}
.stat-grid div{background:#000;box-shadow:0 0 0 calc(2 * var(--u)) var(--line);padding:calc(7 * var(--u)) calc(9 * var(--u));font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--muted);line-height:1.5;}
.stat-grid div b{display:block;margin-top:calc(4 * var(--u));font-family:'VT323',var(--gv-v2),monospace;font-size:var(--fs-v2);font-weight:normal;color:var(--text);}
.stat-grid .wide{grid-column:1 / -1;}
.stat-caption{font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);color:var(--gold);text-align:left;margin-top:calc(12 * var(--u));}

/* 결산 체인: 주간 결산 통과 때 유물·보너스가 포지션 손익을 불린 순서를 재생 (연출 전용) */
.stage-mult{font-family:'Press Start 2P',var(--gp-p2),monospace;font-size:var(--fs-p2);color:var(--gold);margin-left:auto;white-space:nowrap;}
.stage-mult.f1{color:var(--gold);text-shadow:0 0 calc(4 * var(--u)) var(--gold2);}
.stage-mult.f2{color:var(--gold);text-shadow:0 0 calc(6 * var(--u)) var(--blue);}
.stage-mult.f3{color:var(--gold);text-shadow:0 0 calc(8 * var(--u)) var(--purple);animation:stageJitter .12s steps(2) infinite;}
.stage-mult.f4{color:var(--gold);font-size:var(--fs-p3);text-shadow:0 0 calc(10 * var(--u)) var(--red),0 0 calc(18 * var(--u)) var(--gold);animation:stageJitter .08s steps(2) infinite;}
@keyframes stageJitter{50%{transform:translate(calc(1 * var(--u)), calc(-1 * var(--u)));}}
.overlay-box.stage-f3{box-shadow:0 0 0 calc(3 * var(--u)) var(--purple),0 0 calc(24 * var(--u)) var(--purple),calc(6 * var(--u)) calc(6 * var(--u)) 0 #000;}
.overlay-box.stage-f4{box-shadow:0 0 0 calc(4 * var(--u)) var(--gold),0 0 calc(40 * var(--u)) var(--red),0 0 calc(80 * var(--u)) var(--gold2);}
/* 정산 무대 주인공 배수 + 불꽃 (juice-stage): 누적 배수를 크게, 티어(f1~f4)가 오를수록 불꽃이 커지고 색이 변한다. 불꽃 = hard-stop 그라디언트 막대 7개를 steps()로 일렁임 */
.overlay-box.stage-live{overflow-x:hidden;}
.stage-hero{position:relative;display:flex;justify-content:center;align-items:flex-end;height:calc(88 * var(--u));margin:calc(2 * var(--u)) 0 calc(6 * var(--u));
  --fl-a:var(--red2);--fl-b:var(--gold2);--fl-c:var(--gold);--fl-h:0;}
.stage-hero.t2{--fl-a:var(--red);--fl-b:var(--gold2);--fl-c:var(--gold);}
.stage-hero.t3{--fl-a:var(--purple);--fl-b:var(--red);--fl-c:var(--gold);}
.stage-hero.t4{--fl-a:var(--purple);--fl-b:var(--gold);--fl-c:var(--text);}
.sh-flame{position:absolute;left:50%;bottom:calc(10 * var(--u));width:min(86%, calc(300 * var(--u)));height:calc(40 * var(--u) * var(--fl-h));translate:-50% 0;display:flex;align-items:flex-end;pointer-events:none;}
.sh-flame i{flex:1;height:calc(100% * var(--k));transform-origin:50% 100%;clip-path:polygon(0 22%, 50% 0, 100% 22%, 100% 100%, 0 100%);
  background:linear-gradient(to top, var(--fl-a) 0 34%, var(--fl-b) 34% 68%, var(--fl-c) 68% 100%);
  animation:shFlick var(--fl-ms, .16s) steps(3) infinite;}
.sh-flame i:nth-child(1){--k:.5;animation-delay:-.02s;} .sh-flame i:nth-child(2){--k:.8;animation-delay:-.07s;}
.sh-flame i:nth-child(3){--k:.62;animation-delay:-.12s;} .sh-flame i:nth-child(4){--k:1;animation-delay:-.04s;}
.sh-flame i:nth-child(5){--k:.7;animation-delay:-.1s;} .sh-flame i:nth-child(6){--k:.85;animation-delay:-.14s;}
.sh-flame i:nth-child(7){--k:.45;animation-delay:-.06s;}
@keyframes shFlick{0%{transform:scaleY(1);}33%{transform:scaleY(.72);}66%{transform:scaleY(.9) translateX(calc(1 * var(--u)));}100%{transform:scaleY(1);}}
.sh-num{position:relative;font-family:'Press Start 2P',var(--gp-p4),monospace;font-size:var(--fs-p4);line-height:1.1;color:var(--gold);white-space:nowrap;
  text-shadow:calc(2 * var(--u)) 0 0 #000,calc(-2 * var(--u)) 0 0 #000,0 calc(2 * var(--u)) 0 #000,0 calc(-2 * var(--u)) 0 #000,calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;}   /* 검은 외곽선 4방향: 뒤의 불꽃과 섞여도 읽힌다 */
.sh-num.long{font-size:var(--fs-p3);}
.stage-hero.t1 .sh-num{text-shadow:calc(2 * var(--u)) 0 0 #000,calc(-2 * var(--u)) 0 0 #000,0 calc(2 * var(--u)) 0 #000,0 calc(-2 * var(--u)) 0 #000,calc(4 * var(--u)) calc(4 * var(--u)) 0 var(--red2);}
.stage-hero.t2 .sh-num{text-shadow:calc(2 * var(--u)) 0 0 #000,calc(-2 * var(--u)) 0 0 #000,0 calc(2 * var(--u)) 0 #000,0 calc(-2 * var(--u)) 0 #000,calc(4 * var(--u)) calc(4 * var(--u)) 0 var(--red);}
.stage-hero.t3 .sh-num{color:var(--text);text-shadow:calc(2 * var(--u)) 0 0 #000,calc(-2 * var(--u)) 0 0 #000,0 calc(2 * var(--u)) 0 #000,0 calc(-2 * var(--u)) 0 #000,calc(4 * var(--u)) calc(4 * var(--u)) 0 var(--purple);}
.stage-hero.t4 .sh-num{color:var(--text);text-shadow:calc(2 * var(--u)) 0 0 #000,calc(-2 * var(--u)) 0 0 #000,0 calc(2 * var(--u)) 0 #000,0 calc(-2 * var(--u)) 0 #000,calc(4 * var(--u)) calc(4 * var(--u)) 0 var(--gold),calc(-4 * var(--u)) calc(-4 * var(--u)) 0 var(--red);}
.sh-num.pop{animation:shPop var(--pop-ms, .26s) steps(4);}
.sh-num.slam{animation:shSlam var(--slam-ms, .52s) steps(8);z-index:2;}
@keyframes shSlam{0%{transform:scale(1);}25%{transform:scale(var(--slam, 1.9)) rotate(-2deg);}50%{transform:scale(calc(var(--slam, 1.9) * .9)) rotate(2deg);}75%{transform:scale(.92);}100%{transform:none;}}
@keyframes shPop{0%{transform:scale(var(--pop, 1.3));}100%{transform:none;}}
/* 정산 무대가 열려 있는 동안 Fx.shake가 .overlay-box도 흔든다 (진폭 --ovk 배: 어두운 배경 위 작은 상자라 .cabinet보다 크게) */
/* 폭주 배경 (juice-stage 2): 티어 ≥ rageTier이면 정산 상자(.overlay-box)의 배경 전체가 한 가지 색으로 통째로 바뀌며 순환한다 (뒤 화면은 그대로).
   steps(1)로 4색이 뚝뚝 바뀐다 (한 바퀴 --rage-ms ≥ 1.33초 = 초당 3회 이하). 어두운 바탕 위 저채도(color-mix 알파)만 — 전체 화면 고대비 점멸 금지 */
