    case 'runOver':
      overPending = true;
      // 결산 체인은 결산을 통과했을 때만 (마지막 주 통과 = 졸업). 파산·목표 미달은 바로 게임오버
      if(d.reason === 'VICTORY') whenFxIdle(() => playSettlementChain(run.lastWeek.settlementChain, skipped => {   // 체인을 건너뛰었으면 도장 소리 뒤에 팡파레
        setTimeout(() => { if(!(musicOn() && Music.stinger('victory', { thenTrack: true }))) Sound.play('victory'); }, skipped ? 450 : 0);
        showRunOver(d.reason);
      }));
      else whenFxIdle(() => {   // 반대매매 연쇄를 다 보여준 뒤 게임오버. 스팅어가 끝나면 records 트랙
        if(!(musicOn() && Music.stinger('gameOver', { thenTrack: true }))) Sound.play(d.reason === 'BANKRUPT' ? 'bankrupt' : 'weekFail');
        showRunOver(d.reason);
      });
      break;
    case 'tipEvent':
      Sound.play('tipArrive');
      Music.stinger('tipAlert'); Music.duck('tip', 0.5);   // 고를 때까지 BGM 50%
      if(currentTab === 'play') showTipOverlay();
      break;
    case 'tipResolved': {
      Music.unduck('tip');
      const fromOverlay = overlayOpen && !!$('overlayBox').querySelector('[data-tip-choice]');
