}

const PACK_BURST = { common: [8, ['--muted', '--line2']], uncommon: [16, ['--green2', '--green']], rare: [26, ['--blue', '--cyan']],
                     legendary: [42, ['--purple', '--gold']], mythic: [80, ['--gold', '--gold2', '--text']] };   // 등급별 파티클 수 · 색
const PACK_REVEAL_MS = 500;   // .flip-card: 0.2초 대기 + 0.6초 뒤집기 → 절반 지점
function juicePack(d){
  const rarity = CARD_BY_ID[d.cardId].rarity, pb = PACK_BURST[rarity];
  setTimeout(() => Sound.play('packFlip', { rarity }), PACK_REVEAL_MS - 220);   // 휘릭(0.22초) 끝에 등급 음
  setTimeout(() => {
    const el = $('overlayBox').querySelector('.flip-card'), r = rectOf(el);
    if(r) Fx.burst(r.left + r.width / 2, r.top + r.height / 2, pb[0], pb[1]);
  }, PACK_REVEAL_MS);
}
function showPackResult(d){
  const pk = SHOP_PACK_BY_ID[d.packId], card = CARD_BY_ID[d.cardId];
  showOverlay(`
    <div class="ov-title" style="color:var(--purple)">${pk.icon} ${pk.name} 개봉</div>
    <div class="flip-stage"><div class="flip-card">
      <div class="flip-face flip-back">?</div>
      <div class="flip-face flip-front">${cardHtml(card, {})}</div>
    </div></div>
    <div class="ov-sub"><span class="c-rar ${card.rarity}">${RARITY_LABEL[card.rarity]}</span> · ${card.name} — 덱에 추가 (덱 ${d.deckSize}장)</div>
    <button class="ov-btn" data-act="close">확인</button>`);
}

$('shopBox').addEventListener('click', e => {
  if(!run) return;
  const info = e.target.closest('[data-pack-info]');
  if(info){ e.stopPropagation(); showPackInfo(info.dataset.packInfo); return; }   // 구성 보기는 구매와 별개
  const pk = e.target.closest('[data-pack]');
  const single = e.target.closest('[data-single]');
  const rm = e.target.closest('[data-shop-remove]');
  const relic = e.target.closest('[data-buy-relic]');
  const rr = e.target.closest('[data-reroll]');
  if(rr){ if(!rr.disabled) doReroll(rr.dataset.reroll); return; }
  if(relic) buyRelic(relic.dataset.buyRelic);
  else if(pk) buyPack(pk.dataset.pack);
  else if(single) buySingle(+single.dataset.single);
  else if(rm){ const i = +rm.dataset.shopRemove; shopPickIdx = shopPickIdx === i ? -1 : i; }
  else if(e.target.closest('#shopRemoveBtn')){
    const before = shopRemoveCost();
    if(shopRemoveCard(shopPickIdx)){   // 바로 제거 → 다음 가격이 튀어 오르며 빨갛게 (올랐다는 걸 체감)
      shopPickIdx = -1;
      renderShop(); renderNav();
      Fx.punch($('rmNext'), -(shopRemoveCost() - before), 0.8);
      Fx.flash($('rmNext'), 'rm-up');
      return;
    }
  }
  else if(e.target.closest('#shopLeaveBtn')){
    if(shopOpenNow()){ switchTab('play'); leaveShop(); renderAll(); return; }   // 화면을 먼저 옮겨야 개장 알림이 남는다
  }
  else return;
  renderShop();
  renderNav();
});

/* ── 카드 도감 ── */
let collectionRarity = '';   // 도감 등급 필터 ('' = 전체)
function buildCollection(){
  const augments = CARDS.filter(c => c.type !== 'stock' && c.type !== 'status').length;
  $('collectionSub').textContent = `종목 ${STOCKS.length} · 증강 ${augments} · 상태 ${CARDS.filter(c => c.type === 'status').length}`;
  $('collectionSub').textContent += ` · 유물 ${RELICS.length}`;
  const count = r => CARDS.filter(c => c.type !== 'status' && c.rarity === r).length + RELICS.filter(x => x.rarity === r).length;
  $('collectionFilter').innerHTML = [''].concat(RARITIES).map(r =>
    `<button class="${r === collectionRarity ? 'on' : ''}" data-rarity="${r}">${r ? `<span class="c-rar ${r}">${RARITY_LABEL[r]}</span> ${count(r)}` : '전체'}</button>`).join('');
  const show = x => !collectionRarity || x.rarity === collectionRarity;
  $('collectionBox').innerHTML = TYPE_ORDER.map(t => {
    const list = CARDS.filter(c => c.type === t && (t === 'status' ? !collectionRarity : show(c)));
    if(list.length === 0) return '';
    return `<div class="pile-title">▌ ${TYPE_LABEL[t]} (${list.length})</div>
      <div class="coll-grid">${list.map(c => cardHtml(c, {})).join('')}</div>`;
  }).join('') + (() => { const rl = RELICS.filter(show); return rl.length ? `<div class="pile-title">▌ 유물 (${rl.length})</div>
      <div class="relic-row">${rl.map(r => relicTile(r, {})).join('')}</div>` : ''; })();
}
/* ── 환경 설정 (UI 전용 — 엔진 규칙에는 영향 없음) ── */
const SETTINGS_KEY = 'hodl.settings';
const SETTING_OPTIONS = {
  speed: [[1, '1x'], [2, '2x'], [4, '4x']],
  shake: [[true, '켜기'], [false, '끄기']],
  crt:   [['off', '끄기'], ['weak', '약'], ['strong', '강']],
  sound: [[true, '켜기'], [false, '끄기']],
  chainFx: [[true, '켜기'], [false, '끄기']],
  sfxVol: [[0, '0'], [25, '25'], [50, '50'], [75, '75'], [100, '100']],
  tickSound: [[true, '켜기'], [false, '끄기']],
  hitStop: [[true, '켜기'], [false, '끄기']],
  bgm: [[true, '켜기'], [false, '끄기']],
  fxSpeed: [['normal', '보통'], ['fast', '빠름'], ['min', '최소']],
  bgmVol: [[0, '0'], [25, '25'], [40, '40'], [50, '50'], [75, '75'], [100, '100']],
  uiSize: [['small', '작게'], ['auto', '자동'], ['large', '크게'], ['xlarge', '매우 크게']],
  fontSize: [['normal', '보통'], ['large', '크게']]
};
// 시스템 '동작 줄이기'가 켜져 있으면 흔들림·글리치(·히트스톱)를 기본으로 끈다. 파티클·소리는 그대로
const PREFERS_REDUCED_MOTION = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
const DEFAULT_SETTINGS = { speed: 1, shake: !PREFERS_REDUCED_MOTION, crt: 'strong', sound: true, chainFx: true,
                           sfxVol: 50, tickSound: false, hitStop: true, bgm: true, bgmVol: 40, fxSpeed: 'normal',
                           uiSize: 'auto', fontSize: 'normal' };
function loadSettings(){
  const s = Object.assign({}, DEFAULT_SETTINGS);
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(SETTINGS_KEY)); } catch(e) {}
  if(saved && typeof saved === 'object'){
    Object.keys(SETTING_OPTIONS).forEach(k => {   // 허용된 값만 받는다 (깨진 값이면 기본값)
      if(SETTING_OPTIONS[k].some(o => o[0] === saved[k])) s[k] = saved[k];
    });
  }
  return s;
}
let settings = loadSettings();
function saveSettings(){
  try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); } catch(e) {}
}
function applySettings(){
  Sound.setEnabled(settings.sound);
  Sound.setVolume(settings.sfxVol / 100);
  Music.setEnabled(settings.sound && settings.bgm);   // 사운드를 끄면 배경음악도 꺼진다
  Music.setVolume(settings.bgmVol / 100);
  Fx.setOptions({ motion: settings.shake, hitStop: settings.hitStop });
  Fx.setSpeed(settings.fxSpeed);   // 흔들림을 끄면 글리치·히트스톱도 꺼진다
  document.documentElement.dataset.font = settings.fontSize;   // 글자 크기: --fs-* 한 단계 위 (CSS html[data-font="large"])
  layoutUi();
  document.body.dataset.crt = settings.crt;
}
function settingRow(key, label, desc, disabled){
