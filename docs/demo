@keyframes ovShake2{0%,100%{transform:none;}20%{transform:translate(calc(-4 * var(--u) * var(--ovk, 2)),calc(2 * var(--u) * var(--ovk, 2)));}40%{transform:translate(calc(4 * var(--u) * var(--ovk, 2)),calc(-2 * var(--u) * var(--ovk, 2)));}60%{transform:translate(calc(-3 * var(--u) * var(--ovk, 2)),calc(-1 * var(--u) * var(--ovk, 2)));}80%{transform:translate(calc(3 * var(--u) * var(--ovk, 2)),calc(1 * var(--u) * var(--ovk, 2)));}}
@keyframes ovShake3{0%,100%{transform:none;}12%{transform:translate(calc(-8 * var(--u) * var(--ovk, 2)),calc(4 * var(--u) * var(--ovk, 2)));}25%{transform:translate(calc(7 * var(--u) * var(--ovk, 2)),calc(-5 * var(--u) * var(--ovk, 2)));}37%{transform:translate(calc(-6 * var(--u) * var(--ovk, 2)),calc(-3 * var(--u) * var(--ovk, 2)));}50%{transform:translate(calc(6 * var(--u) * var(--ovk, 2)),calc(3 * var(--u) * var(--ovk, 2)));}62%{transform:translate(calc(-4 * var(--u) * var(--ovk, 2)),calc(2 * var(--u) * var(--ovk, 2)));}75%{transform:translate(calc(3 * var(--u) * var(--ovk, 2)),calc(-2 * var(--u) * var(--ovk, 2)));}87%{transform:translate(calc(-2 * var(--u) * var(--ovk, 2)),calc(1 * var(--u) * var(--ovk, 2)));}}
