<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title></title>
<script>
/* 게임 이름·메타 — 이름이 나오는 곳(탭 제목·타이틀 로고·전광판 등)은 전부 여기를 읽는다. 이름을 바꿀 땐 이 값만 */
const GAME_TITLE = { ko: '풀매수 기원단', en: 'HODL or Die', sub: '' };
const GAME_META  = {
  version: 'Version 0.1 (DEMO)',
  author: '',                       // 제작자명 — 빈 문자열이면 타이틀의 'GAME BY' 줄을 숨긴다
  links: { steam: '', discord: '' } // 타이틀 오른쪽 아래 링크 버튼 — 비어 있으면 숨긴다
};
document.title = GAME_TITLE.ko + ': ' + GAME_TITLE.en + (GAME_TITLE.sub ? ' — ' + GAME_TITLE.sub : '');
</script>
<style>
/* ── 폰트 (전부 로컬 파일: docs/assets/fonts/, 라이선스 OFL 1.1 — 같은 폴더의 *-OFL.txt) ──
   글자 크기 체계 (기준 해상도 960×600 기준 px — 데스크톱은 이걸 통째로 정수·0.5배 확대한다):
   · Press Start 2P: 8 / 16 / 24만 (원래 calc(8 * var(--u)) 픽셀의 정수배라 선명). 화면 제목·큰 숫자·버튼·짧은 영문 태그(NORMAL·GAP)에만.
   · VT323 본문: 16 / 20 / 24 / 30 (최소 16).
   · 한글 Galmuri: 원래 픽셀 크기와 그 2배만 — 10(Galmuri9) · 12(Galmuri11) · 15(Galmuri14) · 16(Galmuri7×2) · 20(Galmuri9×2) · 24(Galmuri11×2) · 30(Galmuri14×2). 최소 10.
   font-size는 전부 아래 --fs-* 변수만 쓰고, font-family도 같은 역할 변수(--gf-* 한글 전용 · --gp-* Press Start 2P 옆 한글 · --gv-* VT323 옆 한글)를 쓴다.
   '글자 크기: 크게'(html[data-font="large"])는 변수를 한 단계씩 올린다. */
@font-face{font-family:'Press Start 2P';src:url('assets/fonts/PressStart2P-Regular.ttf') format('truetype');font-display:swap;}
@font-face{font-family:'VT323';src:url('assets/fonts/VT323-Regular.ttf') format('truetype');font-display:swap;}
/* 한글만 쓰는 곳: 파일 원래 크기(또는 2배)로만 쓰므로 size-adjust 100% */
@font-face{font-family:'Galmuri7';src:url('assets/fonts/Galmuri7.woff2') format('woff2');font-display:swap;}    /* 8px(아이콘성 짧은 라벨) · 16px(2배) */
@font-face{font-family:'Galmuri9';src:url('assets/fonts/Galmuri9.woff2') format('woff2');font-display:swap;}    /* 10px · 20px(2배) */
@font-face{font-family:'Galmuri11';src:url('assets/fonts/Galmuri11.woff2') format('woff2');font-display:swap;}  /* 12px · 24px(2배) */
@font-face{font-family:'Galmuri14';src:url('assets/fonts/Galmuri14.woff2') format('woff2');font-display:swap;}  /* 15px · 30px(2배) */
/* Press Start 2P 옆 한글: CSS 글자 크기 × size-adjust = Galmuri 원래 크기(또는 2배). 계산 = 목표 px ÷ CSS px */
@font-face{font-family:'GP8';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:125%;font-display:swap;}     /* PS2P 8px → 한글 Galmuri9 10px */
@font-face{font-family:'GP8L';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:150%;font-display:swap;}   /* PS2P 8px → 한글 Galmuri11 12px (글자 크게) */
@font-face{font-family:'GP16';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:100%;font-display:swap;}    /* PS2P 16px → 한글 Galmuri7×2 16px */
@font-face{font-family:'GP16L';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:125%;font-display:swap;}   /* PS2P 16px → 한글 Galmuri9×2 20px (글자 크게) */
@font-face{font-family:'GP24';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:100%;font-display:swap;}   /* PS2P 24px → 한글 Galmuri11×2 24px */
@font-face{font-family:'GP24L';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:125%;font-display:swap;}  /* PS2P 24px → 한글 Galmuri14×2 30px (글자 크게) */
/* VT323 옆 한글: VT323 글자가 작아서 약 75% (기존 규칙 그대로). 계산 = 목표 px ÷ CSS px */
@font-face{font-family:'GV16';src:url('assets/fonts/Galmuri11.woff2') format('woff2');size-adjust:75%;font-display:swap;}     /* VT323 16px → Galmuri11 12px */
@font-face{font-family:'GV20';src:url('assets/fonts/Galmuri14.woff2') format('woff2');size-adjust:75%;font-display:swap;}     /* VT323 20px → Galmuri14 15px */
@font-face{font-family:'GV24';src:url('assets/fonts/Galmuri7.woff2') format('woff2');size-adjust:66.6667%;font-display:swap;} /* VT323 24px → Galmuri7×2 16px */
@font-face{font-family:'GV30';src:url('assets/fonts/Galmuri9.woff2') format('woff2');size-adjust:66.6667%;font-display:swap;} /* VT323 30px → Galmuri9×2 20px */
:root{
  /* 화면 배율: 데스크톱은 layoutUi()가 --ui(창 높이 ÷ 600, 1~2.5)를 정한다. 모든 길이는 --u의 배수 */
  --ui:1;
  --u:calc(var(--ui) * 1px);
  /* 한글 전용 (Galmuri) */
  --fs-xs:calc(10 * var(--u));  --gf-xs:'Galmuri9';
  --fs-sm:calc(12 * var(--u));  --gf-sm:'Galmuri11';
  --fs-md:calc(15 * var(--u));  --gf-md:'Galmuri14';
  --fs-m16:calc(16 * var(--u)); --gf-m16:'Galmuri7';
  --fs-lg:calc(20 * var(--u));  --gf-lg:'Galmuri9';
  --fs-xl:calc(24 * var(--u));  --gf-xl:'Galmuri11';
  --fs-xxl:calc(30 * var(--u)); --gf-xxl:'Galmuri14';
  /* Press Start 2P (+ 옆 한글) */
  --fs-p1:calc(8 * var(--u));   --gp-p1:'GP8';
  --fs-p2:calc(16 * var(--u));  --gp-p2:'GP16';
  --fs-p3:calc(24 * var(--u));  --gp-p3:'GP24';
  /* VT323 본문 (+ 옆 한글) */
  --fs-v1:calc(16 * var(--u));  --gv-v1:'GV16';
  --fs-v2:calc(20 * var(--u));  --gv-v2:'GV20';
  --fs-v3:calc(24 * var(--u));  --gv-v3:'GV24';
  --fs-v4:calc(30 * var(--u));  --gv-v4:'GV30';
}
/* 글자 크기: 크게 — 한 단계씩 (Press Start 2P는 8/16/24만 선명해서 크기는 그대로, 옆 한글만 한 단계 위) */
html[data-font="large"]{
  --fs-xs:calc(12 * var(--u));  --gf-xs:'Galmuri11';
  --fs-sm:calc(15 * var(--u));  --gf-sm:'Galmuri14';
  --fs-md:calc(16 * var(--u));  --gf-md:'Galmuri7';
  --fs-m16:calc(20 * var(--u)); --gf-m16:'Galmuri9';
  --fs-lg:calc(24 * var(--u));  --gf-lg:'Galmuri11';
  --fs-xl:calc(30 * var(--u));  --gf-xl:'Galmuri14';
  --gp-p1:'GP8L'; --gp-p2:'GP16L'; --gp-p3:'GP24L';
  --fs-v1:calc(20 * var(--u));  --gv-v1:'GV20';
  --fs-v2:calc(24 * var(--u));  --gv-v2:'GV24';
  --fs-v3:calc(30 * var(--u));  --gv-v3:'GV30';
}
button,input,select,textarea{font-family:inherit;}
small{font-size:inherit;}   /* 브라우저 기본 smaller(83%)는 허용 크기가 아니다 — 작은 글씨는 규칙마다 --fs-*로 정한다 */

/* ── PIXEL DESIGN SYSTEM ─────────────────────────────────── */
:root{
  --bg:#02040a;
  --panel:#080e1c;
  --panel2:#0c1428;
  --green:#00ff41;
  --green2:#00c832;
  --green-dim:#003a14;
  --red:#ff1a3c;
  --red2:#cc0028;
  --red-dim:#3a000e;
  --gold:#ffd700;
  --gold2:#e6a800;
  --purple:#9f5fff;
  --cyan:#00e5ff;
  --text:#d4deff;
  /* 대비(WCAG): --muted #8a96c4 = bg #02040a 7.07:1 · panel #080e1c 6.64:1 · panel2 #0c1428 6.32:1 (이전 #4a5580은 2.83·2.66·2.53)
     --text2 #acb6d4 = 카드 설명 등 보조 본문 (예전 --text opacity .8과 같은 색, panel2 대비 9.07:1). --line(1.24:1)은 글자색에 쓰지 않는다 */
  --muted:#8a96c4;
  --text2:#acb6d4;
  --line:#1a2240;
  --line2:#0f172a;
  --blue:#3d7bff;
}

.px-border{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--line),
    inset 0 0 0 calc(1 * var(--u)) rgba(255,255,255,.04);
  image-rendering:pixelated;
}
.px-border-gold{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--gold2),
    0 0 0 calc(4 * var(--u)) #000,
    inset 0 0 0 calc(1 * var(--u)) rgba(255,215,0,.12);
}
.px-border-green{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--green2),
    0 0 0 calc(4 * var(--u)) #000,
    inset 0 0 0 calc(1 * var(--u)) rgba(0,255,65,.08);
}
.px-border-red{
  box-shadow:
    0 0 0 calc(2 * var(--u)) var(--red2),
    0 0 0 calc(4 * var(--u)) #000;
}

*{box-sizing:border-box; image-rendering:pixelated;}
html,body{
  margin:0;padding:0;
  background:var(--bg);
  color:var(--text);
  font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);
  overflow-x:hidden;
}

/* ── CRT LAYER ───────────────────────────────────────────── */
body::before{
  content:'';
  position:fixed;inset:0;z-index:9999;
  pointer-events:none;
  background:repeating-linear-gradient(
    0deg,
    transparent,
    transparent calc(2 * var(--u)),
    rgba(0,0,0,.08) calc(2 * var(--u)),
    rgba(0,0,0,.08) calc(4 * var(--u))
  );
}
body::after{
  content:'';
  position:fixed;inset:0;z-index:9998;
  pointer-events:none;
  background:radial-gradient(ellipse at center,transparent 60%,rgba(0,0,0,.55) 100%);
}

/* ── CABINET (MAIN UI CONTAINER) ────────────────────────── */
.cabinet{
  position:relative;
  max-width:calc(520 * var(--u));margin:0 auto;min-height:100vh;
  background:linear-gradient(180deg,#080e1c,#02040a 60%);
  border-left:calc(3 * var(--u)) solid #1a2240;
  border-right:calc(3 * var(--u)) solid #1a2240;
  box-shadow:0 0 calc(80 * var(--u)) rgba(0,0,0,.9) inset,0 0 calc(2 * var(--u)) var(--cyan) inset;
  overflow:hidden;z-index:1;
}


.screen{display:none;position:relative;z-index:1;min-height:100vh;}
.screen.active{display:block;}

/* ═══════════════════════════════════════════════════════════
   01 TITLE
═══════════════════════════════════════════════════════════ */
/* 타이틀: 전체 화면. 배경 = 흐르는 캔들(20~30%) + CRT 노이즈·스캔라인·비네팅 + 모서리 청록 테두리.
   왼쪽 위 로고 · 왼쪽 아래 [대괄호 메뉴] · 오른쪽 위 버전 · 오른쪽 아래 아이콘 · 맨 아래 전광판 */
#screen-title{position:relative;overflow:hidden;background:var(--bg);}
#screen-title.active{display:block;}
.t-chart{position:absolute;left:0;right:0;bottom:0;width:100%;height:66%;opacity:.25;image-rendering:pixelated;pointer-events:none;}
.t-noise{position:absolute;inset:0;width:100%;height:100%;opacity:.07;image-rendering:pixelated;pointer-events:none;}
.t-scan{position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg, rgba(0,0,0,.28) 0, rgba(0,0,0,.28) calc(1 * var(--u)), transparent calc(1 * var(--u)), transparent calc(3 * var(--u)));
  box-shadow:inset 0 0 calc(160 * var(--u)) calc(50 * var(--u)) #000;}
.t-frame{position:absolute;inset:calc(8 * var(--u));pointer-events:none;box-shadow:inset 0 0 0 calc(1 * var(--u)) rgba(0,229,255,.28);}
.t-frame i{position:absolute;width:calc(22 * var(--u));height:calc(22 * var(--u));border:0 solid var(--cyan);}
.t-frame i:nth-child(1){top:0;left:0;border-width:calc(2 * var(--u)) 0 0 calc(2 * var(--u));}
.t-frame i:nth-child(2){top:0;right:0;border-width:calc(2 * var(--u)) calc(2 * var(--u)) 0 0;}
.t-frame i:nth-child(3){bottom:0;left:0;border-width:0 0 calc(2 * var(--u)) calc(2 * var(--u));}
.t-frame i:nth-child(4){bottom:0;right:0;border-width:0 calc(2 * var(--u)) calc(2 * var(--u)) 0;}

/* 로고: 한글 이름(Galmuri14 원래 크기의 정수배 — JS가 --logo-ko를 정한다) + 영문(Press Start 2P 8의 배수) + 떡상 기원부적 */
.t-logo{position:absolute;left:6%;top:9%;z-index:2;}
.t-ko{position:relative;font-family:'Galmuri14',monospace;font-size:var(--logo-ko, 60px);line-height:1.15;color:var(--green);white-space:nowrap;}
.t-ko .t-ch{position:relative;display:inline-block;text-shadow:0 .1em 0 #003a14, .06em .06em 0 #000;}
.t-ko .t-ch::after{content:'';position:absolute;left:50%;bottom:-.14em;width:max(calc(2 * var(--u)), .06em);height:.2em;margin-left:-.03em;background:var(--green2);box-shadow:.03em .03em 0 #000;}   /* 글자마다 캔들 아래꼬리 */
.t-ko .t-sp{display:inline-block;width:.45em;}
.t-ko .t-ch.pop{animation:tPop .6s steps(6);}
@keyframes tPop{0%{transform:none;}25%{transform:translateY(-.3em);color:var(--gold);}45%{transform:translateY(-.34em);color:var(--gold);}80%{transform:translateY(.04em);}100%{transform:none;}}
.t-logo.limitdown .t-ko{color:var(--red);transform:translateX(calc(3 * var(--u)));}
.t-logo.limitdown .t-ko .t-ch{text-shadow:0 .1em 0 #3a000e, calc(-3 * var(--u)) 0 0 var(--cyan);}
.t-logo.limitdown .t-ko .t-ch::after{background:var(--red2);}
.t-logo.limitdown .t-limit{display:block;}
.t-limit{display:none;position:absolute;left:0;top:-1.6em;font-family:var(--gf-md),monospace;font-size:var(--fs-md);color:#000;background:var(--red);padding:0 calc(6 * var(--u));}
.t-en{margin-top:.55em;font-family:'Press Start 2P',monospace;font-size:var(--logo-en, 24px);line-height:1.2;color:var(--gold);letter-spacing:.08em;
  text-shadow:.12em .12em 0 #5c3d00;white-space:nowrap;}
.t-logo .jibu-badge{
  position:absolute;top:-.1em;right:-1.25em;font-size:var(--logo-ko, 60px);
  width:calc(82 * var(--u));height:calc(82 * var(--u));
  background:var(--red-dim);
  box-shadow:0 0 0 calc(3 * var(--u)) var(--red),0 0 0 calc(6 * var(--u)) #000,0 0 0 calc(8 * var(--u)) var(--gold2),calc(4 * var(--u)) calc(4 * var(--u)) 0 #000;
  transform:rotate(12deg);
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  font-family:var(--gf-md),monospace;color:var(--gold);line-height:1.2;
  animation:badgeFloat 2.4s steps(4) infinite;
}
.t-logo .jibu-badge b{font-weight:normal;font-family:var(--gf-md),monospace;font-size:var(--fs-md);}
.t-logo .jibu-badge span{font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;color:var(--text);margin-top:calc(4 * var(--u));}
@keyframes badgeFloat{
  0%{transform:rotate(12deg) translateY(0);}
  50%{transform:rotate(8deg) translateY(calc(-5 * var(--u)));}
  100%{transform:rotate(12deg) translateY(0);}
}

/* 메뉴: [대괄호] 세로 목록. 선택(호버·키보드 공용 .sel) = 바가 왼쪽부터 초록으로 차오름 + 캔들 커서 ▮ 깜빡임 */
.t-menu{position:absolute;left:6%;bottom:calc(92 * var(--u));width:48%;display:flex;flex-direction:column;gap:calc(6 * var(--u));z-index:2;}
.t-item{position:relative;display:block;width:100%;text-align:left;border:none;cursor:pointer;overflow:hidden;
  background:rgba(2,4,10,.72);box-shadow:0 0 0 calc(1 * var(--u)) var(--line);
  padding:calc(8 * var(--u)) calc(14 * var(--u)) calc(8 * var(--u)) calc(34 * var(--u));
  font-family:var(--gf-lg),monospace;font-size:var(--fs-lg);line-height:1.3;color:var(--text2);letter-spacing:.04em;}
.t-item[hidden]{display:none;}
.t-item::before{content:'';position:absolute;inset:0;background:var(--green-dim);box-shadow:inset 0 0 0 calc(1 * var(--u)) var(--green2);
  transform:scaleX(0);transform-origin:left;transition:transform .18s steps(6);}
.t-item > span{position:relative;}
.t-item .t-cur{position:absolute;left:calc(14 * var(--u));top:50%;margin-top:-.62em;color:var(--green);visibility:hidden;}
.t-item.sel{color:var(--green);text-shadow:0 0 calc(8 * var(--u)) rgba(0,255,65,.6);}
.t-item.sel::before{transform:scaleX(1);}
.t-item.sel .t-cur{visibility:visible;animation:blink .5s step-end infinite;}
.t-item.armed{color:var(--red);}
.t-item.armed::before{background:var(--red-dim);box-shadow:inset 0 0 0 calc(1 * var(--u)) var(--red2);}
.t-item.flash::before{background:var(--green);animation:tFlash .2s steps(2);}
.t-item.flash{color:#000;text-shadow:none;}
@keyframes tFlash{50%{background:var(--text);}}
.t-gap{height:calc(10 * var(--u));}

.t-meta{position:absolute;top:calc(22 * var(--u));right:calc(28 * var(--u));text-align:right;z-index:2;
  font-family:'VT323',var(--gv-v1),monospace;font-size:var(--fs-v1);line-height:1.3;color:var(--muted);}
.t-meta div[hidden]{display:none;}
.t-corner{position:absolute;right:calc(28 * var(--u));bottom:calc(92 * var(--u));z-index:2;display:flex;flex-direction:column;align-items:flex-end;gap:calc(10 * var(--u));}
.t-links{display:flex;gap:calc(8 * var(--u));}
.t-links a{padding:calc(4 * var(--u)) calc(8 * var(--u));background:rgba(2,4,10,.8);box-shadow:0 0 0 calc(1 * var(--u)) var(--line);color:var(--cyan);text-decoration:none;
  font-family:var(--gf-xs),monospace;font-size:var(--fs-xs);}
.t-links a[hidden]{display:none;}
.t-icons{display:flex;gap:calc(10 * var(--u));}
.t-icon{width:calc(44 * var(--u));height:calc(44 * var(--u));border:none;cursor:pointer;background:rgba(2,4,10,.8);color:var(--cyan);
  box-shadow:0 0 0 calc(2 * var(--u)) var(--line),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;font-family:'VT323',var(--gv-v3),monospace;font-size:var(--fs-v3);line-height:1;}
.t-icon:hover,.t-icon.sel{box-shadow:0 0 0 calc(2 * var(--u)) var(--cyan),calc(3 * var(--u)) calc(3 * var(--u)) 0 #000;color:var(--text);}
.t-press{position:absolute;left:0;right:0;bottom:calc(52 * var(--u));text-align:center;z-index:2;
  font-family:var(--gf-sm),monospace;font-size:var(--fs-sm);color:var(--text2);animation:blink 1.1s step-end infinite;}
.t-press[hidden]{display:none;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}

/* 등장: CRT 켜짐(가운데 가로선이 펴지며 위아래로 열림) → 차트 페이드인 → 로고 타자 → 메뉴가 위부터 미끄러져 들어옴 */
.t-crt{position:absolute;inset:0;z-index:30;pointer-events:none;display:none;}
.t-crt::before,.t-crt::after{content:'';position:absolute;left:0;right:0;height:50%;background:#000;}
.t-crt::before{top:0;transform-origin:top;}
.t-crt::after{bottom:0;transform-origin:bottom;}
.t-crt i{position:absolute;left:0;right:0;top:50%;height:calc(2 * var(--u));margin-top:calc(-1 * var(--u));background:var(--text);box-shadow:0 0 calc(12 * var(--u)) var(--cyan);}
