.flip-stage.pk{padding-top:calc(44 * var(--u));}   /* 카드가 떠 있는 높이만큼 (제목을 가리지 않게) */
.pk-float{position:relative;z-index:1;animation:pkDescend .6s steps(6) var(--pk-shake) both;}   /* 바깥: 공중 → 내려옴 */
.pk-shake{animation:pkShake var(--pk-shake) steps(8);}                                           /* 안쪽: 흔들림 */
