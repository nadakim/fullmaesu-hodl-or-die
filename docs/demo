    <div class="relic-row">${sh.relics.length ? sh.relics.map(id => {
      const r = RELIC_BY_ID[id], price = RELIC_PRICE[r.rarity], owned = hasRelic(id);
      return relicTile(r, { extra: `<button class="buy-btn" data-buy-relic="${id}" ${owned || run.slush < price ? 'disabled' : ''}>${owned ? '보유 중' : `${fmtSlush(price)} 구매`}</button>` });
    }).join('') : '<div class="shop-note">더 들여올 유물이 없습니다. 전부 모았습니다.</div>'}</div>

    <span class="section-label">▌ 카드 제거 (덱 압축) — 주 ${SHOP_REMOVE_LIMIT}회 · 이번 주 ${fmtSlush(removeCost)} (주차마다 +${SHOP_REMOVE_PER_WEEK}만)</span>
    <div class="deck-list shop-remove">${run.masterDeck.map((id, i) =>
      cardHtml(CARD_BY_ID[id], { attrs: canRemove ? `data-shop-remove="${i}"` : '', cls: i === shopPickIdx ? 'picked' : '' })).join('')}</div>
    <button class="ov-btn alt shop-remove-btn" id="shopRemoveBtn" ${canRemove && shopPickIdx >= 0 && run.slush >= removeCost ? '' : 'disabled'}>
      ${!canRemove ? (sh.removed >= SHOP_REMOVE_LIMIT ? '이번 주 제거 완료' : `덱 ${MIN_DECK_SIZE}장 이하 — 제거 불가`)
        : shopPickIdx < 0 ? '제거할 카드를 고르세요' : `✂ ${CARD_BY_ID[run.masterDeck[shopPickIdx]].name} 영구 제거 (${fmtSlush(removeCost)})`}
    </button>`;
}

