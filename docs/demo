.p-l2{display:flex;align-items:center;flex-wrap:wrap;gap:calc(2 * var(--u)) calc(8 * var(--u));margin-top:calc(2 * var(--u));
  font-size:var(--fs-xs);font-family:var(--gf-xs),monospace;color:var(--muted);line-height:1.35;}
.p-l2 .detail{white-space:nowrap;}
.p-icons{display:flex;gap:calc(3 * var(--u));white-space:nowrap;}
