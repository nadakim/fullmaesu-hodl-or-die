const TUNER_KEY = 'hodl.tuner';
const JUICE_DEFAULTS = JSON.parse(JSON.stringify(JUICE_CONFIG));
const TUNER_ON = /[?&](tuner|debug)=1(&|$)/.test(location.search);   // UI 규칙 7: 디버그 UI는 ?debug=1(또는 예전 ?tuner=1) · 백틱(`) 키로만
const TUNER_COMBO_TEST = { hits: 20, gapMs: 220 };
let tunerLastCopy = '';
function tunerLeaves(obj, path, out){   // 숫자 칸 목록 [{ path: ['stageMs', 'row'], v }]
  Object.keys(obj).forEach(k => {
    const v = obj[k], p = path.concat(k);
    if(typeof v === 'number') out.push({ path: p, v });
    else if(v && typeof v === 'object') tunerLeaves(v, p, out);
  });
  return out;
}
const tunerGet = (root, path) => path.reduce((o, k) => (o == null ? undefined : o[k]), root);
function tunerSet(path, v){ const parent = tunerGet(JUICE_CONFIG, path.slice(0, -1)); if(parent && typeof parent[path[path.length - 1]] === 'number') parent[path[path.length - 1]] = v; if(path.length === 1 && DUR_LINKS[path[0]]) syncDurVars(); }
/* JUICE_CONFIG ↔ :root --dur-* 묶음: 튜너로 바꾼 값을 CSS 애니메이션에도 (기본값은 CSS 쪽 하나) */
const DUR_LINKS = { hazeInMs: 'haze-in', packFlipMs: 'pack-flip', mythSpinMs: 'myth-spin', comboCoolMs: 'combo-cool' };
function syncDurVars(){ Object.keys(DUR_LINKS).forEach(k => document.documentElement.style.setProperty('--dur-' + DUR_LINKS[k], JUICE_CONFIG[k] + 'ms')); }
function tunerLoad(){
  try {
    const saved = JSON.parse(localStorage.getItem(TUNER_KEY) || 'null');
    if(saved) tunerLeaves(saved, [], []).forEach(({ path, v }) => { if(Number.isFinite(v)) tunerSet(path, v); });
  } catch(e) {}
}
function tunerSave(){ try { localStorage.setItem(TUNER_KEY, JSON.stringify(JUICE_CONFIG)); } catch(e) {} }
function tunerRange(def){   // 슬라이더 범위: 기본값의 4배까지 (0이면 0~10, 1 미만이면 0~1)
  if(def === 0) return [0, 10, 1];
  if(Math.abs(def) < 1) return [0, 1, 0.01];
  return [0, Math.max(10, Math.ceil(Math.abs(def) * 4)), def % 1 ? 0.01 : 1];
}
function buildTuner(){
  const box = document.createElement('div');
  box.id = 'tunerPanel'; box.className = 'tuner';
  const rows = tunerLeaves(JUICE_DEFAULTS, [], []).map(({ path }) => {
    const [mn, mx, st] = tunerRange(tunerGet(JUICE_DEFAULTS, path)), cur = tunerGet(JUICE_CONFIG, path), key = path.join('.');
    return `<label class="tn-row"><span class="tn-k">${key}</span>
      <input type="range" min="${mn}" max="${Math.max(mx, cur)}" step="${st}" value="${cur}" data-tn="${key}"><b class="tn-v" data-tnv="${key}">${cur}</b></label>`;
  }).join('');
  box.innerHTML = `<div class="tn-head"><span>JUICE TUNER</span><button class="tn-btn" data-tn-act="fold">─</button></div>
    <div class="tn-body">
      <div class="tn-btns"><button class="tn-btn" data-tn-act="combo">콤보 테스트</button><button class="tn-btn" data-tn-act="stage">정산 무대 테스트</button><button class="tn-btn" data-tn-act="copy">값 복사</button><button class="tn-btn" data-tn-act="reset">기본값</button></div>
      <div class="tn-btns"><select class="tn-sel" id="tunerRelic">${RELICS.slice().sort((a, b) => (b.rule ? 1 : 0) - (a.rule ? 1 : 0)).map(r => `<option value="${r.id}">${r.rule ? '⚠ ' : ''}${r.icon} ${r.name}</option>`).join('')}</select><button class="tn-btn" data-tn-act="relic">유물 장착</button></div>
      <textarea class="tn-out" id="tunerOut" readonly hidden></textarea>
      ${rows}
    </div>`;
  document.body.appendChild(box);
  box.addEventListener('input', e => {
    const key = e.target.dataset.tn;
    if(!key) return;
    const v = +e.target.value;
    tunerSet(key.split('.'), v);
    box.querySelector(`[data-tnv="${key}"]`).textContent = v;
    tunerSave();
  });
  box.addEventListener('click', e => {
    const act = e.target.dataset.tnAct;
    if(act === 'fold') box.classList.toggle('folded');
    if(act === 'combo') tunerComboTest();
    if(act === 'stage') tunerStageTest();
    if(act === 'copy') tunerCopy();
    if(act === 'reset') tunerReset();
    if(act === 'relic'){ const id = $('tunerRelic').value; toast(window.__debug.giveRelic(id) ? `${RELIC_BY_ID[id].icon} ${RELIC_BY_ID[id].name} 장착` : '장착 실패 (판 없음 · 이미 있음 · 칸 가득)', 'info'); }
  });
}
function tunerComboTest(){   // 가짜 수익 이벤트 1→20 → 끊김 (단계·음높이·JACKPOT·'최대 ×N' 확인용)
  comboBreak();
  let k = 0;
  const iv = setInterval(() => {
    if(k++ < TUNER_COMBO_TEST.hits) comboHit('test');
    else { clearInterval(iv); comboBreak(); }
  }, TUNER_COMBO_TEST.gapMs);
}
function tunerStageTest(){   // 가짜 정산 기록 ×2 → ×10 → ×100 → ×1,000 → ×10,000 (불꽃 티어·팝·상자 흔들림 확인용). 판이 있고 TR룸일 때만
  if(!run || currentTab !== 'play'){ toast('TR룸에서 판을 시작한 뒤 눌러 주세요', 'info'); return; }
  const base = 1000, mults = [2, 5, 10, 10, 10];   // 누적 ×2 → ×10 → ×100 → ×1,000 → ×10,000
