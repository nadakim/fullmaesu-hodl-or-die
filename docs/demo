  return `<div class="boss-notice px-panel-red ${b.final ? 'final' : ''} ${compact ? 'compact' : ''}" data-boss="${b.id}">
    <div class="bn-lead">${lead}</div><div class="bn-name">${b.icon} ${b.name} <span class="bn-kind">${bossKindLabel(b)}</span></div>
