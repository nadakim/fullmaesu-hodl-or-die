  const payout = chips * m - base;
  Fx.skipQueue(); stageClose();
  playDayStage({ round: run.round, day: 1, payout, settlement: [{ posId: 0, posName: '테스트 종목', assetId: 'test', dir: 1, lev: 1, base, steps, chips, mult: m, payout, sources: [] }] });
}
function tunerCopy(){
  tunerLastCopy = JSON.stringify(JUICE_CONFIG, null, 2);
  const out = $('tunerOut');
  out.hidden = false; out.value = tunerLastCopy; out.select();
  try { if(navigator.clipboard) navigator.clipboard.writeText(tunerLastCopy).then(() => toast('JUICE_CONFIG 복사됨', 'good'), () => {}); } catch(e) {}
