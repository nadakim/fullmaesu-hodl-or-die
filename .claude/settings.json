{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/protect-files.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/content-guard.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/engine-guard.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
